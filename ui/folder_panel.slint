import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize, IconSlot } from "icons.slint";
import { FolderNodeView } from "types.slint";
import { NodeButton } from "node_button.slint";
import { SmoothScrollArea } from "smooth_scroll_view.slint";
import { FolderPanelToolbar } from "folder_panel_toolbar.slint";

export component FolderItemRow inherits Rectangle {
    in property <FolderNodeView> folder;
    in property <int> drop-target-folder-id: -1;
    callback clicked();
    callback toggle-expand();
    callback context-menu-requested(length /* x */, length /* y */);
    callback row-hovered(int /* folder_id */);
    callback row-unhovered(int /* folder_id */);

    property <bool> is-drop-target: root.folder.id == root.drop-target-folder-id && !root.folder.is-deleted;

    height: 24px;
    background: root.is-drop-target ? #89b4fa44 : (
        root.folder.is-selected ? Theme.surface-selected : (
            ftouch.has-hover ? Theme.surface-hover : transparent
        )
    );
    border-radius: 3px;
    border-width: (root.folder.is-selected || root.is-drop-target) ? 1.5px : 0px;
    border-color: root.is-drop-target ? Theme.accent : (root.folder.is-selected ? Theme.primary : transparent);

    property <bool> is-hovered: ftouch.has-hover;
    changed is-hovered => {
        if self.is-hovered {
            root.row-hovered(root.folder.id);
        } else {
            root.row-unhovered(root.folder.id);
        }
    }

    ftouch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                if event.button == PointerEventButton.right {
                    root.context-menu-requested(ftouch.mouse-x, ftouch.mouse-y);
                } else if event.button == PointerEventButton.left {
                    root.clicked();
                }
            }
        }
    }

    HorizontalLayout {
        padding-left: (root.folder.depth * 16px) + 6px;
        padding-right: 8px;
        spacing: 6px;
        alignment: start;

        // Tree Node Toggle (+ / -) Button
        NodeButton {
            has-children: root.folder.has-children;
            is-expanded: root.folder.is-expanded;
            show-leaf-bullet: false;
            button-size: 14px;
            y: (parent.height - self.height) / 2;
            toggled(state) => {
                root.toggle-expand();
            }
        }

        // Folder Icon / Drop Target Indicator
        IconSlot {
            icon: root.is-drop-target ? IconId.arrow-down : IconId.folder;
            size: IconSize.md;
            color: root.is-drop-target
                ? Theme.accent
                : (root.folder.is-deleted
                    ? Theme.status-deleted
                    : (root.folder.is-selected ? Theme.primary : Theme.text-muted));
        }

        // Strictly Left-Aligned Folder Name with Count Suffix
        Text {
            text: root.folder.name;
            color: root.is-drop-target ? Theme.accent : (
                root.folder.is-selected ? Theme.primary : (
                    root.folder.is-deleted ? Theme.text-muted : Theme.text
                )
            );
            font-weight: (root.folder.is-selected || root.is-drop-target) ? 700 : 400;
            font-italic: root.folder.is-deleted;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-alignment: left;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

export component FolderTreeList inherits Rectangle {
    background: Theme.background;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    in property <[FolderNodeView]> folders: [];
    in property <int> drop-target-folder-id: -1;
    out property <length> scroll-offset-y: scroll-area.clamped-y;

    callback folder-clicked(int, string);
    callback folder-toggle-expand(int);
    callback folder-context-menu(int, length, length);
    callback row-hovered(int);
    callback row-unhovered(int);

    /// Programmatically scrolls by a delta in pixels
    public function scroll-by(dy: length) {
        scroll-area.handle-scroll(0px, dy);
    }

    /// Programmatically scrolls to ensure a specific folder row is in view
    public function scroll-folder-to-row(row-idx: int) {
        if row-idx >= 0 {
            scroll-area.scroll-into-view(row-idx * 24px, 24px);
        }
    }

    scroll-area := SmoothScrollArea {
        width: 100%;
        height: 100%;
        enable-horizontal: false;
        enable-vertical: true;
        content-width: self.width;
        content-height: tree-layout.preferred-height;

        tree-layout := VerticalLayout {
            spacing: 0px;
            alignment: start;

            for folder in root.folders: FolderItemRow {
                folder: folder;
                drop-target-folder-id: root.drop-target-folder-id;
                clicked => { root.folder-clicked(folder.id, folder.path); }
                toggle-expand => { root.folder-toggle-expand(folder.id); }
                row-hovered(id) => { root.row-hovered(id); }
                row-unhovered(id) => { root.row-unhovered(id); }
                context-menu-requested(mx, my) => {
                    root.folder-context-menu(folder.id, self.x + mx, self.y + my + scroll-area.clamped-y);
                }
            }
        }
    }
}

export component FolderPanel inherits VerticalLayout {
    spacing: 6px;
    vertical-stretch: 1;

    in property <[FolderNodeView]> folders: [];
    in property <bool> is-refreshing: false;
    in property <bool> is-busy: false;
    in-out property <bool> show-hidden-folders: false;
    in property <int> drop-target-folder-id: -1;
    out property <length> scroll-offset-y: tree-list.scroll-offset-y;

    callback folder-clicked(int, string);
    callback folder-toggle-expand(int);
    callback folder-context-menu(int, length, length);
    callback folder-refresh-all-clicked();
    callback folder-refresh-relative-clicked();
    callback collapse-all-clicked();
    callback toggle-hidden-folders(bool);
    callback row-hovered(int);
    callback row-unhovered(int);

    /// Programmatically scrolls the tree list by a delta in pixels
    public function scroll-by(dy: length) {
        tree-list.scroll-by(dy);
    }

    /// Public endpoint to scroll to specific folder row index
    public function scroll-folder-to-row(row-idx: int) {
        tree-list.scroll-folder-to-row(row-idx);
    }

    // Modular Encapsulated Panel Toolbar (replaces static header)
    FolderPanelToolbar {
        is-refreshing: root.is-refreshing;
        is-busy: root.is-busy;
        show-hidden <=> root.show-hidden-folders;
        collapse-all-clicked => { root.collapse-all-clicked(); }
        toggle-hidden-clicked(h) => { root.toggle-hidden-folders(h); }
        refresh-selected(idx) => {
            if idx == 0 {
                root.folder-refresh-all-clicked();
            } else {
                root.folder-refresh-relative-clicked();
            }
        }
    }

    // Scrollable Tree Box
    tree-list := FolderTreeList {
        vertical-stretch: 1;
        folders: root.folders;
        drop-target-folder-id: root.drop-target-folder-id;
        folder-clicked(id, path) => { root.folder-clicked(id, path); }
        folder-toggle-expand(id) => { root.folder-toggle-expand(id); }
        row-hovered(id) => { root.row-hovered(id); }
        row-unhovered(id) => { root.row-unhovered(id); }
        folder-context-menu(id, x, y) => { root.folder-context-menu(id, tree-list.x + x, tree-list.y + y); }
    }
}
