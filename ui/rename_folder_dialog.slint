import { LineEdit, Button } from "std-widgets.slint";
import { Theme } from "styles.slint";
import { ButtonBar } from "button_bar.slint";

export component RenameFolderDialog inherits Window {
    title: "RustView - Rename Folder";
    preferred-width: 480px;
    preferred-height: 230px;
    min-width: 400px;
    min-height: 190px;
    always-on-top: true;
    background: Theme.background;

    in-out property <string> initial-name: "";
    in-out property <string> new-name <=> name-input.text;
    in property <string> error-message: "";

    // Conflict & Smart Resolution Properties
    in-out property <bool> has-conflict: false;
    in-out property <string> suggested-name: "";
    in-out property <string> conflict-message: "";

    callback confirmed(string);
    callback cancelled();
    callback name-edited(string);
    callback use-suggested-name();

    forward-focus: name-input;

    public function select-all() {
        name-input.select-all();
    }

    dialog-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: 0px;
            spacing: 0px;
            alignment: space-between;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                vertical-stretch: 1;

                Text {
                    text: "📁 Rename Directory";
                    font-size: 14px;
                    font-weight: 700;
                    color: Theme.primary;
                }

                Text {
                    text: "Enter a new name for this folder on disk and in database:";
                    font-size: 11px;
                    color: Theme.text-muted;
                }

                name-input := LineEdit {
                    text: root.initial-name;
                    placeholder-text: "Folder name...";
                    height: 32px;
                    vertical-stretch: 0;
                    edited => {
                        root.name-edited(self.text);
                    }
                    accepted => {
                        if self.text != "" {
                            root.confirmed(self.text);
                        }
                    }
                    key-pressed(event) => {
                        if event.text == Key.Escape {
                            root.cancelled();
                            return accept;
                        }
                        return reject;
                    }
                }

                // Real-time Conflict Alert & Quick Resolution Action
                if root.has-conflict : Rectangle {
                    background: #f9e2af18;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #f9e2af44;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        Text {
                            text: "⚠ " + root.conflict-message;
                            font-size: 11px;
                            font-weight: 700;
                            color: #f9e2af;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            Text {
                                text: "Next available name:";
                                font-size: 11px;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                            }

                            Button {
                                text: "Use \"" + root.suggested-name + "\"";
                                clicked => {
                                    root.use-suggested-name();
                                }
                            }
                        }
                    }
                }

                if root.error-message != "" : Text {
                    text: root.error-message;
                    font-size: 11px;
                    color: #ff5555;
                    wrap: word-wrap;
                }
            }

            ButtonBar {
                vertical-stretch: 0;
                bar-height: 48px;
                show-cancel: true;
                show-save: true;
                text-save: root.has-conflict ? "Rename Anyway" : "Rename";
                text-cancel: "Cancel";
                cancel-clicked => { root.cancelled(); }
                save-clicked => {
                    if name-input.text != "" {
                        root.confirmed(name-input.text);
                    }
                }
            }
        }
    }
}
