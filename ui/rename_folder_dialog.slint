import { LineEdit } from "std-widgets.slint";
import { Theme } from "styles.slint";
import { ButtonBar } from "button_bar.slint";

export component RenameFolderDialog inherits Window {
    title: "RustView - Rename Folder";
    preferred-width: 460px;
    preferred-height: 190px;
    min-width: 400px;
    min-height: 170px;
    background: Theme.background;

    in-out property <string> initial-name: "";
    in-out property <string> new-name <=> name-input.text;
    in property <string> error-message: "";

    callback confirmed(string);
    callback cancelled();

    VerticalLayout {
        padding: 0px;
        spacing: 0px;
        alignment: space-between;

        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            vertical-stretch: 1;

            Text {
                text: "📁 Rename Directory";
                font-size: 14px;
                font-weight: 700;
                color: Theme.primary;
            }

            Text {
                text: "Enter a new name for this folder on disk and in database:";
                font-size: 11px;
                color: Theme.text-muted;
            }

            name-input := LineEdit {
                text: root.initial-name;
                placeholder-text: "Folder name...";
                height: 32px;
                vertical-stretch: 0;
                accepted => {
                    if self.text != "" {
                        root.confirmed(self.text);
                    }
                }
            }

            if root.error-message != "" : Text {
                text: root.error-message;
                font-size: 11px;
                color: #ff5555;
                wrap: word-wrap;
            }
        }

        ButtonBar {
            vertical-stretch: 0;
            bar-height: 48px;
            show-cancel: true;
            show-save: true;
            text-save: "Rename";
            text-cancel: "Cancel";
            cancel-clicked => { root.cancelled(); }
            save-clicked => {
                if name-input.text != "" {
                    root.confirmed(name-input.text);
                }
            }
        }
    }
}
