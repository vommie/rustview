import { Theme } from "styles.slint";

/// Compact, versatile button component designed specifically for panel toolbars.
/// Supports Icon-only, Text-only, and Icon+Text modes with automatic sizing, disabled states, and perfect vertical centering.
export component ToolbarButton inherits Rectangle {
    in property <image> icon;
    in property <string> text: "";
    in property <string> tooltip: "";
    in property <bool> is-enabled: true;
    in property <bool> is-active: false;
    in property <length> icon-size: 13px;
    in property <length> font-size: 11px;
    in property <length> button-width: 0px;

    callback clicked();

    property <bool> has-icon: root.icon.width > 0 && root.icon.height > 0;
    property <bool> has-text: root.text != "";

    // Auto-size width: custom button-width if set (> 0px), square (self.height) when icon-only, content-fitted when text is present
    width: root.button-width > 0px
        ? root.button-width
        : ((!root.has-text && root.has-icon)
            ? self.height
            : content-layout.preferred-width);
    height: 100%;
    horizontal-stretch: 0;
    border-radius: 3px;

    background: !root.is-enabled ? transparent : (
        root.is-active ? Theme.surface-selected : (
            touch-area.pressed ? Theme.surface-selected : (
                touch-area.has-hover ? Theme.surface-hover : transparent
            )
        )
    );

    border-width: (root.is-active || (touch-area.has-hover && root.is-enabled)) ? 1px : 0px;
    border-color: !root.is-enabled ? transparent : (root.is-active ? Theme.primary : Theme.border);
    opacity: !root.is-enabled ? 0.38 : 1.0;

    touch-area := TouchArea {
        enabled: root.is-enabled;
        mouse-cursor: root.is-enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    content-layout := HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: root.has-text ? 6px : 2px;
        padding-right: root.has-text ? 6px : 2px;
        spacing: 4px;
        alignment: center;

        if root.has-icon : Image {
            source: root.icon;
            width: root.icon-size;
            height: root.icon-size;
            y: (parent.height - self.height) / 2;
            image-fit: contain;
            opacity: root.is-enabled ? (touch-area.has-hover ? 1.0 : 0.85) : 0.4;
        }

        if root.has-text : Text {
            text: root.text;
            font-size: root.font-size;
            font-weight: root.is-active ? 700 : 400;
            color: !root.is-enabled ? Theme.text-muted : (
                root.is-active ? Theme.primary : (
                    touch-area.has-hover ? Theme.text : Theme.text-muted
                )
            );
            vertical-alignment: center;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}
