import { Button, LineEdit, CheckBox, SpinBox, AboutSlint } from "std-widgets.slint";
import { Theme } from "styles.slint";
import { SettingsCard } from "settings_card.slint";

export component SettingsPageGeneral inherits VerticalLayout {
    spacing: 12px;

    in-out property <string> root-folder-path: "";
    in-out property <bool> ignore-nested-mounts: true;
    in-out property <bool> remember-last-folder: true;
    in-out property <bool> confirm-delete: true;
    in-out property <int> confirm-open-file-count: 5;
    in-out property <int> deletion-mode-idx: 0;
    in property <string> app-version: "";

    callback browse-root-folder();

    SettingsCard {
        title: "Root Directory";
        description: "Specifies the root directory for your media library. If not set, no folders or media are displayed.";

        HorizontalLayout {
            spacing: 8px;

            LineEdit {
                text: root.root-folder-path;
                placeholder-text: "No root directory selected";
                horizontal-stretch: 1;
                read-only: true;
            }

            Button {
                text: "Browse...";
                clicked => { root.browse-root-folder(); }
            }
        }

        CheckBox {
            text: "Ignore mount points inside the root directory during folder scans";
            checked <=> root.ignore-nested-mounts;
        }
    }

    SettingsCard {
        title: "Session";

        CheckBox {
            text: "Remember last opened folder on startup";
            checked <=> root.remember-last-folder;
        }
    }

    SettingsCard {
        title: "Confirmations";
        description: "Actions that ask for your confirmation before they run.";

        CheckBox {
            text: "Confirm before deleting files";
            checked <=> root.confirm-delete;
        }

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: "Confirm before opening this many files at once or more:";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }

            SpinBox {
                width: 90px;
                minimum: 2;
                maximum: 500;
                value <=> root.confirm-open-file-count;
            }
        }

        Text {
            text: "Applies to Open, Open With, Open in File Manager and Open in (Background) Tabs. Open in Fullscreen has its own limit and never asks.";
            font-size: 11px;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
    }

    SettingsCard {
        title: "About";
        description: "RustView " + root.app-version + " - media browser for images and videos. MIT License, Copyright (c) 2026 vommie.";

        Text {
            text: "The user interface is built with Slint, used under the Slint Royalty-free License 2.0. Videos play through mpv and FFmpeg.";
            font-size: 11px;
            color: Theme.text-muted;
            wrap: word-wrap;
        }

        AboutSlint {
            height: 88px;
        }
    }
}
