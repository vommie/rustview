import { Theme } from "styles.slint";
import { IconId } from "icons.slint";
import { PanelToolbar, ToolbarButton, ToolbarSpacer, ToolbarSeparator, ToolbarSelectButton, ToolbarSelectItem } from "panel_toolbar.slint";
import { Throbber } from "throbber.slint";
import { TooltipReasons } from "tooltips.slint";

/// Specialized, fully encapsulated horizontal toolbar for the Folders Panel.
/// Houses folder tree control actions such as rescanning, structure refresh, active background throbber indicator,
/// collapse-all non-active branches, toggle button for showing/hiding hidden folders, and an intelligent combo refresh button.
export component FolderPanelToolbar inherits PanelToolbar {
    in property <bool> is-refreshing: false;
    in property <bool> is-busy: false;
    in-out property <bool> show-hidden: false;
    in-out property <int> refresh-mode-idx: 0;

    callback refresh-selected(int /* 0 = Entire Tree, 1 = Selected Folder */);
    callback collapse-all-clicked();
    callback toggle-hidden-clicked(bool);

    toolbar-height: 26px;

    // 1. Throbber Indicator: Positioned as first item on the left, dynamically vertically centered
    Throbber {
        is-active: root.is-refreshing;
        size: 14px;
        throbber-color: Theme.primary;
        tooltip: "Scanning directory tree on filesystem...";
    }

    // 2. Expander / Spacer: Pushes toolbar control buttons to the right
    ToolbarSpacer {}

    // 3. Collapse All Non-Active Branches Action Button (Icon-only)
    ToolbarButton {
        icon: IconId.collapse-tree;
        tooltip: "Collapse all folders except active path";
        clicked => { root.collapse-all-clicked(); }
    }

    ToolbarSeparator {}

    // 4. Toggle Hidden Folders Action Button (Icon-only)
    ToolbarButton {
        icon: root.show-hidden ? IconId.hidden-shown : IconId.hidden-hidden;
        tooltip: root.show-hidden
            ? "Hide hidden folders (dot-folders and .hidden entries)"
            : "Show hidden folders (dot-folders and .hidden entries)";
        is-active: root.show-hidden;
        clicked => {
            root.show-hidden = !root.show-hidden;
            root.toggle-hidden-clicked(root.show-hidden);
        }
    }

    ToolbarSeparator {}

    // 5. Folder Tree Refresh Combo-Button (ToolbarSelectButton API)
    ToolbarSelectButton {
        current-index <=> root.refresh-mode-idx;
        is-enabled: !root.is-busy && !root.is-refreshing;
        button-display-mode: 0; // Icon only on main button
        popup-display-mode: 2;  // Icon + Text in dropdown options
        popup-align-right: true;
        tooltip: "Scan and refresh folder tree (Entire Tree or Selected Folder)"
            + (root.is-refreshing
                ? "\nDisabled: The folder tree is currently being scanned"
                : (root.is-busy ? "\n" + TooltipReasons.busy : ""));

        model: [
            {
                id: 0,
                text: "Refresh Entire Tree (Full)",
                icon: IconId.refresh
            },
            {
                id: 1,
                text: "Refresh Selected Folder (Relative)",
                icon: IconId.refresh-relative
            }
        ];

        selected(idx) => {
            root.refresh-selected(idx);
        }
    }
}
