import { Theme } from "styles.slint";
import { Icons } from "icons.slint";
import { PanelToolbar, ToolbarSeparator, ToolbarSpacer, ToolbarToggleButton, ToolbarSelectButton, ToolbarSelectItem } from "panel_toolbar.slint";
import { ToolbarTagResetButton } from "toolbar_tag_reset_button.slint";

/// Specialized, fully encapsulated horizontal toolbar for the Tag & Rate Panel.
/// Houses compact Mode, Match, Scope dropdown (Folder, Folder & Subfolders, Global), expander spacer, and sensitive query Reset button.
export component TagPanelToolbar inherits PanelToolbar {
    in-out property <bool> is-assign-mode: false;
    in-out property <int> match-mode-idx: 0; // 0 = ALL, 1 = ANY
    in-out property <int> scope-mode-idx: 2; // 0 = Folder, 1 = Folder & Subfolders, 2 = Global (Default)
    in property <bool> has-active-query: false;

    callback mode-toggled(bool);
    callback match-mode-changed(int);
    callback scope-mode-changed(int);
    callback reset-clicked();

    toolbar-height: 26px;

    // 1. Mode Toggle Button: QUERY vs ASSIGN
    ToolbarToggleButton {
        text-active: "ASSIGN";
        text-inactive: "QUERY";
        is-active: root.is-assign-mode;
        is-enabled: true;
        tooltip: "Mode: Toggle between Tag Query Filter and Tag Assignment mode";
        toggled(active) => {
            root.is-assign-mode = active;
            root.mode-toggled(active);
        }
    }

    ToolbarSeparator {}

    // 2. Match Mode Toggle Button: ALL vs ANY (Disabled in Assign Mode)
    ToolbarToggleButton {
        text-active: "ANY";
        text-inactive: "ALL";
        is-active: root.match-mode-idx == 1;
        is-enabled: !root.is-assign-mode;
        tooltip: root.is-assign-mode ? "Match criteria is inactive during tag assignment" : "Match: Match ALL selected tags vs ANY tag";
        toggled(active) => {
            root.match-mode-idx = active ? 1 : 0;
            root.match-mode-changed(root.match-mode-idx);
        }
    }

    ToolbarSeparator {}

    // 3. Scope Select Button: Folder, Folder & Subfolders, Global (Disabled in Assign Mode)
    ToolbarSelectButton {
        current-index <=> root.scope-mode-idx;
        is-enabled: !root.is-assign-mode;
        button-display-mode: 0; // Icon only on main button
        popup-display-mode: 2;  // Icon + Text in dropdown options
        tooltip: root.is-assign-mode
            ? "Search scope is inactive during tag assignment"
            : "Scope: Choose query search target (Folder, Folder & Subfolders, Global)";

        model: [
            {
                id: 0,
                text: "Folder",
                icon: Icons.query-folder
            },
            {
                id: 1,
                text: "Folder & Subfolders",
                icon: Icons.query-subfolders
            },
            {
                id: 2,
                text: "Global",
                icon: Icons.query-global
            }
        ];

        selected(idx) => {
            root.scope-mode-changed(idx);
        }
    }

    // 4. Expander Spacer
    ToolbarSpacer {}

    // 5. Sensitive Query Reset Button (SPoT-controlled via ToolbarTagResetButton)
    ToolbarTagResetButton {
        is-assign-mode: root.is-assign-mode;
        has-active-query: root.has-active-query;
        clicked => {
            root.reset-clicked();
        }
    }
}
