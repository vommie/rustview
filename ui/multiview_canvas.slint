import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { MultiviewTileView, MultiviewGutterView, MultiviewScreenView } from "multiview_types.slint";
import { MultiviewGutter } from "multiview_gutter.slint";

/// The scene of a Multiview: background, image and status tiles and gutters. Video tiles are native mpv windows that Rust
/// places on top of this scene. The same component draws the fullscreen window, the tab view and the tab grid item, so a
/// tab is always a true miniature of the fullscreen arrangement. All geometry (tiles, gutters, screen) arrives in logical
/// pixels relative to this canvas. The action bar of the hovered tile floats above the canvas in a window of its own.
export component MultiviewCanvas inherits Rectangle {
    in property <[MultiviewTileView]> tiles;
    in property <[MultiviewGutterView]> gutters;
    in property <MultiviewScreenView> screen;
    in property <int> background-mode: 0; // 0 = Dark Theme (#11111b), 1 = Deep Black (#000000), 2 = Checkerboard
    // A color that replaces the background of `background-mode` (transparent = use the mode).
    in property <color> fill-color: transparent;
    in property <color> outer-color: #000000; // shown around the screen when the host has another aspect ratio
    // A non-interactive canvas is a picture: it has no touch areas, so clicks reach whatever is below it.
    in property <bool> interactive: true;
    in property <bool> show-frame: false;
    // The mouse wheel is reported (previous/next for a single image); otherwise it passes through untouched.
    in property <bool> wheel-navigation: false;

    callback tile-clicked(int /* tile index */, bool /* is_ctrl */);
    callback background-clicked(bool /* is_ctrl */);
    callback middle-clicked();
    callback wheel(length /* delta-y */);
    callback gutter-drag-started(int);
    callback gutter-dragged(int, length /* distance from drag start */);
    callback gutter-drag-finished(int);
    callback gutter-reset();
    callback gutter-swap(int);

    background: root.outer-color;
    clip: true;

    if root.show-frame : Rectangle {
        x: root.screen.x - 1px;
        y: root.screen.y - 1px;
        width: root.screen.width + 2px;
        height: root.screen.height + 2px;
        border-width: 1px;
        border-color: Theme.border;
    }

    Rectangle {
        x: root.screen.x;
        y: root.screen.y;
        width: root.screen.width;
        height: root.screen.height;
        background: root.fill-color != Colors.transparent ? root.fill-color : (root.background-mode == 1 ? #000000 : (root.background-mode == 2 ? #1e1e2e : #11111b));

        if root.fill-color == Colors.transparent && root.background-mode == 2 : Rectangle {
            width: 100%;
            height: 100%;
            background: #181825;
            opacity: 0.5;
        }
    }

    if root.interactive : TouchArea {
        width: 100%;
        height: 100%;

        scroll-event(event) => {
            if root.wheel-navigation {
                root.wheel(event.delta-y);
                return accept;
            }
            return reject;
        }

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                if event.button == PointerEventButton.left {
                    root.background-clicked(event.modifiers.control || event.modifiers.meta);
                } else if event.button == PointerEventButton.middle {
                    root.middle-clicked();
                }
            }
        }
    }

    for tile[index] in root.tiles : Rectangle {
        x: tile.x;
        y: tile.y;
        width: tile.width;
        height: tile.height;

        if tile.kind == 0 && tile.image.width > 0 : Image {
            source: tile.image;
            width: 100%;
            height: 100%;
            image-fit: contain;
        }

        if tile.is-loading && tile.error-text == "" : AppIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            icon: IconId.loader;
            size: IconSize.xxl;
            color: Theme.primary;
        }

        if tile.error-text != "" : Rectangle {
            background: Theme.corrupt-bg;
            border-width: 1px;
            border-color: #f38ba844;

            VerticalLayout {
                alignment: center;
                spacing: 10px;
                padding: 12px;

                HorizontalLayout {
                    alignment: center;
                    AppIcon {
                        icon: IconId.status-warning;
                        size: IconSize.xxl;
                        color: Theme.status-corrupt;
                    }
                }

                Text {
                    text: tile.error-text;
                    font-size: 13px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        if root.interactive : TouchArea {
            scroll-event(event) => {
                if root.wheel-navigation {
                    root.wheel(event.delta-y);
                    return accept;
                }
                return reject;
            }

            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    if event.button == PointerEventButton.left {
                        root.tile-clicked(index, event.modifiers.control || event.modifiers.meta);
                    } else if event.button == PointerEventButton.middle {
                        root.middle-clicked();
                    }
                }
            }
        }
    }

    for gutter[index] in root.gutters : MultiviewGutter {
        x: gutter.x;
        y: gutter.y;
        width: gutter.width;
        height: gutter.height;
        vertical: gutter.vertical;
        interactive: root.interactive;

        drag-started => {
            root.gutter-drag-started(index);
        }
        dragged(distance) => {
            root.gutter-dragged(index, distance);
        }
        drag-finished => {
            root.gutter-drag-finished(index);
        }
        reset => {
            root.gutter-reset();
        }
        swap => {
            root.gutter-swap(index);
        }
    }
}
