import { Theme } from "styles.slint";
import { IconId } from "icons.slint";
import { DialogHeading } from "dialog_heading.slint";
import { ButtonBar } from "button_bar.slint";

export component DeleteTagDialog inherits Window {
    title: "RustView - Delete Tag";
    width: 480px;
    preferred-height: dialog-layout.preferred-height;
    min-height: dialog-layout.preferred-height;
    background: Theme.background;

    in-out property <string> tag-name: "";
    in-out property <bool> has-children: false;
    in-out property <string> children-names: "";
    in property <string> error-message: "";

    callback confirmed();
    callback cancelled();

    forward-focus: dialog-focus;

    dialog-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            return reject;
        }

        dialog-layout := VerticalLayout {
            width: root.width;
            padding: 0px;
            spacing: 0px;
            alignment: space-between;

            VerticalLayout {
                width: root.width;
                padding: 16px;
                spacing: 10px;
                vertical-stretch: 1;

                DialogHeading {
                    icon: IconId.status-warning;
                    text: "Delete Tag";
                    color: #f38ba8;
                }

                Text {
                    text: "Are you sure you want to delete the tag '" + root.tag-name + "'?";
                    font-size: 12px;
                    color: Theme.text;
                    wrap: word-wrap;
                }

                if root.has-children : Rectangle {
                    background: #f38ba822;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #f38ba866;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;

                        Text {
                            text: "Warning: The following child tags will also be permanently deleted:";
                            font-size: 11px;
                            font-weight: 700;
                            color: #f38ba8;
                        }

                        Text {
                            text: root.children-names;
                            font-size: 11px;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }
                }

                Text {
                    text: "This tag will be unassigned from all media files.";
                    font-size: 11px;
                    color: Theme.text-muted;
                }

                if root.error-message != "" : Text {
                    text: root.error-message;
                    font-size: 11px;
                    color: #ff5555;
                    wrap: word-wrap;
                }
            }

            ButtonBar {
                vertical-stretch: 0;
                bar-height: 48px;
                show-cancel: true;
                show-save: true;
                text-save: "Delete Tag";
                text-cancel: "Cancel";
                cancel-clicked => { root.cancelled(); }
                save-clicked => { root.confirmed(); }
            }
        }
    }
}
