import { Theme } from "styles.slint";
import { TagNodeView } from "types.slint";
import { TagPanel } from "tag_panel.slint";
import { MetadataInspector } from "metadata_inspector.slint";

export { TagPanel } from "tag_panel.slint";
export { MetadataInspector } from "metadata_inspector.slint";
export { RatingBar } from "rating_bar.slint";

export component SidebarRight inherits Rectangle {
    width: 280px;
    background: Theme.surface;

    in-out property <bool> is-assign-mode: false;
    in-out property <int> match-mode-idx: 0;
    in-out property <int> scope-mode-idx: 0;
    in-out property <int> selected-rating: -1;
    in property <[TagNodeView]> tags: [];

    in property <string> info-filename: "-";
    in property <string> info-size: "-";
    in property <string> info-dimensions: "-";
    in property <string> info-format: "-";
    in property <string> info-hash: "-";
    in property <int> info-selection-count: 0;

    callback mode-toggled(bool);
    callback rating-selected(int);
    callback tag-clicked(int);
    callback tag-toggle-expand(int);
    callback tag-context-menu(int, length, length);
    callback root-context-menu(length, length);
    callback tag-filter-changed(string);
    callback match-mode-changed(int);
    callback scope-mode-changed(int);

    // Left border separator line
    Rectangle {
        x: 0px;
        width: 1px;
        background: Theme.border;
    }

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        // Tagging and Rating Management Subsystem
        tag-panel := TagPanel {
            is-assign-mode <=> root.is-assign-mode;
            match-mode-idx <=> root.match-mode-idx;
            scope-mode-idx <=> root.scope-mode-idx;
            selected-rating <=> root.selected-rating;
            tags: root.tags;

            mode-toggled(assign) => { root.mode-toggled(assign); }
            match-mode-changed(m) => { root.match-mode-changed(m); }
            scope-mode-changed(s) => { root.scope-mode-changed(s); }
            rating-selected(r) => { root.rating-selected(r); }
            tag-filter-changed(txt) => { root.tag-filter-changed(txt); }
            tag-clicked(id) => { root.tag-clicked(id); }
            tag-toggle-expand(id) => { root.tag-toggle-expand(id); }
            tag-context-menu(id, x, y) => { root.tag-context-menu(id, tag-panel.x + x, tag-panel.y + y); }
            root-context-menu(x, y) => { root.root-context-menu(tag-panel.x + x, tag-panel.y + y); }
        }

        // Media Metadata Inspector Subsystem
        MetadataInspector {
            filename: root.info-filename;
            filesize: root.info-size;
            dimensions: root.info-dimensions;
            format-name: root.info-format;
            hash-or-rating: root.info-hash;
            selection-count: root.info-selection-count;
        }
    }
}
