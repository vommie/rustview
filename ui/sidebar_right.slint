import { Theme } from "styles.slint";
import { TagColumnView, TagHistoryRowModel } from "types.slint";
import { TagPanel } from "tag_panel.slint";
import { SidebarPanelTabBar } from "sidebar_panel_tab_bar.slint";

export { TagPanel } from "tag_panel.slint";
export { RatingBar } from "rating_bar.slint";

export component SidebarRight inherits Rectangle {
    in-out property <length> sidebar-width: 280px;
    width: root.sidebar-width;
    background: Theme.surface;

    // Tag Panel properties
    in-out property <bool> is-assign-mode: false;
    in-out property <int> match-mode-idx: 0;
    in-out property <int> scope-mode-idx: 2;
    in-out property <int> selected-rating: 0;
    in property <bool> has-selection: true;
    in property <[bool]> partial-ratings: [false, false, false, false, false, false];
    in property <bool> has-active-query: false;
    in property <bool> is-tab-view: false;
    in-out property <string> tag-filter-text: "";
    in-out property <bool> tag-filter-is-regex: false;
    in property <[TagColumnView]> tag-columns: [];

    // Tag History properties
    in property <[TagHistoryRowModel]> tag-history-rows: [];
    in property <int> tag-history-count: 0;
    in-out property <bool> tag-history-is-collapsed: false;
    in-out property <length> tag-history-height: 96px;

    callback tag-history-collapsed-toggled(bool);
    callback tag-history-tag-clicked(int /* tag_id */);
    callback tag-history-geometry-changed(length /* available_width */);
    callback tag-history-resized(length /* new_height */);
    callback tag-history-resize-finished(length /* final_height */);

    out property <bool> tag-filter-has-focus: tag-panel.filter-has-focus;

    callback mode-toggled(bool);
    callback rating-selected(int);
    callback tag-clicked(int);
    callback tag-toggle-expand(int);
    callback tag-context-menu(int, length, length);
    callback root-context-menu(length, length);
    callback tag-filter-changed(string);
    callback tag-regex-toggled(bool);
    callback match-mode-changed(int);
    callback scope-mode-changed(int);
    callback reset-clicked();
    callback tag-tree-geometry-changed(length /* available_height */);

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        // 1. Right Sidebar Dock Tab Bar (Single structured tab container matching left sidebar architecture)
        SidebarPanelTabBar {
            tabs: [
                {
                    id: "tags_rate",
                    title: "Tag & Rate",
                    icon_name: "tag",
                    is_active: true,
                    shift_x: 0px,
                    is_placeholder: false
                }
            ];
            tab-selected(_id) => { }
        }

        // 2. Stacked Active Panel Area
        stacked-container := Rectangle {
            vertical-stretch: 1;

            tag-panel := TagPanel {
                width: 100%;
                height: 100%;
                is-assign-mode <=> root.is-assign-mode;
                match-mode-idx <=> root.match-mode-idx;
                scope-mode-idx <=> root.scope-mode-idx;
                selected-rating <=> root.selected-rating;
                has-selection: root.has-selection;
                partial-ratings: root.partial-ratings;
                has-active-query: root.has-active-query;
                is-tab-view: root.is-tab-view;
                filter-text <=> root.tag-filter-text;
                tag-filter-is-regex <=> root.tag-filter-is-regex;
                tag-columns: root.tag-columns;

                // Forward Tag History properties
                tag-history-rows: root.tag-history-rows;
                tag-history-count: root.tag-history-count;
                tag-history-is-collapsed <=> root.tag-history-is-collapsed;
                tag-history-height <=> root.tag-history-height;
                tag-history-collapsed-toggled(c) => { root.tag-history-collapsed-toggled(c); }
                tag-history-tag-clicked(id) => { root.tag-history-tag-clicked(id); }
                tag-history-geometry-changed(w) => { root.tag-history-geometry-changed(w); }
                tag-history-resized(h) => { root.tag-history-resized(h); }
                tag-history-resize-finished(h) => { root.tag-history-resize-finished(h); }

                mode-toggled(assign) => { root.mode-toggled(assign); }
                match-mode-changed(m) => { root.match-mode-changed(m); }
                scope-mode-changed(s) => { root.scope-mode-changed(s); }
                reset-clicked => { root.reset-clicked(); }
                rating-selected(r) => { root.rating-selected(r); }
                tag-filter-changed(txt) => { root.tag-filter-changed(txt); }
                tag-regex-toggled(r) => { root.tag-regex-toggled(r); }
                tag-clicked(id) => { root.tag-clicked(id); }
                tag-toggle-expand(id) => { root.tag-toggle-expand(id); }
                tag-context-menu(id, x, y) => { root.tag-context-menu(id, stacked-container.x + x, stacked-container.y + y); }
                root-context-menu(x, y) => { root.root-context-menu(stacked-container.x + x, stacked-container.y + y); }
                tree-geometry-changed(h) => { root.tag-tree-geometry-changed(h); }
            }
        }
    }
}
