import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { TooltipHost } from "tooltips.slint";

/// Generic, modular, and feature-rich Search & Filter Field component API for Slint.
/// Features built-in inline Regex toggle button, interactive Clear/Reset button,
/// Escape key clear handling while focused, focus ring styling, and tooltip integration.
export component SearchField inherits Rectangle {
    // Core State Properties
    in-out property <string> text: "";
    in-out property <bool> is-regex: false;
    in property <string> placeholder-text: "Filter...";
    in property <bool> is-enabled: true;

    // Output property reflecting internal text input focus state for focus routing
    out property <bool> has-focus: input.has-focus;

    // Feature Toggle Options (Sensible Defaults)
    in property <bool> enable-regex-toggle: true;
    in property <bool> enable-clear-button: true;
    in property <bool> enable-escape-clear: true;
    in property <bool> show-search-icon: false;

    // Dimension & Typography API
    in property <length> field-width: 160px;
    in property <length> field-height: 24px;
    in property <length> font-size: 11px;
    in property <length> icon-size: IconSize.xs;
    in property <length> corner-radius: 4px;

    // Theme & Styling Overrides (falls back to Theme defaults when transparent)
    in property <color> custom-bg: transparent;
    in property <color> custom-border: transparent;
    in property <color> custom-focus-border: transparent;
    in property <color> custom-text: transparent;

    // Tooltip Descriptions
    in property <string> regex-tooltip: "Toggle Regular Expression filter mode";
    in property <string> clear-tooltip: "Clear search filter (Esc)";

    // Event Hooks
    callback search-changed(string /* query */);
    callback regex-toggled(bool /* is_regex_active */);
    callback accepted(string /* current_text */);
    callback cleared();

    // Focus forwarding: ensures any focus received by SearchField is passed directly to TextInput
    forward-focus: input;

    // Programmatic Public API
    public function clear() {
        root.text = "";
        root.search-changed("");
        root.cleared();
    }

    public function focus-input() {
        input.focus();
    }

    public function select-all() {
        input.select-all();
    }

    width: root.field-width;
    height: root.field-height;
    border-radius: root.corner-radius;
    border-width: 1px;

    background: !root.is-enabled ? #1e1e2e44 : (
        root.custom-bg != transparent ? root.custom-bg : Theme.surface-variant
    );

    border-color: !root.is-enabled ? Theme.border : (
        input.has-focus
            ? (root.custom-focus-border != transparent ? root.custom-focus-border : Theme.primary)
            : (root.custom-border != transparent ? root.custom-border : Theme.border)
    );

    animate border-color { duration: 120ms; }
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 4px;
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: 4px;

        // 1. Optional Leading Search Icon
        if root.show-search-icon : VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            AppIcon {
                icon: IconId.search;
                size: root.icon-size;
                color: input.has-focus ? Theme.primary : Theme.text-muted;
            }
        }

        // 2. Central Text Input & Placeholder Container
        input-container := Rectangle {
            horizontal-stretch: 1;
            height: 100%;
            clip: true;

            if input.text == "" : Text {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                text: root.placeholder-text;
                font-size: root.font-size;
                color: Theme.text-muted;
                vertical-alignment: center;
                horizontal-alignment: left;
                overflow: elide;
            }

            input := TextInput {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                text <=> root.text;
                font-size: root.font-size;
                color: root.is-enabled
                    ? (root.custom-text != transparent ? root.custom-text : Theme.text)
                    : Theme.text-muted;
                selection-background-color: Theme.primary;
                selection-foreground-color: #000000;
                vertical-alignment: center;
                horizontal-alignment: left;
                single-line: true;
                enabled: root.is-enabled;

                edited => {
                    root.search-changed(self.text);
                }

                accepted => {
                    root.accepted(self.text);
                }

                key-pressed(event) => {
                    if event.text == Key.Escape && root.enable-escape-clear {
                        if root.text != "" {
                            root.text = "";
                            root.search-changed("");
                            root.cleared();
                            return accept;
                        }
                    }
                    if event.text == Key.Return {
                        root.accepted(self.text);
                        return accept;
                    }
                    return reject;
                }
            }
        }

        // 3. Integrated Regex Toggle Button
        if root.enable-regex-toggle : VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            regex-btn := Rectangle {
                width: 20px;
                height: 18px;
                border-radius: 3px;
                background: root.is-regex
                    ? Theme.surface-selected
                    : (regex-touch.has-hover ? Theme.surface-hover : transparent);
                border-width: root.is-regex ? 1px : 0px;
                border-color: root.is-regex ? Theme.primary : transparent;

                regex-tooltip-host := TooltipHost {
                    text: root.regex-tooltip;
                    shortcut: ".*";
                }

                // Stays enabled even when the field is disabled, otherwise Slint reports no hover and the tooltip
                // could never appear. Clicks are filtered below.
                regex-touch := TouchArea {
                    mouse-cursor: root.is-enabled ? pointer : default;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            regex-tooltip-host.on-hover-leave();
                        }
                    }
                    clicked => {
                        regex-tooltip-host.on-hover-leave();
                        if root.is-enabled {
                            root.is-regex = !root.is-regex;
                            root.regex-toggled(root.is-regex);
                        }
                    }
                    moved => {
                        regex-tooltip-host.on-mouse-move(self.mouse-x, self.mouse-y);
                    }
                }

                property <bool> is-regex-hovered: regex-touch.has-hover && root.regex-tooltip != "";
                changed is-regex-hovered => {
                    if self.is-regex-hovered {
                        regex-tooltip-host.on-hover-enter(regex-touch.mouse-x, regex-touch.mouse-y);
                    } else {
                        regex-tooltip-host.on-hover-leave();
                    }
                }

                AppIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon: IconId.regex;
                    size: IconSize.sm;
                    color: root.is-regex
                        ? Theme.primary
                        : (regex-touch.has-hover ? Theme.text : Theme.text-muted);
                }
            }
        }

        // 4. Integrated Clear / Reset Button
        if root.enable-clear-button && root.text != "" : VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            clear-btn := Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: clear-touch.has-hover ? Theme.surface-hover : transparent;

                clear-tooltip-host := TooltipHost {
                    text: root.clear-tooltip;
                    shortcut: "Esc";
                }

                // Stays enabled even when the field is disabled, otherwise Slint reports no hover and the tooltip
                // could never appear. Clicks are filtered below.
                clear-touch := TouchArea {
                    mouse-cursor: root.is-enabled ? pointer : default;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            clear-tooltip-host.on-hover-leave();
                        }
                    }
                    clicked => {
                        clear-tooltip-host.on-hover-leave();
                        if root.is-enabled {
                            root.text = "";
                            root.search-changed("");
                            root.cleared();
                            input.focus();
                        }
                    }
                    moved => {
                        clear-tooltip-host.on-mouse-move(self.mouse-x, self.mouse-y);
                    }
                }

                property <bool> is-clear-hovered: clear-touch.has-hover && root.clear-tooltip != "";
                changed is-clear-hovered => {
                    if self.is-clear-hovered {
                        clear-tooltip-host.on-hover-enter(clear-touch.mouse-x, clear-touch.mouse-y);
                    } else {
                        clear-tooltip-host.on-hover-leave();
                    }
                }

                AppIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon: IconId.close;
                    size: IconSize.xs;
                    color: clear-touch.has-hover ? Theme.text : Theme.text-muted;
                }
            }
        }
    }
}
