import { Slider, CheckBox, ComboBox } from "std-widgets.slint";
import { Theme } from "styles.slint";
import { SettingsCard } from "settings_card.slint";

export component SettingsPageAppearance inherits VerticalLayout {
    spacing: 12px;

    in-out property <int> default-thumb-size: 190;
    in-out property <int> thumb-aspect-idx: 1; // 0=1:1, 1=4:3, 2=5:4, 3=16:9, 4=3:4, 5=4:5, 6=9:16
    in-out property <bool> show-filenames: true;
    in-out property <bool> show-rating-badge: true;
    in-out property <bool> show-tag-badge: true;
    in-out property <bool> enable-hover-previews: true;
    in-out property <bool> enable-tooltips: true;
    in-out property <int> tooltip-delay-ms: 750;

    SettingsCard {
        title: "Grid & Thumbnail Presentation";

        HorizontalLayout {
            Text {
                text: "Default Thumbnail Width:";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Slider {
                width: 140px;
                minimum: 80;
                maximum: 400;
                value: root.default-thumb-size;
                changed(v) => { root.default-thumb-size = Math.round(v); }
            }
            Text {
                text: root.default-thumb-size + "px";
                color: Theme.primary;
                width: 50px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Thumbnail Aspect Ratio:";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            ComboBox {
                width: 180px;
                model: ["1:1 (Square)", "4:3 (Standard)", "5:4 (Landscape)", "16:9 (Widescreen)", "3:4 (Portrait)", "4:5 (Portrait)", "9:16 (Tall Portrait)"];
                current-index <=> root.thumb-aspect-idx;
            }
        }

        CheckBox {
            text: "Display filenames below tiles";
            checked <=> root.show-filenames;
        }

        CheckBox {
            text: "Show colored rating badge overlay";
            checked <=> root.show-rating-badge;
        }

        CheckBox {
            text: "Show tag indicator overlay";
            checked <=> root.show-tag-badge;
        }

        CheckBox {
            text: "Enable hover video preview animation (YouTube-style)";
            checked <=> root.enable-hover-previews;
        }
    }

    SettingsCard {
        title: "Tooltips";
        description: "Configure application-wide hover tooltip behavior and display delay.";

        CheckBox {
            text: "Enable hover tooltips across application";
            checked <=> root.enable-tooltips;
        }

        if root.enable-tooltips : HorizontalLayout {
            Text {
                text: "Tooltip Display Delay:";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Slider {
                width: 140px;
                minimum: 50;
                maximum: 1500;
                value: root.tooltip-delay-ms;
                changed(v) => { root.tooltip-delay-ms = Math.round(v / 25) * 25; }
            }
            Text {
                text: root.tooltip-delay-ms + " ms";
                color: Theme.primary;
                width: 60px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }
    }
}
