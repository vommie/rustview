import { Theme } from "styles.slint";

/// Standalone visual progress indicator for recursive folder structure scans.
export component FolderRefreshProgress inherits Rectangle {
    in property <bool> is-refreshing: false;
    in property <int> scanned-count: 0;

    height: 18px;
    background: Theme.surface-variant;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        alignment: center;

        Text {
            text: "Scanning Folders...";
            font-size: 10px;
            font-weight: 700;
            color: Theme.primary;
            vertical-alignment: center;
        }

        if root.scanned-count > 0 : Text {
            text: "(" + root.scanned-count + " dirs)";
            font-size: 10px;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
    }
}
