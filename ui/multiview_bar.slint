import { Theme } from "styles.slint";
import { AppIcon, IconSize } from "icons.slint";
import { TooltipArea } from "tooltips.slint";
import { ButtonFeedbackOverlay } from "button_feedback.slint";
import { MultiviewBarButtonView } from "multiview_types.slint";

component MultiviewBarButton inherits Rectangle {
    in property <MultiviewBarButtonView> action;
    // The button has its menu open: it stays highlighted and shows no tooltip.
    in property <bool> open: false;
    in property <length> size: 28px;

    callback activated();

    width: root.size;
    height: root.size;
    border-radius: 6px;
    background: root.action.attention ? Theme.accent.with-alpha(0.7) : (root.open ? Theme.primary.with-alpha(0.28) : (area.has-hover ? Theme.surface-hover : transparent));
    animate background { duration: 90ms; }

    area := TooltipArea {
        width: 100%;
        height: 100%;
        text: root.action.tooltip;
        tooltip-enabled: !root.open;

        clicked => {
            root.activated();
        }

        AppIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            icon: root.action.icon;
            size: IconSize.lg;
            color: root.action.attention ? Theme.background : (!root.action.enabled ? Theme.text-muted.with-alpha(0.5) : ((root.action.toggle && root.action.active) || root.open || area.has-hover ? Theme.primary : Theme.text));
        }

        ButtonFeedbackOverlay {
            feedback: root.action.feedback;
            border-radius: root.border-radius;
        }
    }
}

/// Row of action buttons for the hovered medium. It is drawn in the window of its own that `MultiviewBarWindow` is,
/// which floats above the Multiview (and its native video windows) and is blended with them by the compositing manager.
export component MultiviewBar inherits Rectangle {
    in property <[MultiviewBarButtonView]> actions;
    // Glass: the window is blended with what is below it. Without a compositing manager the window cannot be blended, so
    // the bar is solid then.
    in property <bool> translucent: true;
    // Position of the button whose menu is open (-1 = none).
    in property <int> menu-owner-index: -1;

    callback action-clicked(int /* action id */);

    // The size follows from the number of buttons alone, so Rust can read it at any time (a layout is only computed when
    // the window draws).
    property <length> button-size: 28px;
    property <length> button-spacing: 2px;
    property <length> inset: 3px;

    /// Center of the button at `index`, from the left edge of the bar (the layout is plain arithmetic, see `width`).
    public pure function button-center-x(index: int) -> length {
        return root.inset + index * (root.button-size + root.button-spacing) + root.button-size / 2;
    }

    width: root.actions.length * root.button-size + Math.max(root.actions.length - 1, 0) * root.button-spacing + 2 * root.inset;
    height: root.button-size + 2 * root.inset;
    background: root.translucent ? Theme.surface.with-alpha(0.7) : Theme.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;

    layout := HorizontalLayout {
        padding: root.inset;
        spacing: root.button-spacing;

        for action[index] in root.actions : MultiviewBarButton {
            action: action;
            open: index == root.menu-owner-index;
            size: root.button-size;

            activated => {
                root.action-clicked(action.id);
            }
        }
    }
}
