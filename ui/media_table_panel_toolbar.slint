import { Theme } from "styles.slint";
import { Icons } from "icons.slint";
import { PanelToolbar, ToolbarButton, ToolbarSeparator, ToolbarSpacer, ToolbarSelectButton, ToolbarSelectItem } from "panel_toolbar.slint";
import { ToolbarSearchField } from "toolbar_search_field.slint";

/// Dedicated modular toolbar for the Media Table View.
/// Integrates Expander, Virtual Folder Toggle, Media Type Selector, Filter Search, Refresh, and ViewMode Switcher.
export component MediaTablePanelToolbar inherits PanelToolbar {
    in-out property <string> search-text: "";
    in-out property <bool> regex-mode: false;
    in property <bool> is-table-view: true;
    in-out property <bool> is-virtual-folder: false;
    in property <bool> is-virtual-folder-enabled: true;
    in property <string> virtual-folder-tooltip: "";
    in-out property <int> media-type-filter-idx: 2;

    callback search-changed(string);
    callback regex-toggled(bool);
    callback virtual-folder-toggled(bool);
    callback media-type-filter-changed(int);
    callback refresh-clicked();
    callback view-mode-toggled(bool);

    toolbar-height: 26px;

    // 1. Expander / Spacer (Pushes search & view actions to the right)
    ToolbarSpacer {}

    // 2. Virtual Folder Toggle Button
    ToolbarButton {
        icon: root.is-virtual-folder ? Icons.virtual-folder-disable : Icons.virtual-folder-enable;
        tooltip: root.virtual-folder-tooltip != "" ? root.virtual-folder-tooltip : (
            !root.is-virtual-folder-enabled
                ? "No subfolders available in current folder"
                : (root.is-virtual-folder
                    ? "Disable recursive folder view (show current folder only)"
                    : "Recursive folder view: Show media from current folder and all subfolders")
        );
        is-active: root.is-virtual-folder;
        is-enabled: root.is-virtual-folder-enabled;
        clicked => {
            root.is-virtual-folder = !root.is-virtual-folder;
            root.virtual-folder-toggled(root.is-virtual-folder);
        }
    }

    ToolbarSeparator {}

    // 3. Media Type Select Button (Videos, Images, Videos & Images)
    ToolbarSelectButton {
        current-index <=> root.media-type-filter-idx;
        button-display-mode: 0; // Icon only on main button
        popup-display-mode: 2;  // Icon + Text in dropdown options
        tooltip: "Filter media types (Videos, Images, Videos & Images)";

        model: [
            {
                id: 0,
                text: "Videos",
                icon: Icons.media-filter-videos
            },
            {
                id: 1,
                text: "Images",
                icon: Icons.media-filter-images
            },
            {
                id: 2,
                text: "Videos & Images",
                icon: Icons.media-filter-videos-images
            }
        ];

        selected(idx) => {
            root.media-type-filter-changed(idx);
        }
    }

    ToolbarSeparator {}

    // 4. Filter Search Field (with inline Regex Toggle and Clear button)
    search-field := ToolbarSearchField {
        placeholder-text: "Filter...";
        field-width: 160px;
        text <=> root.search-text;
        is-regex <=> root.regex-mode;
        search-changed(txt) => { root.search-changed(txt); }
        regex-toggled(r) => { root.regex-toggled(r); }
    }

    // 5. Separator
    ToolbarSeparator {}

    // 6. Refresh Media Button
    ToolbarButton {
        icon: Icons.refresh;
        tooltip: "Scan and refresh media in current folder";
        clicked => { root.refresh-clicked(); }
    }

    // 7. Separator
    ToolbarSeparator {}

    // 8. View Mode Switcher Button
    ToolbarButton {
        icon: root.is-table-view ? Icons.grid-view : Icons.list-view;
        tooltip: root.is-table-view ? "Switch to Grid View" : "Switch to Table View";
        clicked => { root.view-mode-toggled(!root.is-table-view); }
    }
}
