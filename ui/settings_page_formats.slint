import { Button, CheckBox } from "std-widgets.slint";
import { Theme } from "styles.slint";
import { SettingsCard } from "settings_card.slint";
import { SearchField } from "search_field.slint";
import { InlineNotice } from "inline_notice.slint";
import { SettingsFormatRow, FormatRowView, UnsupportedFormatView } from "settings_format_row.slint";

/// The header of an Images / Videos card: title, how many formats are on, and the all on / all off buttons.
component FormatSectionHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> summary;
    in property <bool> has-rows: true;

    callback all-on();
    callback all-off();

    spacing: 8px;

    Text {
        text: root.title;
        font-weight: 700;
        color: Theme.primary;
        vertical-alignment: center;
    }

    Text {
        text: root.summary;
        font-size: 11px;
        color: Theme.text-muted;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }

    Button {
        text: "All on";
        enabled: root.has-rows;
        clicked => { root.all-on(); }
    }

    Button {
        text: "All off";
        enabled: root.has-rows;
        clicked => { root.all-off(); }
    }
}

component FormatGroupHeading inherits Text {
    font-size: 11px;
    font-weight: 700;
    color: Theme.text-muted;
}

export component SettingsPageFormats inherits VerticalLayout {
    spacing: 12px;

    in property <string> intro;
    /// Explains that already indexed files of switched-off formats stay in the library; "" hides the notice.
    in property <string> hidden-notice;
    in property <string> image-summary;
    in property <string> video-summary;
    in property <[FormatRowView]> image-formats;
    in property <[FormatRowView]> video-formats;
    in property <[UnsupportedFormatView]> unsupported;
    in-out property <string> filter-text;
    in-out property <bool> auto-detect-extensionless: true;

    callback format-toggled(string /* id */, bool /* enabled */);
    /// kind: 0 = images, 1 = videos.
    callback set-all(int /* kind */, bool /* enabled */);
    callback filter-edited(string /* text */);

    SettingsCard {
        title: "Supported File Formats";
        description: "Every format below is on by default. Switch a format off to leave it out: its files are not scanned, renamed or listed, and files of it that are already indexed disappear from lists, counts and searches. Nothing is deleted from the library, and switching the format on again brings everything back (new files after the next refresh).";

        if root.hidden-notice != "" : InlineNotice {
            text: root.hidden-notice;
        }

        Text {
            text: root.intro;
            font-size: 11px;
            color: Theme.text-muted;
            wrap: word-wrap;
        }

        SearchField {
            text <=> root.filter-text;
            field-width: 320px;
            field-height: 28px;
            font-size: 12px;
            show-search-icon: true;
            enable-regex-toggle: false;
            placeholder-text: "Find a format or extension (heic, mkv, .jpg)";
            search-changed(text) => { root.filter-edited(text); }
        }
    }

    SettingsCard {
        FormatSectionHeader {
            title: "Images";
            summary: root.image-summary;
            has-rows: root.image-formats.length > 0;
            all-on => { root.set-all(0, true); }
            all-off => { root.set-all(0, false); }
        }

        for row in root.image-formats : VerticalLayout {
            spacing: 2px;

            if row.group-title != "" : FormatGroupHeading {
                text: row.group-title;
            }

            SettingsFormatRow {
                item: row;
                toggled(enabled) => { root.format-toggled(row.id, enabled); }
            }
        }

        if root.image-formats.length == 0 : Text {
            text: "No image format matches the search.";
            font-size: 11px;
            color: Theme.text-muted;
        }
    }

    SettingsCard {
        FormatSectionHeader {
            title: "Videos";
            summary: root.video-summary;
            has-rows: root.video-formats.length > 0;
            all-on => { root.set-all(1, true); }
            all-off => { root.set-all(1, false); }
        }

        for row in root.video-formats : VerticalLayout {
            spacing: 2px;

            if row.group-title != "" : FormatGroupHeading {
                text: row.group-title;
            }

            SettingsFormatRow {
                item: row;
                toggled(enabled) => { root.format-toggled(row.id, enabled); }
            }
        }

        if root.video-formats.length == 0 : Text {
            text: "No video format matches the search.";
            font-size: 11px;
            color: Theme.text-muted;
        }
    }

    SettingsCard {
        title: "Tools";
        description: "Automated filesystem maintenance and media format detection utilities.";

        CheckBox {
            text: "Auto-detect MIME type and append extension for extensionless files on refresh";
            checked <=> root.auto-detect-extensionless;
        }

        Text {
            text: "Only files whose content is a switched-on format are renamed.";
            font-size: 11px;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
    }

    SettingsCard {
        title: "Not supported";
        description: "Common formats RustView cannot show. Their files are skipped by every refresh.";

        for item in root.unsupported : VerticalLayout {
            spacing: 2px;
            padding-left: 8px;
            padding-right: 8px;

            Text {
                text: item.title;
                font-size: 12px;
                color: Theme.text;
                wrap: word-wrap;
            }

            Text {
                text: item.text;
                font-size: 11px;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
        }
    }
}
