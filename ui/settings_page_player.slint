import { Slider, CheckBox } from "std-widgets.slint";
import { Theme } from "styles.slint";
import { SettingsCard } from "settings_card.slint";

export component SettingsPagePlayer inherits VerticalLayout {
    spacing: 12px;

    in-out property <int> hwdec-idx: 0;
    in-out property <bool> autoplay-videos: true;
    in-out property <float> default-volume: 100.0;

    SettingsCard {
        title: "Hardware Acceleration & Playback";

        CheckBox {
            text: "Autoplay videos when opened";
            checked <=> root.autoplay-videos;
        }

        HorizontalLayout {
            Text {
                text: "Default Audio Volume:";
                color: Theme.text;
                vertical-alignment: center;
            }
            Slider {
                width: 140px;
                minimum: 0.0;
                maximum: 100.0;
                value: root.default-volume;
                changed(v) => { root.default-volume = v; }
            }
            Text {
                text: Math.round(root.default-volume) + "%";
                color: Theme.primary;
                width: 45px;
                vertical-alignment: center;
            }
        }
    }
}
