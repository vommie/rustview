import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";

/// The stand-in for a video whose player is in the fullscreen window right now (a native mpv window cannot be in two places, so the
/// item would otherwise show an empty black area): a discreet badge with a "shown elsewhere" icon, and a caption where there is room.
export component AwayBadge inherits Rectangle {
    background: #000000;

    property <bool> roomy: root.width >= 110px && root.height >= 72px;
    property <bool> tiny: root.width < 44px || root.height < 44px;

    VerticalLayout {
        alignment: center;
        spacing: 6px;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: root.tiny ? 0px : (root.roomy ? 40px : 32px);
                height: self.width;
                border-radius: self.width / 2;
                background: #ffffff14;
                border-width: 1px;
                border-color: #ffffff2e;

                AppIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon: IconId.playing-elsewhere;
                    size: root.roomy ? IconSize.xl : IconSize.lg;
                    color: #ffffff9e;
                }
            }
        }

        if root.roomy : Text {
            text: "Playing in fullscreen";
            font-size: 10px;
            color: #ffffff85;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

/// The whole inner area of the tab view while its tab is shown in the fullscreen window: the tab is locked and its media (the players
/// and windows, a Multiview as a whole) are over there, so the area says so instead of showing a stale or empty picture.
export component AwayPanel inherits Rectangle {
    background: Theme.background;

    TouchArea {
        // Nothing below the panel can be used while the tab is away.
        mouse-cursor: default;
    }

    VerticalLayout {
        alignment: center;
        spacing: 10px;
        padding: 24px;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 72px;
                height: 72px;
                border-radius: 36px;
                background: #ffffff14;
                border-width: 1px;
                border-color: #ffffff2e;

                AppIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon: IconId.playing-elsewhere;
                    size: IconSize.xxl;
                    color: #ffffff9e;
                }
            }
        }

        Text {
            text: "Shown in fullscreen";
            font-size: 15px;
            font-weight: 700;
            color: Theme.text;
            horizontal-alignment: center;
        }

        Text {
            text: "This tab is open in the fullscreen window. Close the fullscreen to continue here.";
            font-size: 12px;
            color: Theme.text-muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}
