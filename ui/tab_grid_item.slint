import { Theme } from "styles.slint";
import { Icons, AppIcon } from "icons.slint";
import { TabGridItemModel } from "types.slint";

/// Standalone Masonry Tile item for the TabGridView.
/// Displays live loaded image buffers or transparent video subwindow placeholders with full aspect ratio preservation.
export component TabGridItemView inherits Rectangle {
    in property <TabGridItemModel> item;
    in property <length> padding-h: 8px;
    in property <length> padding-v: 6px;
    in property <length> border-width-val: 1px;
    in property <length> corner-radius-val: 4px;

    callback left-clicked(int /* tab_id */);
    callback middle-clicked(int /* tab_id */);
    callback close-clicked(int /* tab_id */);
    callback context-menu-requested(int /* tab_id */, length /* x */, length /* y */);

    x: root.item.x;
    y: root.item.y;
    width: root.item.width;
    height: root.item.height;

    background: tile-touch.has-hover ? Theme.surface-hover : Theme.surface;
    border-width: tile-touch.has-hover ? Math.max(1.5px, root.border-width-val) : root.border-width-val;
    border-color: tile-touch.has-hover ? Theme.primary : Theme.border;
    border-radius: root.corner-radius-val;
    clip: true;

    // Full-Tile TouchArea: Handles mouse actions across the entire item area
    tile-touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                if event.button == PointerEventButton.left {
                    root.left-clicked(root.item.id);
                } else if event.button == PointerEventButton.middle {
                    root.middle-clicked(root.item.id);
                } else if event.button == PointerEventButton.right {
                    root.context-menu-requested(root.item.id, self.mouse-x, self.mouse-y);
                }
            }
        }
    }

    VerticalLayout {
        padding-left: root.padding-h;
        padding-right: root.padding-h;
        padding-top: root.padding-v;
        padding-bottom: root.padding-v;
        spacing: 4px;

        // 1. Top Media Header Bar
        Rectangle {
            height: 22px;
            vertical-stretch: 0;
            background: transparent;

            HorizontalLayout {
                spacing: 4px;
                alignment: space-between;

                // Left: Format Icon + Title
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    horizontal-stretch: 1;

                    AppIcon {
                        icon: root.item.is-video ? Icons.video : Icons.image;
                        size: 13px;
                        allow-tint: true;
                        color: Theme.primary;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: root.item.title;
                        font-size: 11px;
                        font-weight: 700;
                        color: Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                // Right: Rating & Close Button
                HorizontalLayout {
                    spacing: 4px;
                    alignment: end;
                    horizontal-stretch: 0;

                    if root.item.rating > 0 : AppIcon {
                        icon: Icons.rating-icon(root.item.rating);
                        size: 13px;
                        allow-tint: false;
                        y: (parent.height - self.height) / 2;
                    }

                    // Close Button
                    Rectangle {
                        width: 16px;
                        height: 16px;
                        border-radius: 8px;
                        y: (parent.height - self.height) / 2;
                        background: close-touch.has-hover ? #f38ba833 : transparent;

                        close-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.close-clicked(root.item.id);
                            }
                        }

                        Text {
                            text: "✕";
                            font-size: 10px;
                            font-weight: 700;
                            color: close-touch.has-hover ? #f38ba8 : Theme.text-muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // 2. Center Media Canvas / Placeholder Area
        Rectangle {
            vertical-stretch: 1;
            background: #000000;
            border-radius: Math.max(0px, root.corner-radius-val - 2px);
            clip: true;

            // Render live Image buffer for image tabs
            if !root.item.is-video && root.item.image.width > 0 : Image {
                source: root.item.image;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }

            // Fallback placeholder icon
            if !root.item.is-video && root.item.image.width == 0 : Text {
                text: "🖼";
                font-size: 28px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Video Viewport Area (X11 Subwindow maps directly to this space)
            if root.item.is-video : Rectangle {
                width: 100%;
                height: 100%;
                background: transparent;

                // Bottom-right paused video indicator badge
                Rectangle {
                    x: parent.width - 24px;
                    y: parent.height - 20px;
                    width: 20px;
                    height: 16px;
                    background: #000000bb;
                    border-radius: 2px;

                    Text {
                        text: "⏸";
                        font-size: 9px;
                        color: #ffffff;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
