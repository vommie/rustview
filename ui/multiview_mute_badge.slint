import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";

/// Small mute toggle shown in the top right corner of a hovered video tile. It sits in a hole that is cut into the
/// native mpv window, so this rectangle is also exactly the clickable area.
export component MultiviewMuteBadge inherits Rectangle {
    in property <bool> muted: false;

    callback clicked();

    background: touch.has-hover ? Theme.surface-hover : Theme.surface.with-alpha(0.9);
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border;

    touch := TouchArea {
        mouse-cursor: pointer;

        clicked => {
            root.clicked();
        }
    }

    AppIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: root.muted ? IconId.volume-off : IconId.volume-on;
        size: IconSize.md;
        color: touch.has-hover ? Theme.primary : Theme.text;
    }
}
