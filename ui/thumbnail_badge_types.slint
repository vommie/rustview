import { MediaItemView } from "types.slint";

// Shared data contract between the Slint UI and the Rust thumbnail badge engine
// (src/ui/thumbnail_badges). Enums are defined here once and used on both sides.

/// Corner of the thumbnail a badge is anchored to. The left corners form the primary badge area
/// (left-aligned), the right corners the secondary badge area (right-aligned). Each area gets
/// half of the thumbnail width.
export enum ThumbnailBadgeOrientation {
    top-left,
    top-right,
    bottom-left,
    bottom-right,
}

/// Visual form of a badge. All forms share the same base design (see thumbnail_badge.slint).
export enum ThumbnailBadgeKind {
    /// Compact rounded label with text (e.g. "VIDEO", "04:30").
    text,
    /// Circular label with a short glyph (e.g. the rating number).
    round,
    /// Bare icon without background (e.g. the tag indicator).
    icon,
}

/// Semantic theme color of a badge. Resolved against the Theme palette so badges follow theme changes.
export enum ThumbnailBadgeTone {
    standard,
    info,
    muted,
    danger,
    rating-0,
    rating-1,
    rating-2,
    rating-3,
    rating-4,
    rating-5,
}

/// What happens when the badges of one area do not fit into its half of the thumbnail width.
export enum ThumbnailBadgeOverflowMode {
    /// Badges that do not fit on the first line are hidden.
    hide,
    /// Badges flow onto further lines (like CSS flex-wrap).
    wrap,
}

/// User-facing badge visibility and overflow configuration (mirrors the Appearance settings).
export struct ThumbnailBadgeConfig {
    show_rating: bool,
    show_tag: bool,
    show_media_type: bool,
    show_duration: bool,
    overflow_mode: ThumbnailBadgeOverflowMode,
}

/// One badge, described by content and color only. Size and position are determined by the
/// Slint layout from the real rendered content.
export struct ThumbnailBadgeView {
    id: string,
    orientation: ThumbnailBadgeOrientation,
    kind: ThumbnailBadgeKind,
    tone: ThumbnailBadgeTone,
    text: string,
    icon_name: string,
    has_custom_color: bool,
    custom_color: color,
    custom_text_color: color,
}

/// The ordered badges of each thumbnail corner.
export struct ThumbnailBadgeZones {
    top_left: [ThumbnailBadgeView],
    top_right: [ThumbnailBadgeView],
    bottom_left: [ThumbnailBadgeView],
    bottom_right: [ThumbnailBadgeView],
}

/// Implemented in Rust. Collects and orders all badges of one media item per thumbnail corner.
export global ThumbnailBadgeEngine {
    pure callback collect(MediaItemView, ThumbnailBadgeConfig) -> ThumbnailBadgeZones;
}
