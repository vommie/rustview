import { Button, LineEdit } from "std-widgets.slint";
import { Theme } from "styles.slint";
import { TagNodeView } from "types.slint";
import { RatingBar } from "rating_bar.slint";
import { SmoothScrollArea } from "smooth_scroll_view.slint";
import { NodeButton } from "node_button.slint";

export component TagDockHeader inherits Rectangle {
    height: 28px;

    in-out property <bool> is-assign-mode: false;
    callback mode-toggled(bool);
    callback root-context-menu(length, length);

    header-touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.root-context-menu(header-touch.mouse-x, header-touch.mouse-y);
            }
        }
    }

    HorizontalLayout {

        Text {
            text: "TAG & RATE";
            font-size: 11px;
            font-weight: 700;
            color: Theme.primary;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Button {
            text: root.is-assign-mode ? "Mode: ASSIGN" : "Mode: QUERY";
            clicked => {
                root.is-assign-mode = !root.is-assign-mode;
                root.mode-toggled(root.is-assign-mode);
            }
        }
    }
}

export component QueryScopeControls inherits HorizontalLayout {
    height: 28px;
    spacing: 6px;

    in-out property <int> match-mode-idx: 0;
    in-out property <int> scope-mode-idx: 0;

    callback match-mode-changed(int);
    callback scope-mode-changed(int);

    Button {
        text: root.match-mode-idx == 0 ? "Match: ALL" : "Match: ANY";
        clicked => {
            root.match-mode-idx = root.match-mode-idx == 0 ? 1 : 0;
            root.match-mode-changed(root.match-mode-idx);
        }
    }

    Button {
        text: root.scope-mode-idx == 0 ? "Scope: Folder" : "Scope: Global";
        clicked => {
            root.scope-mode-idx = root.scope-mode-idx == 0 ? 1 : 0;
            root.scope-mode-changed(root.scope-mode-idx);
        }
    }
}

export component TagTreeItem inherits Rectangle {
    in property <TagNodeView> tag;
    callback clicked();
    callback toggle-expanded();
    callback scroll-requested(length /* dx */, length /* dy */);
    callback context-menu-requested(length /* x */, length /* y */);

    height: 22px;

    background: root.tag.is-selected ? Theme.surface-selected :
                (root.tag.is-assigned ? (root.tag.is-dimmed ? #a6e3a118 : #a6e3a128) :
                (root.tag.is-partial ? (root.tag.is-dimmed ? #f9e2af15 : #f9e2af22) :
                (tag-touch.has-hover ? Theme.surface-hover : (root.tag.is-dimmed ? #1e1e2e66 : Theme.surface-variant))));

    border-radius: 3px;
    border-width: 1px;

    border-color: root.tag.is-selected ? Theme.primary :
                 (root.tag.is-assigned ? (root.tag.is-dimmed ? #a6e3a188 : #a6e3a1) :
                 (root.tag.is-partial ? (root.tag.is-dimmed ? #f9e2af88 : #f9e2af) : Theme.border));

    tag-touch := TouchArea {
        scroll-event(event) => {
            root.scroll-requested(event.delta-x, event.delta-y);
            return accept;
        }

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                if event.button == PointerEventButton.right {
                    root.context-menu-requested(tag-touch.mouse-x, tag-touch.mouse-y);
                } else if event.button == PointerEventButton.left {
                    root.clicked();
                }
            }
        }
    }

    HorizontalLayout {
        opacity: root.tag.is-dimmed ? 0.8 : 1.0;
        padding-left: (root.tag.depth * 14px) + 6px;
        padding-right: 8px;
        spacing: 4px;
        alignment: start;

        NodeButton {
            has-children: root.tag.has-children;
            is-expanded: root.tag.is-expanded;
            show-leaf-bullet: root.tag.depth > 0;
            button-size: 14px;
            y: (parent.height - self.height) / 2;
            toggled(new-state) => {
                root.toggle-expanded();
            }
        }

        if root.tag.is-assigned || root.tag.is-partial : Rectangle {
            width: 12px;
            height: 12px;
            y: (parent.height - self.height) / 2;

            Text {
                text: root.tag.is-assigned ? "✓" : "◐";
                font-size: 10px;
                font-weight: 700;
                color: root.tag.is-assigned ? #a6e3a1 : #f9e2af;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.tag.name;
            color: root.tag.is-selected ? Theme.primary :
                   (root.tag.is-assigned ? #a6e3a1 :
                   (root.tag.is-partial ? #f9e2af : Theme.text));

            font-weight: (root.tag.is-selected || root.tag.is-assigned || root.tag.depth == 0) ? 700 : 400;
            font-italic: root.tag.is-partial;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-alignment: left;
        }
    }
}

export component TagTreeList inherits Rectangle {
    vertical-stretch: 1;
    background: Theme.background;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    in property <[TagNodeView]> tags: [];
    callback tag-clicked(int);
    callback tag-toggle-expand(int);
    callback tag-context-menu(int, length, length);
    callback root-context-menu(length, length);

    property <length> item-row-height: 22px;
    property <length> row-spacing: 2px;
    property <int> rows-per-column: Math.max(1, Math.floor((self.height - 8px) / (root.item-row-height + root.row-spacing)));

    scroll-area := SmoothScrollArea {
        width: 100%;
        height: 100%;
        content-width: Math.max(self.width, grid-layout.preferred-width + 8px);
        content-height: Math.max(self.height, grid-layout.preferred-height + 8px);
        enable-horizontal: true;
        enable-vertical: false;

        // Background TouchArea positioned inside scroll viewport to catch right clicks anywhere on empty tree space
        bg-touch := TouchArea {
            width: 100%;
            height: 100%;

            scroll-event(event) => {
                scroll-area.handle-scroll(event.delta-x, event.delta-y);
                return accept;
            }

            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                    root.root-context-menu(
                        scroll-area.clamped-x + bg-touch.mouse-x,
                        scroll-area.clamped-y + bg-touch.mouse-y
                    );
                }
            }
        }

        grid-layout := GridLayout {
            padding: 4px;
            spacing: root.row-spacing;

            for tag[index] in root.tags: TagTreeItem {
                col: Math.floor(index / root.rows-per-column);
                row: Math.mod(index, root.rows-per-column);
                tag: tag;
                clicked => { root.tag-clicked(tag.id); }
                toggle-expanded => { root.tag-toggle-expand(tag.id); }
                scroll-requested(dx, dy) => {
                    scroll-area.handle-scroll(dx, dy);
                }
                context-menu-requested(mx, my) => {
                    root.tag-context-menu(
                        tag.id,
                        scroll-area.clamped-x + self.x + mx,
                        scroll-area.clamped-y + self.y + my
                    );
                }
            }
        }
    }
}

export component TagPanel inherits VerticalLayout {
    spacing: 8px;
    vertical-stretch: 1;

    in-out property <bool> is-assign-mode: false;
    in-out property <int> match-mode-idx: 0;
    in-out property <int> scope-mode-idx: 0;
    in-out property <int> selected-rating: -1;
    in property <[TagNodeView]> tags: [];

    callback mode-toggled(bool);
    callback match-mode-changed(int);
    callback scope-mode-changed(int);
    callback rating-selected(int);
    callback tag-filter-changed(string);
    callback tag-clicked(int);
    callback tag-toggle-expand(int);
    callback tag-context-menu(int, length, length);
    callback root-context-menu(length, length);

    // Dock Header
    header := TagDockHeader {
        is-assign-mode <=> root.is-assign-mode;
        mode-toggled(assign) => { root.mode-toggled(assign); }
        root-context-menu(x, y) => { root.root-context-menu(header.x + x, header.y + y); }
    }

    // Query Scope Controls (Only active in Query Mode)
    if !root.is-assign-mode : QueryScopeControls {
        match-mode-idx <=> root.match-mode-idx;
        scope-mode-idx <=> root.scope-mode-idx;
        match-mode-changed(m) => { root.match-mode-changed(m); }
        scope-mode-changed(s) => { root.scope-mode-changed(s); }
    }

    // Rating Selector Bar
    RatingBar {
        selected-rating <=> root.selected-rating;
        rating-selected(r) => { root.rating-selected(r); }
    }

    // Tag Filter Input
    LineEdit {
        placeholder-text: "Filter tags...";
        edited(text) => { root.tag-filter-changed(text); }
    }

    // Tag Hierarchical Tree View
    tree-list := TagTreeList {
        tags: root.tags;
        tag-clicked(id) => { root.tag-clicked(id); }
        tag-toggle-expand(id) => { root.tag-toggle-expand(id); }
        tag-context-menu(id, x, y) => { root.tag-context-menu(id, tree-list.x + x, tree-list.y + y); }
        root-context-menu(x, y) => { root.root-context-menu(tree-list.x + x, tree-list.y + y); }
    }
}
