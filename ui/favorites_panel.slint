import { Theme } from "styles.slint";
import { FavoriteItemView } from "types.slint";
import { SmoothScrollArea } from "smooth_scroll_view.slint";

export component FavoriteItemRow inherits Rectangle {
    in property <FavoriteItemView> item;
    callback clicked();

    height: 26px;
    background: root.item.is-selected ? Theme.surface-selected : (fav-touch.has-hover ? Theme.surface-hover : transparent);
    border-radius: 2px;

    fav-touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        alignment: center;

        Text {
            text: root.item.alias;
            color: root.item.is-valid ? Theme.text : Theme.text-muted;
            font-italic: !root.item.is-valid;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

export component FavoritesList inherits Rectangle {
    background: Theme.background;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    in property <[FavoriteItemView]> favorites: [];
    callback favorite-clicked(string);

    if root.favorites.length == 0 : VerticalLayout {
        alignment: center;
        spacing: 6px;

        Text {
            text: "★";
            font-size: 24px;
            color: Theme.border;
            horizontal-alignment: center;
        }

        Text {
            text: "No favorites saved";
            font-size: 11px;
            color: Theme.text-muted;
            horizontal-alignment: center;
        }
    }

    scroll-area := SmoothScrollArea {
        visible: root.favorites.length > 0;
        width: 100%;
        height: 100%;
        enable-horizontal: false;
        enable-vertical: true;
        content-width: self.width;
        content-height: fav-layout.preferred-height;

        fav-layout := VerticalLayout {
            spacing: 0px;
            alignment: start;

            for fav in root.favorites: FavoriteItemRow {
                item: fav;
                clicked => { root.favorite-clicked(fav.path); }
            }
        }
    }
}

export component FavoritesPanel inherits VerticalLayout {
    spacing: 4px;
    vertical-stretch: 1;

    in property <[FavoriteItemView]> favorites: [];
    callback favorite-clicked(string);

    // Scrollable List Container occupying full panel height
    FavoritesList {
        vertical-stretch: 1;
        favorites: root.favorites;
        favorite-clicked(path) => { root.favorite-clicked(path); }
    }
}
