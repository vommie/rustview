import { Theme } from "styles.slint";

/// Standalone text component that dynamically clips overflowing text on the left side with an ellipsis badge "…".
export component LeftElidedText inherits Rectangle {
    in property <string> text: "";
    in property <color> text-color: Theme.text-muted;
    in property <length> font-size: 11px;
    in property <color> bg-color: Theme.background;

    clip: true;
    horizontal-stretch: 1;

    property <bool> is-overflowing: txt.preferred-width > self.width;

    txt := Text {
        x: root.is-overflowing ? (parent.width - self.preferred-width) : 0px;
        y: 0px;
        height: 100%;
        text: root.text;
        color: root.text-color;
        font-size: root.font-size;
        vertical-alignment: center;
    }

    if root.is-overflowing : Rectangle {
        x: 0px;
        y: 0px;
        width: 14px;
        height: 100%;
        background: root.bg-color;

        Text {
            x: 0px;
            text: "…";
            color: root.text-color;
            font-size: root.font-size;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

export component MetadataRow inherits HorizontalLayout {
    in property <string> label: "";
    in property <string> value: "-";
    in property <color> value-color: Theme.text-muted;
    in property <length> value-font-size: 11px;

    spacing: 4px;

    Text {
        text: root.label;
        color: Theme.text-muted;
        font-size: root.value-font-size;
        min-width: 72px;
    }

    Text {
        text: root.value;
        color: root.value-color;
        font-size: root.value-font-size;
        horizontal-stretch: 1;
        overflow: elide;
    }
}

export component MetadataPathRow inherits HorizontalLayout {
    in property <string> label: "Path:";
    in property <string> path-value: "-";
    in property <color> value-color: Theme.text;
    in property <length> value-font-size: 11px;

    spacing: 4px;

    Text {
        text: root.label;
        color: Theme.text-muted;
        font-size: root.value-font-size;
        min-width: 72px;
    }

    LeftElidedText {
        text: root.path-value;
        text-color: root.value-color;
        font-size: root.value-font-size;
        bg-color: Theme.background;
    }
}

export component MetadataInspector inherits Rectangle {
    height: 160px;
    background: Theme.background;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border;

    in property <string> filename: "-";
    in property <string> path-label: "Path:";
    in property <string> path-value: "-";
    in property <string> filesize: "-";
    in property <string> dimensions: "-";
    in property <string> format-name: "-";
    in property <string> hash-or-rating: "-";
    in property <int> selection-count: 0;

    VerticalLayout {
        padding: 8px;
        spacing: 4px;

        // Header Title with Selection Count Suffix
        Text {
            text: "INFO / METADATA" + (root.selection-count > 1 ? (" (" + root.selection-count + " Files)") : "");
            font-size: 10px;
            font-weight: 700;
            color: Theme.primary;
        }

        // Modular Inspector Rows
        MetadataRow {
            label: "File:";
            value: root.filename;
            value-color: Theme.text;
        }

        MetadataPathRow {
            label: root.path-label;
            path-value: root.path-value;
            value-color: Theme.text-muted;
        }

        MetadataRow {
            label: "Size:";
            value: root.filesize;
        }

        MetadataRow {
            label: "Dimensions:";
            value: root.dimensions;
        }

        MetadataRow {
            label: "Format:";
            value: root.format-name;
        }

        MetadataRow {
            label: root.selection-count > 1 ? "Details:" : "MD5:";
            value: root.hash-or-rating;
            value-font-size: 10px;
        }
    }
}
