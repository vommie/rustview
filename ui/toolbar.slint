import { Button } from "std-widgets.slint";
import { Theme } from "styles.slint";

export component TopToolbar inherits Rectangle {
    height: 38px;
    background: Theme.surface;

    callback settings-clicked();

    // Bottom border separator line
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: start;

        Button {
            text: "Settings";
            icon: @image-url("icons/settings.svg");
            clicked => { root.settings-clicked(); }
        }
    }
}
