import { Theme } from "styles.slint";
import { Icons } from "icons.slint";
import { ToolbarButton } from "toolbar_button.slint";

export component TopToolbar inherits Rectangle {
    height: 38px;
    background: Theme.surface;

    callback settings-clicked();

    // Bottom border separator line
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: start;

        ToolbarButton {
            text: "Settings";
            icon: Icons.settings;
            icon-size: 15px;
            font-size: 12px;
            height: 28px;
            y: (parent.height - self.height) / 2;
            clicked => { root.settings-clicked(); }
        }
    }
}
