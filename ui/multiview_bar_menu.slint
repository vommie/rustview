import { Theme } from "styles.slint";
import { ContextMenuItemModel } from "types.slint";
import { ContextMenuItemRow } from "context_menu.slint";
import { SmoothScrollArea } from "smooth_scroll_view.slint";

/// Drop-down of a button of the media action bar, drawn as a speech bubble: a caret points at the button that opened it, the body is
/// slightly translucent (solid without a compositing manager) and holds the same rows as a context menu. Any bar button with a menu
/// uses this component; the window around it decides where it sits (`anchor-x` is the center of the opener, relative to the left edge
/// of this component).
export component MultiviewBarMenu inherits Rectangle {
    in property <[ContextMenuItemModel]> items;
    in property <length> anchor-x: 0px;
    in property <bool> translucent: true;
    in property <length> max-content-height: 300px;
    out property <length> caret-height: 7px;
    out property <length> content-height: root.caret-height + root.body-height;
    out property <length> corner-radius: 8px;
    out property <length> caret-center-x: root.caret-x;

    property <length> body-height: Math.min(menu-layout.preferred-height + 8px, Math.max(root.max-content-height - root.caret-height, 0px));
    property <color> fill: root.translucent ? Theme.surface.with-alpha(0.9) : Theme.surface;
    property <length> caret-x: Math.max(14px, Math.min(root.width - 14px, root.anchor-x));

    callback item-clicked(int /* item id */);

    height: root.content-height;

    // Swallows the clicks on the gaps between rows.
    body := Rectangle {
        y: root.caret-height;
        height: root.body-height;
        background: root.fill;
        border-radius: root.corner-radius;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;

        TouchArea { }

        scroll := SmoothScrollArea {
            width: 100%;
            height: 100%;
            enable-horizontal: false;
            enable-vertical: true;
            scrollbar-size: 5px;
            scrollbar-padding: 2px;
            content-width: self.width;
            content-height: menu-layout.preferred-height;

            menu-layout := VerticalLayout {
                padding: 4px;
                spacing: 1px;

                for item in root.items : ContextMenuItemRow {
                    item: item;

                    scrolled(dx, dy) => {
                        scroll.handle-scroll(dx, dy);
                    }

                    clicked => {
                        root.item-clicked(item.id);
                    }
                }
            }
        }
    }

    // The caret, drawn over the top edge of the body: a filled triangle whose base also covers the body's border, and its two outer edges.
    Path {
        x: root.caret-x - 7px;
        y: 0px;
        width: 14px;
        height: root.caret-height + 1px;
        viewbox-width: 14;
        viewbox-height: 8;
        commands: "M 0 7 L 7 0 L 14 7 L 14 8 L 0 8 Z";
        fill: root.fill;
    }

    Path {
        x: root.caret-x - 7px;
        y: 0px;
        width: 14px;
        height: root.caret-height + 1px;
        viewbox-width: 14;
        viewbox-height: 8;
        commands: "M 0 7.5 L 7 0.5 L 14 7.5";
        stroke: Theme.border;
        stroke-width: 1px;
    }
}
