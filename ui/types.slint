export struct MediaItemView {
    id: int,
    filename: string,
    filesize_str: string,
    dimensions_str: string,
    rating: int,
    has_tags: bool,
    thumbnail: image,
    is_selected: bool,
    is_video: bool,
}

export struct FolderNodeView {
    id: int,
    name: string,
    path: string,
    depth: int,
    is_expanded: bool,
    is_selected: bool,
}

export struct FavoriteItemView {
    alias: string,
    path: string,
    is_valid: bool,
    is_selected: bool,
}

export struct TagNodeView {
    id: int,
    name: string,
    depth: int,
    has_children: bool,
    is_expanded: bool,
    is_selected: bool,
    is_assigned: bool,
    is_partial: bool,
    is_dimmed: bool,
}

export struct ContextMenuItemModel {
    id: int,
    text: string,
    shortcut: string,
    icon_name: string,
    kind: int, // 0 = Action, 1 = Checkable, 2 = Radio, 3 = Separator, 4 = Header, 5 = Submenu
    is_checked: bool,
    is_enabled: bool,
    has_submenu: bool,
    submenu_depth: int,
    menu_index: int,
}
