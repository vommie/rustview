export struct MediaItemView {
    id: int,
    filename: string,
    path_str: string,
    modified_date_str: string,
    created_date_str: string,
    filesize_str: string,
    rating: int,
    rating_str: string,
    tags_count: int,
    tags_str: string,
    width_str: string,
    height_str: string,
    ar_str: string,
    duration_str: string,
    format_str: string,
    flags_str: string,
    has_tags: bool,
    thumbnail: image,
    is_selected: bool,
    is_video: bool,
    is_corrupted: bool,
    is_deleted: bool,
}

export struct FolderNodeView {
    id: int,
    name: string,
    path: string,
    depth: int,
    has_children: bool,
    is_expanded: bool,
    is_selected: bool,
    is_deleted: bool,
    subfolder_count: int,
    file_count: int,
}

export struct FavoriteItemView {
    alias: string,
    path: string,
    is_valid: bool,
    is_selected: bool,
}

export struct TagNodeView {
    id: int,
    name: string,
    depth: int,
    has_children: bool,
    is_expanded: bool,
    is_selected: bool,
    is_assigned: bool,
    is_partial: bool,
    is_dimmed: bool,
}

export struct TagColumnView {
    tags: [TagNodeView],
}

export struct ContextMenuItemModel {
    id: int,
    text: string,
    shortcut: string,
    icon_name: string,
    icon: image,
    kind: int, // 0 = Action, 1 = Checkable, 2 = Radio, 3 = Separator, 4 = Header, 5 = Submenu
    is_checked: bool,
    is_enabled: bool,
    has_submenu: bool,
    submenu_depth: int,
    menu_index: int,
}

export struct ConflictFileView {
    filename: string,
    folder_path: string,
    filesize_str: string,
    dimensions_str: string,
    date_str: string,
    hash_str: string,
    thumbnail: image,
}

export struct TabItemModel {
    id: int,
    media_id: int,
    title: string,
    format_str: string,
    is_active: bool,
    is_video: bool,
    rating: int,
    has_tags: bool,
}
