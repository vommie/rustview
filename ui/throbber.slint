import { Theme } from "styles.slint";
import { Icons } from "icons.slint";
import { TooltipHost } from "tooltips.slint";

/// Fully encapsulated, standalone, reusable animated Throbber component for Slint.
/// Supports smooth continuous rotation, visibility animations, theme colorization,
/// custom sizes, dimmed/disabled states, and integrated hover tooltips with dynamic vertical and horizontal centering.
export component Throbber inherits Rectangle {
    // State & Behavior Properties
    in-out property <bool> is-active: false;
    in property <bool> is-dimmed: false;
    in property <string> tooltip: "Processing in background...";
    in property <duration> animation-interval: 35ms;
    in property <angle> rotation-step: 18deg;

    // Dimension & Sizing API
    in property <length> size: 14px;

    // Theme & Styling API
    in property <color> throbber-color: Theme.primary;

    // Public API Functions for Programmatic Control
    public function show() {
        root.is-active = true;
    }

    public function hide() {
        root.is-active = false;
    }

    // Geometry & Layout Integration (Fixed-coordinate inner frame with stable invariant X/Y alignment)
    property <length> target-width: root.size + 4px;
    width: root.is-active ? root.target-width : 0px;
    height: 100%;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    clip: true;
    visible: root.is-active;
    opacity: root.is-active ? (root.is-dimmed ? 0.45 : 1.0) : 0.0;
    background: transparent;

    animate width { duration: 150ms; }
    animate opacity { duration: 150ms; }

    property <angle> current-angle: 0deg;

    changed is-active => {
        if self.is-active {
            root.current-angle = 0deg;
        }
    }

    // Rotation Animation Timer
    spin-timer := Timer {
        interval: root.animation-interval;
        running: root.is-active;
        triggered => {
            root.current-angle = root.current-angle + root.rotation-step;
            if root.current-angle >= 360deg {
                root.current-angle = 0deg;
            }
        }
    }

    tooltip-host := TooltipHost {
        text: root.tooltip;
        is-enabled: root.is-active && root.tooltip != "";
    }

    touch-area := TouchArea {
        enabled: root.is-active && root.tooltip != "";
        mouse-cursor: default;
        moved => {
            tooltip-host.on-mouse-move(self.mouse-x, self.mouse-y);
        }
    }

    property <bool> is-hovered: touch-area.has-hover && root.tooltip != "";
    changed is-hovered => {
        if self.is-hovered && root.is-active {
            tooltip-host.on-hover-enter(touch-area.mouse-x, touch-area.mouse-y);
        } else {
            tooltip-host.on-hover-leave();
        }
    }

    // Fixed-width inner frame ensuring the rotating icon never shifts coordinates or wobbles during width animation
    Rectangle {
        x: 0px;
        y: 0px;
        width: root.target-width;
        height: parent.height;

        Image {
            x: (parent.width - root.size) / 2;
            y: (parent.height - root.size) / 2;
            width: root.size;
            height: root.size;
            source: Icons.loader;
            image-fit: contain;
            colorize: root.throbber-color;
            transform-rotation: root.current-angle;
        }
    }
}
