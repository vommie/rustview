import { Theme } from "styles.slint";
import { Icons } from "icons.slint";
import { PanelToolbar, ToolbarButton, ToolbarToggleButton, ToolbarSeparator, ToolbarSpacer } from "panel_toolbar.slint";
import { ToolbarThumbWidthControl } from "toolbar_thumb_width_control.slint";
import { ToolbarSearchField } from "toolbar_search_field.slint";

/// Dedicated modular toolbar for the Media Grid View.
/// Integrates Thumbnail Width Slider (left-aligned), Expander, Filter Search, Regex Toggle, Refresh, and ViewMode Switcher.
export component MediaGridPanelToolbar inherits PanelToolbar {
    in-out property <int> thumb-width: 190;
    in-out property <string> search-text <=> search-field.text;
    in-out property <bool> regex-mode: false;
    in-out property <bool> is-table-view: false;

    callback thumb-width-changed(int);
    callback search-changed(string);
    callback regex-toggled(bool);
    callback refresh-clicked();
    callback view-mode-toggled(bool);

    toolbar-height: 26px;

    // 1. Thumbnail Width Slider Control (Strictly Left-Aligned)
    ToolbarThumbWidthControl {
        thumb-width <=> root.thumb-width;
        thumb-width-changed(w) => { root.thumb-width-changed(w); }
    }

    // 2. Expander / Spacer (Expands to push search & view actions to the right)
    ToolbarSpacer {}

    // 3. Filter Search Field
    search-field := ToolbarSearchField {
        placeholder-text: "Filter...";
        field-width: 150px;
        search-changed(txt) => { root.search-changed(txt); }
    }

    // 4. Filter Regex Toggle Button
    ToolbarToggleButton {
        text: ".*";
        is-active: root.regex-mode;
        tooltip: "Toggle Regular Expression filter mode";
        font-size: 12px;
        padding-horizontal: 6px;
        toggled(active) => {
            root.regex-mode = active;
            root.regex-toggled(active);
        }
    }

    // 5. Separator
    ToolbarSeparator {}

    // 6. Refresh Media Button
    ToolbarButton {
        icon: Icons.refresh;
        tooltip: "Scan and refresh media in current folder";
        clicked => { root.refresh-clicked(); }
    }

    // 7. Separator
    ToolbarSeparator {}

    // 8. View Mode Switcher Button
    ToolbarButton {
        icon: root.is-table-view ? Icons.grid-view : Icons.list-view;
        tooltip: root.is-table-view ? "Switch to Grid View" : "Switch to Table View";
        clicked => { root.view-mode-toggled(!root.is-table-view); }
    }
}
