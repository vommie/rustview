import { Theme } from "styles.slint";
import { Icons, AppIcon } from "icons.slint";

/// Standalone, ultra-minimalistic, frameless fullscreen media viewer window.
/// Displays high-resolution images or seamlessly embedded MPV videos fitted to the display.
export component ImageFullscreenWindow inherits Window {
    title: "RustView - Fullscreen";
    no-frame: true;

    in property <image> source-image;
    in property <bool> is-loading: false;
    in property <string> error-message: "";
    in property <int> background-mode: 0; // 0 = Dark Theme (#11111b), 1 = Deep Black (#000000), 2 = Checkerboard
    in property <bool> is-video: false;
    in property <bool> allow-navigation: false; // ONLY true for Quick-Fullscreen (Browse View); strictly false for Tab-Fullscreen

    callback request-close();
    callback request-rename();
    callback next-image();
    callback previous-image();
    callback canvas-clicked(bool /* is_ctrl */);

    background: root.background-mode == 1 ? #000000 : (root.background-mode == 2 ? #1e1e2e : #11111b);

    // Keyboard navigation and instant ESC / Ctrl+W / F2 handling
    forward-focus: fs-focus;
    fs-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.request-close();
                return accept;
            }
            // Close on Ctrl+W or Meta+W (Command+W on macOS)
            if (event.text == "w" || event.text == "W") && (event.modifiers.control || event.modifiers.meta) {
                root.request-close();
                return accept;
            }
            // Handle terminal ASCII 0x17 (Ctrl+W) only when Control modifier is explicitly pressed
            if event.modifiers.control && event.text == "\u{17}" {
                root.request-close();
                return accept;
            }
            if event.text == Key.F2 {
                root.request-rename();
                return accept;
            }

            // Navigation is ONLY permitted in Quick-Fullscreen (Browse context). Tab-Fullscreen is strictly locked to its own file.
            if root.allow-navigation {
                // Next image: RightArrow, DownArrow, PageDown, or Space
                if event.text == Key.RightArrow || event.text == Key.DownArrow || event.text == Key.PageDown || event.text == Key.Space {
                    root.next-image();
                    return accept;
                }
                // Previous image: LeftArrow, UpArrow, or PageUp
                if event.text == Key.LeftArrow || event.text == Key.UpArrow || event.text == Key.PageUp {
                    root.previous-image();
                    return accept;
                }
            }

            return reject;
        }
    }

    // Interactive canvas supporting double-click/middle-click to close and mouse wheel navigation.
    // Right-click intentionally has NO action in RustView fullscreen.
    fs-touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: !root.is-video || root.error-message != ""; // Native MPV handles its own controls ONLY when actively playing video without error

        scroll-event(event) => {
            // Wheel navigation only permitted in Quick-Fullscreen
            if root.allow-navigation {
                if event.delta-y < 0px {
                    root.next-image();
                    return accept;
                }
                if event.delta-y > 0px {
                    root.previous-image();
                    return accept;
                }
            }
            return reject;
        }

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                if event.button == PointerEventButton.left {
                    root.canvas-clicked(event.modifiers.control || event.modifiers.meta);
                } else if event.button == PointerEventButton.middle {
                    root.request-close();
                }
                // Right click intentionally does nothing in RustView fullscreen
            }
        }
    }

    // Optional Checkerboard Pattern Background for transparency inspection
    if root.background-mode == 2 : Rectangle {
        width: 100%;
        height: 100%;
        background: #181825;
        opacity: 0.5;
    }

    // High-Resolution Image Canvas: Fitted with aspect-ratio preservation (Images only when no error)
    if !root.is-video && root.source-image.width > 0 && !root.is-loading && root.error-message == "" : Image {
        source: root.source-image;
        width: 100%;
        height: 100%;
        image-fit: contain;
    }

    // Loading indicator
    if root.is-loading && root.error-message == "" : VerticalLayout {
        alignment: center;
        spacing: 12px;

        HorizontalLayout {
            alignment: center;
            AppIcon {
                icon: Icons.loader;
                size: 36px;
                allow-tint: true;
                color: Theme.primary;
            }
        }

        Text {
            text: root.is-video ? "Initializing video player..." : "Loading high-resolution image...";
            font-size: 13px;
            color: Theme.text-muted;
            horizontal-alignment: center;
        }
    }

    // Centered Fallback View for missing or unreadable files
    if root.error-message != "" && !root.is-loading : VerticalLayout {
        alignment: center;
        spacing: 16px;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 80px;
                height: 80px;
                border-radius: 40px;
                background: Theme.corrupt-bg;
                border-width: 1px;
                border-color: #f38ba844;

                AppIcon {
                    icon: Icons.media-file-corrupted;
                    size: 48px;
                    allow-tint: true;
                    color: Theme.status-corrupt;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        Text {
            text: "File Not Found on Disk";
            font-size: 18px;
            font-weight: 700;
            color: Theme.status-corrupt;
            horizontal-alignment: center;
        }

        Text {
            text: root.error-message;
            font-size: 13px;
            color: Theme.text-muted;
            horizontal-alignment: center;
            wrap: word-wrap;
            max-width: 600px;
        }

        Text {
            text: "Press Escape, Ctrl+W, or double-click to exit fullscreen.";
            font-size: 11px;
            color: Theme.text-muted;
            opacity: 0.7;
            horizontal-alignment: center;
        }
    }
}
