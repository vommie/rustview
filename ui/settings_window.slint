import { Theme } from "styles.slint";
import { SettingsSidebar } from "settings_sidebar.slint";
import { SettingsPageGeneral } from "settings_page_general.slint";
import { SettingsPageFolders } from "settings_page_folders.slint";
import { SettingsPageAppearance } from "settings_page_appearance.slint";
import { SettingsPagePerformance } from "settings_page_performance.slint";
import { SettingsPageFormats } from "settings_page_formats.slint";
import { SettingsPageViewer } from "settings_page_viewer.slint";
import { SettingsPageFullscreen } from "settings_page_fullscreen.slint";
import { SettingsPageTagsRatings } from "settings_page_tags_ratings.slint";
import { SettingsPageApi } from "settings_page_api.slint";
import { SettingsPageDebug } from "settings_page_debug.slint";
import { ButtonBar } from "button_bar.slint";
import { SmoothScrollArea } from "smooth_scroll_view.slint";
import { GlobalTooltipLayer } from "global_tooltip_layer.slint";
import { TooltipSettings } from "tooltips.slint";

export { SettingsSidebar } from "settings_sidebar.slint";
export { SettingsPageGeneral } from "settings_page_general.slint";
export { SettingsPageFolders } from "settings_page_folders.slint";
export { SettingsPageAppearance } from "settings_page_appearance.slint";
export { SettingsPagePerformance } from "settings_page_performance.slint";
export { SettingsPageFormats } from "settings_page_formats.slint";
export { SettingsPageViewer } from "settings_page_viewer.slint";
export { SettingsPageFullscreen } from "settings_page_fullscreen.slint";
export { SettingsPageTagsRatings } from "settings_page_tags_ratings.slint";
export { SettingsPageApi } from "settings_page_api.slint";
export { SettingsPageDebug } from "settings_page_debug.slint";
export { SettingsCard } from "settings_card.slint";
export { ButtonBar } from "button_bar.slint";
export { SmoothScrollArea } from "smooth_scroll_view.slint";

export component SettingsWindow inherits Window {
    title: "RustView - Settings";
    preferred-width: 860px;
    preferred-height: 640px;
    min-width: 740px;
    min-height: 540px;
    background: Theme.background;

    in-out property <int> active-category: 0;

    // General options
    in-out property <string> root-folder-path: "";
    in-out property <bool> ignore-nested-mounts: true;
    in-out property <bool> remember-last-folder: true;
    in-out property <bool> confirm-delete: true;
    in-out property <int> deletion-mode-idx: 0;

    // Folders options
    in-out property <bool> auto-reveal-remembered-folder: true;
    in-out property <bool> persist-folder-tree-state: true;
    in-out property <bool> show-deleted-folders: true;
    in-out property <bool> show-folder-metrics: true;
    in-out property <bool> show-hidden-folders: false;
    in-out property <bool> support-dot-hidden-files: true;

    // Appearance options
    in-out property <int> default-thumb-size: 190;
    in-out property <int> thumb-aspect-idx: 1; // 0=1:1, 1=4:3, 2=5:4, 3=16:9, 4=3:4, 5=4:5, 6=9:16
    in-out property <bool> show-filenames: true;
    in-out property <bool> show-rating-badge: true;
    in-out property <bool> show-tag-badge: true;
    in-out property <bool> show-media-type-badges: true;
    in-out property <bool> show-duration-badge: true;
    in-out property <int> thumbnail-badge-overflow-idx: 0; // 0=hide, 1=wrap
    in-out property <bool> enable-hover-previews: true;
    in-out property <bool> enable-tooltips: true;
    in-out property <int> tooltip-delay-ms: 750;

    // Grid Items Layout options
    in-out property <int> grid-item-padding-h: 8;
    in-out property <int> grid-item-padding-v: 6;
    in-out property <int> grid-spacing: 12;
    in-out property <int> grid-padding: 12;
    in-out property <int> grid-item-border-width: 1;
    in-out property <int> grid-item-corner-radius: 4;

    // Performance options
    in-out property <int> worker-threads: 4;
    in-out property <int> batch-commit-size: 32;
    in-out property <int> l1-cache-slots: 512;
    in-out property <int> thumb-db-size: 256;
    in-out property <int> thumb-format-idx: 0; // 0 = WebP, 1 = JPEG
    in-out property <int> thumb-quality: 80;
    in-out property <int> scaling-algo-idx: 0;
    in-out property <int> video-engine-idx: 0; // 0 = FFmpeg, 1 = MPV
    in-out property <int> video-offset-percent: 10;
    in-out property <int> short-video-threshold-secs: 10;
    in-out property <bool> generate-video-previews: true;
    in-out property <int> preview-frame-count: 5;
    in-out property <bool> custom-preview-settings: true;
    in-out property <int> preview-format-idx: 0; // 0 = WebP, 1 = JPEG
    in-out property <int> preview-quality: 40;

    // Formats options
    in property <string> supported-image-formats: "jpg, jpeg, jfif, jpe, png, webp, avif, gif, bmp, tiff, tif, psd";
    in property <string> supported-video-formats: "mp4, m4v, mkv, webm, mov, avi, mpg, mpeg, flv";
    in-out property <bool> auto-detect-extensionless: true;

    // Viewer options
    in-out property <bool> open-images-in-tab: true;
    in-out property <bool> allow-multiple-image-tabs: false;
    in-out property <bool> open-videos-in-tab: true;
    in-out property <bool> allow-multiple-video-tabs: true;
    in-out property <bool> viewer-show-tab-rating-badge: false;
    in-out property <int> viewer-background-mode-idx: 0;

    // Fullscreen options
    in property <[string]> display-options: [];
    in-out property <int> selected-display-idx: 0;
    in-out property <bool> fullscreen-enable-specific: false;
    in-out property <bool> fullscreen-enable-fallback: false;
    in-out property <int> fullscreen-fallback-target-idx: 0;
    in-out property <bool> fullscreen-media-bar-enabled: true;
    in-out property <bool> fullscreen-media-bar-show-mute: true;
    in-out property <bool> fullscreen-media-bar-show-sticky: true;
    in-out property <bool> fullscreen-media-bar-show-open-as-tab: true;
    in-out property <bool> fullscreen-media-bar-show-remove: true;
    in-out property <int> fullscreen-media-bar-reveal-distance-px: 15;
    in-out property <bool> fullscreen-sound-auto-control: true;
    in-out property <int> fullscreen-sound-follows-idx: 0; // 0 = first video, 1 = newest video, 2 = nobody
    in-out property <bool> fullscreen-sound-hand-over: true;
    in-out property <int> fullscreen-background-source-idx: 0; // 0 = theme, 1 = same as viewer, 2 = custom color
    in-out property <color> fullscreen-background-color: Theme.fullscreen-background;
    callback refresh-displays();
    callback pick-fullscreen-background();

    // Tags & Ratings options
    in-out property <int> max-history-tags: 20;

    // API options
    in-out property <bool> auto-complete-external-stubs: true;

    // Debug options
    in-out property <bool> obfuscate-logs: true;

    // Callbacks to Rust backend
    callback browse-root-folder();
    callback save-and-apply();
    callback cancel-clicked();

    // The tooltips of this window follow the options being edited (the dialog is a window of its own with its own
    // tooltip settings).
    changed enable-tooltips => {
        TooltipSettings.enabled = root.enable-tooltips;
    }
    changed tooltip-delay-ms => {
        TooltipSettings.default-delay = root.tooltip-delay-ms * 1ms;
    }

    forward-focus: dialog-focus;

    dialog-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel-clicked();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            HorizontalLayout {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                padding: 0px;
                spacing: 0px;

                SettingsSidebar {
                    active-category <=> root.active-category;
                }

                SmoothScrollArea {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                    enable-horizontal: false;
                    enable-vertical: true;
                    content-width: self.width;
                    content-height: page-content.preferred-height;

                    page-content := VerticalLayout {
                        padding: 16px;
                        spacing: 16px;
                        alignment: start;

                        if root.active-category == 0 : SettingsPageGeneral {
                            root-folder-path <=> root.root-folder-path;
                            ignore-nested-mounts <=> root.ignore-nested-mounts;
                            remember-last-folder <=> root.remember-last-folder;
                            confirm-delete <=> root.confirm-delete;
                            deletion-mode-idx <=> root.deletion-mode-idx;
                            browse-root-folder => { root.browse-root-folder(); }
                        }

                        if root.active-category == 1 : SettingsPageFolders {
                            auto-reveal-remembered-folder <=> root.auto-reveal-remembered-folder;
                            persist-folder-tree-state <=> root.persist-folder-tree-state;
                            show-deleted-folders <=> root.show-deleted-folders;
                            show-folder-metrics <=> root.show-folder-metrics;
                            show-hidden-folders <=> root.show-hidden-folders;
                            support-dot-hidden-files <=> root.support-dot-hidden-files;
                        }

                        if root.active-category == 2 : SettingsPageAppearance {
                            default-thumb-size <=> root.default-thumb-size;
                            thumb-aspect-idx <=> root.thumb-aspect-idx;
                            show-filenames <=> root.show-filenames;
                            show-rating-badge <=> root.show-rating-badge;
                            show-tag-badge <=> root.show-tag-badge;
                            show-media-type-badges <=> root.show-media-type-badges;
                            show-duration-badge <=> root.show-duration-badge;
                            thumbnail-badge-overflow-idx <=> root.thumbnail-badge-overflow-idx;
                            enable-hover-previews <=> root.enable-hover-previews;
                            enable-tooltips <=> root.enable-tooltips;
                            tooltip-delay-ms <=> root.tooltip-delay-ms;
                            grid-item-padding-h <=> root.grid-item-padding-h;
                            grid-item-padding-v <=> root.grid-item-padding-v;
                            grid-spacing <=> root.grid-spacing;
                            grid-padding <=> root.grid-padding;
                            grid-item-border-width <=> root.grid-item-border-width;
                            grid-item-corner-radius <=> root.grid-item-corner-radius;
                        }

                        if root.active-category == 3 : SettingsPagePerformance {
                            worker-threads <=> root.worker-threads;
                            batch-commit-size <=> root.batch-commit-size;
                            l1-cache-slots <=> root.l1-cache-slots;
                            thumb-db-size <=> root.thumb-db-size;
                            thumb-format-idx <=> root.thumb-format-idx;
                            thumb-quality <=> root.thumb-quality;
                            scaling-algo-idx <=> root.scaling-algo-idx;
                            video-engine-idx <=> root.video-engine-idx;
                            video-offset-percent <=> root.video-offset-percent;
                            short-video-threshold-secs <=> root.short-video-threshold-secs;
                            generate-video-previews <=> root.generate-video-previews;
                            preview-frame-count <=> root.preview-frame-count;
                            custom-preview-settings <=> root.custom-preview-settings;
                            preview-format-idx <=> root.preview-format-idx;
                            preview-quality <=> root.preview-quality;
                        }

                        if root.active-category == 4 : SettingsPageFormats {
                            supported-image-formats: root.supported-image-formats;
                            supported-video-formats: root.supported-video-formats;
                            auto-detect-extensionless <=> root.auto-detect-extensionless;
                        }

                        if root.active-category == 5 : SettingsPageViewer {
                            open-images-in-tab <=> root.open-images-in-tab;
                            allow-multiple-image-tabs <=> root.allow-multiple-image-tabs;
                            open-videos-in-tab <=> root.open-videos-in-tab;
                            allow-multiple-video-tabs <=> root.allow-multiple-video-tabs;
                            show-tab-rating-badge <=> root.viewer-show-tab-rating-badge;
                            background-mode-idx <=> root.viewer-background-mode-idx;
                        }

                        if root.active-category == 6 : SettingsPageFullscreen {
                            display-options: root.display-options;
                            selected-display-idx <=> root.selected-display-idx;
                            enable-specific-monitor <=> root.fullscreen-enable-specific;
                            enable-fallback-rule <=> root.fullscreen-enable-fallback;
                            fallback-target-idx <=> root.fullscreen-fallback-target-idx;
                            media-bar-enabled <=> root.fullscreen-media-bar-enabled;
                            media-bar-show-mute <=> root.fullscreen-media-bar-show-mute;
                            media-bar-show-sticky <=> root.fullscreen-media-bar-show-sticky;
                            media-bar-show-open-as-tab <=> root.fullscreen-media-bar-show-open-as-tab;
                            media-bar-show-remove <=> root.fullscreen-media-bar-show-remove;
                            media-bar-reveal-distance-px <=> root.fullscreen-media-bar-reveal-distance-px;
                            sound-auto-control <=> root.fullscreen-sound-auto-control;
                            sound-follows-idx <=> root.fullscreen-sound-follows-idx;
                            sound-hand-over <=> root.fullscreen-sound-hand-over;
                            background-source-idx <=> root.fullscreen-background-source-idx;
                            background-color <=> root.fullscreen-background-color;
                            refresh-displays => { root.refresh-displays(); }
                            pick-background-color => { root.pick-fullscreen-background(); }
                        }

                        if root.active-category == 7 : SettingsPageTagsRatings {
                            max-history-tags <=> root.max-history-tags;
                        }

                        if root.active-category == 8 : SettingsPageApi {
                            auto-complete-external-stubs <=> root.auto-complete-external-stubs;
                        }

                        if root.active-category == 9 : SettingsPageDebug {
                            obfuscate-logs <=> root.obfuscate-logs;
                        }
                    }
                }
            }

            ButtonBar {
                vertical-stretch: 0;
                show-cancel: true;
                show-save: true;
                cancel-clicked => { root.cancel-clicked(); }
                save-clicked => { root.save-and-apply(); }
            }
        }
    }

    // Tooltips of the options (drawn above everything, they never take the pointer).
    GlobalTooltipLayer {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
    }
}
