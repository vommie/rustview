import { Theme } from "styles.slint";
import { SettingsSidebar } from "settings_sidebar.slint";
import { SettingsPageGeneral } from "settings_page_general.slint";
import { SettingsPageFolders } from "settings_page_folders.slint";
import { SettingsPageAppearance } from "settings_page_appearance.slint";
import { SettingsPagePerformance } from "settings_page_performance.slint";
import { SettingsPagePlayer } from "settings_page_player.slint";
import { SettingsPageTags } from "settings_page_tags.slint";
import { SettingsPageDebug } from "settings_page_debug.slint";
import { ButtonBar } from "button_bar.slint";
import { SmoothScrollArea } from "smooth_scroll_view.slint";

export { SettingsSidebar } from "settings_sidebar.slint";
export { SettingsPageGeneral } from "settings_page_general.slint";
export { SettingsPageFolders } from "settings_page_folders.slint";
export { SettingsPageAppearance } from "settings_page_appearance.slint";
export { SettingsPagePerformance } from "settings_page_performance.slint";
export { SettingsPagePlayer } from "settings_page_player.slint";
export { SettingsPageTags } from "settings_page_tags.slint";
export { SettingsPageDebug } from "settings_page_debug.slint";
export { SettingsCard } from "settings_card.slint";
export { ButtonBar } from "button_bar.slint";
export { SmoothScrollArea } from "smooth_scroll_view.slint";

export component SettingsWindow inherits Window {
    title: "RustView - Settings";
    preferred-width: 860px;
    preferred-height: 640px;
    min-width: 740px;
    min-height: 540px;
    background: Theme.background;

    in-out property <int> active-category: 0;

    // General options
    in-out property <string> root-folder-path: "";
    in-out property <bool> remember-last-folder: true;
    in-out property <bool> confirm-delete: true;
    in-out property <int> deletion-mode-idx: 0;

    // Folders options
    in-out property <bool> auto-reveal-remembered-folder: true;
    in-out property <bool> persist-folder-tree-state: true;
    in-out property <bool> show-deleted-folders: true;
    in-out property <bool> show-folder-metrics: true;
    in-out property <bool> show-hidden-folders: false;
    in-out property <bool> support-dot-hidden-files: true;

    // Appearance options
    in-out property <int> default-thumb-size: 190;
    in-out property <int> thumb-aspect-idx: 1; // 0=1:1, 1=4:3, 2=5:4, 3=16:9, 4=3:4, 5=4:5, 6=9:16
    in-out property <bool> show-filenames: true;
    in-out property <bool> show-rating-badge: true;
    in-out property <bool> show-tag-badge: true;
    in-out property <bool> enable-hover-previews: true;
    in-out property <bool> enable-tooltips: true;
    in-out property <int> tooltip-delay-ms: 750;

    // Performance options
    in-out property <int> worker-threads: 4;
    in-out property <int> batch-commit-size: 32;
    in-out property <int> l1-cache-slots: 512;
    in-out property <int> thumb-db-size: 256;
    in-out property <int> thumb-format-idx: 0; // 0 = WebP, 1 = JPEG
    in-out property <int> thumb-quality: 80;
    in-out property <int> scaling-algo-idx: 0;
    in-out property <int> video-engine-idx: 0; // 0 = FFmpeg, 1 = MPV
    in-out property <int> video-offset-percent: 10;
    in-out property <bool> generate-video-previews: true;
    in-out property <int> preview-frame-count: 5;
    in-out property <bool> custom-preview-settings: true;
    in-out property <int> preview-format-idx: 0; // 0 = WebP, 1 = JPEG
    in-out property <int> preview-quality: 40;

    // Player options
    in-out property <int> hwdec-idx: 0;
    in-out property <bool> autoplay-videos: true;
    in-out property <float> default-volume: 100.0;

    // Debug options
    in-out property <bool> obfuscate-logs: true;

    // Callbacks to Rust backend
    callback browse-root-folder();
    callback save-and-apply();
    callback cancel-clicked();

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        HorizontalLayout {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            padding: 0px;
            spacing: 0px;

            SettingsSidebar {
                active-category <=> root.active-category;
            }

            SmoothScrollArea {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                enable-horizontal: false;
                enable-vertical: true;
                content-width: self.width;
                content-height: page-content.preferred-height;

                page-content := VerticalLayout {
                    padding: 16px;
                    spacing: 16px;
                    alignment: start;

                    if root.active-category == 0 : SettingsPageGeneral {
                        root-folder-path <=> root.root-folder-path;
                        remember-last-folder <=> root.remember-last-folder;
                        confirm-delete <=> root.confirm-delete;
                        deletion-mode-idx <=> root.deletion-mode-idx;
                        browse-root-folder => { root.browse-root-folder(); }
                    }

                    if root.active-category == 1 : SettingsPageFolders {
                        auto-reveal-remembered-folder <=> root.auto-reveal-remembered-folder;
                        persist-folder-tree-state <=> root.persist-folder-tree-state;
                        show-deleted-folders <=> root.show-deleted-folders;
                        show-folder-metrics <=> root.show-folder-metrics;
                        show-hidden-folders <=> root.show-hidden-folders;
                        support-dot-hidden-files <=> root.support-dot-hidden-files;
                    }

                    if root.active-category == 2 : SettingsPageAppearance {
                        default-thumb-size <=> root.default-thumb-size;
                        thumb-aspect-idx <=> root.thumb-aspect-idx;
                        show-filenames <=> root.show-filenames;
                        show-rating-badge <=> root.show-rating-badge;
                        show-tag-badge <=> root.show-tag-badge;
                        enable-hover-previews <=> root.enable-hover-previews;
                        enable-tooltips <=> root.enable-tooltips;
                        tooltip-delay-ms <=> root.tooltip-delay-ms;
                    }

                    if root.active-category == 3 : SettingsPagePerformance {
                        worker-threads <=> root.worker-threads;
                        batch-commit-size <=> root.batch-commit-size;
                        l1-cache-slots <=> root.l1-cache-slots;
                        thumb-db-size <=> root.thumb-db-size;
                        thumb-format-idx <=> root.thumb-format-idx;
                        thumb-quality <=> root.thumb-quality;
                        scaling-algo-idx <=> root.scaling-algo-idx;
                        video-engine-idx <=> root.video-engine-idx;
                        video-offset-percent <=> root.video-offset-percent;
                        generate-video-previews <=> root.generate-video-previews;
                        preview-frame-count <=> root.preview-frame-count;
                        custom-preview-settings <=> root.custom-preview-settings;
                        preview-format-idx <=> root.preview-format-idx;
                        preview-quality <=> root.preview-quality;
                    }

                    if root.active-category == 4 : SettingsPagePlayer {
                        hwdec-idx <=> root.hwdec-idx;
                        autoplay-videos <=> root.autoplay-videos;
                        default-volume <=> root.default-volume;
                    }

                    if root.active-category == 5 : SettingsPageTags {}

                    if root.active-category == 6 : SettingsPageDebug {
                        obfuscate-logs <=> root.obfuscate-logs;
                    }
                }
            }
        }

        ButtonBar {
            vertical-stretch: 0;
            show-cancel: true;
            show-save: true;
            cancel-clicked => { root.cancel-clicked(); }
            save-clicked => { root.save-and-apply(); }
        }
    }
}
