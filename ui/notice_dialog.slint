import { Theme } from "styles.slint";
import { IconId } from "icons.slint";
import { DialogHeading } from "dialog_heading.slint";
import { ButtonBar } from "button_bar.slint";

/// A message with a reason that the user acknowledges (an action was refused or only partly possible).
export component NoticeDialog inherits Window {
    title: root.window-title;
    width: 480px;
    preferred-height: dialog-layout.preferred-height;
    min-height: dialog-layout.preferred-height;
    background: Theme.background;

    in-out property <string> window-title: "RustView";
    in-out property <string> heading: "";
    in-out property <string> message: "";
    /// Lines that belong to the message (file names, reasons); shown apart and empty when there are none.
    in-out property <string> details: "";
    in-out property <string> footnote: "";

    callback acknowledged();

    forward-focus: dialog-focus;

    dialog-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape || event.text == Key.Return {
                root.acknowledged();
                return accept;
            }
            return reject;
        }

        dialog-layout := VerticalLayout {
            width: root.width;
            padding: 0px;
            spacing: 0px;
            alignment: space-between;

            VerticalLayout {
                width: root.width;
                padding: 16px;
                spacing: 12px;
                vertical-stretch: 1;

                DialogHeading {
                    icon: IconId.status-warning;
                    text: root.heading;
                    color: #f9e2af;
                }

                Text {
                    text: root.message;
                    font-size: 12px;
                    color: Theme.text;
                    wrap: word-wrap;
                }

                if root.details != "" : Rectangle {
                    background: Theme.surface-variant;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;

                        Text {
                            text: root.details;
                            font-size: 11px;
                            color: Theme.primary;
                            wrap: word-wrap;
                        }
                    }
                }

                if root.footnote != "" : Text {
                    text: root.footnote;
                    font-size: 11px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
            }

            ButtonBar {
                vertical-stretch: 0;
                bar-height: 48px;
                show-ok: true;
                text-ok: "OK";
                ok-clicked => { root.acknowledged(); }
            }
        }
    }
}
