import { Button } from "std-widgets.slint";
import { Theme } from "styles.slint";

export component DeleteFolderDialog inherits Window {
    title: "RustView - Delete Folder";
    preferred-width: 500px;
    preferred-height: 250px;
    min-width: 440px;
    min-height: 230px;
    background: Theme.background;

    in-out property <string> folder-name: "";
    in-out property <int> subfolders-count: 0;
    in-out property <int> files-count: 0;
    in property <string> error-message: "";

    callback move-to-trash-confirmed();
    callback permanent-delete-confirmed();
    callback cancelled();

    VerticalLayout {
        padding: 0px;
        spacing: 0px;
        alignment: space-between;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            vertical-stretch: 1;

            Text {
                text: "⚠ Delete Folder";
                font-size: 15px;
                font-weight: 700;
                color: #f38ba8;
            }

            Text {
                text: "Are you sure you want to delete the folder '" + root.folder-name + "'?";
                font-size: 12px;
                color: Theme.text;
                wrap: word-wrap;
            }

            Rectangle {
                background: #f38ba818;
                border-radius: 4px;
                border-width: 1px;
                border-color: #f38ba844;

                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;

                    Text {
                        text: "Contents to be deleted:";
                        font-size: 11px;
                        font-weight: 700;
                        color: #f38ba8;
                    }

                    Text {
                        text: "• " + root.subfolders-count + " subfolder(s)\n• " + root.files-count + " media file(s)";
                        font-size: 11px;
                        color: Theme.text;
                    }
                }
            }

            Text {
                text: "This folder and its contents will be completely removed from the library database.";
                font-size: 11px;
                color: Theme.text-muted;
            }

            if root.error-message != "" : Text {
                text: root.error-message;
                font-size: 11px;
                color: #ff5555;
                wrap: word-wrap;
            }
        }

        // Action Buttons Bar
        Rectangle {
            height: 48px;
            background: Theme.surface;
            vertical-stretch: 0;

            Rectangle {
                y: 0px;
                height: 1px;
                background: Theme.border;
            }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 10px;
                alignment: end;

                Button {
                    text: "Cancel";
                    clicked => { root.cancelled(); }
                }

                Button {
                    text: "Permanently Delete";
                    clicked => { root.permanent-delete-confirmed(); }
                }

                Button {
                    text: "Move to Trash";
                    primary: true;
                    clicked => { root.move-to-trash-confirmed(); }
                }
            }
        }
    }
}
