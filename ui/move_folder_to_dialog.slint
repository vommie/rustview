import { Theme } from "styles.slint";
import { ButtonBar } from "button_bar.slint";

export component MoveFolderToDialog inherits Window {
    title: "RustView - Move Folder";
    preferred-width: 480px;
    preferred-height: 230px;
    min-width: 420px;
    min-height: 210px;
    background: Theme.background;

    in-out property <string> source-folder-name: "";
    in-out property <string> target-folder-name: "";
    in-out property <int> subfolders-count: 0;
    in-out property <int> files-count: 0;
    in property <string> error-message: "";

    callback confirmed();
    callback cancelled();

    forward-focus: dialog-focus;

    dialog-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: 0px;
            spacing: 0px;
            alignment: space-between;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                vertical-stretch: 1;

                Text {
                    text: "📦 Move Directory";
                    font-size: 15px;
                    font-weight: 700;
                    color: Theme.primary;
                }

                Text {
                    text: "Move folder '" + root.source-folder-name + "' under destination '" + root.target-folder-name + "'?";
                    font-size: 12px;
                    color: Theme.text;
                    wrap: word-wrap;
                }

                Rectangle {
                    background: Theme.surface-variant;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;

                        Text {
                            text: "Contents to be relocated on disk and in database:";
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.primary;
                        }

                        Text {
                            text: "• " + root.subfolders-count + " subfolder(s)\n• " + root.files-count + " media file(s)";
                            font-size: 11px;
                            color: Theme.text;
                        }
                    }
                }

                if root.error-message != "" : Text {
                    text: root.error-message;
                    font-size: 11px;
                    color: #ff5555;
                    wrap: word-wrap;
                }
            }

            ButtonBar {
                vertical-stretch: 0;
                bar-height: 48px;
                show-cancel: true;
                show-save: true;
                text-save: "Move Folder";
                text-cancel: "Cancel";
                cancel-clicked => { root.cancelled(); }
                save-clicked => { root.confirmed(); }
            }
        }
    }
}
