import { Theme } from "styles.slint";
import { Icons, AppIcon } from "icons.slint";
import { MediaItemView } from "types.slint";
import { SmoothScrollArea } from "smooth_scroll_view.slint";
import { MediaHeaderBar } from "media_header_bar.slint";
import { RubberbandOverlay } from "rubberband_selection.slint";

export component MediaTile inherits Rectangle {
    in property <MediaItemView> item;
    in property <int> thumb-width: 190;
    in property <int> thumb-aspect-idx: 1;
    in property <bool> show-media-type-badges: true;
    in property <length> padding-h: 8px;
    in property <length> padding-v: 6px;
    in property <length> border-width-val: 1px;
    in property <length> corner-radius-val: 4px;

    property <length> item-thumb-w: root.thumb-width * 1px;
    property <length> item-thumb-h: Theme.calculate-thumb-height(root.thumb-width, root.thumb-aspect-idx);

    property <length> tile-width: root.item-thumb-w + (root.padding-h * 2);
    property <length> tile-height: root.item-thumb-h + (root.padding-v * 2) + 22px;

    width: root.tile-width;
    height: root.tile-height;

    // Strict State Priority: Selected > Deleted > Corrupted > Normal
    background: item.is-selected ? Theme.surface-selected : (
        tile-touch.has-hover ? Theme.surface-hover : (
            item.is-deleted ? #31324440 : (
                item.is-corrupted ? #f38ba812 : Theme.surface
            )
        )
    );

    border-width: item.is-selected ? Math.max(2px, root.border-width-val + 1px) : (
        (item.is-deleted || item.is-corrupted) ? Math.max(1.5px, root.border-width-val) : root.border-width-val
    );

    border-color: item.is-selected ? Theme.primary : (
        item.is-deleted ? #6c7086 : (
            item.is-corrupted ? #f38ba8 : (root.border-width-val > 0px ? Theme.border : transparent)
        )
    );

    border-radius: root.corner-radius-val;
    clip: true;

    callback clicked(bool /* is_ctrl */, bool /* is_shift */);
    callback middle-clicked();
    callback context-menu-requested(length /* x */, length /* y */);
    callback hover-changed(bool /* is_hover */);
    callback drag-started(int /* id */, length /* local_x */, length /* local_y */);
    callback drag-moved(length /* local_x */, length /* local_y */);
    callback drag-ended();

    property <bool> is-hovered: tile-touch.has-hover;
    changed is-hovered => {
        // Trigger hover animation for both videos and animated GIFs
        if item.is-video || item.format-str == "gif" {
            root.hover-changed(self.is-hovered);
        }
    }

    tile-touch := TouchArea {
        property <length> press-x: 0px;
        property <length> press-y: 0px;
        property <bool> is-drag-active: false;
        property <bool> was-already-selected: false;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                if event.button == PointerEventButton.left {
                    self.press-x = self.mouse-x;
                    self.press-y = self.mouse-y;
                    self.is-drag-active = false;
                    self.was-already-selected = item.is-selected;

                    if !item.is-selected || event.modifiers.control || event.modifiers.meta || event.modifiers.shift {
                        root.clicked(event.modifiers.control || event.modifiers.meta, event.modifiers.shift);
                    }
                } else if event.button == PointerEventButton.right {
                    root.context-menu-requested(self.mouse-x, self.mouse-y);
                } else if event.button == PointerEventButton.middle {
                    root.middle-clicked();
                }
            }
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                if self.is-drag-active {
                    self.is-drag-active = false;
                    root.drag-ended();
                } else {
                    if self.was-already-selected && !event.modifiers.control && !event.modifiers.meta && !event.modifiers.shift {
                        root.clicked(false, false);
                    }
                }
            }
        }

        moved => {
            if self.pressed && !self.is-drag-active {
                let dx = self.mouse-x - self.press-x;
                let dy = self.mouse-y - self.press-y;
                if (dx * dx + dy * dy) > 25px * 1px {
                    self.is-drag-active = true;
                    root.drag-started(item.id, self.mouse-x, self.mouse-y);
                }
            }
            if self.is-drag-active {
                root.drag-moved(self.mouse-x, self.mouse-y);
            }
        }
    }

    VerticalLayout {
        padding-left: root.padding-h;
        padding-right: root.padding-h;
        padding-top: root.padding-v;
        padding-bottom: root.padding-v;
        spacing: 4px;
        alignment: center;

        Rectangle {
            width: root.item-thumb-w;
            height: root.item-thumb-h;
            background: item.is-deleted ? #1e1e2e : (item.is-corrupted ? #2d161d : #000000);
            border-radius: Math.max(0px, root.corner-radius-val - 2px);
            clip: true;

            if item.thumbnail.width > 0 : Image {
                source: item.thumbnail;
                width: 100%;
                height: 100%;
                image-fit: contain;
                opacity: item.is-deleted ? 0.45 : (item.is-corrupted ? 0.70 : 1.0);
            }

            // Fallback Vector SVG icon when no thumbnail image exists (Priority: Deleted > Corrupted > Default)
            if item.thumbnail.width == 0 : Rectangle {
                width: 100%;
                height: 100%;
                background: transparent;

                if item.is-deleted : AppIcon {
                    icon: Icons.media-file-missing;
                    allow-tint: true;
                    color: #6c7086;
                    size: Math.min(48px, root.item-thumb-h - 16px);
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                if !item.is-deleted && item.is-corrupted : AppIcon {
                    icon: Icons.media-file-corrupted;
                    allow-tint: true;
                    color: #f38ba8;
                    size: Math.min(48px, root.item-thumb-h - 16px);
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                if !item.is-deleted && !item.is-corrupted : Text {
                    text: "📄";
                    font-size: 32px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Top-Right Rating Badge: Always visible whenever item has rating > 0
            if item.rating > 0 : Rectangle {
                x: parent.width - 20px;
                y: 4px;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: Theme.rating-color(item.rating);

                Text {
                    text: item.rating;
                    font-size: 10px;
                    font-weight: 700;
                    color: #000000;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Top-Left Tag Badge: Always visible whenever item has assigned tags
            if item.has-tags : Rectangle {
                x: 4px;
                y: 4px;
                width: 14px;
                height: 14px;

                AppIcon {
                    icon: Icons.tag;
                    allow-tint: false;
                    size: 14px;
                }
            }

            // Bottom Media Type / Status Badges (Strictly guarded by show_media_type_badges, Priority: Deleted > Corrupted > Type)
            if root.show-media-type-badges : Rectangle {
                x: 4px;
                y: parent.height - 18px;
                width: (item.is-deleted || item.is-corrupted) ? 48px : ((item.format-str == "gif") ? 28px : 32px);
                height: 14px;
                background: item.is-deleted ? #6c7086cc : (item.is-corrupted ? #f38ba8cc : #000000aa);
                border-radius: 2px;

                Text {
                    text: item.is-deleted ? "DELETED" : (
                        item.is-corrupted ? "CORRUPT" : (
                            item.is-video ? "VIDEO" : (
                                item.format-str == "gif" ? "GIF" : "IMAGE"
                            )
                        )
                    );
                    font-size: 8px;
                    font-weight: 700;
                    color: (item.is-deleted || !item.is-corrupted) ? #ffffff : #11111b;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Text {
            text: item.filename;
            color: item.is-selected ? Theme.primary : (
                item.is-deleted ? #6c7086 : (
                    item.is-corrupted ? #f38ba8 : Theme.text
                )
            );
            font-size: 11px;
            font-weight: item.is-selected ? 700 : 400;
            font-italic: item.is-deleted;
            horizontal-alignment: center;
            overflow: elide;
            height: 18px;
        }
    }
}

export component VirtualizedMediaGrid inherits Rectangle {
    background: Theme.background;
    clip: true;

    in property <[MediaItemView]> media-items: [];
    in property <int> visible-start-index: 0;
    in property <int> total-items-count: 0;

    in property <int> thumb-size: 190;
    in property <int> thumb-aspect-idx: 1;
    in property <int> sort-column: 0;
    in property <int> sort-order: 0;

    in property <bool> show-media-type-badges: true;
    in property <int> grid-item-padding-h: 8;
    in property <int> grid-item-padding-v: 6;
    in property <int> grid-spacing-val: 12;
    in property <int> grid-padding-val: 12;
    in property <int> grid-item-border-width: 1;
    in property <int> grid-item-corner-radius: 4;

    // Rubberband selection state properties
    in property <bool> rubberband-active: false;
    in property <length> rubberband-x: 0px;
    in property <length> rubberband-y: 0px;
    in property <length> rubberband-width: 0px;
    in property <length> rubberband-height: 0px;

    property <length> grid-padding: root.grid-padding-val * 1px;
    property <length> grid-spacing: root.grid-spacing-val * 1px;
    property <length> item-padding-h: root.grid-item-padding-h * 1px;
    property <length> item-padding-v: root.grid-item-padding-v * 1px;
    property <length> border-w: root.grid-item-border-width * 1px;
    property <length> corner-r: root.grid-item-corner-radius * 1px;
    property <length> scrollbar-gutter-reserve: 16px;

    property <length> item-thumb-w: root.thumb-size * 1px;
    property <length> item-thumb-h: Theme.calculate-thumb-height(root.thumb-size, root.thumb-aspect-idx);

    property <length> item-tile-width: root.item-thumb-w + (root.item-padding-h * 2);
    property <length> item-tile-height: root.item-thumb-h + (root.item-padding-v * 2) + 22px;
    property <length> column-stride: root.item-tile-width + root.grid-spacing;
    property <length> row-stride: root.item-tile-height + root.grid-spacing;

    property <length> available-width: Math.max(0px, self.width - (root.grid-padding * 2) - root.scrollbar-gutter-reserve + root.grid-spacing);
    out property <int> columns: Math.max(1, Math.floor(root.available-width / Math.max(1px, root.column-stride)));

    property <int> total-rows: Math.ceil(root.total-items-count / root.columns);
    property <length> total-content-height: (root.total-rows * root.row-stride) + (2 * root.grid-padding);

    property <int> pool-rows-count: Math.min(root.total-rows, Math.ceil(scroll-area.height / Math.max(1px, root.row-stride)) + 6);
    property <int> first-visible-row: Math.max(0, Math.floor(-scroll-area.clamped-y / Math.max(1px, root.row-stride)));
    property <int> scroll-block: Math.floor(-scroll-area.clamped-y / Math.max(1px, root.row-stride * 2));

    callback item-clicked(int /* id */, bool /* ctrl */, bool /* shift */);
    callback item-middle-clicked(int /* id */);
    callback item-context-menu(int /* id */, length /* x */, length /* y */);
    callback sort-clicked(int /* column_index */);
    callback background-clicked();
    callback item-hover-changed(int /* id */, bool /* is_hover */);
    callback visible-chunk-changed(int /* first_item */, int /* last_item */, int /* total */);

    callback item-drag-started(int /* id */, length /* x */, length /* y */);
    callback item-drag-moved(length /* x */, length /* y */);
    callback item-drag-ended();

    // Rubberband selection callbacks
    callback rubberband-started(length /* start_content_x */, length /* start_content_y */, length /* view_x */, length /* view_y */, bool /* ctrl */, bool /* shift */);
    callback rubberband-moved(length /* content_x */, length /* content_y */, length /* view_x */, length /* view_y */);
    callback rubberband-ended();

    public function scroll-to-top() {
        scroll-area.scroll-to-top();
    }

    public function scroll-to-index(item-idx: int) {
        if root.columns > 0 {
            let target-row = Math.floor(item-idx / root.columns);
            let target-y = -(target-row * root.row-stride);
            scroll-area.viewport-y = target-y;
        }
    }

    public function scroll-by(dy: length) {
        scroll-area.handle-scroll(0px, dy);
    }

    pure public function get-viewport-y() -> length {
        return scroll-area.clamped-y;
    }

    pure public function get-top-visible-index() -> int {
        return root.first-visible-row * root.columns;
    }

    changed scroll-block => {
        let first-item = self.scroll-block * 2 * root.columns;
        let last-item = Math.min(root.total-items-count, first-item + (root.pool-rows-count * root.columns));
        root.visible-chunk-changed(first-item, last-item, root.total-items-count);
    }

    changed columns => {
        let first-item = self.scroll-block * 2 * root.columns;
        let last-item = Math.min(root.total-items-count, first-item + (root.pool-rows-count * root.columns));
        root.visible-chunk-changed(first-item, last-item, root.total-items-count);
    }

    changed pool-rows-count => {
        let first-item = self.scroll-block * 2 * root.columns;
        let last-item = Math.min(root.total-items-count, first-item + (root.pool-rows-count * root.columns));
        root.visible-chunk-changed(first-item, last-item, root.total-items-count);
    }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        MediaHeaderBar {
            sort-column: root.sort-column;
            sort-order: root.sort-order;
            enable-resize: false;
            auto-width: true;
            sort-clicked(idx) => { root.sort-clicked(idx); }
        }

        scroll-area := SmoothScrollArea {
            vertical-stretch: 1;
            enable-horizontal: false;
            enable-vertical: true;
            content-width: self.width;
            content-height: root.total-content-height;

            bg-touch := TouchArea {
                width: 100%;
                height: 100%;

                property <length> press-x: 0px;
                property <length> press-y: 0px;
                property <bool> is-rubberband-active: false;
                property <bool> press-ctrl: false;
                property <bool> press-shift: false;

                scroll-event(event) => {
                    scroll-area.handle-scroll(event.delta-x, event.delta-y);
                    return accept;
                }

                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        self.press-x = self.mouse-x;
                        self.press-y = self.mouse-y;
                        self.is-rubberband-active = false;
                        self.press-ctrl = event.modifiers.control || event.modifiers.meta;
                        self.press-shift = event.modifiers.shift;
                    }
                    if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                        if self.is-rubberband-active {
                            self.is-rubberband-active = false;
                            root.rubberband-ended();
                        } else {
                            root.background-clicked();
                        }
                    }
                }

                moved => {
                    if self.pressed {
                        let dx = self.mouse-x - self.press-x;
                        let dy = self.mouse-y - self.press-y;
                        let dist-sq = (dx * dx) + (dy * dy);

                        if !self.is-rubberband-active && dist-sq > 16px * 1px {
                            self.is-rubberband-active = true;
                            let start-content-x = self.press-x;
                            let start-content-y = self.press-y;
                            let start-view-x = self.press-x;
                            let start-view-y = self.press-y + scroll-area.clamped-y;
                            root.rubberband-started(
                                start-content-x,
                                start-content-y,
                                start-view-x,
                                start-view-y,
                                self.press-ctrl,
                                self.press-shift
                            );
                        }

                        if self.is-rubberband-active {
                            let cur-content-x = self.mouse-x;
                            let cur-content-y = self.mouse-y;
                            let cur-view-x = self.mouse-x;
                            let cur-view-y = self.mouse-y + scroll-area.clamped-y;
                            root.rubberband-moved(cur-content-x, cur-content-y, cur-view-x, cur-view-y);
                        }
                    }
                }
            }

            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: root.total-content-height;

                for item[idx] in root.media-items: MediaTile {
                    property <int> global-idx: root.visible-start-index + idx;
                    property <int> r-idx: Math.floor(self.global-idx / root.columns);
                    property <int> c-idx: Math.mod(self.global-idx, root.columns);

                    x: root.grid-padding + (self.c-idx * root.column-stride);
                    y: root.grid-padding + (self.r-idx * root.row-stride);
                    width: root.item-tile-width;
                    height: root.item-tile-height;

                    item: item;
                    thumb-width: root.thumb-size;
                    thumb-aspect-idx: root.thumb-aspect-idx;
                    show-media-type-badges: root.show-media-type-badges;
                    padding-h: root.item-padding-h;
                    padding-v: root.item-padding-v;
                    border-width-val: root.border-w;
                    corner-radius-val: root.corner-r;

                    clicked(ctrl, shift) => { root.item-clicked(self.item.id, ctrl, shift); }
                    middle-clicked => { root.item-middle-clicked(self.item.id); }
                    hover-changed(hover) => { root.item-hover-changed(self.item.id, hover); }
                    context-menu-requested(mx, my) => {
                        root.item-context-menu(
                            self.item.id,
                            self.x + mx,
                            28px + self.y + my + scroll-area.clamped-y
                        );
                    }
                    drag-started(id, mx, my) => {
                        root.item-drag-started(
                            id,
                            self.x + mx,
                            28px + self.y + my + scroll-area.clamped-y
                        );
                    }
                    drag-moved(mx, my) => {
                        root.item-drag-moved(
                            self.x + mx,
                            28px + self.y + my + scroll-area.clamped-y
                        );
                    }
                    drag-ended => {
                        root.item-drag-ended();
                    }
                }

                // Visual Rubberband Selection Rectangle (in Content Space)
                RubberbandOverlay {
                    is-active: root.rubberband-active;
                    rect-x: root.rubberband-x;
                    rect-y: root.rubberband-y;
                    rect-width: root.rubberband-width;
                    rect-height: root.rubberband-height;
                }
            }
        }
    }
}
