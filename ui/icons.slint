import { Theme } from "styles.slint";
import { IconId, IconRegistry } from "icon_registry.slint";

// `IconId` / `IconRegistry` are generated by build.rs from assets/icons/icons.toml (the single source of truth
// for all icons). Re-export them so the rest of the UI only ever imports from this file.
export { IconId, IconRegistry }

/// Standard icon sizes in logical pixels. Icons are Tabler SVGs on a 24px grid: they are sharpest at 24px
/// (2px strokes) and stay crisp at the sizes below because `AppIcon` snaps them to whole physical pixels.
export global IconSize {
    out property <length> xs: 12px;
    out property <length> sm: 14px;
    out property <length> md: 16px;
    out property <length> lg: 20px;
    out property <length> xl: 24px;
    out property <length> xxl: 48px;
}

/// Semantic helpers that map domain values to icons.
export global IconLookup {
    /// Rating badge icon for a rating value (0..5); out-of-range values fall back to the unrated badge.
    pure public function rating(rating: int) -> IconId {
        if rating == 1 { return IconId.rating-1; }
        if rating == 2 { return IconId.rating-2; }
        if rating == 3 { return IconId.rating-3; }
        if rating == 4 { return IconId.rating-4; }
        if rating == 5 { return IconId.rating-5; }
        return IconId.rating-0;
    }
}

/// Themed vector icon. Monochrome icons are tinted with `color`; colored icons (tag, ratings) keep their own
/// colors (decided by the manifest, not by the caller).
///
/// Crisp rendering: Slint rasterizes SVGs at the exact physical size of the `Image` item. That only yields
/// pixel-exact edges if the item's size AND position are whole physical pixels, so this component
///   * rounds `size` to whole physical pixels (any scale factor), and
///   * compensates fractional layout positions (e.g. `(parent.height - self.height) / 2` = 4.5px) by
///     offsetting the inner image to the nearest physical pixel.
/// Do not put `opacity` on an icon (it forces an offscreen layer); use a color with alpha instead.
export component AppIcon {
    in property <IconId> icon: IconId.none;
    in property <color> color: Theme.text;
    in property <length> size: IconSize.md;

    property <length> snapped-size: Math.max(1, Math.round(root.size / 1phx)) * 1phx;
    property <length> abs-x: root.absolute-position.x;
    property <length> abs-y: root.absolute-position.y;

    width: root.snapped-size;
    height: root.snapped-size;

    Image {
        x: Math.round(root.abs-x / 1phx) * 1phx - root.abs-x;
        y: Math.round(root.abs-y / 1phx) * 1phx - root.abs-y;
        width: root.snapped-size;
        height: root.snapped-size;
        source: IconRegistry.source(root.icon);
        image-fit: contain;
        colorize: IconRegistry.is-tinted(root.icon) ? root.color : transparent;
    }
}

/// Layout-friendly icon cell for rows (menus, tabs, list items, toolbar buttons). A fixed-size item inside a
/// horizontal layout is placed at the TOP of the row by Slint; this cell instead stretches to the row height
/// and centers the icon vertically and horizontally. `slot-width` reserves horizontal space (default: the icon
/// size); set it larger than `size` to keep label columns aligned even when no icon is shown.
export component IconSlot {
    in property <IconId> icon: IconId.none;
    in property <color> color: Theme.text;
    in property <length> size: IconSize.md;
    in property <length> slot-width: root.size;

    width: root.slot-width;
    horizontal-stretch: 0;

    if root.icon != IconId.none : AppIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: root.icon;
        size: root.size;
        color: root.color;
    }
}
