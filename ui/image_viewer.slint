import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { Throbber } from "throbber.slint";

export component ImageViewer inherits Rectangle {
    in property <image> source-image;
    in property <bool> is-loading: false;
    in property <string> error-message: "";
    in property <int> background-mode: 0; // 0 = Dark Theme (#11111b), 1 = Deep Black (#000000), 2 = Checkerboard
    in property <bool> is-video: false;

    callback next-image();
    callback previous-image();
    callback image-clicked();
    callback image-middle-clicked();
    callback viewport-geometry-changed(length /* x */, length /* y */, length /* width */, length /* height */);

    background: root.background-mode == 1 ? #000000 : (root.background-mode == 2 ? #1e1e2e : #11111b);
    clip: true;

    changed width => {
        if root.is-video && root.error-message == "" {
            root.viewport-geometry-changed(root.x, root.y, root.width, root.height);
        }
    }

    changed height => {
        if root.is-video && root.error-message == "" {
            root.viewport-geometry-changed(root.x, root.y, root.width, root.height);
        }
    }

    viewer-touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: !root.is-video || root.error-message != "";

        scroll-event(event) => {
            if event.delta-y < 0px {
                root.next-image();
                return accept;
            }
            if event.delta-y > 0px {
                root.previous-image();
                return accept;
            }
            return reject;
        }

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                if event.button == PointerEventButton.left {
                    root.image-clicked();
                } else if event.button == PointerEventButton.middle {
                    root.image-middle-clicked();
                }
            }
        }
    }

    if root.background-mode == 2 : Rectangle {
        width: 100%;
        height: 100%;
        background: #181825;
        opacity: 0.5;
    }

    if !root.is-video && root.source-image.width > 0 && !root.is-loading && root.error-message == "" : Image {
        source: root.source-image;
        width: 100%;
        height: 100%;
        image-fit: contain;
    }

    // Video Viewport Area: Solid black background ensures Slint's OpenGL canvas is 100% opaque.
    // When XShape cutouts punch through the MPV window, Slint's opaque background and menus are revealed,
    // guaranteeing the desktop never shines through.
    if root.is-video && root.error-message == "" : Rectangle {
        width: 100%;
        height: 100%;
        background: #000000;
    }

    if root.is-loading && root.error-message == "" : VerticalLayout {
        alignment: center;
        spacing: 12px;

        HorizontalLayout {
            alignment: center;
            Throbber {
                is-active: true;
                size: 32px;
                throbber-color: Theme.primary;
            }
        }

        Text {
            text: root.is-video ? "Initializing video player..." : "Loading high-resolution image...";
            font-size: 12px;
            color: Theme.text-muted;
            horizontal-alignment: center;
        }
    }

    if root.error-message != "" && !root.is-loading : VerticalLayout {
        alignment: center;
        spacing: 12px;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 64px;
                height: 64px;
                border-radius: 32px;
                background: Theme.corrupt-bg;
                border-width: 1px;
                border-color: #f38ba844;

                AppIcon {
                    icon: IconId.status-warning;
                    size: IconSize.xxl;
                    color: Theme.status-corrupt;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        Text {
            text: "File Not Found on Disk";
            font-size: 15px;
            font-weight: 700;
            color: Theme.status-corrupt;
            horizontal-alignment: center;
        }

        Text {
            text: root.error-message;
            font-size: 12px;
            color: Theme.text-muted;
            horizontal-alignment: center;
            wrap: word-wrap;
            max-width: 500px;
        }
    }
}
