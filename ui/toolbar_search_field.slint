import { LineEdit } from "std-widgets.slint";
import { Theme } from "styles.slint";

/// Standalone compact search input field tailored specifically for panel toolbars.
export component ToolbarSearchField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text: "Filter...";
    in property <length> field-width: 150px;

    callback search-changed(string);
    callback accepted(string);

    width: root.field-width;
    height: 100%;
    background: transparent;

    input := LineEdit {
        width: 100%;
        height: 100%;
        placeholder-text: root.placeholder-text;
        edited(t) => { root.search-changed(t); }
        accepted(t) => { root.accepted(t); }
    }
}
