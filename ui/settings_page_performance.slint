import { Slider, Button, ComboBox, CheckBox } from "std-widgets.slint";
import { Theme } from "styles.slint";
import { SettingsCard } from "settings_card.slint";

export component SettingsPagePerformance inherits VerticalLayout {
    spacing: 12px;

    in-out property <int> worker-threads: 4;
    in-out property <int> batch-commit-size: 32;
    in-out property <int> l1-cache-slots: 512;
    in-out property <int> thumb-db-size: 256;
    in-out property <int> thumb-format-idx: 0; // 0 = WebP, 1 = JPEG
    in-out property <int> thumb-quality: 80;
    in-out property <int> scaling-algo-idx: 0; // 0 = CatmullRom, 1 = Bilinear, 2 = Lanczos3, 3 = Nearest
    in-out property <int> video-engine-idx: 0; // 0 = FFmpeg, 1 = MPV
    in-out property <int> video-offset-percent: 10;
    in-out property <int> short-video-threshold-secs: 10;
    in-out property <bool> generate-video-previews: true;
    in-out property <int> preview-frame-count: 5;
    in-out property <bool> custom-preview-settings: true;
    in-out property <int> preview-format-idx: 0; // 0 = WebP, 1 = JPEG
    in-out property <int> preview-quality: 40;

    // Card 1: Threading & Concurrency
    SettingsCard {
        title: "Concurrency & Multiprocessing Architecture";
        description: "Configure background thread pools and batched transactional commits to maximize CPU throughput across multiple cores.";

        HorizontalLayout {
            Text {
                text: "Rayon Worker Threads:";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Slider {
                width: 150px;
                minimum: 1;
                maximum: 32;
                value: root.worker-threads;
                changed(v) => { root.worker-threads = Math.round(v); }
            }
            Text {
                text: root.worker-threads + " threads";
                color: Theme.primary;
                width: 75px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        HorizontalLayout {
            Text {
                text: "LMDB Batch Commit Size:";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Slider {
                width: 150px;
                minimum: 8;
                maximum: 128;
                value: root.batch-commit-size;
                changed(v) => { root.batch-commit-size = Math.round(v); }
            }
            Text {
                text: root.batch-commit-size + " items";
                color: Theme.primary;
                width: 75px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }
    }

    // Card 2: L1 In-Memory RAM Cache
    SettingsCard {
        title: "L1 In-Memory RAM Cache";
        description: "Uncompressed thumbnails are retained in physical RAM for instant, stutter-free 60 FPS scrolling and zero disk latency.";

        HorizontalLayout {
            Text {
                text: "L1 Cache Capacity:";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Slider {
                width: 150px;
                minimum: 100;
                maximum: 4000;
                value: root.l1-cache-slots;
                changed(v) => { root.l1-cache-slots = Math.round(v); }
            }
            Text {
                text: root.l1-cache-slots + " slots";
                color: Theme.primary;
                width: 75px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }
    }

    // Card 3: Database Thumbnail Storage & Encoding
    SettingsCard {
        title: "Database Thumbnail Storage & Encoding";
        description: "Configure how thumbnails are resized, encoded, and persisted in binary L2 PackStore containers. Exact aspect ratios are preserved without letterbox borders.";

        HorizontalLayout {
            Text {
                text: "Target DB Bounding Size:";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Slider {
                width: 150px;
                minimum: 128;
                maximum: 512;
                value: root.thumb-db-size;
                changed(v) => { root.thumb-db-size = Math.round(v / 64) * 64; }
            }
            Text {
                text: root.thumb-db-size + " px";
                color: Theme.primary;
                width: 75px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Storage Format:";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Button {
                text: "WebP";
                primary: root.thumb-format-idx == 0;
                clicked => { root.thumb-format-idx = 0; }
            }

            Button {
                text: "JPEG";
                primary: root.thumb-format-idx == 1;
                clicked => { root.thumb-format-idx = 1; }
            }
        }

        HorizontalLayout {
            Text {
                text: "Compression Quality:";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Slider {
                width: 150px;
                minimum: 10;
                maximum: 100;
                value: root.thumb-quality;
                changed(v) => { root.thumb-quality = Math.round(v); }
            }
            Text {
                text: root.thumb-quality + "%";
                color: Theme.primary;
                width: 75px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Scaling Algorithm:";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            ComboBox {
                width: 200px;
                model: ["Bicubic (CatmullRom)", "Bilinear (Triangle)", "Lanczos3", "Nearest"];
                current-index <=> root.scaling-algo-idx;
            }
        }
    }

    // Card 4: Video Thumbnailing & Previews
    SettingsCard {
        title: "Video Thumbnailing & Previews";
        description: "Specify the backend video decoding library, extraction timestamp offset, short video handling threshold, and multi-frame preview animation generation.";

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Video Extraction Engine:";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            ComboBox {
                width: 200px;
                model: ["FFmpeg (High Performance)", "MPV (libmpv Engine)"];
                current-index <=> root.video-engine-idx;
            }
        }

        HorizontalLayout {
            Text {
                text: "Primary Thumbnail Position Offset:";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Slider {
                width: 150px;
                minimum: 1;
                maximum: 90;
                value: root.video-offset-percent;
                changed(v) => { root.video-offset-percent = Math.round(v); }
            }
            Text {
                text: root.video-offset-percent + "%";
                color: Theme.primary;
                width: 75px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        HorizontalLayout {
            Text {
                text: "Short Video Threshold (Linear Scan):";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Slider {
                width: 150px;
                minimum: 1;
                maximum: 60;
                value: root.short-video-threshold_secs;
                changed(v) => { root.short-video-threshold-secs = Math.round(v); }
            }
            Text {
                text: root.short-video-threshold-secs + " s";
                color: Theme.primary;
                width: 75px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        CheckBox {
            text: "Generate multi-frame previews for hover animation";
            checked <=> root.generate-video-previews;
        }

        if root.generate-video-previews : HorizontalLayout {
            Text {
                text: "Preview Frame Count (10%-90% split):";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Slider {
                width: 150px;
                minimum: 2;
                maximum: 100;
                value: root.preview-frame-count;
                changed(v) => { root.preview-frame-count = Math.round(v); }
            }
            Text {
                text: root.preview-frame-count + " frames";
                color: Theme.primary;
                width: 75px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        if root.generate-video-previews : CheckBox {
            text: "Use dedicated compression settings for previews";
            checked <=> root.custom-preview-settings;
        }

        if root.generate-video-previews && root.custom-preview-settings : HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Preview Storage Format:";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Button {
                text: "WebP";
                primary: root.preview-format-idx == 0;
                clicked => { root.preview-format-idx = 0; }
            }

            Button {
                text: "JPEG";
                primary: root.preview-format-idx == 1;
                clicked => { root.preview-format-idx = 1; }
            }
        }

        if root.generate-video-previews && root.custom-preview-settings : HorizontalLayout {
            Text {
                text: "Preview Compression Quality:";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Slider {
                width: 150px;
                minimum: 10;
                maximum: 100;
                value: root.preview-quality;
                changed(v) => { root.preview-quality = Math.round(v); }
            }
            Text {
                text: root.preview-quality + "%";
                color: Theme.primary;
                width: 75px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }
    }
}
