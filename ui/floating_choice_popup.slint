import { Button } from "std-widgets.slint";
import { Theme } from "styles.slint";

/// Compact, generic, modular Floating Choice Popup anchored at drop targets.
export component FloatingChoicePopup inherits Rectangle {
    in property <string> target-folder-name: "";
    in property <int> item-count: 1;
    in property <length> pos-x: 0px;
    in property <length> pos-y: 0px;

    callback copy-clicked();
    callback move-clicked();
    callback cancel-clicked();
    callback dismissed();

    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    z: 150;

    // Transparent backdrop dismissing the menu on outside clicks without side-effects
    backdrop := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.dismissed();
            }
        }
    }

    // Anchored Menu Box
    popup-box := Rectangle {
        property <length> popup-w: Math.max(240px, popup-layout.preferred-width);
        property <length> popup-h: popup-layout.preferred-height;

        x: Math.max(8px, Math.min(parent.width - self.popup-w - 8px, root.pos-x));
        y: Math.max(8px, Math.min(parent.height - self.popup-h - 8px, root.pos-y));
        width: self.popup-w;
        height: self.popup-h;
        background: Theme.surface;
        border-radius: 6px;
        border-width: 1.5px;
        border-color: Theme.primary;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000cc;
        drop-shadow-offset-y: 4px;

        popup-layout := VerticalLayout {
            padding: 8px;
            spacing: 6px;

            // Target Header Indicator
            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                Text {
                    text: "📁";
                    font-size: 13px;
                    vertical-alignment: center;
                }

                Text {
                    text: (root.item-count > 1 ? (root.item-count + " Files ➔ ") : "1 File ➔ ") + root.target-folder-name;
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.primary;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            // Compact Horizontal Action Buttons (Equal visual weight, no primary button)
            HorizontalLayout {
                spacing: 6px;
                alignment: center;

                Button {
                    text: "Copy";
                    height: 26px;
                    clicked => { root.copy-clicked(); }
                }

                Button {
                    text: "Move";
                    height: 26px;
                    clicked => { root.move-clicked(); }
                }

                Button {
                    text: "Cancel";
                    height: 26px;
                    clicked => { root.cancel-clicked(); }
                }
            }
        }
    }
}
