import { Theme } from "styles.slint";
import { ButtonBar } from "button_bar.slint";

export component MissingFolderDeleteDialog inherits Window {
    title: "RustView - Folder Not Found on Disk";
    preferred-width: 520px;
    preferred-height: 270px;
    min-width: 450px;
    min-height: 240px;
    background: Theme.background;

    in-out property <string> folder-name: "";
    in-out property <string> folder-path: "";
    in-out property <int> subfolders-count: 0;
    in-out property <int> files-count: 0;
    in property <string> error-message: "";

    callback clean-confirmed();
    callback cancelled();

    VerticalLayout {
        padding: 0px;
        spacing: 0px;
        alignment: space-between;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            vertical-stretch: 1;

            Text {
                text: "⚠ Folder Not Found on Disk";
                font-size: 15px;
                font-weight: 700;
                color: #fab387;
            }

            Text {
                text: "The folder '" + root.folder-name + "' could not be found on physical storage:";
                font-size: 12px;
                color: Theme.text;
                wrap: word-wrap;
            }

            Text {
                text: root.folder-path;
                font-size: 11px;
                font-italic: true;
                color: Theme.text-muted;
                wrap: word-wrap;
            }

            Rectangle {
                background: #fab38718;
                border-radius: 4px;
                border-width: 1px;
                border-color: #fab38744;

                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;

                    Text {
                        text: "Database records available for cleanup:";
                        font-size: 11px;
                        font-weight: 700;
                        color: #fab387;
                    }

                    Text {
                        text: "• " + root.subfolders-count + " subfolder record(s)\n• " + root.files-count + " media file & thumbnail record(s)";
                        font-size: 11px;
                        color: Theme.text;
                    }
                }
            }

            Text {
                text: "Since the folder is missing from disk, it cannot be moved to trash. Would you like to clean its records from the database instead?";
                font-size: 11px;
                color: Theme.text-muted;
                wrap: word-wrap;
            }

            if root.error-message != "" : Text {
                text: root.error-message;
                font-size: 11px;
                color: #ff5555;
                wrap: word-wrap;
            }
        }

        ButtonBar {
            vertical-stretch: 0;
            bar-height: 48px;
            show-cancel: true;
            show-save: true;
            text-save: "Clean from Database";
            text-cancel: "Cancel";
            cancel-clicked => { root.cancelled(); }
            save-clicked => { root.clean-confirmed(); }
        }
    }
}
