import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";

/// The zoom slider that hangs below the media bar of an image (inside the speech bubble of `MultiviewBarMenu`).
///
/// The reset (100%) is in the middle, zooming in is to the right, zooming out to the left; both halves are logarithmic (the
/// same distance is the same factor). A thin line from the middle to the handle shows which way the zoom went, small ticks mark
/// the points the handle snaps to (the snapping itself is done by Rust, which answers with the snapped value at once). The
/// percentage appears above the handle while the pointer is over the slider. The mouse wheel over it steps (5%, Shift 10%,
/// Ctrl 25%), the buttons at its ends step once, a double click on the track or a click on the middle tick resets.
///
/// Every movement is reported as a number that crosses the Slint boundary (`BarClick::from_code` on the Rust side):
/// `4000000 + position * 10000` for the handle (position 0..1), `2000000 + 1/2/4` for up / Shift / Ctrl steps, `3000000` for the
/// reset.
export component MultiviewZoomSlider inherits Rectangle {
    // Tenths of a percent: 1000 = 100%.
    in property <int> value-permille: 1000;
    in property <int> min-permille: 100;
    in property <int> max-permille: 10000;
    in property <[int]> snaps: [];

    callback request(int /* code */);

    out property <length> content-height: 46px;

    property <length> pad: 10px;
    property <length> button: 20px;
    property <length> gap: 6px;
    property <length> handle-size: 14px;
    property <length> center-y: 31px;
    property <length> track-x: root.pad + root.button + root.gap;
    property <length> track-w: Math.max(root.width - 2 * (root.pad + root.button + root.gap), 20px);
    property <float> wheel-acc: 0;
    property <bool> dragging: false;
    property <float> position: root.pos-of(root.value-permille);
    property <bool> active: track-touch.has-hover || root.dragging;

    pure function pos-of(z: int) -> float {
        if z >= 1000 {
            return 0.5 + 0.5 * Math.log(z / 1000.0, root.max-permille / 1000.0);
        }
        return 0.5 - 0.5 * Math.log(z / 1000.0, root.min-permille / 1000.0);
    }

    function position-at(mouse-x: length) -> float {
        return Math.clamp((mouse-x - root.handle-size / 2) / root.track-w, 0, 1);
    }

    function request-position(p: float) {
        root.request(4000000 + Math.round(p * 10000));
    }

    height: root.content-height;

    // The two buttons at the ends: one step down / up.
    Rectangle {
        x: root.pad;
        y: root.center-y - self.height / 2;
        width: root.button;
        height: root.button;
        border-radius: 10px;
        background: minus-touch.has-hover ? Theme.surface-hover : transparent;

        minus-touch := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.request(2000000); }
        }

        AppIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            icon: IconId.zoom-out;
            size: IconSize.md;
            color: minus-touch.has-hover ? Theme.text : Theme.text-muted;
        }
    }

    Rectangle {
        x: root.width - root.pad - root.button;
        y: root.center-y - self.height / 2;
        width: root.button;
        height: root.button;
        border-radius: 10px;
        background: plus-touch.has-hover ? Theme.surface-hover : transparent;

        plus-touch := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.request(2000001); }
        }

        AppIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            icon: IconId.zoom-in;
            size: IconSize.md;
            color: plus-touch.has-hover ? Theme.text : Theme.text-muted;
        }
    }

    // The track.
    Rectangle {
        x: root.track-x + root.handle-size / 2;
        y: root.center-y - 2px;
        width: root.track-w;
        height: 4px;
        border-radius: 2px;
        background: Theme.surface-selected;
    }

    // From the middle to the handle: the way the zoom went.
    Rectangle {
        x: root.track-x + root.handle-size / 2 + Math.min(root.position, 0.5) * root.track-w;
        y: root.center-y - 2px;
        width: Math.abs(root.position - 0.5) * root.track-w;
        height: 4px;
        border-radius: 2px;
        background: Theme.primary;
    }

    // The points the handle snaps to; the middle one is the reset and taller.
    for snap in root.snaps : Rectangle {
        x: root.track-x + root.handle-size / 2 + root.pos-of(snap) * root.track-w - 0.5px;
        y: root.center-y + 5px;
        width: 1px;
        height: snap == 1000 ? 7px : 4px;
        background: snap == 1000 ? Theme.text-muted : Theme.surface-selected;
    }

    // A click on the middle tick resets.
    TouchArea {
        x: root.track-x + root.handle-size / 2 + 0.5 * root.track-w - 7px;
        y: root.center-y + 3px;
        width: 14px;
        height: 12px;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.request(3000000); }
    }

    // The handle.
    Rectangle {
        x: root.track-x + root.position * root.track-w;
        y: root.center-y - self.height / 2;
        width: root.handle-size;
        height: root.handle-size;
        border-radius: root.handle-size / 2;
        background: root.active ? Theme.text : Theme.primary;
        border-width: 2px;
        border-color: Theme.surface;
    }

    // The percentage above the handle, only while the pointer is over the slider.
    Rectangle {
        visible: root.active;
        width: 46px;
        height: 17px;
        x: Math.clamp(root.track-x + root.handle-size / 2 + root.position * root.track-w - self.width / 2, 2px, root.width - self.width - 2px);
        y: 3px;
        border-radius: 8px;
        background: Theme.surface-selected;

        Text {
            text: Math.round(root.value-permille / 10.0) + "%";
            font-size: 10px;
            font-weight: 700;
            color: Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Dragging, the wheel and the double click.
    track-touch := TouchArea {
        x: root.track-x;
        y: 16px;
        width: root.track-w + root.handle-size;
        height: root.content-height - 16px;
        mouse-cursor: MouseCursor.pointer;

        pointer-event(event) => {
            if event.button == PointerEventButton.left {
                if event.kind == PointerEventKind.down {
                    root.dragging = true;
                    root.request-position(root.position-at(self.mouse-x));
                } else if event.kind == PointerEventKind.up {
                    root.dragging = false;
                }
            }
        }

        moved => {
            if self.pressed {
                root.request-position(root.position-at(self.mouse-x));
            }
        }

        double-clicked => {
            root.request(3000000);
        }

        scroll-event(event) => {
            // A notch is 120; the small steps of a touchpad add up to one.
            root.wheel-acc += event.delta-y / 1px;
            if Math.abs(root.wheel-acc) >= 120 {
                root.request(2000000 + (root.wheel-acc > 0 ? 1 : 0) + (event.modifiers.shift ? 2 : 0) + (event.modifiers.control ? 4 : 0));
                root.wheel-acc = 0;
            }
            return accept;
        }
    }
}
