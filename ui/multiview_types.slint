import { IconId } from "icons.slint";
import { ButtonFeedback } from "button_feedback_types.slint";

/// One button of the hover bar of a tile. Rust decides which buttons a tile offers and in which order.
export struct MultiviewBarButtonView {
    id: int, // see ActionId::code
    icon: IconId,
    tooltip: string,
    toggle: bool, // the button shows an on/off state
    active: bool,
    feedback: ButtonFeedback,
}

/// One tile of the Multiview window. All geometry is computed in Rust (physical pixels converted to logical pixels), so
/// Slint and the X11 video windows always use the same rectangles. Video tiles are drawn by mpv in a native window on
/// top of the Slint scene; Slint only draws images, loading and error states.
export struct MultiviewTileView {
    x: length,
    y: length,
    width: length,
    height: length,
    kind: int, // 0 = image, 1 = video (native window), 2 = unavailable
    image: image,
    is-loading: bool,
    error-text: string,
}

/// A draggable separator between two tiles (or the two rows of a 2x2 grid) with a swap button in the middle.
export struct MultiviewGutterView {
    x: length,
    y: length,
    width: length,
    height: length,
    vertical: bool,
    // Only the swap button of one column of a 2x2 grid: no divider line and no drag.
    swap-only: bool,
}

/// Where the virtual display of a Multiview (the container) is shown inside its canvas, in logical pixels relative to the
/// canvas. In the fullscreen window it covers the whole window; in a tab it is the scaled-down, centered miniature.
export struct MultiviewScreenView {
    x: length,
    y: length,
    width: length,
    height: length,
}
