import { Theme } from "styles.slint";
import { ButtonBar } from "button_bar.slint";
import { SmoothScrollArea } from "smooth_scroll_view.slint";

export component MissingFileDialog inherits Window {
    title: "RustView - File Not Found on Disk";
    preferred-width: 540px;
    preferred-height: 320px;
    min-width: 460px;
    min-height: 260px;
    background: Theme.background;

    in-out property <bool> has-multiple: false;
    in-out property <int> missing-files-count: 1;
    in-out property <string> single-file-name: "";
    in-out property <string> single-file-path: "";
    in-out property <string> missing-files-text: "";
    in property <string> operation-context: "File operation";

    callback acknowledged();

    VerticalLayout {
        padding: 0px;
        spacing: 0px;
        alignment: space-between;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            vertical-stretch: 1;

            Text {
                text: "⚠ File Not Found on Disk";
                font-size: 15px;
                font-weight: 700;
                color: #fab387;
            }

            Text {
                text: root.has-multiple
                    ? ("During '" + root.operation-context + "', the following " + root.missing-files-count + " files could not be found on physical storage:")
                    : ("During '" + root.operation-context + "', the file '" + root.single-file-name + "' could not be found on physical storage:");
                font-size: 12px;
                color: Theme.text;
                wrap: word-wrap;
            }

            // Single File Presentation Card
            if !root.has-multiple : Rectangle {
                background: #fab38718;
                border-radius: 4px;
                border-width: 1px;
                border-color: #fab38744;

                VerticalLayout {
                    padding: 10px;
                    spacing: 4px;

                    Text {
                        text: root.single-file-name;
                        font-size: 12px;
                        font-weight: 700;
                        color: Theme.primary;
                        wrap: word-wrap;
                    }

                    Text {
                        text: root.single-file-path;
                        font-size: 11px;
                        font-italic: true;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                }
            }

            // Multiple Files Scrollable List Presentation
            if root.has-multiple : Rectangle {
                vertical-stretch: 1;
                min-height: 100px;
                background: #fab38718;
                border-radius: 4px;
                border-width: 1px;
                border-color: #fab38744;
                clip: true;

                SmoothScrollArea {
                    width: 100%;
                    height: 100%;
                    enable-horizontal: true;
                    enable-vertical: true;
                    content-width: Math.max(self.width, files-text-elem.preferred-width + 20px);
                    content-height: files-text-elem.preferred-height + 16px;

                    files-text-elem := Text {
                        x: 10px;
                        y: 8px;
                        text: root.missing-files-text;
                        font-size: 11px;
                        color: Theme.text;
                    }
                }
            }

            Text {
                text: "The database record is out of sync with your filesystem. You can refresh the folder to synchronize the library.";
                font-size: 11px;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
        }

        ButtonBar {
            vertical-stretch: 0;
            bar-height: 48px;
            show-ok: true;
            text-ok: "OK";
            ok-clicked => { root.acknowledged(); }
        }
    }
}
