import { TextEdit, LineEdit } from "std-widgets.slint";
import { Theme } from "styles.slint";
import { ButtonBar } from "button_bar.slint";

export component MissingFileDialog inherits Window {
    title: "RustView - File Not Found on Disk";
    preferred-width: 560px;
    preferred-height: 340px;
    min-width: 480px;
    min-height: 280px;
    background: Theme.background;

    in-out property <bool> has-multiple: false;
    in-out property <int> missing-files-count: 1;
    in-out property <string> single-file-name: "";
    in-out property <string> single-file-path: "";
    in-out property <string> missing-files-text: "";
    in property <string> operation-context: "File operation";

    callback acknowledged();

    forward-focus: dialog-focus;

    dialog-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.acknowledged();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: 0px;
            spacing: 0px;
            alignment: space-between;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                vertical-stretch: 1;

                Text {
                    text: "⚠ File Not Found on Disk";
                    font-size: 15px;
                    font-weight: 700;
                    color: #fab387;
                }

                Text {
                    text: root.has-multiple
                        ? ("During '" + root.operation-context + "', the following " + root.missing-files-count + " files could not be found on physical storage:")
                        : ("During '" + root.operation-context + "', the file '" + root.single-file-name + "' could not be found on physical storage:");
                    font-size: 12px;
                    color: Theme.text;
                    wrap: word-wrap;
                }

                // Single File Presentation Card with selectable read-only LineEdit path
                if !root.has-multiple : Rectangle {
                    background: #fab38718;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #fab38744;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;

                        Text {
                            text: root.single-file-name;
                            font-size: 12px;
                            font-weight: 700;
                            color: Theme.primary;
                            wrap: word-wrap;
                        }

                        LineEdit {
                            text: root.single-file-path;
                            font-size: 11px;
                            read-only: true;
                            key-pressed(event) => {
                                if event.text == Key.Escape {
                                    root.acknowledged();
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }
                }

                // Multiple Files Read-Only Textarea (TextEdit) Presentation
                if root.has-multiple : TextEdit {
                    vertical-stretch: 1;
                    min-height: 120px;
                    text: root.missing-files-text;
                    read-only: true;
                    wrap: no-wrap;
                    font-size: 11px;
                    key-pressed(event) => {
                        if event.text == Key.Escape {
                            root.acknowledged();
                            return accept;
                        }
                        return reject;
                    }
                }

                Text {
                    text: "The database record is out of sync with your filesystem. You can refresh the folder to synchronize the library.";
                    font-size: 11px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
            }

            ButtonBar {
                vertical-stretch: 0;
                bar-height: 48px;
                show-ok: true;
                text-ok: "OK";
                ok-clicked => { root.acknowledged(); }
            }
        }
    }
}
