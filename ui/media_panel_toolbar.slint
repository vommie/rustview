import { Theme } from "styles.slint";
import { Icons } from "icons.slint";
import { PanelToolbar, ToolbarButton, ToolbarSeparator, ToolbarSpacer, ToolbarSelectButton, ToolbarSelectItem } from "panel_toolbar.slint";
import { ToolbarThumbWidthControl } from "toolbar_thumb_width_control.slint";
import { ToolbarSearchField } from "toolbar_search_field.slint";

/// Persistent, unified toolbar for the central Media Area.
/// Houses the Thumbnail Width Slider (visible in Grid View), Filter Search (with embedded Regex & Clear),
/// Media Type Filter Selector (Videos, Images, Videos & Images), Refresh button, and instant View Mode Switcher.
export component MediaPanelToolbar inherits PanelToolbar {
    in-out property <int> thumb-width: 190;
    in-out property <string> search-text: "";
    in-out property <bool> regex-mode: false;
    in property <bool> is-table-view: false;
    in-out property <int> media-type-filter-idx: 2; // 0 = Videos, 1 = Images, 2 = Videos & Images (Default: 2)

    callback thumb-width-changed(int);
    callback search-changed(string);
    callback regex-toggled(bool);
    callback media-type-filter-changed(int);
    callback refresh-clicked();
    callback view-mode-toggled(bool /* target_is_table */);

    toolbar-height: 26px;

    // 1. Thumbnail Width Slider Control (Visible in Grid View only)
    if !root.is-table-view : ToolbarThumbWidthControl {
        thumb-width <=> root.thumb-width;
        thumb-width-changed(w) => { root.thumb-width-changed(w); }
    }

    // 2. Expander / Spacer (Pushes search & view actions to the right)
    ToolbarSpacer {}

    // 3. Media Type Filter Select Button (Strictly positioned to the left of the Search Filter input)
    ToolbarSelectButton {
        current-index <=> root.media-type-filter-idx;
        button-display-mode: 0; // Icon only on main button
        popup-display-mode: 2;  // Icon + Text in dropdown options
        tooltip: "Filter media types (Videos, Images, Videos & Images)";

        model: [
            {
                id: 0,
                text: "Videos",
                icon: Icons.media-filter-videos
            },
            {
                id: 1,
                text: "Images",
                icon: Icons.media-filter-images
            },
            {
                id: 2,
                text: "Videos & Images",
                icon: Icons.media-filter-videos-images
            }
        ];

        selected(idx) => {
            root.media-type-filter-changed(idx);
        }
    }

    ToolbarSeparator {}

    // 4. Filter Search Field (with inline Regex Toggle and Clear button)
    search-field := ToolbarSearchField {
        placeholder-text: "Filter...";
        field-width: 160px;
        text <=> root.search-text;
        is-regex <=> root.regex-mode;
        search-changed(txt) => { root.search-changed(txt); }
        regex-toggled(r) => { root.regex-toggled(r); }
    }

    // 5. Separator
    ToolbarSeparator {}

    // 6. Refresh Media Button
    ToolbarButton {
        icon: Icons.refresh;
        tooltip: "Scan and refresh media in current folder";
        clicked => { root.refresh-clicked(); }
    }

    // 7. Separator
    ToolbarSeparator {}

    // 8. Persistent View Mode Switcher Button (Instant response on very first click)
    ToolbarButton {
        icon: root.is-table-view ? Icons.grid-view : Icons.list-view;
        tooltip: root.is-table-view ? "Switch to Grid View" : "Switch to Table View";
        clicked => {
            root.view-mode-toggled(!root.is-table-view);
        }
    }
}
