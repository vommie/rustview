import { Theme } from "styles.slint";
import { Icons, AppIcon } from "icons.slint";
import { ContextMenuItemModel, ContextMenuLevelModel } from "types.slint";
import { TooltipArea, TooltipHost } from "tooltips.slint";
import { SmoothScrollArea } from "smooth_scroll_view.slint";

export component ContextMenuItemRow inherits Rectangle {
    in property <ContextMenuItemModel> item;
    in property <bool> is-parent-active: false;
    callback clicked();
    callback scrolled(length /* delta_x */, length /* delta_y */);
    callback row-hovered(bool /* is_hover */, length /* y_pos */, int /* menu_index */, bool /* has_sub */);

    height: (root.item.kind == 3) ? 7px : ((root.item.kind == 4) ? 22px : 28px);
    background: (!root.item.is-enabled || root.item.kind == 3 || root.item.kind == 4)
        ? transparent
        : ((item-touch.has-hover || root.is-parent-active) ? Theme.surface-hover : transparent);
    border-radius: 4px;

    tooltip-host := TooltipHost {
        text: root.item.tooltip;
        is-enabled: root.item.tooltip != "" && root.item.kind != 3;
        delay: 350ms;
    }

    item-touch := TouchArea {
        enabled: true;
        mouse-cursor: (root.item.kind == 3 || root.item.kind == 4) ? default : (
            !root.item.is-enabled ? not-allowed : pointer
        );

        scroll-event(event) => {
            root.scrolled(event.delta-x, event.delta-y);
            return accept;
        }

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                tooltip-host.on-hover-leave();
            }
        }
        clicked => {
            if root.item.is-enabled && root.item.kind != 3 && root.item.kind != 4 {
                tooltip-host.on-hover-leave();
                root.clicked();
            }
        }
        moved => {
            tooltip-host.on-mouse-move(self.mouse-x, self.mouse-y);
        }
    }

    property <bool> is-hovered: item-touch.has-hover;
    changed is-hovered => {
        if self.is-hovered {
            if root.item.tooltip != "" && root.item.kind != 3 {
                tooltip-host.on-hover-enter(item-touch.mouse-x, item-touch.mouse-y);
            }
            root.row-hovered(true, root.y, root.item.menu-index, root.item.has-submenu);
        } else {
            tooltip-host.on-hover-leave();
        }
    }

    // Separator Line
    if root.item.kind == 3 : Rectangle {
        y: 3px;
        height: 1px;
        background: Theme.border;
    }

    // Header Label with Sticky-Prefix Truncation and Hover Tooltip
    if root.item.kind == 4 : TooltipArea {
        width: 100%;
        height: 100%;
        text: root.item.tooltip != "" ? root.item.tooltip : root.item.text;
        tooltip-enabled: root.item.tooltip != "";
        delay: 350ms;

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            alignment: start;

            Text {
                text: root.item.text;
                font-size: 10px;
                font-weight: 700;
                color: Theme.primary;
                vertical-alignment: center;
                horizontal-alignment: left;
                overflow: elide;
            }
        }
    }

    // Standard Action / Checkable / Submenu Row
    if root.item.kind != 3 && root.item.kind != 4 : HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: start;

        Rectangle {
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;

            if root.item.kind == 1 && root.item.is-checked : Text {
                text: "✓";
                font-size: 11px;
                font-weight: 700;
                color: Theme.primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if root.item.kind == 2 && root.item.is-checked : Text {
                text: "●";
                font-size: 9px;
                color: Theme.primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if root.item.kind != 1 && root.item.kind != 2 && root.item.icon.width > 0 : Image {
                source: root.item.icon;
                width: 14px;
                height: 14px;
                image-fit: contain;
                horizontal-alignment: center;
                vertical-alignment: center;
                opacity: root.item.is-enabled ? 1.0 : 0.4;
            }
        }

        Text {
            text: root.item.text;
            color: root.item.is-enabled ? Theme.text : Theme.text-muted;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: left;
            horizontal-stretch: 1;
            overflow: elide;
        }

        if root.item.shortcut != "" : Text {
            text: root.item.shortcut;
            color: Theme.text-muted;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }

        if root.item.has-submenu : Text {
            text: "▶";
            font-size: 9px;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
    }
}

export component ContextMenuPopup inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    z: 160;

    in property <[ContextMenuLevelModel]> levels: [];

    callback item-clicked(int);
    callback request-submenu(int /* depth */, length /* visible_row_y */, int /* menu_index */);
    callback close-submenus-above(int /* depth */);
    callback dismissed();

    property <int> pending-depth: -1;
    property <length> pending-row-y: 0px;
    property <int> pending-menu-idx: 0;

    submenu-timer := Timer {
        interval: 160ms;
        running: false;
        triggered => {
            self.running = false;
            if root.pending-depth >= 0 {
                root.request-submenu(root.pending-depth, root.pending-row-y, root.pending-menu-idx);
                root.pending-depth = -1;
            }
        }
    }

    forward-focus: popup-focus;
    popup-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismissed();
                return accept;
            }
            return reject;
        }
    }

    backdrop-touch := TouchArea {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.dismissed();
            }
        }
        clicked => { root.dismissed(); }
    }

    for level[depth] in root.levels : Rectangle {
        x: level.x;
        y: level.y;
        width: level.width;
        height: Math.min(level.max_height, level-layout.preferred-height);
        background: Theme.surface;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000bb;
        clip: true;

        scroll-area := SmoothScrollArea {
            width: 100%;
            height: 100%;
            enable-horizontal: false;
            enable-vertical: true;
            scrollbar-size: 5px;
            scrollbar-padding: 2px;
            content-width: self.width;
            content-height: level-layout.preferred-height;

            level-layout := VerticalLayout {
                padding: 4px;
                spacing: 1px;

                for item in level.items : ContextMenuItemRow {
                    item: item;
                    is-parent-active: item.is-checked && item.has-submenu;

                    scrolled(dx, dy) => {
                        submenu-timer.running = false;
                        root.pending-depth = -1;
                        if root.levels.length > depth + 1 {
                            root.request-submenu(depth, 0px, 0);
                        }
                        scroll-area.handle-scroll(dx, dy);
                    }

                    row-hovered(is-hover, row-y, m-idx, has-sub) => {
                        if is-hover {
                            if !has-sub {
                                submenu-timer.running = false;
                                root.pending-depth = -1;
                                if root.levels.length > depth + 1 {
                                    root.request-submenu(depth, 0px, 0);
                                }
                            } else {
                                if !item.is-checked {
                                    root.pending-depth = depth;
                                    root.pending-row-y = row-y + scroll-area.clamped-y;
                                    root.pending-menu-idx = m-idx;
                                    submenu-timer.running = true;
                                }
                            }
                        }
                    }

                    clicked => {
                        if !item.has-submenu {
                            root.item-clicked(item.id);
                        }
                    }
                }
            }
        }
    }
}
