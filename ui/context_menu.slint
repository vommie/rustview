import { Theme } from "styles.slint";
import { ContextMenuItemModel } from "types.slint";

export component ContextMenuItemRow inherits Rectangle {
    in property <ContextMenuItemModel> item;
    callback clicked();
    callback row-hovered(bool /* is_hover */, length /* y_pos */);

    height: (root.item.kind == 3) ? 7px : ((root.item.kind == 4) ? 22px : 28px);
    background: (!root.item.is-enabled || root.item.kind == 3 || root.item.kind == 4)
        ? transparent
        : (item-touch.has-hover ? Theme.surface-hover : transparent);
    border-radius: 4px;

    property <bool> is-hovered: item-touch.has-hover;
    changed is-hovered => {
        if self.is-hovered {
            root.row-hovered(true, root.y);
        }
    }

    item-touch := TouchArea {
        enabled: root.item.is-enabled && root.item.kind != 3 && root.item.kind != 4;
        clicked => { root.clicked(); }
    }

    // Separator Line
    if root.item.kind == 3 : Rectangle {
        y: 3px;
        height: 1px;
        background: Theme.border;
    }

    // Header Label (Left-aligned)
    if root.item.kind == 4 : HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: start;

        Text {
            text: root.item.text;
            font-size: 10px;
            font-weight: 700;
            color: Theme.primary;
            vertical-alignment: center;
            horizontal-alignment: left;
        }
    }

    // Standard Action / Checkable / Submenu Row (Left-aligned)
    if root.item.kind != 3 && root.item.kind != 4 : HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: start;

        // Checkable / Indicator Icon Box
        Rectangle {
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;

            if root.item.kind == 1 && root.item.is_checked : Text {
                text: "✓";
                font-size: 11px;
                font-weight: 700;
                color: Theme.primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if root.item.kind == 2 && root.item.is_checked : Text {
                text: "●";
                font-size: 9px;
                color: Theme.primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Action Text (Strictly Left-aligned)
        Text {
            text: root.item.text;
            color: root.item.is_enabled ? Theme.text : Theme.text-muted;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: left;
            horizontal-stretch: 1;
            overflow: elide;
        }

        // Keyboard Shortcut Text (Right-aligned)
        if root.item.shortcut != "" : Text {
            text: root.item.shortcut;
            color: Theme.text-muted;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }

        // Submenu Flyout Indicator Arrow
        if root.item.has_submenu : Text {
            text: "▶";
            font-size: 9px;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
    }
}

export component ContextMenuPopup inherits Rectangle {
    in property <[ContextMenuItemModel]> items: [];
    in property <[ContextMenuItemModel]> submenu-items: [];
    in property <length> pos-x: 0px;
    in property <length> pos-y: 0px;

    in-out property <bool> is-submenu-open: false;
    in-out property <length> submenu-rel-y: 0px;

    callback item-clicked(int);
    callback dismissed();

    // 1. Transparent Backdrop TouchArea
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.dismissed(); }
    }

    // 2. Primary Menu Box (Fitted to content height)
    main-box := Rectangle {
        width: 220px;
        height: main-layout.preferred-height;

        x: Math.max(8px, Math.min(parent.width - self.width - 8px, root.pos-x));
        y: Math.max(8px, Math.min(parent.height - self.height - 8px, root.pos-y));

        background: Theme.surface;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000bb;

        main-layout := VerticalLayout {
            padding: 4px;
            spacing: 1px;

            for item in root.items: ContextMenuItemRow {
                item: item;
                row-hovered(is-hover, row-y) => {
                    if item.has_submenu && is-hover {
                        root.is-submenu-open = true;
                        root.submenu-rel-y = row-y;
                    } else if !item.has_submenu && is-hover {
                        root.is-submenu-open = false;
                    }
                }
                clicked => {
                    if !item.has_submenu {
                        root.item-clicked(item.id);
                    }
                }
            }
        }
    }

    // 3. Flyout Submenu Box (Positioned to the right or flipped to left)
    if root.is-submenu-open && root.submenu-items.length > 0 : Rectangle {
        width: 200px;
        height: sub-layout.preferred-height;

        // Automatically flip to the left if overflowing the right edge
        x: (main-box.x + main-box.width + self.width + 8px > parent.width)
            ? Math.max(8px, main-box.x - self.width - 4px)
            : (main-box.x + main-box.width + 4px);

        y: Math.max(8px, Math.min(parent.height - self.height - 8px, main-box.y + root.submenu-rel-y));

        background: Theme.surface;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000bb;

        sub-layout := VerticalLayout {
            padding: 4px;
            spacing: 1px;

            for sub-item in root.submenu-items: ContextMenuItemRow {
                item: sub-item;
                clicked => {
                    root.item-clicked(sub-item.id);
                }
            }
        }
    }
}
