import { Theme } from "styles.slint";
import { Icons, AppIcon } from "icons.slint";
import { ContextMenuItemModel } from "types.slint";

export component ContextMenuItemRow inherits Rectangle {
    in property <ContextMenuItemModel> item;
    callback clicked();
    callback row-hovered(bool /* is_hover */, length /* y_pos */, int /* menu_index */, bool /* has_sub */);

    height: (root.item.kind == 3) ? 7px : ((root.item.kind == 4) ? 22px : 28px);
    background: (!root.item.is-enabled || root.item.kind == 3 || root.item.kind == 4)
        ? transparent
        : (item-touch.has-hover ? Theme.surface-hover : transparent);
    border-radius: 4px;

    property <bool> is-hovered: item-touch.has-hover;
    changed is-hovered => {
        if self.is-hovered {
            root.row-hovered(true, root.y, root.item.menu-index, root.item.has-submenu);
        }
    }

    item-touch := TouchArea {
        enabled: root.item.is-enabled && root.item.kind != 3 && root.item.kind != 4;
        clicked => { root.clicked(); }
    }

    // Separator Line
    if root.item.kind == 3 : Rectangle {
        y: 3px;
        height: 1px;
        background: Theme.border;
    }

    // Header Label (Left-aligned)
    if root.item.kind == 4 : HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: start;

        Text {
            text: root.item.text;
            font-size: 10px;
            font-weight: 700;
            color: Theme.primary;
            vertical-alignment: center;
            horizontal-alignment: left;
        }
    }

    // Standard Action / Checkable / Submenu Row
    if root.item.kind != 3 && root.item.kind != 4 : HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: start;

        // Icon Box (Checkmark / Radio / Real App Desktop Icon)
        Rectangle {
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;

            if root.item.kind == 1 && root.item.is-checked : Text {
                text: "✓";
                font-size: 11px;
                font-weight: 700;
                color: Theme.primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if root.item.kind == 2 && root.item.is-checked : Text {
                text: "●";
                font-size: 9px;
                color: Theme.primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Real Application Icon (from Desktop file icon path)
            if root.item.kind != 1 && root.item.kind != 2 && root.item.icon.width > 0 : Image {
                source: root.item.icon;
                width: 14px;
                height: 14px;
                image-fit: contain;
                horizontal-alignment: center;
                vertical-alignment: center;
                opacity: root.item.is-enabled ? 1.0 : 0.4;
            }
        }

        // Action Text
        Text {
            text: root.item.text;
            color: root.item.is-enabled ? Theme.text : Theme.text-muted;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: left;
            horizontal-stretch: 1;
            overflow: elide;
        }

        // Keyboard Shortcut Text
        if root.item.shortcut != "" : Text {
            text: root.item.shortcut;
            color: Theme.text-muted;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }

        // Submenu Flyout Indicator Arrow
        if root.item.has-submenu : Text {
            text: "▶";
            font-size: 9px;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
    }
}

export component ContextMenuPopup inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;

    in property <[ContextMenuItemModel]> level0-items: [];
    in property <[ContextMenuItemModel]> level1-items: [];
    in property <[ContextMenuItemModel]> level2-items: [];
    in property <[ContextMenuItemModel]> level3-items: [];
    in property <[ContextMenuItemModel]> level4-items: [];
    in property <[ContextMenuItemModel]> level5-items: [];

    in property <length> pos-x: 0px;
    in property <length> pos-y: 0px;

    in-out property <length> sub1-y: 0px;
    in-out property <length> sub2-y: 0px;
    in-out property <length> sub3-y: 0px;
    in-out property <length> sub4-y: 0px;
    in-out property <length> sub5-y: 0px;

    callback item-clicked(int);
    callback request-submenu(int /* depth */, int /* menu_index */);
    callback dismissed();

    // Isolated focus scope catching Escape only while the context popup is active
    forward-focus: popup-focus;
    popup-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismissed();
                return accept;
            }
            return reject;
        }
    }

    property <length> menu-width: 230px;

    property <length> l0-x: Math.max(8px, Math.min(root.width - 230px - 8px, root.pos-x));

    property <length> l1-x: (root.l0-x + 230px + root.menu-width + 8px > root.width)
        ? Math.max(8px, root.l0-x - root.menu-width - 4px)
        : (root.l0-x + 230px + 4px);

    property <length> l2-x: (root.l1-x + root.menu-width + root.menu-width + 8px > root.width)
        ? Math.max(8px, root.l1-x - root.menu-width - 4px)
        : (root.l1-x + root.menu-width + 4px);

    property <length> l3-x: (root.l2-x + root.menu-width + root.menu-width + 8px > root.width)
        ? Math.max(8px, root.l2-x - root.menu-width - 4px)
        : (root.l2-x + root.menu-width + 4px);

    property <length> l4-x: (root.l3-x + root.menu-width + root.menu-width + 8px > root.width)
        ? Math.max(8px, root.l3-x - root.menu-width - 4px)
        : (root.l3-x + root.menu-width + 4px);

    property <length> l5-x: (root.l4-x + root.menu-width + root.menu-width + 8px > root.width)
        ? Math.max(8px, root.l4-x - root.menu-width - 4px)
        : (root.l4-x + root.menu-width + 4px);

    // 1. Transparent Full-Window Backdrop: Immediately closes on the VERY FIRST click/pointer-down
    backdrop-touch := TouchArea {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.dismissed();
            }
        }
        clicked => { root.dismissed(); }
    }

    // Level 0 Menu Box
    Rectangle {
        width: 230px;
        height: layout0.preferred-height;
        x: root.l0-x;
        y: Math.max(8px, Math.min(root.height - self.height - 8px, root.pos-y));
        background: Theme.surface;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000bb;

        layout0 := VerticalLayout {
            padding: 4px;
            spacing: 1px;
            for item in root.level0-items: ContextMenuItemRow {
                item: item;
                row-hovered(is-hover, row-y, m-idx, has-sub) => {
                    if is-hover {
                        root.sub1-y = row-y;
                        root.request-submenu(0, has-sub ? m-idx : 0);
                    }
                }
                clicked => {
                    if !item.has-submenu { root.item-clicked(item.id); }
                }
            }
        }
    }

    // Level 1 Submenu Box
    if root.level1-items.length > 0 : Rectangle {
        width: root.menu-width;
        height: layout1.preferred-height;
        x: root.l1-x;
        y: Math.max(8px, Math.min(root.height - self.height - 8px, root.pos-y + root.sub1-y));
        background: Theme.surface;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000bb;

        layout1 := VerticalLayout {
            padding: 4px;
            spacing: 1px;
            for item in root.level1-items: ContextMenuItemRow {
                item: item;
                row-hovered(is-hover, row-y, m-idx, has-sub) => {
                    if is-hover {
                        root.sub2-y = row-y;
                        root.request-submenu(1, has-sub ? m-idx : 0);
                    }
                }
                clicked => {
                    if !item.has-submenu { root.item-clicked(item.id); }
                }
            }
        }
    }

    // Level 2 Submenu Box
    if root.level2-items.length > 0 : Rectangle {
        width: root.menu-width;
        height: layout2.preferred-height;
        x: root.l2-x;
        y: Math.max(8px, Math.min(root.height - self.height - 8px, root.pos-y + root.sub1-y + root.sub2-y));
        background: Theme.surface;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000bb;

        layout2 := VerticalLayout {
            padding: 4px;
            spacing: 1px;
            for item in root.level2-items: ContextMenuItemRow {
                item: item;
                row-hovered(is-hover, row-y, m-idx, has-sub) => {
                    if is-hover {
                        root.sub3-y = row-y;
                        root.request-submenu(2, has-sub ? m-idx : 0);
                    }
                }
                clicked => {
                    if !item.has-submenu { root.item-clicked(item.id); }
                }
            }
        }
    }

    // Level 3 Submenu Box
    if root.level3-items.length > 0 : Rectangle {
        width: root.menu-width;
        height: layout3.preferred-height;
        x: root.l3-x;
        y: Math.max(8px, Math.min(root.height - self.height - 8px, root.pos-y + root.sub1-y + root.sub2-y + root.sub3-y));
        background: Theme.surface;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000bb;

        layout3 := VerticalLayout {
            padding: 4px;
            spacing: 1px;
            for item in root.level3-items: ContextMenuItemRow {
                item: item;
                row-hovered(is-hover, row-y, m-idx, has-sub) => {
                    if is-hover {
                        root.sub4-y = row-y;
                        root.request-submenu(3, has-sub ? m-idx : 0);
                    }
                }
                clicked => {
                    if !item.has-submenu { root.item-clicked(item.id); }
                }
            }
        }
    }

    // Level 4 Submenu Box
    if root.level4-items.length > 0 : Rectangle {
        width: root.menu-width;
        height: layout4.preferred-height;
        x: root.l4-x;
        y: Math.max(8px, Math.min(root.height - self.height - 8px, root.pos-y + root.sub1-y + root.sub2-y + root.sub3-y + root.sub4-y));
        background: Theme.surface;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000bb;

        layout4 := VerticalLayout {
            padding: 4px;
            spacing: 1px;
            for item in root.level4-items: ContextMenuItemRow {
                item: item;
                row-hovered(is-hover, row-y, m-idx, has-sub) => {
                    if is-hover {
                        root.sub5-y = row-y;
                        root.request-submenu(4, has-sub ? m-idx : 0);
                    }
                }
                clicked => {
                    if !item.has-submenu { root.item-clicked(item.id); }
                }
            }
        }
    }

    // Level 5 Submenu Box
    if root.level5-items.length > 0 : Rectangle {
        width: root.menu-width;
        height: layout5.preferred-height;
        x: root.l5-x;
        y: Math.max(8px, Math.min(root.height - self.height - 8px, root.pos-y + root.sub1-y + root.sub2-y + root.sub3-y + root.sub4-y + root.sub5-y));
        background: Theme.surface;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000bb;

        layout5 := VerticalLayout {
            padding: 4px;
            spacing: 1px;
            for item in root.level5-items: ContextMenuItemRow {
                item: item;
                clicked => {
                    root.item-clicked(item.id);
                }
            }
        }
    }
}
