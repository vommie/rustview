import { Theme } from "styles.slint";
import { Icons, AppIcon } from "icons.slint";
import { ContextMenuItemModel } from "types.slint";
import { TooltipArea, TooltipHost } from "tooltips.slint";

export component ContextMenuItemRow inherits Rectangle {
    in property <ContextMenuItemModel> item;
    callback clicked();
    callback row-hovered(bool /* is_hover */, length /* y_pos */, int /* menu_index */, bool /* has_sub */);

    height: (root.item.kind == 3) ? 7px : ((root.item.kind == 4) ? 22px : 28px);
    background: (!root.item.is-enabled || root.item.kind == 3 || root.item.kind == 4)
        ? transparent
        : (item-touch.has-hover ? Theme.surface-hover : transparent);
    border-radius: 4px;

    tooltip-host := TooltipHost {
        text: root.item.tooltip;
        is-enabled: root.item.tooltip != "" && root.item.kind != 3;
        delay: 350ms;
    }

    item-touch := TouchArea {
        enabled: root.item.kind != 3 && root.item.kind != 4;
        mouse-cursor: !root.item.is-enabled ? not-allowed : pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                tooltip-host.on-hover-leave();
            }
        }
        clicked => {
            if root.item.is-enabled {
                tooltip-host.on-hover-leave();
                root.clicked();
            }
        }
        moved => {
            tooltip-host.on-mouse-move(self.mouse-x, self.mouse-y);
        }
    }

    property <bool> is-hovered: item-touch.has-hover;
    changed is-hovered => {
        if self.is-hovered {
            if root.item.tooltip != "" && root.item.kind != 3 {
                tooltip-host.on-hover-enter(item-touch.mouse-x, item-touch.mouse-y);
            }
            root.row-hovered(true, root.y, root.item.menu-index, root.item.has-submenu);
        } else {
            tooltip-host.on-hover-leave();
        }
    }

    // Separator Line
    if root.item.kind == 3 : Rectangle {
        y: 3px;
        height: 1px;
        background: Theme.border;
    }

    // Header Label with Sticky-Prefix Truncation and Hover Tooltip
    if root.item.kind == 4 : TooltipArea {
        width: 100%;
        height: 100%;
        text: root.item.tooltip != "" ? root.item.tooltip : root.item.text;
        tooltip-enabled: root.item.tooltip != "";
        delay: 350ms;

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            alignment: start;

            Text {
                text: root.item.text;
                font-size: 10px;
                font-weight: 700;
                color: Theme.primary;
                vertical-alignment: center;
                horizontal-alignment: left;
                overflow: elide;
            }
        }
    }

    // Standard Action / Checkable / Submenu Row
    if root.item.kind != 3 && root.item.kind != 4 : HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: start;

        Rectangle {
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;

            if root.item.kind == 1 && root.item.is-checked : Text {
                text: "✓";
                font-size: 11px;
                font-weight: 700;
                color: Theme.primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if root.item.kind == 2 && root.item.is-checked : Text {
                text: "●";
                font-size: 9px;
                color: Theme.primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if root.item.kind != 1 && root.item.kind != 2 && root.item.icon.width > 0 : Image {
                source: root.item.icon;
                width: 14px;
                height: 14px;
                image-fit: contain;
                horizontal-alignment: center;
                vertical-alignment: center;
                opacity: root.item.is-enabled ? 1.0 : 0.4;
            }
        }

        Text {
            text: root.item.text;
            color: root.item.is-enabled ? Theme.text : Theme.text-muted;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: left;
            horizontal-stretch: 1;
            overflow: elide;
        }

        if root.item.shortcut != "" : Text {
            text: root.item.shortcut;
            color: Theme.text-muted;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }

        if root.item.has-submenu : Text {
            text: "▶";
            font-size: 9px;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
    }
}

export component ContextMenuPopup inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    z: 160;

    in property <[ContextMenuItemModel]> level0-items: [];
    in property <[ContextMenuItemModel]> level1-items: [];
    in property <[ContextMenuItemModel]> level2-items: [];
    in property <[ContextMenuItemModel]> level3-items: [];
    in property <[ContextMenuItemModel]> level4-items: [];
    in property <[ContextMenuItemModel]> level5-items: [];

    in property <length> pos-x: 0px;
    in property <length> pos-y: 0px;

    in-out property <length> sub1-y: 0px;
    in-out property <length> sub2-y: 0px;
    in-out property <length> sub3-y: 0px;
    in-out property <length> sub4-y: 0px;
    in-out property <length> sub5-y: 0px;

    callback item-clicked(int);
    callback request-submenu(int /* depth */, int /* menu_index */);
    callback dismissed();

    forward-focus: popup-focus;
    popup-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismissed();
                return accept;
            }
            return reject;
        }
    }

    property <length> menu-width: 230px;

    property <length> l0-x: Math.max(8px, Math.min(root.width - root.menu-width - 8px, root.pos-x));

    property <length> l1-x: (root.l0-x + root.menu-width + root.menu-width - 2px + 8px > root.width)
        ? Math.max(8px, root.l0-x - root.menu-width + 2px)
        : (root.l0-x + root.menu-width - 2px);

    property <length> l2-x: (root.l1-x + root.menu-width + root.menu-width - 2px + 8px > root.width)
        ? Math.max(8px, root.l1-x - root.menu-width + 2px)
        : (root.l1-x + root.menu-width - 2px);

    property <length> l3-x: (root.l2-x + root.menu-width + root.menu-width - 2px + 8px > root.width)
        ? Math.max(8px, root.l2-x - root.menu-width + 2px)
        : (root.l2-x + root.menu-width - 2px);

    property <length> l4-x: (root.l3-x + root.menu-width + root.menu-width - 2px + 8px > root.width)
        ? Math.max(8px, root.l3-x - root.menu-width + 2px)
        : (root.l3-x + root.menu-width - 2px);

    property <length> l5-x: (root.l4-x + root.menu-width + root.menu-width - 2px + 8px > root.width)
        ? Math.max(8px, root.l4-x - root.menu-width + 2px)
        : (root.l4-x + root.menu-width - 2px);

    backdrop-touch := TouchArea {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.dismissed();
            }
        }
        clicked => { root.dismissed(); }
    }

    l0-rect := Rectangle {
        width: root.menu-width;
        height: layout0.preferred-height;
        x: root.l0-x;
        y: Math.max(8px, Math.min(root.height - self.height - 8px, root.pos-y));
        background: Theme.surface;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000bb;

        layout0 := VerticalLayout {
            padding: 4px;
            spacing: 1px;
            for item in root.level0-items: ContextMenuItemRow {
                item: item;
                row-hovered(is-hover, row-y, m-idx, has-sub) => {
                    if is-hover {
                        root.sub1-y = row-y;
                        if has-sub || root.level1-items.length > 0 {
                            root.request-submenu(0, has-sub ? m-idx : 0);
                        }
                    }
                }
                clicked => {
                    if !item.has-submenu { root.item-clicked(item.id); }
                }
            }
        }
    }

    if root.level1-items.length > 0 : Rectangle {
        width: root.menu-width;
        height: layout1.preferred-height;
        x: root.l1-x;
        y: Math.max(8px, Math.min(root.height - self.height - 8px, l0-rect.y + root.sub1-y - 4px));
        background: Theme.surface;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000bb;

        layout1 := VerticalLayout {
            padding: 4px;
            spacing: 1px;
            for item in root.level1-items: ContextMenuItemRow {
                item: item;
                row-hovered(is-hover, row-y, m-idx, has-sub) => {
                    if is-hover {
                        root.sub2-y = row-y;
                        if has-sub || root.level2-items.length > 0 {
                            root.request-submenu(1, has-sub ? m-idx : 0);
                        }
                    }
                }
                clicked => {
                    if !item.has-submenu { root.item-clicked(item.id); }
                }
            }
        }
    }

    if root.level2-items.length > 0 : Rectangle {
        width: root.menu-width;
        height: layout2.preferred-height;
        x: root.l2-x;
        y: Math.max(8px, Math.min(root.height - self.height - 8px, l0-rect.y + root.sub1-y + root.sub2-y - 8px));
        background: Theme.surface;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000bb;

        layout2 := VerticalLayout {
            padding: 4px;
            spacing: 1px;
            for item in root.level2-items: ContextMenuItemRow {
                item: item;
                row-hovered(is-hover, row-y, m-idx, has-sub) => {
                    if is-hover {
                        root.sub3-y = row-y;
                        if has-sub || root.level3-items.length > 0 {
                            root.request-submenu(2, has-sub ? m-idx : 0);
                        }
                    }
                }
                clicked => {
                    if !item.has-submenu { root.item-clicked(item.id); }
                }
            }
        }
    }

    if root.level3-items.length > 0 : Rectangle {
        width: root.menu-width;
        height: layout3.preferred-height;
        x: root.l3-x;
        y: Math.max(8px, Math.min(root.height - self.height - 8px, l0-rect.y + root.sub1-y + root.sub2-y + root.sub3-y - 12px));
        background: Theme.surface;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000bb;

        layout3 := VerticalLayout {
            padding: 4px;
            spacing: 1px;
            for item in root.level3-items: ContextMenuItemRow {
                item: item;
                row-hovered(is-hover, row-y, m-idx, has-sub) => {
                    if is-hover {
                        root.sub4-y = row-y;
                        if has-sub || root.level4-items.length > 0 {
                            root.request-submenu(3, has-sub ? m-idx : 0);
                        }
                    }
                }
                clicked => {
                    if !item.has-submenu { root.item-clicked(item.id); }
                }
            }
        }
    }

    if root.level4-items.length > 0 : Rectangle {
        width: root.menu-width;
        height: layout4.preferred-height;
        x: root.l4-x;
        y: Math.max(8px, Math.min(root.height - self.height - 8px, l0-rect.y + root.sub1-y + root.sub2-y + root.sub3-y + root.sub4-y - 16px));
        background: Theme.surface;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000bb;

        layout4 := VerticalLayout {
            padding: 4px;
            spacing: 1px;
            for item in root.level4-items: ContextMenuItemRow {
                item: item;
                row-hovered(is-hover, row-y, m-idx, has-sub) => {
                    if is-hover {
                        root.sub5-y = row-y;
                        if has-sub || root.level5-items.length > 0 {
                            root.request-submenu(4, has-sub ? m-idx : 0);
                        }
                    }
                }
                clicked => {
                    if !item.has-submenu { root.item-clicked(item.id); }
                }
            }
        }
    }

    if root.level5-items.length > 0 : Rectangle {
        width: root.menu-width;
        height: layout5.preferred-height;
        x: root.l5-x;
        y: Math.max(8px, Math.min(root.height - self.height - 8px, l0-rect.y + root.sub1-y + root.sub2-y + root.sub3-y + root.sub4-y + root.sub5-y - 20px));
        background: Theme.surface;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000bb;

        layout5 := VerticalLayout {
            padding: 4px;
            spacing: 1px;
            for item in root.level5-items: ContextMenuItemRow {
                item: item;
                clicked => {
                    root.item-clicked(item.id);
                }
            }
        }
    }
}
