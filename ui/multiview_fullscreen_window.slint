import { MultiviewTileView, MultiviewGutterView, MultiviewActionView } from "multiview_types.slint";
import { MultiviewCanvas } from "multiview_canvas.slint";
import { GlobalTooltipLayer } from "global_tooltip_layer.slint";
import { TooltipSettings } from "tooltips.slint";

/// Frameless fullscreen window showing one to four media (Multiview). Video tiles are native mpv windows placed on top
/// of this scene by Rust; everything else (background, images, gutters, action bar) is drawn by the shared
/// `MultiviewCanvas`.
export component MultiviewFullscreenWindow inherits Window {
    title: "RustView - Fullscreen (Multiview)";
    no-frame: true;

    in property <[MultiviewTileView]> tiles;
    in property <[MultiviewGutterView]> gutters;
    in property <int> bar-tile: -1;
    in property <[MultiviewActionView]> bar-actions;
    in property <bool> enable-tooltips: true;
    in property <int> tooltip-delay-ms: 750;
    in property <int> background-mode: 0; // 0 = Dark Theme (#11111b), 1 = Deep Black (#000000), 2 = Checkerboard
    in-out property <bool> is-ready: false;

    callback request-close();
    callback request-rename();
    callback tile-clicked(int /* tile index */, bool /* is_ctrl */);
    callback background-clicked(bool /* is_ctrl */);
    callback middle-clicked();
    callback gutter-drag-started(int);
    callback gutter-dragged(int, length /* distance from drag start */);
    callback gutter-drag-finished(int);
    callback gutter-reset();
    callback gutter-swap(int);
    callback action-clicked(int /* tile index */, int /* action id */);
    callback overlay-changed(bool /* visible */, length /* x */, length /* y */, length /* width */, length /* height */);
    callback tooltip-changed(bool /* visible */, length /* x */, length /* y */, length /* width */, length /* height */);
    callback size-changed();

    // Root window is transparent so mapping on the wrong display before X11 repositioning is invisible
    background: transparent;

    changed enable-tooltips => {
        TooltipSettings.enabled = root.enable-tooltips;
    }
    changed tooltip-delay-ms => {
        TooltipSettings.default-delay = root.tooltip-delay-ms * 1ms;
    }

    changed width => {
        root.size-changed();
    }
    changed height => {
        root.size-changed();
    }

    forward-focus: fs-focus;
    fs-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.request-close();
                return accept;
            }
            if (event.text == "w" || event.text == "W") && (event.modifiers.control || event.modifiers.meta) {
                root.request-close();
                return accept;
            }
            if event.modifiers.control && event.text == "\u{17}" {
                root.request-close();
                return accept;
            }
            if event.text == Key.F2 {
                root.request-rename();
                return accept;
            }
            return reject;
        }
    }

    main-canvas := MultiviewCanvas {
        width: 100%;
        height: 100%;
        opacity: root.is-ready ? 1.0 : 0.0;
        animate opacity { duration: 60ms; }

        tiles: root.tiles;
        gutters: root.gutters;
        bar-tile: root.bar-tile;
        bar-actions: root.bar-actions;
        screen: { x: 0px, y: 0px, width: root.width, height: root.height };
        background-mode: root.background-mode;

        tile-clicked(index, is-ctrl) => {
            root.tile-clicked(index, is-ctrl);
        }
        background-clicked(is-ctrl) => {
            root.background-clicked(is-ctrl);
        }
        middle-clicked => {
            root.middle-clicked();
        }
        gutter-drag-started(index) => {
            root.gutter-drag-started(index);
        }
        gutter-dragged(index, distance) => {
            root.gutter-dragged(index, distance);
        }
        gutter-drag-finished(index) => {
            root.gutter-drag-finished(index);
        }
        gutter-reset => {
            root.gutter-reset();
        }
        gutter-swap(index) => {
            root.gutter-swap(index);
        }
        action-clicked(tile, id) => {
            root.action-clicked(tile, id);
        }
        overlay-changed(visible, x, y, w, h) => {
            root.overlay-changed(visible, x, y, w, h);
        }
    }

    GlobalTooltipLayer {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;

        state-changed(visible, x, y, w, h) => {
            root.tooltip-changed(visible, x, y, w, h);
        }
    }
}
