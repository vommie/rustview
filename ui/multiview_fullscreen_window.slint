import { MultiviewTileView, MultiviewGutterView, MultiviewBadgeView } from "multiview_types.slint";
import { MultiviewCanvas } from "multiview_canvas.slint";

/// Frameless fullscreen window showing several media side by side (Multiview). Video tiles are native mpv windows placed
/// on top of this scene by Rust; everything else (background, images, gutters, badge) is drawn by the shared
/// `MultiviewCanvas`. There is no navigation: arrow keys and the mouse wheel never switch media.
export component MultiviewFullscreenWindow inherits Window {
    title: "RustView - Fullscreen (Multiview)";
    no-frame: true;

    in property <[MultiviewTileView]> tiles;
    in property <[MultiviewGutterView]> gutters;
    in property <MultiviewBadgeView> badge;
    in property <int> background-mode: 0; // 0 = Dark Theme (#11111b), 1 = Deep Black (#000000), 2 = Checkerboard
    in-out property <bool> is-ready: false;

    callback request-close();
    callback request-rename();
    callback tile-clicked(int /* tile index */, bool /* is_ctrl */);
    callback background-clicked(bool /* is_ctrl */);
    callback middle-clicked();
    callback gutter-drag-started(int);
    callback gutter-dragged(int, length /* distance from drag start */);
    callback gutter-drag-finished(int);
    callback gutter-reset();
    callback gutter-swap(int);
    callback badge-clicked();
    callback size-changed();

    // Root window is transparent so mapping on the wrong display before X11 repositioning is invisible
    background: transparent;

    changed width => {
        root.size-changed();
    }
    changed height => {
        root.size-changed();
    }

    forward-focus: fs-focus;
    fs-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.request-close();
                return accept;
            }
            if (event.text == "w" || event.text == "W") && (event.modifiers.control || event.modifiers.meta) {
                root.request-close();
                return accept;
            }
            if event.modifiers.control && event.text == "\u{17}" {
                root.request-close();
                return accept;
            }
            if event.text == Key.F2 {
                root.request-rename();
                return accept;
            }
            return reject;
        }
    }

    main-canvas := MultiviewCanvas {
        width: 100%;
        height: 100%;
        opacity: root.is-ready ? 1.0 : 0.0;
        animate opacity { duration: 60ms; }

        tiles: root.tiles;
        gutters: root.gutters;
        badge: root.badge;
        screen: { x: 0px, y: 0px, width: root.width, height: root.height };
        background-mode: root.background-mode;

        tile-clicked(index, is-ctrl) => {
            root.tile-clicked(index, is-ctrl);
        }
        background-clicked(is-ctrl) => {
            root.background-clicked(is-ctrl);
        }
        middle-clicked => {
            root.middle-clicked();
        }
        gutter-drag-started(index) => {
            root.gutter-drag-started(index);
        }
        gutter-dragged(index, distance) => {
            root.gutter-dragged(index, distance);
        }
        gutter-drag-finished(index) => {
            root.gutter-drag-finished(index);
        }
        gutter-reset => {
            root.gutter-reset();
        }
        gutter-swap(index) => {
            root.gutter-swap(index);
        }
        badge-clicked => {
            root.badge-clicked();
        }
    }
}
