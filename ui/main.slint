import { Theme } from "styles.slint";
import { Icons, AppIcon } from "icons.slint";
import { TooltipSettings, GlobalTooltip } from "tooltips.slint";
import { MediaItemView, FolderNodeView, FavoriteItemView, TagNodeView, TagColumnView, ContextMenuItemModel, ConflictFileView } from "types.slint";
import { TopToolbar } from "toolbar.slint";
import { SidebarLeft } from "sidebar_left.slint";
import { SidebarRight } from "sidebar_right.slint";
import { VirtualizedMediaGrid } from "media_grid.slint";
import { MediaTableView } from "media_table.slint";
import { StatusBar } from "status_bar.slint";
import { ContextMenuPopup } from "context_menu.slint";
import { ResizerBar } from "resizer_bar.slint";
import { FloatingChoicePopup } from "floating_choice_popup.slint";
import { MediaPanelToolbar } from "media_panel_toolbar.slint";

export { SettingsWindow } from "settings_window.slint";
export { FileRenameDialog } from "file_rename_dialog.slint";
export { FileOpsConflictDialog } from "file_ops_conflict_dialog.slint";
export { DeleteFileDialog } from "delete_file_dialog.slint";
export { RemoveOrphanedFileDialog } from "remove_orphaned_file_dialog.slint";
export { AddTagDialog } from "add_tag_dialog.slint";
export { RenameTagDialog } from "rename_tag_dialog.slint";
export { DeleteTagDialog } from "delete_tag_dialog.slint";
export { RenameFolderDialog } from "rename_folder_dialog.slint";
export { DeleteFolderDialog } from "delete_folder_dialog.slint";
export { MoveFolderToDialog } from "move_folder_to_dialog.slint";
export { RemoveOrphanedFolderDialog } from "remove_orphaned_folder_dialog.slint";
export { RebornFolderDeleteWarnDialog } from "reborn_folder_delete_warn_dialog.slint";
export { MissingFolderDeleteDialog } from "missing_folder_delete_dialog.slint";
export { MissingFileDialog } from "missing_file_dialog.slint";
export { TooltipSettings, GlobalTooltip } from "tooltips.slint";

export component MainWindow inherits Window {
    title: "RustView";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 600px;
    background: Theme.background;

    // View state properties
    in-out property <bool> is-table-view: false;
    in-out property <bool> is-modal-locked: false;
    in-out property <int> thumb-size: 190;
    in-out property <int> thumb-aspect-idx: 1;
    in-out property <bool> show-media-type-badges: true;
    in-out property <string> status-text: "Ready.";
    in-out property <string> items-metric-text: "Items: 0";
    in-out property <string> search-query: "";
    in-out property <bool> regex-mode: false;
    in-out property <int> media-type-filter-idx: 2;

    // Grid Items Layout properties
    in-out property <int> grid-item-padding-h: 8;
    in-out property <int> grid-item-padding-v: 6;
    in-out property <int> grid-spacing: 12;
    in-out property <int> grid-padding: 12;
    in-out property <int> grid-item-border-width: 1;
    in-out property <int> grid-item-corner-radius: 4;

    // Viewport windowing properties
    in-out property <int> visible-start-index: 0;
    in-out property <int> total-items-count: 0;

    // Drag and Drop State Properties
    in-out property <bool> is-dragging-media: false;
    in-out property <int> drag-count: 0;
    in-out property <string> drag-title: "";
    in-out property <image> drag-thumbnail;
    in-out property <length> drag-x: 0px;
    in-out property <length> drag-y: 0px;
    in-out property <int> drop-target-folder-id: -1;
    out property <length> folder-tree-scroll-y: sidebar_left.folder-tree-scroll-y;

    // Floating Choice Popup State Properties
    in-out property <bool> is-choice-popup-open: false;
    in-out property <int> choice-target-folder-id: -1;
    in-out property <string> choice-target-folder-name: "";
    in-out property <int> choice-item-count: 1;
    in-out property <length> choice-popup-x: 0px;
    in-out property <length> choice-popup-y: 0px;

    // Tooltip global settings properties
    in-out property <bool> enable-tooltips: true;
    in-out property <int> tooltip-delay-ms: 750;

    changed enable-tooltips => {
        TooltipSettings.enabled = root.enable-tooltips;
    }

    changed tooltip-delay-ms => {
        TooltipSettings.default-delay = root.tooltip-delay-ms * 1ms;
    }

    in-out property <length> sidebar-left-width: 260px;
    in-out property <length> sidebar-right-width: 280px;

    in-out property <int> sort-column-idx: 0;
    in-out property <int> sort-order-idx: 0;

    // All 12 Table Column Widths
    in-out property <length> col-filename-width: 260px;
    in-out property <length> col-modified-date-width: 145px;
    in-out property <length> col-created-date-width: 145px;
    in-out property <length> col-size-width: 95px;
    in-out property <length> col-rating-width: 65px;
    in-out property <length> col-tags-width: 65px;
    in-out property <length> col-width-width: 70px;
    in-out property <length> col-height-width: 70px;
    in-out property <length> col-ar-width: 65px;
    in-out property <length> col-duration-width: 110px;
    in-out property <length> col-format-width: 75px;
    in-out property <length> col-flags-width: 85px;

    in-out property <bool> is-refreshing-folders: false;
    in-out property <int> folder-scan-count: 0;
    in-out property <bool> show-hidden-folders: false;

    in-out property <bool> is-indexing-media: false;
    in-out property <int> media-index-current: 0;
    in-out property <int> media-index-total: 0;

    in-out property <bool> is-preloading: false;
    in-out property <int> preload-current: 0;
    in-out property <int> preload-total: 100;

    in-out property <bool> is-generating: false;
    in-out property <int> generate-current: 0;
    in-out property <int> generate-total: 100;
    in-out property <int> active-workers: 0;

    in-out property <bool> tag-is-assign-mode: false;
    in-out property <int> tag-match-mode-idx: 0;
    in-out property <int> tag-scope-mode-idx: 2;
    in-out property <int> selected-rating: 0;
    in property <bool> has-file-selection: false;
    in property <[bool]> partial-ratings: [false, false, false, false, false, false];
    in-out property <bool> has-active-query: false;
    in-out property <string> tag-filter-text: "";
    in-out property <bool> tag-filter-is-regex: false;

    in-out property <bool> is-context-menu-open: false;
    in-out property <length> context-menu-x: 0px;
    in-out property <length> context-menu-y: 0px;
    in property <[ContextMenuItemModel]> level0-context-items: [];
    in property <[ContextMenuItemModel]> level1-context-items: [];
    in property <[ContextMenuItemModel]> level2-context-items: [];
    in property <[ContextMenuItemModel]> level3-context-items: [];
    in property <[ContextMenuItemModel]> level4-context-items: [];
    in property <[ContextMenuItemModel]> level5-context-items: [];

    in property <[MediaItemView]> media-items: [];
    in property <[FolderNodeView]> folders: [];
    in property <[FavoriteItemView]> favorites: [];
    in property <[TagColumnView]> tag-columns: [];

    in property <string> info-filename: "-";
    in property <string> info-size: "-";
    in property <string> info-dimensions: "-";
    in property <string> info-format: "-";
    in property <string> info-hash: "-";
    in property <string> info-status: "OK";
    in property <color> info-status-color: Theme.status-ok;
    in property <int> info-selection-count: 0;

    callback refresh-folder();
    callback open-settings();
    callback folder-selected(int, string);
    callback folder-toggle-expand(int);
    callback folder-context-menu(int /* id */, length /* x */, length /* y */);
    callback folder-refresh-clicked();
    callback folder-collapse-all-clicked();
    callback favorite-selected(string);
    callback toggle-hidden-folders(bool /* show_hidden */);
    callback media-clicked(int /* id */, bool /* is_ctrl */, bool /* is_shift */);
    callback media-context-menu(int /* id */, length /* x */, length /* y */);
    callback media-hover-changed(int /* id */, bool /* is_hover */);
    callback background-clicked();
    callback visible-chunk-changed(int /* first_item */, int /* last_item */, int /* total */);

    callback media-drag-started(int /* id */, length /* x */, length /* y */);
    callback media-drag-moved(length /* x */, length /* y */);
    callback media-drag-ended();
    callback folder-row-hovered(int /* folder_id */);
    callback folder-row-unhovered(int /* folder_id */);
    callback media-dropped-on-folder(int /* target_folder_id */);

    callback choice-popup-copy(int /* target_folder_id */);
    callback choice-popup-move(int /* target_folder_id */);
    callback choice-popup-cancel();
    callback choice-popup-dismissed();

    callback context-menu-item-clicked(int /* action_id */);
    callback context-menu-request-submenu(int /* depth */, int /* menu_index */);
    callback context-menu-dismissed();

    callback search-query-changed(string);
    callback regex-mode-toggled(bool);
    callback media-type-filter-changed(int /* index */);
    callback rating-applied(int);
    callback tag-toggled(int);
    callback tag-toggle-expand(int);
    callback tag-context-menu(int /* tag_id */, length /* x */, length /* y */);
    callback tag-root-context-menu(length /* x */, length /* y */);
    callback tag-filter-changed(string);
    callback tag-regex-toggled(bool);
    callback tag-mode-toggled(bool);
    callback match-mode-changed(int);
    callback scope-mode-changed(int);
    callback tag-reset-clicked();
    callback tag-tree-geometry-changed(length /* available_height */);

    callback sort-column-clicked(int /* column_index */);
    callback column-resized(int /* column_index */, length /* new_width */);
    callback column-resize-finished(int /* column_index */, length /* final_width */);
    callback view-mode-toggled-with-index(bool /* is_table */, int /* anchor_top_index */);

    callback sidebar-left-resized(length /* new_width */);
    callback sidebar-left-resize-finished(length /* final_width */);
    callback sidebar-right-resized(length /* new_width */);
    callback sidebar-right-resize-finished(length /* final_width */);

    public function scroll-folder-tree-by(dy: length) {
        sidebar_left.scroll-folder-tree-by(dy);
    }

    public function scroll-folder-to-row(row-idx: int) {
        sidebar_left.scroll-folder-to-row(row-idx);
    }

    public function scroll-media-to-top() {
        if !root.is-table-view {
            grid-view.scroll-to-top();
        } else {
            table-view.scroll-to-top();
        }
    }

    public function scroll-media-to-index(item-idx: int, is-table: bool) {
        if is-table {
            table-view.scroll-to-index(item-idx);
        } else {
            grid-view.scroll-to-index(item-idx);
        }
    }

    pure public function get-current-top-item-index() -> int {
        if root.is-table-view {
            return table-view.get-top-visible-index();
        } else {
            return grid-view.get-top-visible-index();
        }
    }

    VerticalLayout {
        spacing: 0px;

        TopToolbar {
            settings-clicked => { root.open-settings(); }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;

            sidebar_left := SidebarLeft {
                sidebar-width: root.sidebar-left-width;
                folders: root.folders;
                favorites: root.favorites;
                drop-target-folder-id: root.drop-target-folder-id;
                is-refreshing-folders: root.is-refreshing-folders;
                show-hidden-folders <=> root.show-hidden-folders;
                toggle-hidden-folders(h) => { root.toggle-hidden-folders(h); }
                folder-collapse-all-clicked => { root.folder-collapse-all-clicked(); }
                folder-clicked(id, path) => { root.folder-selected(id, path); }
                folder-toggle-expand(id) => { root.folder-toggle-expand(id); }
                folder-row-hovered(id) => { root.folder-row-hovered(id); }
                folder-row-unhovered(id) => { root.folder-row-unhovered(id); }
                folder-context-menu(id, x, y) => { root.folder-context-menu(id, sidebar_left.x + x, 38px + sidebar_left.y + y); }
                folder-refresh-clicked => { root.folder-refresh-clicked(); }
                favorite-clicked(path) => { root.favorite-selected(path); }
            }

            resizer_left := ResizerBar {
                is-horizontal: true;
                property <length> start-w: 260px;
                drag-started => {
                    self.start-w = root.sidebar-left-width;
                }
                dragged(delta) => {
                    root.sidebar-left-width = Math.max(150px, Math.min(700px, self.start-w + delta));
                    root.sidebar-left-resized(root.sidebar-left-width);
                }
                drag-finished => {
                    root.sidebar-left-resize-finished(root.sidebar-left-width);
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0px;

                MediaPanelToolbar {
                    thumb-width <=> root.thumb-size;
                    search-text <=> root.search-query;
                    regex-mode <=> root.regex-mode;
                    is-table-view: root.is-table-view;
                    media-type-filter-idx <=> root.media-type-filter-idx;
                    thumb-width-changed(w) => { }
                    search-changed(t) => { root.search-query-changed(t); }
                    regex-toggled(r) => { root.regex-mode-toggled(r); }
                    media-type-filter-changed(m) => { root.media-type-filter-changed(m); }
                    refresh-clicked => { root.refresh-folder(); }
                    view-mode-toggled(new-is-table) => {
                        let anchor-top-idx = new-is-table ? grid-view.get-top-visible-index() : table-view.get-top-visible-index();
                        root.is-table-view = new-is-table;
                        root.view-mode-toggled-with-index(new-is-table, anchor-top-idx);
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.background;

                    grid-view := VirtualizedMediaGrid {
                        visible: !root.is-table-view;
                        media-items: root.media-items;
                        visible-start-index: root.visible-start-index;
                        total-items-count: root.total-items-count;
                        thumb-size: root.thumb-size;
                        thumb-aspect-idx: root.thumb-aspect-idx;
                        show-media-type-badges: root.show-media-type-badges;
                        grid-item-padding-h: root.grid-item-padding-h;
                        grid-item-padding-v: root.grid-item-padding-v;
                        grid-spacing-val: root.grid-spacing;
                        grid-padding-val: root.grid-padding;
                        grid-item-border-width: root.grid-item-border-width;
                        grid-item-corner-radius: root.grid-item-corner-radius;
                        sort-column: root.sort-column-idx;
                        sort-order: root.sort-order-idx;
                        visible-chunk-changed(first, last, tot) => {
                            root.visible-chunk-changed(first, last, tot);
                        }
                        item-clicked(id, ctrl, shift) => { root.media-clicked(id, ctrl, shift); }
                        item-context-menu(id, x, y) => { root.media-context-menu(id, x + root.sidebar-left-width + resizer_left.width, y + 64px); }
                        item-hover-changed(id, hover) => { root.media-hover-changed(id, hover); }
                        sort-clicked(idx) => { root.sort-column-clicked(idx); }
                        background-clicked => { root.background-clicked(); }
                        item-drag-started(id, x, y) => { root.media-drag-started(id, x + root.sidebar-left-width + resizer_left.width, y + 64px); }
                        item-drag-moved(x, y) => { root.media-drag-moved(x + root.sidebar-left-width + resizer_left.width, y + 64px); }
                        item-drag-ended => { root.media-drag-ended(); }
                    }

                    table-view := MediaTableView {
                        visible: root.is-table-view;
                        items: root.media-items;
                        visible-start-index: root.visible-start-index;
                        total-items-count: root.total-items-count;
                        sort-column: root.sort-column-idx;
                        sort-order: root.sort-order-idx;

                        col-filename-width <=> root.col-filename-width;
                        col-modified-date-width <=> root.col-modified-date-width;
                        col-created-date-width <=> root.col-created-date-width;
                        col-size-width <=> root.col-size-width;
                        col-rating-width <=> root.col-rating-width;
                        col-tags-width <=> root.col-tags-width;
                        col-width-width <=> root.col-width-width;
                        col-height-width <=> root.col-height-width;
                        col-ar-width <=> root.col-ar-width;
                        col-duration-width <=> root.col-duration-width;
                        col-format-width <=> root.col-format-width;
                        col-flags-width <=> root.col-flags-width;

                        visible-chunk-changed(first, last, tot) => {
                            root.visible-chunk-changed(first, last, tot);
                        }
                        item-clicked(id, ctrl, shift) => { root.media-clicked(id, ctrl, shift); }
                        item-context-menu(id, x, y) => { root.media-context-menu(id, x + root.sidebar-left-width + resizer_left.width, y + 64px); }
                        sort-clicked(idx) => { root.sort-column-clicked(idx); }
                        column-resized(idx, w) => { root.column-resized(idx, w); }
                        column-resize-finished(idx, w) => { root.column-resize-finished(idx, w); }
                        background-clicked => { root.background-clicked(); }
                        item-drag-started(id, x, y) => { root.media-drag-started(id, x + root.sidebar-left-width + resizer_left.width, y + 64px); }
                        item-drag-moved(x, y) => { root.media-drag-moved(x + root.sidebar-left-width + resizer_left.width, y + 64px); }
                        item-drag-ended => { root.media-drag-ended(); }
                    }
                }
            }

            resizer_right := ResizerBar {
                is-horizontal: true;
                property <length> start-w: 280px;
                drag-started => {
                    self.start-w = root.sidebar-right-width;
                }
                dragged(delta) => {
                    root.sidebar-right-width = Math.max(150px, Math.min(700px, self.start-w - delta));
                    root.sidebar-right-resized(root.sidebar-right-width);
                }
                drag-finished => {
                    root.sidebar-right-resize-finished(root.sidebar-right-width);
                }
            }

            sidebar_right := SidebarRight {
                sidebar-width: root.sidebar-right-width;
                tag-columns: root.tag-columns;
                is-assign-mode <=> root.tag-is-assign-mode;
                match-mode-idx <=> root.tag-match-mode-idx;
                scope-mode-idx <=> root.tag-scope-mode-idx;
                selected-rating <=> root.selected-rating;
                has-selection: root.has-file-selection;
                partial-ratings: root.partial-ratings;
                has-active-query: root.has-active-query;
                tag-filter-text <=> root.tag-filter-text;
                tag-filter-is-regex <=> root.tag-filter-is-regex;
                info-filename: root.info-filename;
                info-size: root.info-size;
                info-dimensions: root.info-dimensions;
                info-format: root.info-format;
                info-hash: root.info-hash;
                info-status: root.info-status;
                info-status-color: root.info-status-color;
                info-selection-count: root.info-selection-count;

                mode-toggled(assign) => { root.tag-mode-toggled(assign); }
                rating-selected(r) => { root.rating-applied(r); }
                tag-clicked(id) => { root.tag-toggled(id); }
                tag-toggle-expand(id) => { root.tag-toggle-expand(id); }
                tag-context-menu(id, x, y) => { root.tag-context-menu(id, sidebar_right.x + x, 38px + sidebar_right.y + y); }
                root-context-menu(x, y) => { root.tag-root-context-menu(sidebar_right.x + x, 38px + sidebar_right.y + y); }
                tag-filter-changed(txt) => { root.tag-filter-changed(txt); }
                tag-regex-toggled(r) => { root.tag-regex-toggled(r); }
                match-mode-changed(m) => { root.match-mode-changed(m); }
                scope-mode-changed(s) => { root.scope-mode-changed(s); }
                reset-clicked => { root.tag-reset-clicked(); }
                tag-tree-geometry-changed(h) => { root.tag-tree-geometry-changed(h); }
            }
        }

        StatusBar {
            status-message: root.status-text;
            item-count-str: root.items-metric-text;
            is-refreshing-folders: root.is-refreshing-folders;
            folder-scan-count: root.folder-scan-count;
            is-indexing-media: root.is-indexing-media;
            media-index-current: root.media-index-current;
            media-index-total: root.media-index-total;
            is-preloading: root.is-preloading;
            preload-val: root.preload-current;
            preload-max: root.preload-total;
            is-generating: root.is-generating;
            generate-val: root.generate-current;
            generate-max: root.generate-total;
            active-workers: root.active-workers;
        }
    }

    // Context Menu Popup Overlay
    if root.is-context-menu-open : ContextMenuPopup {
        level0-items: root.level0-context-items;
        level1-items: root.level1-context-items;
        level2-items: root.level2-context-items;
        level3-items: root.level3-context-items;
        level4-items: root.level4-context-items;
        level5-items: root.level5-context-items;
        pos-x: root.context-menu-x;
        pos-y: root.context-menu-y;
        item-clicked(id) => { root.context-menu-item-clicked(id); }
        request-submenu(depth, m-idx) => { root.context-menu-request-submenu(depth, m-idx); }
        dismissed => { root.context-menu-dismissed(); }
    }

    // Floating Choice Popup Overlay
    if root.is-choice-popup-open : FloatingChoicePopup {
        target-folder-name: root.choice-target-folder-name;
        item-count: root.choice-item-count;
        pos-x: root.choice-popup-x;
        pos-y: root.choice-popup-y;
        copy-clicked => { root.choice-popup-copy(root.choice-target-folder-id); }
        move-clicked => { root.choice-popup-move(root.choice-target-folder-id); }
        cancel-clicked => { root.choice-popup-cancel(); }
        dismissed => { root.choice-popup-dismissed(); }
    }

    // Global Non-Blocking Tooltip Overlay (Never steals mouse clicks or touches!)
    if GlobalTooltip.is-visible && TooltipSettings.enabled : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        z: 200;
        background: transparent;

        // Position the tooltip bubble without any TouchArea or event blocking
        Rectangle {
            property <length> bubble-w: bubble-layout.preferred-width;
            property <length> bubble-h: bubble-layout.preferred-height;

            x: Math.max(8px, Math.min(parent.width - self.bubble-w - 8px, GlobalTooltip.pos-x));
            y: Math.max(8px, Math.min(parent.height - self.bubble-h - 8px, GlobalTooltip.pos-y));
            width: self.bubble-w;
            height: self.bubble-h;

            background: TooltipSettings.default-background;
            border-radius: TooltipSettings.default-corner-radius;
            border-width: 1px;
            border-color: TooltipSettings.default-border;
            drop-shadow-blur: 8px;
            drop-shadow-color: #000000aa;
            drop-shadow-offset-y: 2px;

            bubble-layout := HorizontalLayout {
                padding-left: TooltipSettings.default-padding-h;
                padding-right: TooltipSettings.default-padding-h;
                padding-top: TooltipSettings.default-padding-v;
                padding-bottom: TooltipSettings.default-padding-v;
                spacing: 6px;
                alignment: center;

                if GlobalTooltip.icon.width > 0 : AppIcon {
                    icon: GlobalTooltip.icon;
                    size: 13px;
                    allow-tint: GlobalTooltip.allow-icon-tint;
                    color: TooltipSettings.default-text;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: GlobalTooltip.text;
                    font-size: TooltipSettings.default-font-size;
                    color: TooltipSettings.default-text;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                }

                if GlobalTooltip.shortcut != "" : Rectangle {
                    background: #ffffff14;
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: #ffffff22;
                    height: 18px;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 5px;
                        padding-right: 5px;
                        alignment: center;

                        Text {
                            text: GlobalTooltip.shortcut;
                            font-size: 10.5px;
                            font-weight: 700;
                            color: TooltipSettings.default-shortcut-color;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    if root.is-modal-locked : Rectangle {
        background: #00000066;

        TouchArea {
        }
    }
}
