import { Theme } from "styles.slint";

/// Generic, fully decoupled pure API Progress Bar component with sharp rectangular geometry.
export component TaskProgressBar inherits Rectangle {
    // Value Range & State Properties
    in property <float> progress-val: 0.0;
    in property <float> progress-min: 0.0;
    in property <float> progress-max: 100.0;
    in property <bool> is-active: true;
    in property <bool> is-indeterminate: false;

    // Visual Customization Properties (Sharp 0px corners)
    in property <length> bar-width: 150px;
    in property <length> bar-height: 18px;
    in property <length> bar-radius: 0px;
    in property <length> bar-border-width: 1px;
    in property <color> bar-border-color: Theme.border;
    in property <color> track-color: Theme.surface-variant;
    in property <color> fill-color: Theme.primary;

    // Label & Typography Customization Properties (High-contrast bright white for dark theme)
    in property <bool> show-overlay-text: true;
    in property <string> overlay-text: "";
    in property <color> overlay-text-color: #ffffff;
    in property <length> overlay-font-size: 10px;
    in property <int> overlay-font-weight: 700;

    // Event Hooks
    callback clicked();

    width: root.bar-width;
    height: root.bar-height;
    background: root.track-color;
    border-radius: root.bar-radius;
    border-width: root.bar-border-width;
    border-color: root.bar-border-color;
    clip: true;

    // Fill Bar (Sharp rectangular progress fill)
    if root.is-active : Rectangle {
        x: 0px;
        y: 0px;
        height: 100%;
        width: root.width * Math.min(1.0, Math.max(0.0, (root.progress-val - root.progress-min) / Math.max(0.001, root.progress-max - root.progress-min)));
        background: root.fill-color;
        border-radius: root.bar-radius;
    }

    // Centered Embedded Text Overlay with High-Contrast Dark-Theme Styling
    if root.show-overlay-text && root.is-active : Text {
        width: 100%;
        height: 100%;
        text: root.overlay-text;
        font-size: root.overlay-font-size;
        font-weight: root.overlay-font-weight;
        color: root.overlay-text-color;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}
