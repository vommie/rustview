# Table of a 100,000-item folder: scrolling, the mouse wheel and resizing two columns.
ready
folder Flat-100k
settle 800
view table
settle 800
begin table_scroll_3000
scroll 3000 3
end
settle 500
begin table_scroll_12000
scroll 12000 3
end
settle 500
begin table_scroll_30000
scroll 30000 3
end
settle 500
begin table_wheel_25
wheel 25 3
end
settle 500
begin table_column_name
press @column:0
sweep 160 0 1.5 2
release
end
settle 400
begin table_column_path
press @column:1
sweep -120 0 1.5 2
release
end
settle 400
view grid
settle 300
quit
