import { Theme } from "styles.slint";
import { AppIdentity } from "app_identity.slint";
import { SettingsSidebar } from "settings_sidebar.slint";
import { SettingsPageGeneral } from "settings_page_general.slint";
import { SettingsPageFolders } from "settings_page_folders.slint";
import { SettingsPageAppearance } from "settings_page_appearance.slint";
import { SettingsPagePerformance } from "settings_page_performance.slint";
import { SettingsPageFormats } from "settings_page_formats.slint";
import { FormatRowView, UnsupportedFormatView } from "settings_format_row.slint";
import { SettingsPageViewer } from "settings_page_viewer.slint";
import { SettingsPageFullscreen } from "settings_page_fullscreen.slint";
import { SettingsPageImageEdit, RatioChipView } from "settings_page_image_edit.slint";
import { SettingsPageTagsRatings } from "settings_page_tags_ratings.slint";
import { SettingsPageHotkeys } from "settings_page_hotkeys.slint";
import { SettingsPageApi } from "settings_page_api.slint";
import { SettingsPageDebug } from "settings_page_debug.slint";
import { ButtonBar } from "button_bar.slint";
import { SmoothScrollArea } from "smooth_scroll_view.slint";
import { GlobalTooltipLayer } from "global_tooltip_layer.slint";
import { TooltipSettings } from "tooltips.slint";
import { HoldConfirm } from "hold.slint";

export { SettingsSidebar } from "settings_sidebar.slint";
export { SettingsPageGeneral } from "settings_page_general.slint";
export { SettingsPageFolders } from "settings_page_folders.slint";
export { SettingsPageAppearance } from "settings_page_appearance.slint";
export { SettingsPagePerformance } from "settings_page_performance.slint";
export { SettingsPageFormats } from "settings_page_formats.slint";
export { SettingsPageViewer } from "settings_page_viewer.slint";
export { SettingsPageFullscreen } from "settings_page_fullscreen.slint";
export { SettingsPageImageEdit, RatioChipView } from "settings_page_image_edit.slint";
export { SettingsPageTagsRatings } from "settings_page_tags_ratings.slint";
export { SettingsPageHotkeys } from "settings_page_hotkeys.slint";
export { SettingsPageApi } from "settings_page_api.slint";
export { SettingsPageDebug } from "settings_page_debug.slint";
export { SettingsCard } from "settings_card.slint";
export { ButtonBar } from "button_bar.slint";
export { SmoothScrollArea } from "smooth_scroll_view.slint";

export component SettingsWindow inherits Window {
    title: "RustView - Settings";
    icon: AppIdentity.window-icon;
    preferred-width: 860px;
    preferred-height: 640px;
    min-width: 740px;
    min-height: 540px;
    background: Theme.background;

    in-out property <int> active-category: 0;
    in property <string> app-version: "";

    // General options
    in-out property <string> root-folder-path: "";
    in-out property <bool> ignore-nested-mounts: true;
    in-out property <bool> remember-last-folder: true;
    in-out property <bool> confirm-delete: true;
    in-out property <int> confirm-open-file-count: 5;
    in-out property <int> hold-to-confirm-ms: 1000;
    in-out property <int> deletion-mode-idx: 0;

    // Folders options
    in-out property <bool> auto-reveal-remembered-folder: true;
    in-out property <bool> persist-folder-tree-state: true;
    in-out property <bool> show-deleted-folders: true;
    in-out property <bool> show-folder-metrics: true;
    in-out property <bool> show-hidden-folders: false;
    in-out property <bool> support-dot-hidden-files: true;

    // Appearance options
    in-out property <int> default-thumb-size: 190;
    in-out property <int> thumb-aspect-idx: 1; // 0=1:1, 1=4:3, 2=5:4, 3=16:9, 4=3:4, 5=4:5, 6=9:16
    in-out property <bool> show-filenames: true;
    in-out property <bool> show-rating-badge: true;
    in-out property <bool> show-tag-badge: true;
    in-out property <bool> show-media-type-badges: true;
    in-out property <bool> show-animated-badge: true;
    in-out property <bool> show-duration-badge: true;
    in-out property <int> thumbnail-badge-overflow-idx: 0; // 0=hide, 1=wrap
    in-out property <bool> enable-hover-previews: true;
    in-out property <bool> enable-tooltips: true;
    in-out property <int> tooltip-delay-ms: 750;

    // Type-ahead find options
    in-out property <bool> type-ahead-enabled: true;
    in-out property <int> type-ahead-timeout-ms: 1000;
    in-out property <int> type-ahead-new-search-gap-ms: 500;
    in-out property <bool> type-ahead-include-folders: true;
    in-out property <bool> type-ahead-cycle-repeated-keys: true;
    in-out property <bool> type-ahead-center-target: true;
    in-out property <bool> type-ahead-show-no-match: true;
    in-out property <int> type-ahead-multiview-delay-ms: 400;

    // Grid Items Layout options
    in-out property <int> grid-item-padding-h: 8;
    in-out property <int> grid-item-padding-v: 6;
    in-out property <int> grid-spacing: 12;
    in-out property <int> grid-padding: 12;
    in-out property <int> grid-item-border-width: 1;
    in-out property <int> grid-item-corner-radius: 4;

    // Performance options
    in-out property <int> worker-threads: 4;
    in-out property <int> batch-commit-size: 32;
    in-out property <bool> memory-budget-auto: true;
    in-out property <int> memory-budget-mb: 4096;
    in property <int> memory-budget-max-mb: 65536;
    in property <string> memory-summary;
    in property <string> memory-warning;
    in-out property <int> thumb-db-size: 256;
    in-out property <int> thumb-format-idx: 0; // 0 = WebP, 1 = JPEG
    in-out property <int> thumb-quality: 80;
    in-out property <int> scaling-algo-idx: 0;
    in-out property <int> video-engine-idx: 0; // 0 = FFmpeg, 1 = MPV
    in-out property <int> video-offset-percent: 10;
    in-out property <int> short-video-threshold-secs: 10;
    in-out property <bool> generate-video-previews: true;
    in-out property <int> preview-frame-count: 5;
    in-out property <bool> custom-preview-settings: true;
    in-out property <int> preview-format-idx: 0; // 0 = WebP, 1 = JPEG
    in-out property <int> preview-quality: 40;

    // Formats options (the rows and the switches live in `settings/formats_page.rs`)
    in property <string> formats-intro;
    in property <string> formats-hidden-notice;
    in property <string> formats-image-summary;
    in property <string> formats-video-summary;
    in property <[FormatRowView]> format-image-rows;
    in property <[FormatRowView]> format-video-rows;
    in property <[UnsupportedFormatView]> format-unsupported;
    in-out property <string> formats-filter-text;
    in-out property <bool> auto-detect-extensionless: true;
    callback format-toggled(string, bool);
    callback formats-set-all(int, bool);
    callback formats-filter-edited(string);
    callback formats-page-shown();

    // Viewer options
    in-out property <bool> open-images-in-tab: true;
    in-out property <bool> allow-multiple-image-tabs: false;
    in-out property <bool> open-videos-in-tab: true;
    in-out property <bool> allow-multiple-video-tabs: true;
    in-out property <int> video-jump-secs: 5;
    in-out property <int> video-jump-long-secs: 60;
    in-out property <bool> viewer-show-tab-rating-badge: false;
    in-out property <int> viewer-background-mode-idx: 0;

    // Fullscreen options
    in property <[string]> display-options: [];
    in-out property <int> selected-display-idx: 0;
    in-out property <bool> fullscreen-enable-specific: false;
    in-out property <bool> fullscreen-enable-fallback: false;
    in-out property <int> fullscreen-fallback-target-idx: 0;
    in-out property <bool> fullscreen-media-bar-enabled: true;
    in-out property <bool> fullscreen-media-bar-show-mute: true;
    in-out property <bool> fullscreen-media-bar-show-sticky: true;
    in-out property <bool> fullscreen-media-bar-show-duplicate: true;
    in-out property <bool> fullscreen-media-bar-show-open-as-tab: true;
    in-out property <bool> fullscreen-media-bar-show-open-with: true;
    in-out property <bool> fullscreen-media-bar-show-zoom: true;
    in-out property <bool> fullscreen-media-bar-show-crop: true;

    // Image Edit (the ratio chips and their callbacks live in `settings_dialog/image_edit_page.rs`)
    in property <[RatioChipView]> image-edit-ratios;
    in-out property <string> image-edit-ratio-input;
    in property <string> image-edit-ratio-error;
    in-out property <int> image-edit-crop-grid-idx;
    in-out property <bool> image-edit-align-jpeg;
    in-out property <int> image-edit-overwrite-mode-idx;
    in-out property <int> image-edit-jpeg-quality: 90;
    in-out property <int> image-edit-jpeg-subsampling-idx;
    in-out property <bool> image-edit-jpeg-progressive;
    in-out property <int> image-edit-png-compression-idx: 1;
    in-out property <bool> image-edit-webp-lossless;
    in-out property <int> image-edit-webp-quality: 90;
    in-out property <int> image-edit-avif-quality: 80;
    in-out property <int> image-edit-avif-speed: 6;
    in-out property <int> image-edit-tiff-compression-idx: 1;
    callback image-edit-add-ratio(string);
    callback image-edit-remove-ratio(int);
    callback image-edit-reset-ratios();
    in-out property <bool> fullscreen-media-bar-show-delete: true;
    in-out property <bool> fullscreen-media-bar-show-remove: true;
    in-out property <int> fullscreen-media-bar-reveal-distance-px: 15;
    in-out property <bool> fullscreen-primary-bar-enabled: true;
    in-out property <bool> fullscreen-primary-bar-show-send-to-tab: true;
    in-out property <bool> fullscreen-primary-bar-show-close: true;
    in-out property <bool> fullscreen-primary-bar-show-mute-all: true;
    in-out property <bool> fullscreen-primary-bar-show-play-pause-all: true;
    in-out property <bool> fullscreen-primary-bar-show-reset-layout: true;
    in-out property <bool> fullscreen-primary-bar-show-hide-cursor: true;
    in-out property <bool> fullscreen-primary-bar-show-pin: true;
    in-out property <int> fullscreen-primary-bar-reveal-distance-px: 15;
    in-out property <bool> fullscreen-hide-idle-cursor: false;
    in-out property <int> fullscreen-idle-cursor-secs: 3;
    in-out property <bool> fullscreen-hide-selection-with-cursor: true;
    in-out property <int> fullscreen-selection-brighten-idx: 2; // 0 = off, 1 = weak, 2 = medium, 3 = strong
    in-out property <int> fullscreen-selection-corner-idx: 1; // 0 = short, 1 = medium, 2 = long
    in-out property <int> fullscreen-zoom-step-percent: 15;
    in-out property <int> fullscreen-zoom-max-percent: 1000;
    in-out property <int> fullscreen-zoom-out-percent: 200;
    in-out property <int> fullscreen-zoom-minimap-secs: 3;
    in-out property <bool> fullscreen-zoom-smooth: true;
    in-out property <int> fullscreen-zoom-minimap-idx: 0; // 0 = bottom left, 1 = bottom right
    in-out property <bool> fullscreen-zoom-minimap-always: false;
    in-out property <int> fullscreen-zoom-resample-idx: 0; // 0 = Lanczos, 1 = Catmull-Rom, 2 = Bilinear, 3 = Nearest neighbor
    in-out property <bool> fullscreen-sound-auto-control: true;
    in-out property <int> fullscreen-sound-follows-idx: 0; // 0 = first video, 1 = newest video, 2 = selected video, 3 = nobody
    in-out property <bool> fullscreen-sound-hand-over: true;
    in-out property <bool> fullscreen-rating-show-feedback: true;
    in property <string> fullscreen-rating-keys: "the rating keys";
    in-out property <int> fullscreen-background-source-idx: 0; // 0 = theme, 1 = same as viewer, 2 = custom color
    in-out property <color> fullscreen-background-color: Theme.fullscreen-background;
    callback memory-budget-edited();
    callback refresh-displays();
    callback pick-fullscreen-background();

    // Tags & Ratings options
    in-out property <int> max-history-tags: 20;

    // API options
    in-out property <bool> auto-complete-external-stubs: true;

    // Debug options
    in-out property <bool> obfuscate-logs: true;

    // Callbacks to Rust backend
    callback browse-root-folder();
    callback save-and-apply();
    callback cancel-clicked();

    // The counts on the File Formats page are read from the library when the page is opened.
    changed active-category => {
        if root.active-category == 4 {
            root.formats-page-shown();
        }
    }

    // The tooltips of this window follow the options being edited (the dialog is a window of its own with its own
    // tooltip settings).
    changed enable-tooltips => {
        TooltipSettings.enabled = root.enable-tooltips;
    }
    changed tooltip-delay-ms => {
        TooltipSettings.default-delay = root.tooltip-delay-ms * 1ms;
    }
    // The held elements of this window follow the duration being edited.
    changed hold-to-confirm-ms => {
        HoldConfirm.duration = root.hold-to-confirm-ms * 1ms;
    }

    forward-focus: dialog-focus;

    dialog-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel-clicked();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            HorizontalLayout {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                padding: 0px;
                spacing: 0px;

                SettingsSidebar {
                    active-category <=> root.active-category;
                }

                SmoothScrollArea {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                    enable-horizontal: false;
                    enable-vertical: true;
                    content-width: self.width;
                    content-height: page-content.preferred-height;

                    page-content := VerticalLayout {
                        padding: 16px;
                        spacing: 16px;
                        alignment: start;

                        if root.active-category == 0 : SettingsPageGeneral {
                            root-folder-path <=> root.root-folder-path;
                            ignore-nested-mounts <=> root.ignore-nested-mounts;
                            remember-last-folder <=> root.remember-last-folder;
                            confirm-delete <=> root.confirm-delete;
                            confirm-open-file-count <=> root.confirm-open-file-count;
                            hold-to-confirm-ms <=> root.hold-to-confirm-ms;
                            deletion-mode-idx <=> root.deletion-mode-idx;
                            app-version: root.app-version;
                            browse-root-folder => { root.browse-root-folder(); }
                        }

                        if root.active-category == 1 : SettingsPageFolders {
                            auto-reveal-remembered-folder <=> root.auto-reveal-remembered-folder;
                            persist-folder-tree-state <=> root.persist-folder-tree-state;
                            show-deleted-folders <=> root.show-deleted-folders;
                            show-folder-metrics <=> root.show-folder-metrics;
                            show-hidden-folders <=> root.show-hidden-folders;
                            support-dot-hidden-files <=> root.support-dot-hidden-files;
                        }

                        if root.active-category == 2 : SettingsPageAppearance {
                            default-thumb-size <=> root.default-thumb-size;
                            thumb-aspect-idx <=> root.thumb-aspect-idx;
                            show-filenames <=> root.show-filenames;
                            show-rating-badge <=> root.show-rating-badge;
                            show-tag-badge <=> root.show-tag-badge;
                            show-media-type-badges <=> root.show-media-type-badges;
                            show-animated-badge <=> root.show-animated-badge;
                            show-duration-badge <=> root.show-duration-badge;
                            thumbnail-badge-overflow-idx <=> root.thumbnail-badge-overflow-idx;
                            enable-hover-previews <=> root.enable-hover-previews;
                            enable-tooltips <=> root.enable-tooltips;
                            tooltip-delay-ms <=> root.tooltip-delay-ms;
                            type-ahead-enabled <=> root.type-ahead-enabled;
                            type-ahead-timeout-ms <=> root.type-ahead-timeout-ms;
                            type-ahead-new-search-gap-ms <=> root.type-ahead-new-search-gap-ms;
                            type-ahead-include-folders <=> root.type-ahead-include-folders;
                            type-ahead-cycle-repeated-keys <=> root.type-ahead-cycle-repeated-keys;
                            type-ahead-center-target <=> root.type-ahead-center-target;
                            type-ahead-show-no-match <=> root.type-ahead-show-no-match;
                            type-ahead-multiview-delay-ms <=> root.type-ahead-multiview-delay-ms;
                            grid-item-padding-h <=> root.grid-item-padding-h;
                            grid-item-padding-v <=> root.grid-item-padding-v;
                            grid-spacing <=> root.grid-spacing;
                            grid-padding <=> root.grid-padding;
                            grid-item-border-width <=> root.grid-item-border-width;
                            grid-item-corner-radius <=> root.grid-item-corner-radius;
                        }

                        if root.active-category == 3 : SettingsPagePerformance {
                            worker-threads <=> root.worker-threads;
                            batch-commit-size <=> root.batch-commit-size;
                            memory-budget-auto <=> root.memory-budget-auto;
                            memory-budget-mb <=> root.memory-budget-mb;
                            memory-budget-max-mb: root.memory-budget-max-mb;
                            memory-summary: root.memory-summary;
                            memory-warning: root.memory-warning;
                            memory-budget-edited => { root.memory-budget-edited(); }
                            thumb-db-size <=> root.thumb-db-size;
                            thumb-format-idx <=> root.thumb-format-idx;
                            thumb-quality <=> root.thumb-quality;
                            scaling-algo-idx <=> root.scaling-algo-idx;
                            video-engine-idx <=> root.video-engine-idx;
                            video-offset-percent <=> root.video-offset-percent;
                            short-video-threshold-secs <=> root.short-video-threshold-secs;
                            generate-video-previews <=> root.generate-video-previews;
                            preview-frame-count <=> root.preview-frame-count;
                            custom-preview-settings <=> root.custom-preview-settings;
                            preview-format-idx <=> root.preview-format-idx;
                            preview-quality <=> root.preview-quality;
                        }

                        if root.active-category == 4 : SettingsPageFormats {
                            intro: root.formats-intro;
                            hidden-notice: root.formats-hidden-notice;
                            image-summary: root.formats-image-summary;
                            video-summary: root.formats-video-summary;
                            image-formats: root.format-image-rows;
                            video-formats: root.format-video-rows;
                            unsupported: root.format-unsupported;
                            filter-text <=> root.formats-filter-text;
                            auto-detect-extensionless <=> root.auto-detect-extensionless;
                            format-toggled(id, enabled) => { root.format-toggled(id, enabled); }
                            set-all(kind, enabled) => { root.formats-set-all(kind, enabled); }
                            filter-edited(text) => { root.formats-filter-edited(text); }
                        }

                        if root.active-category == 5 : SettingsPageViewer {
                            open-images-in-tab <=> root.open-images-in-tab;
                            allow-multiple-image-tabs <=> root.allow-multiple-image-tabs;
                            open-videos-in-tab <=> root.open-videos-in-tab;
                            allow-multiple-video-tabs <=> root.allow-multiple-video-tabs;
                            video-jump-secs <=> root.video-jump-secs;
                            video-jump-long-secs <=> root.video-jump-long-secs;
                            show-tab-rating-badge <=> root.viewer-show-tab-rating-badge;
                            background-mode-idx <=> root.viewer-background-mode-idx;
                        }

                        if root.active-category == 6 : SettingsPageFullscreen {
                            display-options: root.display-options;
                            selected-display-idx <=> root.selected-display-idx;
                            enable-specific-monitor <=> root.fullscreen-enable-specific;
                            enable-fallback-rule <=> root.fullscreen-enable-fallback;
                            fallback-target-idx <=> root.fullscreen-fallback-target-idx;
                            media-bar-enabled <=> root.fullscreen-media-bar-enabled;
                            media-bar-show-mute <=> root.fullscreen-media-bar-show-mute;
                            media-bar-show-sticky <=> root.fullscreen-media-bar-show-sticky;
                            media-bar-show-duplicate <=> root.fullscreen-media-bar-show-duplicate;
                            media-bar-show-open-as-tab <=> root.fullscreen-media-bar-show-open-as-tab;
                            media-bar-show-open-with <=> root.fullscreen-media-bar-show-open-with;
                            media-bar-show-zoom <=> root.fullscreen-media-bar-show-zoom;
                            media-bar-show-crop <=> root.fullscreen-media-bar-show-crop;
                            media-bar-show-delete <=> root.fullscreen-media-bar-show-delete;
                            media-bar-show-remove <=> root.fullscreen-media-bar-show-remove;
                            media-bar-reveal-distance-px <=> root.fullscreen-media-bar-reveal-distance-px;
                            primary-bar-enabled <=> root.fullscreen-primary-bar-enabled;
                            primary-bar-show-send-to-tab <=> root.fullscreen-primary-bar-show-send-to-tab;
                            primary-bar-show-close <=> root.fullscreen-primary-bar-show-close;
                            primary-bar-show-mute-all <=> root.fullscreen-primary-bar-show-mute-all;
                            primary-bar-show-play-pause-all <=> root.fullscreen-primary-bar-show-play-pause-all;
                            primary-bar-show-reset-layout <=> root.fullscreen-primary-bar-show-reset-layout;
                            primary-bar-show-hide-cursor <=> root.fullscreen-primary-bar-show-hide-cursor;
                            primary-bar-show-pin <=> root.fullscreen-primary-bar-show-pin;
                            primary-bar-reveal-distance-px <=> root.fullscreen-primary-bar-reveal-distance-px;
                            hide-idle-cursor <=> root.fullscreen-hide-idle-cursor;
                            idle-cursor-secs <=> root.fullscreen-idle-cursor-secs;
                            hide-selection-with-cursor <=> root.fullscreen-hide-selection-with-cursor;
                            selection-brighten-idx <=> root.fullscreen-selection-brighten-idx;
                            selection-corner-idx <=> root.fullscreen-selection-corner-idx;
                            zoom-step-percent <=> root.fullscreen-zoom-step-percent;
                            zoom-max-percent <=> root.fullscreen-zoom-max-percent;
                            zoom-out-percent <=> root.fullscreen-zoom-out-percent;
                            zoom-minimap-secs <=> root.fullscreen-zoom-minimap-secs;
                            zoom-smooth <=> root.fullscreen-zoom-smooth;
                            zoom-minimap-idx <=> root.fullscreen-zoom-minimap-idx;
                            zoom-minimap-always <=> root.fullscreen-zoom-minimap-always;
                            zoom-resample-idx <=> root.fullscreen-zoom-resample-idx;
                            sound-auto-control <=> root.fullscreen-sound-auto-control;
                            sound-follows-idx <=> root.fullscreen-sound-follows-idx;
                            sound-hand-over <=> root.fullscreen-sound-hand-over;
                            rating-show-feedback <=> root.fullscreen-rating-show-feedback;
                            rating-keys: root.fullscreen-rating-keys;
                            background-source-idx <=> root.fullscreen-background-source-idx;
                            background-color <=> root.fullscreen-background-color;
                            refresh-displays => { root.refresh-displays(); }
                            pick-background-color => { root.pick-fullscreen-background(); }
                        }

                        if root.active-category == 7 : SettingsPageImageEdit {
                            ratios: root.image-edit-ratios;
                            ratio-input <=> root.image-edit-ratio-input;
                            ratio-error: root.image-edit-ratio-error;
                            crop-grid-idx <=> root.image-edit-crop-grid-idx;
                            align-jpeg <=> root.image-edit-align-jpeg;
                            overwrite-mode-idx <=> root.image-edit-overwrite-mode-idx;
                            jpeg-quality <=> root.image-edit-jpeg-quality;
                            jpeg-subsampling-idx <=> root.image-edit-jpeg-subsampling-idx;
                            jpeg-progressive <=> root.image-edit-jpeg-progressive;
                            png-compression-idx <=> root.image-edit-png-compression-idx;
                            webp-lossless <=> root.image-edit-webp-lossless;
                            webp-quality <=> root.image-edit-webp-quality;
                            avif-quality <=> root.image-edit-avif-quality;
                            avif-speed <=> root.image-edit-avif-speed;
                            tiff-compression-idx <=> root.image-edit-tiff-compression-idx;
                            add-ratio(text) => { root.image-edit-add-ratio(text); }
                            remove-ratio(index) => { root.image-edit-remove-ratio(index); }
                            reset-ratios => { root.image-edit-reset-ratios(); }
                        }

                        if root.active-category == 8 : SettingsPageTagsRatings {
                            max-history-tags <=> root.max-history-tags;
                        }

                        if root.active-category == 9 : SettingsPageHotkeys { }

                        if root.active-category == 10 : SettingsPageApi {
                            auto-complete-external-stubs <=> root.auto-complete-external-stubs;
                        }

                        if root.active-category == 11 : SettingsPageDebug {
                            obfuscate-logs <=> root.obfuscate-logs;
                        }
                    }
                }
            }

            ButtonBar {
                vertical-stretch: 0;
                show-cancel: true;
                show-save: true;
                cancel-clicked => { root.cancel-clicked(); }
                save-clicked => { root.save-and-apply(); }
            }
        }
    }

    // Tooltips of the options (drawn above everything, they never take the pointer).
    GlobalTooltipLayer {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
    }
}
