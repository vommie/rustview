// The log window (`docs/debug_page.md`): the log of RustView, live. Opened from Settings > Debug; it is a window of its own that
// locks nothing, so it can stay open next to the main window. Filled by `src/ui/log_window/`.

import { ListView } from "std-widgets.slint";
import { Theme } from "styles.slint";
import { AppIdentity } from "app_identity.slint";
import { IconId } from "icons.slint";
import { ToolbarButton } from "toolbar_button.slint";
import { GlobalTooltipLayer } from "global_tooltip_layer.slint";

/// One line. `level`: 0 = error, 1 = warning, 2 = info, 3 = debug, 4 = trace.
export struct LogLineView {
    time: string,
    level: int,
    text: string,
}

export component LogWindow inherits Window {
    title: "RustView - Log";
    icon: AppIdentity.window-icon;
    preferred-width: 900px;
    preferred-height: 560px;
    min-width: 480px;
    min-height: 300px;
    background: Theme.background;

    in property <[LogLineView]> lines;
    // 0 = every line, 1 = warnings and errors, 2 = errors.
    in-out property <int> filter-idx;
    in-out property <bool> private-view;
    in-out property <bool> follow: true;
    in property <string> summary;

    callback filter-changed(int);
    callback private-toggled(bool);
    callback follow-toggled(bool);
    callback copy-shown();
    callback open-folder();

    /// Scrolls to the newest line.
    public function scroll-to-end() {
        list.content-y = min(0px, list.visible-height - list.content-height);
    }

    pure function level-name(level: int) -> string {
        if level == 0 {
            return "ERROR";
        }
        if level == 1 {
            return "WARN";
        }
        if level == 2 {
            return "INFO";
        }
        if level == 3 {
            return "DEBUG";
        }
        return "TRACE";
    }

    pure function level-color(level: int) -> color {
        if level == 0 {
            return Theme.status-corrupt;
        }
        if level == 1 {
            return Theme.accent;
        }
        return Theme.text-muted;
    }

    VerticalLayout {
        Rectangle {
            height: 38px;
            background: Theme.surface;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 4px;

                ToolbarButton {
                    icon: IconId.log-all-lines;
                    tooltip: "Show every line";
                    is-active: root.filter-idx == 0;
                    clicked => {
                        root.filter-idx = 0;
                        root.filter-changed(0);
                    }
                }

                ToolbarButton {
                    icon: IconId.log-warnings;
                    tooltip: "Show warnings and errors only";
                    is-active: root.filter-idx == 1;
                    clicked => {
                        root.filter-idx = 1;
                        root.filter-changed(1);
                    }
                }

                ToolbarButton {
                    icon: IconId.log-errors;
                    tooltip: "Show errors only";
                    is-active: root.filter-idx == 2;
                    clicked => {
                        root.filter-idx = 2;
                        root.filter-changed(2);
                    }
                }

                Rectangle {
                    width: 10px;
                }

                ToolbarButton {
                    icon: root.private-view ? IconId.log-names-hidden : IconId.log-names-shown;
                    tooltip: root.private-view
                        ? "Names and paths are hidden, as in the private log to share; click to show them"
                        : "Names and paths are shown, as in the real log; click to hide them";
                    is-active: root.private-view;
                    clicked => {
                        root.private-view = !root.private-view;
                        root.private-toggled(root.private-view);
                    }
                }

                ToolbarButton {
                    icon: IconId.log-follow;
                    tooltip: root.follow ? "Follows every new line; click to stop" : "Click to follow every new line";
                    is-active: root.follow;
                    clicked => {
                        root.follow = !root.follow;
                        root.follow-toggled(root.follow);
                    }
                }

                ToolbarButton {
                    icon: IconId.copy;
                    tooltip: "Copy the lines shown";
                    clicked => { root.copy-shown(); }
                }

                ToolbarButton {
                    icon: IconId.folder-open;
                    tooltip: "Open the folder of the log files";
                    clicked => { root.open-folder(); }
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.summary;
                    color: Theme.text-muted;
                    font-size: 11px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }

        list := ListView {
            vertical-stretch: 1;

            for line in root.lines : HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 1px;
                padding-bottom: 1px;
                spacing: 8px;

                Text {
                    width: 90px;
                    text: line.time;
                    color: Theme.text-muted;
                    font-family: "monospace";
                    font-size: 11px;
                }

                Text {
                    width: 44px;
                    text: root.level-name(line.level);
                    color: root.level-color(line.level);
                    font-family: "monospace";
                    font-size: 11px;
                    font-weight: line.level <= 1 ? 700 : 400;
                }

                Text {
                    horizontal-stretch: 1;
                    text: line.text;
                    color: Theme.text;
                    font-family: "monospace";
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }
    }

    // Tooltips of the buttons (drawn above everything, they never take the pointer).
    GlobalTooltipLayer {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
    }
}
