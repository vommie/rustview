import { Theme } from "styles.slint";
import { IconId } from "icons.slint";
import { ToolbarButton } from "toolbar_button.slint";
import { ToolbarSeparator, ToolbarSpacer } from "panel_toolbar.slint";
import { MediaTabBar } from "tab_bar.slint";
import { TabItemModel } from "types.slint";

export component TopToolbar inherits Rectangle {
    height: 38px;
    background: Theme.surface;

    in property <bool> is-browse-active: true;
    in property <bool> is-tab-grid-active: false;
    in property <[TabItemModel]> tabs: [];
    in property <bool> show-tab-rating-badge: false;

    // Tab Drag & Drop State
    in property <bool> is-dragging-tab: false;
    in property <length> drag-ghost-x: 0px;
    in property <string> drag-ghost-title: "";
    in property <string> drag-ghost-format: "";
    in property <IconId> drag-ghost-icon: IconId.media-image;
    in property <int> drag-ghost-rating: 0;
    in property <bool> drag-ghost-is-active: false;

    callback browse-clicked();
    callback tab-grid-clicked();
    callback settings-clicked();
    callback tab-selected(int /* tab_id */);
    callback tab-multi-selected(int /* tab_id */, bool /* ctrl */, bool /* shift */);
    callback tab-selection-cleared();
    callback tab-closed(int /* tab_id */);
    callback tab-context-menu(int /* tab_id */, length /* x */, length /* y */);
    callback tab-wheel-scrolled(bool /* is_next */);

    callback tab-drag-started(int /* tab_id */, int /* source_index */, length /* mouse_x */, length /* tab_width */);
    callback tab-drag-moved(length /* mouse_x */, length /* view_width */);
    callback tab-drag-ended(int /* tab_id */, int /* target_index */);
    callback tab-drag-cancelled(int /* tab_id */);

    public function scroll-tab-bar-by(dx: length) {
        tab-bar.scroll-by(dx);
    }

    public function scroll-tab-into-view(tab-x: length, tab-width: length) {
        tab-bar.scroll-tab-into-view(tab-x, tab-width);
    }

    // Bottom border separator line
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;

        // 1. Permanent Browse button strictly on the far left
        ToolbarButton {
            text: "Browse";
            icon: IconId.library-browse;
            tooltip: "Switch to Library Media Browser";
            is-active: root.is-browse-active;
            height: 28px;
            y: (parent.height - self.height) / 2;
            clicked => { root.browse-clicked(); }
        }

        ToolbarSeparator {}

        // 2. Permanent Tab-Grid button to the right of Browse
        ToolbarButton {
            text: "Tab-Grid";
            icon: IconId.view-tab-grid;
            tooltip: "Masonry overview of all open tabs (Left-click: Open tab, Middle-click: Fullscreen)";
            is-active: root.is-tab-grid-active;
            height: 28px;
            y: (parent.height - self.height) / 2;
            clicked => { root.tab-grid-clicked(); }
        }

        ToolbarSeparator {}

        // 3. Embedded MediaTabBar with integrated Drag & Drop Reordering and Mouse Wheel Tab Cycling
        tab-bar := MediaTabBar {
            horizontal-stretch: 1;
            height: 28px;
            y: (parent.height - self.height) / 2;
            tabs: root.tabs;
            show-rating-badge: root.show-tab-rating-badge;

            is-dragging-tab: root.is-dragging-tab;
            drag-ghost-x: root.drag-ghost-x;
            drag-ghost-title: root.drag-ghost-title;
            drag-ghost-format: root.drag-ghost-format;
            drag-ghost-icon: root.drag-ghost-icon;
            drag-ghost-rating: root.drag-ghost-rating;
            drag-ghost-is-active: root.drag-ghost-is-active;

            tab-selected(id) => { root.tab-selected(id); }
            tab-multi-selected(id, ctrl, shift) => { root.tab-multi-selected(id, ctrl, shift); }
            tab-selection-cleared => { root.tab-selection-cleared(); }
            tab-closed(id) => { root.tab-closed(id); }
            tab-context-menu(id, x, y) => { root.tab-context-menu(id, self.x + x, self.y + y); }
            tab-wheel-scrolled(is-next) => { root.tab-wheel-scrolled(is-next); }

            tab-drag-started(id, s-idx, mx, tw) => {
                root.tab-drag-started(id, s-idx, mx, tw);
            }
            tab-drag-moved(mx, vw) => {
                root.tab-drag-moved(mx, vw);
            }
            tab-drag-ended(id, t-idx) => {
                root.tab-drag-ended(id, t-idx);
            }
            tab-drag-cancelled(id) => {
                root.tab-drag-cancelled(id);
            }
        }

        ToolbarSeparator {}

        // 4. Settings Button strictly on the far right
        ToolbarButton {
            text: "Settings";
            icon: IconId.settings;
            tooltip: "Application configuration and settings";
            font-size: 12px;
            height: 28px;
            y: (parent.height - self.height) / 2;
            clicked => { root.settings-clicked(); }
        }
    }
}
