import { Theme } from "styles.slint";
import { IconId } from "icons.slint";
import { DialogHeading } from "dialog_heading.slint";
import { ButtonBar } from "button_bar.slint";

/// Tells the user that the selected tabs hold more media than one Multiview shows, and how many have to go first.
export component TabMergeLimitDialog inherits Window {
    title: "RustView - Merge Tabs";
    width: 460px;
    preferred-height: dialog-layout.preferred-height;
    min-height: dialog-layout.preferred-height;
    always-on-top: true;
    background: Theme.background;

    in property <string> message: "";
    in property <string> breakdown: "";

    callback closed();

    forward-focus: dialog-focus;

    dialog-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape || event.text == Key.Return {
                root.closed();
                return accept;
            }
            return reject;
        }

        dialog-layout := VerticalLayout {
            width: root.width;
            padding: 0px;
            spacing: 0px;
            alignment: space-between;

            VerticalLayout {
                width: root.width;
                padding: 16px;
                spacing: 12px;
                vertical-stretch: 1;

                DialogHeading {
                    icon: IconId.status-warning;
                    text: "Too Many Media to Merge";
                    color: #fab387;
                }

                Text {
                    text: root.message;
                    font-size: 12px;
                    color: Theme.text;
                    wrap: word-wrap;
                }

                if root.breakdown != "" : Text {
                    text: root.breakdown;
                    font-size: 11px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
            }

            ButtonBar {
                vertical-stretch: 0;
                bar-height: 48px;
                show-ok: true;
                text-ok: "OK";
                ok-clicked => { root.closed(); }
            }
        }
    }
}
