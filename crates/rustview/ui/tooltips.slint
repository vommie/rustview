import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize, IconSlot } from "icons.slint";

/// Global configuration and state registry for the centralized Tooltip Subsystem.
export global TooltipSettings {
    // Master enable flag (synchronized from AppSettings.appearance.enable_tooltips)
    in-out property <bool> enabled: true;

    // Master default delay before a tooltip opens (synchronized from AppSettings.appearance.tooltip_delay_ms)
    in-out property <duration> default-delay: 750ms;

    // Default Visual Styling (Theme adaptive)
    in-out property <color> default-background: #181825f2;
    in-out property <color> default-border: #45475acc;
    in-out property <color> default-text: #cdd6f4;
    in-out property <color> default-shortcut-color: #f9e2af;
    in-out property <length> default-font-size: 12px;
    in-out property <length> default-corner-radius: 4px;
    in-out property <length> default-padding-h: 9px;
    in-out property <length> default-padding-v: 5px;
    in-out property <length> max-width: 340px;
}

/// Single source of truth for the reasons appended to tooltips of disabled elements.
/// Tooltips stay visible on disabled elements; dynamic ones append one of these lines (after a line break)
/// so the user learns why the action is currently unavailable.
export global TooltipReasons {
    /// Same wording as `wording::busy_hint()` (Rust, context menus), so toolbar and menu entries read identically.
    out property <string> busy: "Disabled: Another scan, refresh or thumbnail operation is currently in progress";
}

/// Global non-blocking Tooltip Overlay state manager.
/// Manages tooltip visibility and positioning without creating modal popup window grabs.
export global GlobalTooltip {
    in-out property <bool> is-visible: false;
    in-out property <string> text: "";
    in-out property <string> shortcut: "";
    // The element acts only when held (hold.slint): the bubble shows the hold badge.
    in-out property <bool> hold: false;
    in-out property <IconId> icon: IconId.none;
    in-out property <length> pos-x: 0px;
    in-out property <length> pos-y: 0px;

    public function show(
        text: string,
        shortcut: string,
        icon: IconId,
        x: length,
        y: length
    ) {
        root.text = text;
        root.shortcut = shortcut;
        root.icon = icon;
        root.pos-x = x;
        root.pos-y = y;
        root.is-visible = true;
    }

    public function hide() {
        root.is-visible = false;
    }
}

/// Standalone visual tooltip bubble component with border, drop shadow, text, and optional shortcut badge.
export component TooltipBubble inherits Rectangle {
    in property <string> text: "";
    in property <string> shortcut: "";
    in property <IconId> icon: IconId.none;
    property <bool> has-icon: root.icon != IconId.none;

    // Custom Style Overrides (falls back to TooltipSettings defaults if transparent / 0)
    in property <color> custom-bg: transparent;
    in property <color> custom-border: transparent;
    in property <color> custom-text: transparent;
    in property <length> custom-font-size: 0px;

    background: (root.custom-bg != transparent) ? root.custom-bg : TooltipSettings.default-background;
    border-radius: TooltipSettings.default-corner-radius;
    border-width: 1px;
    border-color: (root.custom-border != transparent) ? root.custom-border : TooltipSettings.default-border;
    drop-shadow-blur: 8px;
    drop-shadow-color: #000000aa;
    drop-shadow-offset-y: 2px;

    HorizontalLayout {
        padding-left: TooltipSettings.default-padding-h;
        padding-right: TooltipSettings.default-padding-h;
        padding-top: TooltipSettings.default-padding-v;
        padding-bottom: TooltipSettings.default-padding-v;
        spacing: 6px;
        alignment: center;

        if root.has-icon : IconSlot {
            icon: root.icon;
            size: IconSize.sm;
            color: (root.custom-text != transparent) ? root.custom-text : TooltipSettings.default-text;
        }

        Text {
            text: root.text;
            font-size: (root.custom-font-size > 0px) ? root.custom-font-size : TooltipSettings.default-font-size;
            color: (root.custom-text != transparent) ? root.custom-text : TooltipSettings.default-text;
            vertical-alignment: center;
            horizontal-alignment: left;
        }

        if root.shortcut != "" : Rectangle {
            background: #ffffff14;
            border-radius: 3px;
            border-width: 1px;
            border-color: #ffffff22;
            height: 18px;
            y: (parent.height - self.height) / 2;

            HorizontalLayout {
                padding-left: 5px;
                padding-right: 5px;
                alignment: center;

                Text {
                    text: root.shortcut;
                    font-size: 10.5px;
                    font-weight: 700;
                    color: TooltipSettings.default-shortcut-color;
                    vertical-alignment: center;
                }
            }
        }
    }
}

/// Generic, modular TooltipHost controller component.
/// Embedded directly inside any button or UI element to manage hover timing, delay, cursor tracking,
/// and instant click-through without modal input interception.
export component TooltipHost inherits Rectangle {
    in property <string> text: "";
    in property <string> shortcut: "";
    in property <IconId> icon: IconId.none;
    in property <bool> is-enabled: true;
    // The element acts only when held: the bubble shows the hold badge (also without a text).
    in property <bool> hold: false;

    // Behavioral Options
    in property <duration> delay: 0ms; // 0ms = use TooltipSettings.default-delay
    in property <bool> follow-cursor: false;
    in property <length> offset-x: 0px;
    in property <length> offset-y: 0px;

    // Internal State
    property <bool> is-hovered: false;
    property <duration> effective-delay: (root.delay > 0ms) ? root.delay : TooltipSettings.default-delay;

    width: 100%;
    height: 100%;
    x: 0px;
    y: 0px;
    background: transparent;

    hover-timer := Timer {
        interval: root.effective-delay;
        running: false;
        triggered() => {
            if root.is-hovered && TooltipSettings.enabled && root.is-enabled && (root.text != "" || root.hold) {
                let target-x = root.absolute-position.x + root.offset-x;
                let target-y = root.absolute-position.y + root.height + 4px + root.offset-y;
                GlobalTooltip.hold = root.hold;
                GlobalTooltip.show(
                    root.text,
                    root.shortcut,
                    root.icon,
                    target-x,
                    target-y
                );
            }
            self.running = false;
        }
    }

    /// Invoked when mouse enters the host component area
    public function on-hover-enter(mx: length, my: length) {
        root.is-hovered = true;
        if TooltipSettings.enabled && root.is-enabled && (root.text != "" || root.hold) {
            if root.effective-delay <= 0ms {
                root.show-now(mx, my);
            } else {
                hover-timer.running = true;
            }
        }
    }

    /// Shows the tooltip at once, without the delay (a short click on a held element explains why nothing happened).
    public function reveal(mx: length, my: length) {
        root.is-hovered = true;
        hover-timer.running = false;
        if TooltipSettings.enabled && root.is-enabled && (root.text != "" || root.hold) {
            root.show-now(mx, my);
        }
    }

    function show-now(mx: length, my: length) {
        let target-x = root.follow-cursor
            ? (root.absolute-position.x + mx + 8px)
            : (root.absolute-position.x + root.offset-x);
        let target-y = root.follow-cursor
            ? (root.absolute-position.y + my + 16px)
            : (root.absolute-position.y + root.height + 4px + root.offset-y);
        GlobalTooltip.hold = root.hold;
        GlobalTooltip.show(
            root.text,
            root.shortcut,
            root.icon,
            target-x,
            target-y
        );
    }

    /// Invoked when mouse leaves the host component area or on click
    public function on-hover-leave() {
        root.is-hovered = false;
        hover-timer.running = false;
        GlobalTooltip.hide();
    }

    /// Invoked during mouse move when follow-cursor is active
    public function on-mouse-move(mx: length, my: length) {
        if root.follow-cursor && root.is-hovered && GlobalTooltip.is-visible {
            GlobalTooltip.pos-x = root.absolute-position.x + mx + 8px;
            GlobalTooltip.pos-y = root.absolute-position.y + my + 16px;
        }
    }
}

/// Standalone wrapper area component that can wrap arbitrary children and provide tooltips.
export component TooltipArea inherits Rectangle {
    in property <string> text: "";
    in property <string> shortcut: "";
    in property <IconId> icon: IconId.none;
    in property <bool> tooltip-enabled: true;
    in property <duration> delay: 0ms;
    in property <bool> follow-cursor: false;
    in property <length> offset-x: 0px;
    in property <length> offset-y: 0px;
    in property <MouseCursor> cursor: MouseCursor.default;

    callback clicked();
    // A press of the right mouse button (a control with a second meaning on the right click).
    callback right-clicked();

    out property <bool> has-hover: touch.has-hover;

    tooltip-host := TooltipHost {
        text: root.text;
        shortcut: root.shortcut;
        icon: root.icon;
        is-enabled: root.tooltip-enabled;
        delay: root.delay;
        follow-cursor: root.follow-cursor;
        offset-x: root.offset-x;
        offset-y: root.offset-y;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: root.cursor;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                tooltip-host.on-hover-leave();
                if event.button == PointerEventButton.right {
                    root.right-clicked();
                }
            }
        }
        clicked => {
            tooltip-host.on-hover-leave();
            root.clicked();
        }
        moved => {
            tooltip-host.on-mouse-move(self.mouse-x, self.mouse-y);
        }
    }

    property <bool> is-hovered: touch.has-hover && root.text != "" && root.tooltip-enabled;
    changed is-hovered => {
        if self.is-hovered {
            tooltip-host.on-hover-enter(touch.mouse-x, touch.mouse-y);
        } else {
            tooltip-host.on-hover-leave();
        }
    }

    @children
}
