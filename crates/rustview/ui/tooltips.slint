// The tooltips, RustCut's bubbles (RustCut's `ui/tooltip.slint`, which grew out of this file; same author, kept alike):
// one bubble per window, drawn by `GlobalTooltipLayer` (global_tooltip_layer.slint) on top of everything (no popup
// window, so it never grabs the pointer). An element embeds a `TooltipHost` (or wraps its children in a `TooltipArea`):
// it waits for the hover delay and hands its tip and its rectangle to `GlobalTooltip`. The layer places the bubble next
// to the element with a tail pointing at it (`TooltipLogic.place`, Rust `src/ui/tooltip/placement.rs`), glides from
// element to element and shows the next tip at once while one just closed. RustView keeps its extras: an icon before
// the text, tips of context menu entries only while a menu is open, and tips that follow the pointer.

import { IconId } from "icons.slint";

export global TooltipSettings {
    // Settings > Appearance (`appearance.enable_tooltips`, `appearance.tooltip_delay_ms`).
    in-out property <bool> enabled: true;
    in-out property <duration> default-delay: 600ms;
    // After a tooltip closed, the next one within this time shows at once (moving along a row of buttons).
    out property <duration> warm-up: 700ms;
    out property <color> background: #181825f4;
    out property <color> border: #45475acc;
    out property <color> text: #cdd6f4;
    out property <color> muted: #a6adc8;
    out property <color> accent: #f9e2af;
    out property <length> font-size: 12px;
    out property <length> small-font-size: 11px;
    out property <length> padding-h: 9px;
    out property <length> padding-v: 6px;
    out property <length> max-width: 320px;
}

/// Single source of truth for the reasons appended to tooltips of disabled elements.
/// Tooltips stay visible on disabled elements; dynamic ones append one of these lines (after a line break)
/// so the user learns why the action is currently unavailable.
export global TooltipReasons {
    /// Same wording as `wording::busy_hint()` (Rust, context menus), so toolbar and menu entries read identically.
    out property <string> busy: "Disabled: Another scan, refresh or thumbnail operation is currently in progress";
}

/// One line of a rich tooltip: a label and its value, or (`heading`) the title of the rows below it.
export struct TipRow {
    label: string,
    value: string,
    heading: bool,
}

/// What a tooltip shows.
export struct Tip {
    title: string,
    text: string,
    // The keys as the keymap writes them ("Ctrl+S", several joined by " or "), or a short explanation.
    shortcut: string,
    rows: [TipRow],
    note: string,
    icon: IconId,
    // The element acts only when held: the bubble shows the hold badge (hold.slint).
    hold: bool,
    // Shows even with tooltips switched off.
    forced: bool,
    // A row of a menu: the bubble goes beside it first, so it never covers the other rows.
    beside: bool,
}

/// A rectangle in window coordinates.
export struct TipRect {
    x: length,
    y: length,
    width: length,
    height: length,
}

/// One key cap: a key's short name or a symbol; `alternative` = another chord of the action starts here ("or").
export struct TipKey {
    text: string,
    icon: IconId,
    alternative: bool,
}

/// The caps of a shortcut text; `keys` is false for a text that is no key (a plain chip, or a line of its own when it is
/// a `sentence`).
export struct TipKeys {
    caps: [TipKey],
    keys: bool,
    alternatives: bool,
    sentence: bool,
}

/// The side of the element the bubble is on.
export enum TipSide { below, above, right, left, over }

/// Where the bubble goes (layer coordinates); `arrow` is the arrow's center along the edge that faces the element.
export struct TipPlacement {
    x: length,
    y: length,
    side: TipSide,
    arrow: length,
}

/// Rust's side (src/ui/tooltip/): the key caps and the placement, pure functions with tests.
export global TooltipLogic {
    pure callback key-caps(/* shortcut */ string) -> TipKeys;
    pure callback place(/* element */ TipRect, /* bubble width */ length, /* bubble height */ length,
        /* area width */ length, /* area height */ length, /* beside first */ bool) -> TipPlacement;
}

/// What the bubble shows and for which element.
export global GlobalTooltip {
    in-out property <bool> is-visible: false;
    in-out property <Tip> tip;
    in-out property <TipRect> anchor;
    // Counts the shows: a host knows whether the bubble is still its own.
    in-out property <int> serial;
    // A tooltip closed a moment ago: the next one skips the delay (the layer cools it down).
    in-out property <bool> warm;
    // The previous bubble was still fading out: the new one glides from its place.
    in-out property <bool> recent;
    in-out property <bool> glide;
    // A context menu of the window is open: only the tooltips of its entries show (`TooltipHost.in-menu`). An element
    // behind the menu's backdrop never hears that the pointer left, so its tooltip would appear over the menu.
    in-out property <bool> menu-open: false;

    public function show(tip: Tip, anchor: TipRect) -> int {
        root.glide = root.is-visible || root.recent;
        root.tip = tip;
        root.anchor = anchor;
        root.serial += 1;
        root.is-visible = true;
        root.warm = true;
        return root.serial;
    }

    /// A shown tip changed (another text under the pointer, the element moved).
    public function update(serial: int, tip: Tip, anchor: TipRect) {
        if serial == root.serial && root.is-visible {
            // Only a moved element glides (the host's first update carries the rectangle `show()` got).
            if anchor != root.anchor {
                root.glide = true;
            }
            root.tip = tip;
            root.anchor = anchor;
        }
    }

    /// The pointer left: the next tooltip close by shows at once.
    public function hide() {
        root.is-visible = false;
    }

    /// A press or a closed dialog: the next tooltip waits for the delay again.
    public function hide-cold() {
        root.is-visible = false;
        root.warm = false;
    }
}

/// Embedded in an element: shows its tip next to the element after the hover delay (at once while another tooltip
/// just closed). The element's touch area calls `on-hover-enter()`/`on-hover-leave()` (or `enter()`/`leave()`) and
/// `press()` on a press.
export component TooltipHost inherits Rectangle {
    in property <string> text;
    in property <string> shortcut;
    in property <string> title;
    in property <[TipRow]> rows;
    in property <string> note;
    in property <IconId> icon: IconId.none;
    in property <bool> is-enabled: true;
    // The element acts only when held: the bubble shows the hold badge (also without a text).
    in property <bool> hold;
    in property <bool> forced;
    in property <bool> beside;
    // The element is an entry of a context menu (see `GlobalTooltip.menu-open`).
    in property <bool> in-menu;
    // 0 ms = `TooltipSettings.default-delay`.
    in property <duration> delay: 0ms;
    // The bubble points at the pointer instead of the element (large areas such as a picture).
    in property <bool> follow-cursor;
    in property <length> offset-x: 0px;
    in property <length> offset-y: 0px;

    property <bool> is-hovered;
    property <length> mouse-x;
    property <length> mouse-y;
    property <int> shown-serial: -1;
    property <bool> mine: GlobalTooltip.is-visible && GlobalTooltip.serial == root.shown-serial;
    property <bool> wanted: (TooltipSettings.enabled || root.forced) && root.is-enabled
        && (root.in-menu || !GlobalTooltip.menu-open)
        && (root.text != "" || root.title != "" || root.rows.length > 0 || root.hold);
    property <Tip> tip: {
        title: root.title,
        text: root.text,
        shortcut: root.shortcut,
        rows: root.rows,
        note: root.note,
        icon: root.icon,
        hold: root.hold,
        forced: root.forced,
        beside: root.beside || root.in-menu,
    };
    // Followed only while the bubble is this host's, so the other hosts track nothing.
    property <Tip> shown-tip: root.mine ? root.tip : { };
    property <TipRect> shown-rect: root.mine ? root.rect() : { };

    x: 0;
    y: 0;
    width: 100%;
    height: 100%;

    function rect() -> TipRect {
        if root.follow-cursor {
            return {
                x: root.absolute-position.x + root.mouse-x,
                y: root.absolute-position.y + root.mouse-y,
                width: 1px,
                height: 16px,
            };
        }
        return {
            x: root.absolute-position.x + root.offset-x,
            y: root.absolute-position.y + root.offset-y,
            width: root.width,
            height: root.height,
        };
    }

    timer := Timer {
        interval: root.delay > 0ms ? root.delay : TooltipSettings.default-delay;
        running: false;
        triggered => {
            self.running = false;
            if root.is-hovered {
                root.show-now();
            }
        }
    }

    function show-now() {
        if root.wanted {
            root.shown-serial = GlobalTooltip.show(root.tip, root.rect());
        }
    }

    public function enter() {
        root.is-hovered = true;
        if !root.wanted {
            return;
        }
        if GlobalTooltip.warm {
            timer.running = false;
            root.show-now();
        } else {
            timer.start();
        }
    }

    public function leave() {
        root.is-hovered = false;
        timer.running = false;
        if root.mine {
            GlobalTooltip.hide();
        }
    }

    public function press() {
        root.is-hovered = false;
        timer.running = false;
        if root.mine {
            GlobalTooltip.hide-cold();
        }
    }

    /// Invoked when the pointer enters the element (`mx`, `my` in the element's coordinates).
    public function on-hover-enter(mx: length, my: length) {
        root.mouse-x = mx;
        root.mouse-y = my;
        root.enter();
    }

    /// Invoked when the pointer leaves the element, or on a click.
    public function on-hover-leave() {
        root.leave();
    }

    /// Shows the tooltip at once, without the delay (a short click on a held element explains why nothing happened).
    public function reveal(mx: length, my: length) {
        root.mouse-x = mx;
        root.mouse-y = my;
        root.is-hovered = true;
        timer.running = false;
        root.show-now();
    }

    /// The pointer moved over the element: a tip that follows the pointer moves along.
    public function on-mouse-move(mx: length, my: length) {
        if root.follow-cursor {
            root.mouse-x = mx;
            root.mouse-y = my;
        }
    }

    // The bubble follows a tip that changes under the pointer and an element that moves.
    changed shown-tip => {
        if root.mine {
            GlobalTooltip.update(root.shown-serial, root.tip, root.rect());
        }
    }
    changed shown-rect => {
        if root.mine {
            GlobalTooltip.update(root.shown-serial, root.tip, root.rect());
        }
    }
    changed wanted => {
        if !root.wanted && root.mine {
            GlobalTooltip.hide();
        }
    }
}

/// A transparent area with a tooltip over its children (labels, fields, pictures). Its touch area lies under the
/// children, so they keep their clicks; `clicked` and `right-clicked` report clicks on the area itself.
export component TooltipArea inherits Rectangle {
    in property <string> text;
    in property <string> shortcut;
    in property <string> title;
    in property <[TipRow]> rows;
    in property <string> note;
    in property <IconId> icon: IconId.none;
    in property <bool> tooltip-enabled: true;
    in property <bool> forced;
    in property <duration> delay: 0ms;
    in property <bool> follow-cursor;
    in property <length> offset-x: 0px;
    in property <length> offset-y: 0px;
    in property <MouseCursor> cursor: MouseCursor.default;
    in property <bool> in-menu;

    callback clicked();
    // A press of the right mouse button (a control with a second meaning on the right click).
    callback right-clicked();

    out property <bool> has-hover: touch.has-hover;

    host := TooltipHost {
        text: root.text;
        shortcut: root.shortcut;
        title: root.title;
        rows: root.rows;
        note: root.note;
        icon: root.icon;
        is-enabled: root.tooltip-enabled;
        forced: root.forced;
        in-menu: root.in-menu;
        delay: root.delay;
        follow-cursor: root.follow-cursor;
        offset-x: root.offset-x;
        offset-y: root.offset-y;
    }

    property <bool> timer-started;

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: root.cursor;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                host.press();
                if event.button == PointerEventButton.right {
                    root.right-clicked();
                }
            } else if event.kind == PointerEventKind.move && self.has-hover && !root.timer-started {
                // The area appeared under a resting pointer (no hover change): the first move starts it.
                root.timer-started = true;
                host.on-hover-enter(self.mouse-x, self.mouse-y);
            }
        }
        clicked => {
            host.press();
            root.clicked();
        }
        moved => {
            host.on-mouse-move(self.mouse-x, self.mouse-y);
        }
        changed has-hover => {
            if self.has-hover {
                root.timer-started = true;
                host.on-hover-enter(self.mouse-x, self.mouse-y);
            } else {
                root.timer-started = false;
                host.on-hover-leave();
            }
        }
    }

    @children
}
