import { Button, ComboBox, LineEdit, Slider } from "std-widgets.slint";
import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { DialogHeading } from "dialog_heading.slint";
import { ButtonBar } from "button_bar.slint";
import { InlineNotice } from "inline_notice.slint";
import { ToggleSwitch } from "toggle_switch.slint";
import { DialogBody } from "dialog_body.slint";

/// A row of an options card: the name (and a hint below it) on the left, the control on the right, both at the top. `hint-width`
/// is the width the hint wraps at (Slint measures wrapped text in nested layouts as one line unless its width is given).
component OptionRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    in property <bool> enabled: true;
    in property <length> hint-width;

    spacing: 12px;
    padding-top: 2px;
    padding-bottom: 2px;

    VerticalLayout {
        horizontal-stretch: 1;
        alignment: start;
        spacing: 1px;

        Text {
            text: root.label;
            font-size: 12px;
            color: root.enabled ? Theme.text : Theme.text-muted;
        }

        if root.hint != "" : Text {
            width: root.hint-width;
            text: root.hint;
            font-size: 10px;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
    }

    VerticalLayout {
        alignment: start;
        @children
    }
}

/// A slider with its value next to it.
component ValueSlider inherits HorizontalLayout {
    in property <int> minimum: 1;
    in property <int> maximum: 100;
    in-out property <int> value: 90;
    in property <bool> enabled: true;

    callback edited();

    spacing: 8px;

    Slider {
        width: 170px;
        minimum: root.minimum;
        maximum: root.maximum;
        value: root.value;
        enabled: root.enabled;
        changed(v) => {
            root.value = Math.round(v);
            root.edited();
        }
    }

    Text {
        text: root.value;
        width: 30px;
        font-size: 12px;
        font-weight: 700;
        color: root.enabled ? Theme.primary : Theme.text-muted;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

/// A switch for an options card.
component OptionSwitch inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;

    callback edited();

    width: 36px;
    height: 20px;

    ToggleSwitch {
        checked: root.checked;
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.checked = !root.checked;
            root.edited();
        }
    }
}

/// A rounded card around option rows.
component OptionCard inherits Rectangle {
    border-radius: 8px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    min-height: card-layout.min-height;
    preferred-height: card-layout.preferred-height;

    card-layout := VerticalLayout {
        padding: 12px;
        spacing: 6px;
        alignment: start;

        @children
    }
}

/// A small caption above a field.
component FieldLabel inherits Text {
    font-size: 11px;
    color: Theme.text-muted;
}

/// "Save As": writes the edited picture to a file of the user's choice (the original's name, folder and format at first, so an
/// unchanged name replaces the original), in a format of their choice and with the few options that matter for it. Also shown
/// when the original's format cannot be written (`note` says why). Rust checks the name and the folder on every change
/// (`changed`) and fills `warnings`, `exists`, `folder-notice` and `error`. The window can be made wider; it scrolls when it is
/// made lower than its content.
export component ImageExportDialog inherits Window {
    title: "RustView - Save As";
    preferred-width: 560px;
    min-width: 460px;
    preferred-height: dialog-layout.preferred-height;
    min-height: dialog-layout.min-height;
    background: Theme.background;

    // Why the picture is saved as a new file (empty for a plain Save As).
    in property <string> note: "";
    in-out property <string> file-name: "";
    in property <string> extension: "jpg";
    in-out property <string> folder: "";
    // 0 = JPEG, 1 = PNG, 2 = WebP, 3 = AVIF, 4 = TIFF, 5 = BMP (`WriteFormat::EXPORT_TARGETS`)
    in-out property <int> format-index: 0;
    in-out property <int> jpeg-quality: 90;
    in-out property <int> jpeg-subsampling-index: 0; // 0 = 4:2:0, 1 = 4:2:2, 2 = 4:4:4
    in-out property <bool> jpeg-progressive: false;
    in-out property <int> png-compression-index: 1; // 0 = fast, 1 = balanced, 2 = smallest
    in-out property <bool> webp-lossless: false;
    in-out property <int> webp-quality: 90;
    in-out property <int> avif-quality: 80;
    in-out property <int> avif-speed: 6;
    in-out property <int> tiff-compression-index: 1; // 0 = none, 1 = LZW, 2 = Deflate
    // The chosen format is the original's own: it can be saved like the original (lossless where possible).
    in property <bool> same-available: false;
    in-out property <bool> same-as-original: true;
    // How "Same as original" saves this picture ("Cut out without any loss", ...).
    in property <string> same-hint: "";
    // The original has a rating or tags ("4 stars and 2 tags"); empty = it has none, or the file is the original itself.
    in property <string> assignments: "";
    in-out property <bool> keep-assignments: true;
    // What the chosen format loses of the picture ("transparency becomes white", ...).
    in property <[string]> warnings;
    // A file of that name is in the folder: saving replaces it (`exists-text` says which).
    in property <bool> exists: false;
    in property <string> exists-text: "";
    // The folder does not exist yet and is created when saving.
    in property <string> folder-notice: "";
    // The name or the folder cannot be used (the Save button is off then).
    in property <string> error: "";
    // The picture: "893 x 1116 px".
    in property <string> size-text: "";

    callback changed();
    callback browse();
    callback save();
    callback cancel();

    property <[string]> format-names: ["JPEG", "PNG", "WebP", "AVIF", "TIFF", "BMP"];
    // The text column of an option row: the window less the paddings of the dialog (18) and the card (12) and the row spacing.
    // The width is 0 while Slint asks for the size the window opens at; it opens at its preferred width.
    property <length> option-text-width: (root.width > 1px ? root.width : root.preferred-width) - 2 * 18px - 2 * 12px - 12px;
    property <length> slider-width: 208px;
    property <length> combo-width: 170px;
    property <length> switch-width: 36px;
    property <bool> options-enabled: !(root.same-available && root.same-as-original);

    forward-focus: name-input;

    /// Puts the text cursor at the end of the name (called each time the dialog is shown; `at` = the name's length in bytes).
    public function focus-name(at: int) {
        name-input.focus();
        name-input.set-selection-offsets(at, at);
    }

    dialog-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel();
                return accept;
            }
            if event.text == Key.Return && root.error == "" {
                root.save();
                return accept;
            }
            return reject;
        }

        dialog-layout := VerticalLayout {
            width: root.width;
            padding: 0px;
            spacing: 0px;

            body := DialogBody {
                content-height: content.preferred-height;

                content := VerticalLayout {
                    width: body.width;
                    height: self.preferred-height;
                    padding: 18px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 8px;

                        DialogHeading {
                            horizontal-stretch: 1;
                            icon: IconId.save-as;
                            text: "Save As";
                            color: Theme.primary;
                        }

                        if root.size-text != "" : VerticalLayout {
                            alignment: center;

                            Rectangle {
                                width: size-label.preferred-width + 16px;
                                height: 22px;
                                border-radius: 11px;
                                background: Theme.surface-variant;

                                size-label := Text {
                                    text: root.size-text;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: Theme.text-muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    if root.note != "" : InlineNotice {
                        icon: IconId.status-warning;
                        text: root.note;
                        color: #fab387;
                    }

                    VerticalLayout {
                        spacing: 6px;

                        FieldLabel {
                            text: "File name";
                        }

                        HorizontalLayout {
                            spacing: 6px;

                            name-input := LineEdit {
                                horizontal-stretch: 1;
                                text <=> root.file-name;
                                edited => {
                                    root.changed();
                                }
                                accepted => {
                                    if root.error == "" {
                                        root.save();
                                    }
                                }
                            }

                            Text {
                                text: "." + root.extension;
                                font-size: 13px;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;

                        FieldLabel {
                            text: "Folder";
                        }

                        HorizontalLayout {
                            spacing: 6px;

                            VerticalLayout {
                                alignment: center;

                                AppIcon {
                                    icon: IconId.folder;
                                    size: IconSize.md;
                                    color: Theme.text-muted;
                                }
                            }

                            folder-input := LineEdit {
                                horizontal-stretch: 1;
                                text <=> root.folder;
                                placeholder-text: "/path/to/folder";
                                edited => {
                                    root.changed();
                                }
                                accepted => {
                                    if root.error == "" {
                                        root.save();
                                    }
                                }
                            }

                            Button {
                                text: "Browse...";
                                clicked => {
                                    root.browse();
                                }
                            }
                        }
                    }

                    // Format: a segmented row of chips.
                    Rectangle {
                        height: 30px;
                        border-radius: 8px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;

                        HorizontalLayout {
                            padding: 2px;
                            spacing: 2px;

                            for name[index] in root.format-names : Rectangle {
                                border-radius: 6px;
                                background: index == root.format-index ? Theme.primary : (chip.has-hover ? Theme.surface-hover : transparent);
                                animate background { duration: 100ms; }

                                chip := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        root.format-index = index;
                                        root.changed();
                                    }
                                }

                                Text {
                                    text: name;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: index == root.format-index ? Theme.background : Theme.text;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // The options of the chosen format.
                    OptionCard {
                        if root.same-available : OptionRow {
                            hint-width: root.option-text-width - root.switch-width;
                            label: "Same as original";
                            hint: root.same-hint;
                            OptionSwitch {
                                checked <=> root.same-as-original;
                                edited => { root.changed(); }
                            }
                        }

                        if root.same-available : Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }

                        if root.format-index == 0 : OptionRow {
                            hint-width: root.option-text-width - root.slider-width;
                            label: "Quality";
                            hint: "90 keeps fine detail; below 75 compression shows.";
                            enabled: root.options-enabled;
                            ValueSlider {
                                value <=> root.jpeg-quality;
                                enabled: root.options-enabled;
                                edited => { root.changed(); }
                            }
                        }
                        if root.format-index == 0 : OptionRow {
                            hint-width: root.option-text-width - root.combo-width;
                            label: "Chroma subsampling";
                            hint: "4:2:0 for photos, 4:4:4 for sharp colored edges (text, graphics).";
                            enabled: root.options-enabled;
                            ComboBox {
                                width: 170px;
                                model: ["4:2:0 (smallest)", "4:2:2", "4:4:4 (sharpest colors)"];
                                current-index <=> root.jpeg-subsampling-index;
                                enabled: root.options-enabled;
                                selected => { root.changed(); }
                            }
                        }
                        if root.format-index == 0 : OptionRow {
                            hint-width: root.option-text-width - root.switch-width;
                            label: "Progressive";
                            hint: "Builds up while loading on the web; usually a little smaller.";
                            enabled: root.options-enabled;
                            OptionSwitch {
                                checked <=> root.jpeg-progressive;
                                enabled: root.options-enabled;
                                edited => { root.changed(); }
                            }
                        }

                        if root.format-index == 1 : OptionRow {
                            hint-width: root.option-text-width - root.combo-width;
                            label: "Compression";
                            hint: "Lossless in every case; only the file size and the time to write it differ.";
                            enabled: root.options-enabled;
                            ComboBox {
                                width: 170px;
                                model: ["Fast", "Balanced", "Smallest file"];
                                current-index <=> root.png-compression-index;
                                enabled: root.options-enabled;
                                selected => { root.changed(); }
                            }
                        }

                        if root.format-index == 2 : OptionRow {
                            hint-width: root.option-text-width - root.switch-width;
                            label: "Lossless";
                            hint: "Keeps every pixel; larger files.";
                            enabled: root.options-enabled;
                            OptionSwitch {
                                checked <=> root.webp-lossless;
                                enabled: root.options-enabled;
                                edited => { root.changed(); }
                            }
                        }
                        if root.format-index == 2 : OptionRow {
                            hint-width: root.option-text-width - root.slider-width;
                            label: "Quality";
                            hint: root.webp-lossless ? "Not used for lossless files." : "85 to 90 is a good choice for photos.";
                            enabled: root.options-enabled && !root.webp-lossless;
                            ValueSlider {
                                value <=> root.webp-quality;
                                enabled: root.options-enabled && !root.webp-lossless;
                                edited => { root.changed(); }
                            }
                        }

                        if root.format-index == 3 : OptionRow {
                            hint-width: root.option-text-width - root.slider-width;
                            label: "Quality";
                            hint: "AVIF looks good at lower values than JPEG; 70 to 80 suits photos.";
                            enabled: root.options-enabled;
                            ValueSlider {
                                value <=> root.avif-quality;
                                enabled: root.options-enabled;
                                edited => { root.changed(); }
                            }
                        }
                        if root.format-index == 3 : OptionRow {
                            hint-width: root.option-text-width - root.slider-width;
                            label: "Speed";
                            hint: "Slower makes smaller files; encoding a large photo can take a while.";
                            enabled: root.options-enabled;
                            ValueSlider {
                                minimum: 1;
                                maximum: 10;
                                value <=> root.avif-speed;
                                enabled: root.options-enabled;
                                edited => { root.changed(); }
                            }
                        }

                        if root.format-index == 4 : OptionRow {
                            hint-width: root.option-text-width - root.combo-width;
                            label: "Compression";
                            hint: "Lossless; LZW is read by every program.";
                            enabled: root.options-enabled;
                            ComboBox {
                                width: 170px;
                                model: ["None", "LZW", "Deflate"];
                                current-index <=> root.tiff-compression-index;
                                enabled: root.options-enabled;
                                selected => { root.changed(); }
                            }
                        }

                        if root.format-index == 5 : Text {
                            text: "BMP has no options: the picture is stored uncompressed.";
                            font-size: 12px;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }

                    if root.assignments != "" : OptionCard {
                        OptionRow {
                            hint-width: root.option-text-width - root.switch-width;
                            label: "Keep rating and tags";
                            hint: "The new file gets the " + root.assignments + " of the original.";
                            OptionSwitch {
                                checked <=> root.keep-assignments;
                            }
                        }
                    }

                    for warning in root.warnings : InlineNotice {
                        icon: IconId.status-warning;
                        text: warning;
                        color: #fab387;
                    }

                    if root.folder-notice != "" && root.error == "" : InlineNotice {
                        icon: IconId.folder-plus;
                        text: root.folder-notice;
                        color: Theme.primary;
                    }

                    if root.exists && root.error == "" : InlineNotice {
                        icon: IconId.status-warning;
                        text: root.exists-text;
                        color: Theme.status-corrupt;
                    }

                    if root.error != "" : InlineNotice {
                        icon: IconId.status-error;
                        text: root.error;
                        color: Theme.status-corrupt;
                    }
                }
            }

            ButtonBar {
                vertical-stretch: 0;
                bar-height: 48px;
                show-cancel: true;
                show-save: true;
                enabled-save: root.error == "";
                text-save: root.exists ? "Replace" : "Save";
                save-clicked => {
                    if root.error == "" {
                        root.save();
                    }
                }
                cancel-clicked => { root.cancel(); }
            }
        }
    }
}
