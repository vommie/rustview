import { Theme, MediaTheme } from "styles.slint";
import { ContextMenuItemModel } from "types.slint";
import { ContextMenuItemRow } from "context_menu.slint";
import { SmoothScrollArea } from "smooth_scroll_view.slint";
import { BarMenuFilterRow, BarMenuRowMeasure, BarMenuSliderRow } from "multiview_bar_menu_rows.slint";

/// Drop-down of a button of the media action bar, drawn as a speech bubble: a caret points at the button that opened it, the body is
/// slightly translucent and holds the same rows as a context menu. Any bar button with a menu uses this component, and the zoom
/// sliders (of the bar and of the minimap) sit in the same bubble; its owner decides where it sits (`anchor-x` is the center of the
/// opener, relative to the left edge of this component).
export component MultiviewBarMenu inherits Rectangle {
    in property <[ContextMenuItemModel]> items;
    in property <length> anchor-x: 0px;
    // The body's fill: slightly see-through by default; the minimap's slider bubble sits on the picture and is opaque.
    in property <color> fill: MediaTheme.surface.with-alpha(0.9);
    // The caret is under the bubble and points down (a bubble that sits above its opener) instead of up.
    in property <bool> caret-down: false;
    in property <length> max-content-height: 300px;
    // The row with this id stays highlighted (its submenu is open beside the bubble; -1 = none).
    in property <int> active-id: -1;
    // More than 0: the bubble holds its children (the zoom slider) instead of the rows, and is this tall (plus its padding).
    in property <length> custom-height: 0px;
    // False: no caret (a submenu beside its menu).
    in property <bool> show-caret: true;
    out property <length> caret-height: root.show-caret ? 7px : 0px;
    out property <length> content-height: root.caret-height + root.body-height;
    out property <length> corner-radius: 8px;
    out property <length> caret-center-x: root.caret-x;
    // The width the rows need (each measured as it is laid out; filter rows with the menu's value column), kept between
    // `min-natural-width` and `max-natural-width`: a menu that wants it takes `width: self.natural-width`.
    in property <length> min-natural-width: 150px;
    in property <length> max-natural-width: 440px;
    out property <length> natural-width: Math.clamp(row-measure.preferred-width + 8px + 2px + 7px, root.min-natural-width, root.max-natural-width);
    // The value column of the filter rows: as wide as the widest value any row can show (so it never changes width).
    out property <length> value-width: value-measure.preferred-width;
    // A row opens a submenu: only then do the filter and slider rows keep a column for the chevron.
    out property <bool> has-submenus: submenu-measure.preferred-width > 0px;

    property <length> body-height: root.custom-height > 0px ? root.custom-height : Math.min(menu-layout.preferred-height + 8px, Math.max(root.max-content-height - root.caret-height, 0px));
    property <length> caret-x: Math.max(14px, Math.min(root.width - 14px, root.anchor-x));

    callback item-clicked(int /* item id */);
    // A slider row (kind 6) moved: its id, the share of its track and the phase (0 = press, 1 = drag, 2 = let go).
    callback item-slider(int, float, int);
    // The reset button of a filter or slider row (kinds 6 and 7).
    callback item-reset(int /* item id */);

    height: root.content-height;

    // Never drawn: what the rows need in width, and the widest value of the filter rows.
    value-measure := VerticalLayout {
        visible: false;
        for item in root.items : Text {
            text: item.value-template;
            font-size: 11px;
        }
    }

    submenu-measure := VerticalLayout {
        visible: false;
        for item in root.items : Rectangle {
            width: item.has-submenu ? 1px : 0px;
        }
    }

    row-measure := VerticalLayout {
        visible: false;
        for item in root.items : BarMenuRowMeasure {
            item: item;
            value-width: root.value-width;
            chevron-slot: root.has-submenus;
        }
    }

    // Swallows the clicks on the gaps between rows.
    body := Rectangle {
        y: root.caret-down ? 0px : root.caret-height;
        height: root.body-height;
        background: root.fill;
        border-radius: root.corner-radius;
        border-width: 1px;
        border-color: MediaTheme.border;
        clip: true;

        TouchArea { }

        @children

        scroll := SmoothScrollArea {
            visible: root.custom-height <= 0px;
            width: 100%;
            height: 100%;
            enable-horizontal: false;
            enable-vertical: true;
            scrollbar-size: 5px;
            scrollbar-padding: 2px;
            content-width: self.width;
            content-height: menu-layout.preferred-height;

            menu-layout := VerticalLayout {
                padding: 4px;
                spacing: 1px;

                for item in root.items : VerticalLayout {
                    if item.kind == 6 : BarMenuSliderRow {
                        item: item;
                        value-width: root.value-width;
                        chevron-slot: root.has-submenus;
                        changed(share, phase) => { root.item-slider(item.id, share, phase); }
                        reset => { root.item-reset(item.id); }
                    }

                    if item.kind == 7 : BarMenuFilterRow {
                        item: item;
                        value-width: root.value-width;
                        chevron-slot: root.has-submenus;
                        is-parent-active: item.id >= 0 && item.id == root.active-id;
                        clicked => { root.item-clicked(item.id); }
                        reset => { root.item-reset(item.id); }
                    }

                    if item.kind != 6 && item.kind != 7 : ContextMenuItemRow {
                        item: item;
                        is-parent-active: item.id >= 0 && item.id == root.active-id;

                        scrolled(dx, dy) => {
                            scroll.handle-scroll(dx, dy);
                        }

                        clicked => {
                            root.item-clicked(item.id);
                        }
                    }
                }
            }
        }
    }

    // The caret, drawn over the edge of the body that faces the opener: a filled triangle whose base also covers the body's border, and its two
    // outer edges.
    Path {
        visible: root.show-caret && !root.caret-down;
        x: root.caret-x - 7px;
        y: 0px;
        width: 14px;
        height: root.caret-height + 1px;
        viewbox-width: 14;
        viewbox-height: 8;
        commands: "M 0 7 L 7 0 L 14 7 L 14 8 L 0 8 Z";
        fill: root.fill;
    }

    Path {
        visible: root.show-caret && !root.caret-down;
        x: root.caret-x - 7px;
        y: 0px;
        width: 14px;
        height: root.caret-height + 1px;
        viewbox-width: 14;
        viewbox-height: 8;
        commands: "M 0 7.5 L 7 0.5 L 14 7.5";
        stroke: MediaTheme.border;
        stroke-width: 1px;
    }

    Path {
        visible: root.show-caret && root.caret-down;
        x: root.caret-x - 7px;
        y: root.body-height - 1px;
        width: 14px;
        height: root.caret-height + 1px;
        viewbox-width: 14;
        viewbox-height: 8;
        commands: "M 0 1 L 7 8 L 14 1 L 14 0 L 0 0 Z";
        fill: root.fill;
    }

    Path {
        visible: root.show-caret && root.caret-down;
        x: root.caret-x - 7px;
        y: root.body-height - 1px;
        width: 14px;
        height: root.caret-height + 1px;
        viewbox-width: 14;
        viewbox-height: 8;
        commands: "M 0 0.5 L 7 7.5 L 14 0.5";
        stroke: MediaTheme.border;
        stroke-width: 1px;
    }
}
