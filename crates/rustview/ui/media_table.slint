import { Theme } from "styles.slint";
import { IconId, IconSize, IconSlot } from "icons.slint";
import { MediaItemView } from "types.slint";
import { SmoothScrollArea } from "smooth_scroll_view.slint";
import { MediaHeaderBar } from "media_header_bar.slint";
import { RubberbandOverlay } from "rubberband_selection.slint";

export component MediaTableRow inherits Rectangle {
    in property <MediaItemView> item;
    in property <length> col-filename-width: 260px;
    in property <length> col-path-width: 180px;
    in property <length> col-modified-date-width: 145px;
    in property <length> col-created-date-width: 145px;
    in property <length> col-size-width: 95px;
    in property <length> col-rating-width: 65px;
    in property <length> col-tags-width: 65px;
    in property <length> col-width-width: 70px;
    in property <length> col-height-width: 70px;
    in property <length> col-ar-width: 65px;
    in property <length> col-duration-width: 110px;
    in property <length> col-format-width: 75px;
    in property <length> col-flags-width: 85px;

    in property <length> row-height: 28px;
    in property <length> scroll-offset-x: 0px;
    /// A dragged medium would be dropped into this folder row.
    in property <bool> is-drop-target: false;

    callback clicked(bool /* ctrl */, bool /* shift */);
    callback middle-clicked();
    callback context-menu-requested(length /* x */, length /* y */);
    callback drag-started(int /* id */, length /* x */, length /* y */);
    callback drag-moved(length /* x */, length /* y */);
    callback drag-ended();
    callback ensure-focus();

    height: root.row-height;
    // Strict Priority: Drop target > Selected > Pending External Stub > Deleted > Corrupted > Normal
    background: root.is-drop-target ? Theme.primary.with-alpha(0.267) : item.is-selected ? Theme.surface-selected : (
        row-touch.has-hover ? Theme.surface-hover : (
            item.is-pending ? Theme.status-pending.with-alpha(0.082) : (
                item.is-deleted ? Theme.surface-hover.with-alpha(0.314) : (
                    item.is-corrupted ? Theme.status-corrupt.with-alpha(0.094) : transparent
                )
            )
        )
    );

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }

    row-touch := TouchArea {
        property <length> press-x: 0px;
        property <length> press-y: 0px;
        property <bool> is-drag-active: false;
        property <bool> was-already-selected: false;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.ensure-focus();
                if event.button == PointerEventButton.left {
                    self.press-x = self.mouse-x;
                    self.press-y = self.mouse-y;
                    self.is-drag-active = false;
                    self.was-already-selected = item.is-selected;

                    if !item.is-selected || event.modifiers.control || event.modifiers.shift {
                        root.clicked(
                            event.modifiers.control,
                            event.modifiers.shift
                        );
                    }
                } else if event.button == PointerEventButton.right {
                    root.context-menu-requested(
                        row-touch.mouse-x + root.scroll-offset-x,
                        row-touch.mouse-y
                    );
                } else if event.button == PointerEventButton.middle {
                    root.middle-clicked();
                }
            }
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                if self.is-drag-active {
                    self.is-drag-active = false;
                    root.drag-ended();
                } else {
                    if self.was-already-selected && !event.modifiers.control && !event.modifiers.shift {
                        root.clicked(false, false);
                    }
                }
            }
        }

        moved => {
            if self.pressed && !self.is-drag-active {
                let dx = self.mouse-x - self.press-x;
                let dy = self.mouse-y - self.press-y;
                if (dx * dx + dy * dy) > 25px * 1px {
                    self.is-drag-active = true;
                    root.drag-started(item.id, self.mouse-x + root.scroll-offset-x, self.mouse-y);
                }
            }
            if self.is-drag-active {
                root.drag-moved(self.mouse-x + root.scroll-offset-x, self.mouse-y);
            }
        }
    }

    HorizontalLayout {
        padding: 0px;
        spacing: 0px;

        // Column 0: Filename
        Rectangle {
            width: root.col-filename-width;
            clip: true;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;
                alignment: start;

                if item.is-folder : IconSlot {
                    icon: item.is-folder-up ? IconId.folder-up : IconId.folder;
                    color: root.is-drop-target ? Theme.accent : (item.is-deleted ? Theme.status-deleted : (item.is-folder-up ? Theme.text-muted : Theme.primary));
                    size: IconSize.md;
                }

                Text {
                    text: item.filename;
                    font-weight: root.is-drop-target ? 700 : 400;
                    color: root.is-drop-target ? Theme.accent : item.is-selected ? Theme.primary : (
                        item.is-pending ? Theme.status-pending : (
                            item.is-deleted ? Theme.status-deleted : (
                                item.is-corrupted ? Theme.status-corrupt : Theme.text
                            )
                        )
                    );
                    font-size: 11px;
                    font-italic: item.is-pending || item.is-deleted;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Column 1: Path
        Rectangle {
            width: root.col-path-width;
            clip: true;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: start;

                Text {
                    text: item.path_str;
                    color: Theme.text-muted;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Column 2: Modified Date
        Rectangle {
            width: root.col-modified-date-width;
            clip: true;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: start;

                Text {
                    text: item.modified_date_str;
                    color: Theme.text-muted;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Column 3: Created Date
        Rectangle {
            width: root.col-created-date-width;
            clip: true;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: start;

                Text {
                    text: item.created_date_str;
                    color: Theme.text-muted;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Column 4: Filesize (MB)
        Rectangle {
            width: root.col-size-width;
            clip: true;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: start;

                Text {
                    text: item.filesize_str;
                    color: Theme.text-muted;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Column 5: Rating
        Rectangle {
            width: root.col-rating-width;
            clip: true;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: start;

                Text {
                    text: item.rating_str;
                    color: item.rating > 0 ? Theme.rating-color(item.rating) : Theme.text-muted;
                    font-weight: item.rating > 0 ? 700 : 400;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Column 6: Tags
        Rectangle {
            width: root.col-tags-width;
            clip: true;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: start;

                Text {
                    text: item.tags_str;
                    color: item.tags_count > 0 ? Theme.primary : Theme.text-muted;
                    font-weight: item.tags_count > 0 ? 700 : 400;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Column 7: Width
        Rectangle {
            width: root.col-width-width;
            clip: true;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: start;

                Text {
                    text: item.width_str;
                    color: Theme.text-muted;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Column 8: Height
        Rectangle {
            width: root.col-height-width;
            clip: true;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: start;

                Text {
                    text: item.height_str;
                    color: Theme.text-muted;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Column 9: AR
        Rectangle {
            width: root.col-ar-width;
            clip: true;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: start;

                Text {
                    text: item.ar_str;
                    color: Theme.text-muted;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Column 10: Duration
        Rectangle {
            width: root.col-duration-width;
            clip: true;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: start;

                Text {
                    text: item.duration_str;
                    color: Theme.text-muted;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Column 11: Format
        Rectangle {
            width: root.col-format-width;
            clip: true;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: start;

                Text {
                    text: item.format_str;
                    color: Theme.text-muted;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Column 12: Flags
        Rectangle {
            width: root.col-flags-width;
            clip: true;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: start;

                Text {
                    text: item.flags_str;
                    color: item.is-pending ? Theme.status-pending : (
                        item.is-deleted ? Theme.status-deleted : (
                            item.is-corrupted ? Theme.status-corrupt : Theme.status-ok
                        )
                    );
                    font-weight: (item.is-pending || item.is-deleted || item.is-corrupted) ? 700 : 400;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

export component MediaTableView inherits Rectangle {
    background: Theme.background;
    clip: true;

    in property <[MediaItemView]> items: [];
    /// The view that is shown; the hidden one neither reports its viewport nor builds rows.
    in property <bool> active: true;
    in property <int> total-items-count: 0;

    in property <int> sort-column: 0;
    in property <int> sort-order: 0;

    // Rubberband selection state properties
    in property <bool> rubberband-active: false;
    in property <length> rubberband-x: 0px;
    in property <length> rubberband-y: 0px;
    in property <length> rubberband-width: 0px;
    in property <length> rubberband-height: 0px;

    // All 13 Table Column Widths
    in-out property <length> col-filename-width: 260px;
    in-out property <length> col-path-width: 180px;
    in-out property <length> col-modified-date-width: 145px;
    in-out property <length> col-created-date-width: 145px;
    in-out property <length> col-size-width: 95px;
    in-out property <length> col-rating-width: 65px;
    in-out property <length> col-tags-width: 65px;
    in-out property <length> col-width-width: 70px;
    in-out property <length> col-height-width: 70px;
    in-out property <length> col-ar-width: 65px;
    in-out property <length> col-duration-width: 110px;
    in-out property <length> col-format-width: 75px;
    in-out property <length> col-flags-width: 85px;

    callback item-clicked(int /* id */, bool /* ctrl */, bool /* shift */);
    callback item-middle-clicked(int /* id */);
    callback item-context-menu(int /* id */, length /* x */, length /* y */);
    callback sort-clicked(int /* column_index */);
    callback column-resized(int /* column_index */, length /* new_width */);
    callback column-resize-finished(int /* column_index */, length /* final_width */);
    callback background-clicked();
    callback background-context-menu(length /* x */, length /* y */);
    /// The viewport moved or changed size: Rust keeps the rows around it filled (see `ui::browse_window`).
    callback viewport-changed(int /* first-row */, int /* visible-rows */, int /* columns */, int /* total */);

    callback item-drag-started(int /* id */, length /* x */, length /* y */);
    callback item-drag-moved(length /* x */, length /* y */);
    callback item-drag-ended();
    /// The id of the folder row under the pointer while a drag is going on, 0 = none (a medium is never a drop target).
    callback item-drag-over-row(int /* id */);
    callback ensure-focus();

    // Rubberband selection callbacks
    callback rubberband-started(length /* start_content_x */, length /* start_content_y */, length /* view_x */, length /* view_y */, bool /* ctrl */, bool /* shift */);
    callback rubberband-moved(length /* content_x */, length /* content_y */, length /* view_x */, length /* view_y */);
    callback rubberband-ended();

    property <length> total-columns-width: root.col-filename-width
        + root.col-path-width
        + root.col-modified-date-width
        + root.col-created-date-width
        + root.col-size-width
        + root.col-rating-width
        + root.col-tags-width
        + root.col-width-width
        + root.col-height-width
        + root.col-ar-width
        + root.col-duration-width
        + root.col-format-width
        + root.col-flags-width;

    property <length> content-scroll-width: Math.max(self.width, root.total-columns-width);

    /// The folder row (negative id) that a dragged medium hovers, 0 = none.
    in property <int> drop-target-row-id: 0;

    property <[MediaItemView]> no-items: [];
    property <length> row-height: 28px;
    property <length> total-content-height: root.total-items-count * root.row-height;

    // Rows that intersect the viewport, partially visible ones included.
    property <int> visible-rows: Math.ceil(scroll-area.height / root.row-height) + 1;
    property <int> first-visible-row: Math.max(0, Math.floor(-scroll-area.clamped-y / root.row-height));

    /// Calculates dynamically how many full table rows fit into the current visible viewport height
    pure public function get-page-rows() -> int {
        return Math.max(1, Math.floor(scroll-area.height / Math.max(1px, root.row-height)));
    }

    /// Scrolls the viewport so that the table row at item-idx is completely visible (never cut off)
    public function scroll-item-into-view(item-idx: int) {
        if item-idx >= 0 && item-idx < root.total-items-count {
            let target-y = (item-idx == 0) ? 0px : (item-idx * root.row-height);
            scroll-area.scroll-into-view(target-y, root.row-height);
        }
    }

    /// Centers the row at item-idx when it is not completely visible (jumps over a distance such as type-ahead find)
    public function scroll-item-centered(item-idx: int) {
        if item-idx >= 0 && item-idx < root.total-items-count {
            scroll-area.scroll-to-center-unless-visible(item-idx * root.row-height, root.row-height);
        }
    }

    public function scroll-to-top() {
        scroll-area.scroll-to-top();
    }

    public function scroll-to-index(item-idx: int) {
        let target-y = -(item-idx * root.row-height);
        scroll-area.viewport-y = target-y;
    }

    public function scroll-by(dy: length) {
        scroll-area.handle-scroll(0px, dy);
    }

    pure public function get-viewport-y() -> length {
        return scroll-area.clamped-y;
    }

    pure public function get-top-visible-index() -> int {
        return root.first-visible-row;
    }

    /// `row-id-at` for a point given relative to the viewport (below the header), as the pointer reports it.
    pure public function row-id-at-viewport(vx: length, vy: length) -> int {
        return root.row-id-at(vx, vy - scroll-area.clamped-y);
    }

    /// The folder row that lies under the content row at `cy` (the pointer at view x `vx`), 0 when there is none: the ring pool
    /// keeps the item of list position g in slot g % pool.
    pure function row-id-at(vx: length, cy: length) -> int {
        let view-y = cy + scroll-area.clamped-y;
        if vx < 0px || vx > scroll-area.width || view-y < 0px || view-y > scroll-area.height || cy < 0px || root.items.length == 0 {
            return 0;
        }
        let position = Math.floor(cy / root.row-height);
        let candidate = root.items[Math.mod(position, root.items.length)];
        return (candidate.index == position && candidate.is-folder) ? candidate.id : 0;
    }

    function emit-viewport() {
        if root.active {
            root.viewport-changed(root.first-visible-row, root.visible-rows, 1, root.total-items-count);
        }
    }

    changed active => { root.emit-viewport(); }
    changed first-visible-row => { root.emit-viewport(); }
    changed visible-rows => { root.emit-viewport(); }
    changed total-items-count => { root.emit-viewport(); }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        header-box := Rectangle {
            height: 28px;
            background: Theme.surface;
            clip: true;

            header-content := Rectangle {
                x: scroll-area.clamped-x;
                width: root.content-scroll-width;
                height: 100%;

                MediaHeaderBar {
                    width: 100%;
                    height: 100%;
                    sort-column: root.sort-column;
                    sort-order: root.sort-order;
                    enable-resize: true;
                    auto-width: false;

                    col-filename-width <=> root.col-filename-width;
                    col-path-width <=> root.col-path-width;
                    col-modified-date-width <=> root.col-modified-date-width;
                    col-created-date-width <=> root.col-created-date-width;
                    col-size-width <=> root.col-size-width;
                    col-rating-width <=> root.col-rating-width;
                    col-tags-width <=> root.col-tags-width;
                    col-width-width <=> root.col-width-width;
                    col-height-width <=> root.col-height-width;
                    col-ar-width <=> root.col-ar-width;
                    col-duration-width <=> root.col-duration-width;
                    col-format-width <=> root.col-format-width;
                    col-flags-width <=> root.col-flags-width;

                    sort-clicked(idx) => { root.sort-clicked(idx); }
                    column-resized(idx, w) => { root.column-resized(idx, w); }
                    column-resize-finished(idx, w) => { root.column-resize-finished(idx, w); }
                }
            }
        }

        scroll-area := SmoothScrollArea {
            vertical-stretch: 1;
            enable-horizontal: true;
            enable-vertical: true;
            content-width: root.content-scroll-width;
            content-height: root.total-content-height;

            bg-touch := TouchArea {
                width: 100%;
                height: 100%;

                property <length> press-x: 0px;
                property <length> press-y: 0px;
                property <bool> is-rubberband-active: false;
                property <bool> press-ctrl: false;
                property <bool> press-shift: false;

                scroll-event(event) => {
                    scroll-area.handle-scroll(event.delta-x, event.delta-y);
                    return accept;
                }

                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                        root.ensure-focus();
                        root.background-context-menu(self.mouse-x + scroll-area.clamped-x, 28px + self.mouse-y + scroll-area.clamped-y);
                    }
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        root.ensure-focus();
                        self.press-x = self.mouse-x;
                        self.press-y = self.mouse-y;
                        self.is-rubberband-active = false;
                        self.press-ctrl = event.modifiers.control;
                        self.press-shift = event.modifiers.shift;
                    }
                    if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                        if self.is-rubberband-active {
                            self.is-rubberband-active = false;
                            root.rubberband-ended();
                        } else {
                            root.background-clicked();
                        }
                    }
                }

                moved => {
                    if self.pressed {
                        let dx = self.mouse-x - self.press-x;
                        let dy = self.mouse-y - self.press-y;
                        let dist-sq = (dx * dx) + (dy * dy);

                        if !self.is-rubberband-active && dist-sq > 16px * 1px {
                            self.is-rubberband-active = true;
                            let start-content-x = self.press-x;
                            let start-content-y = self.press-y;
                            let start-view-x = self.press-x;
                            let start-view-y = self.press-y + scroll-area.clamped-y;
                            root.rubberband-started(
                                start-content-x,
                                start-content-y,
                                start-view-x,
                                start-view-y,
                                self.press-ctrl,
                                self.press-shift
                            );
                        }

                        if self.is-rubberband-active {
                            let cur-content-x = self.mouse-x;
                            let cur-content-y = self.mouse-y;
                            let cur-view-x = self.mouse-x;
                            let cur-view-y = self.mouse-y + scroll-area.clamped-y;
                            root.rubberband-moved(cur-content-x, cur-content-y, cur-view-x, cur-view-y);
                        }
                    }
                }
            }

            Rectangle {
                x: 0px;
                y: 0px;
                width: root.content-scroll-width;
                height: root.total-content-height;

                for item in root.active ? root.items : root.no-items: MediaTableRow {
                    property <int> global-idx: item.index;

                    x: 0px;
                    y: self.global-idx * root.row-height;
                    width: root.content-scroll-width;
                    row-height: root.row-height;
                    item: item;
                    visible: item.index >= 0;
                    is-drop-target: item.is-folder && item.id == root.drop-target-row-id;

                    col-filename-width: root.col-filename-width;
                    col-path-width: root.col-path-width;
                    col-modified-date-width: root.col-modified-date-width;
                    col-created-date-width: root.col-created-date-width;
                    col-size-width: root.col-size-width;
                    col-rating-width: root.col-rating-width;
                    col-tags-width: root.col-tags-width;
                    col-width-width: root.col-width-width;
                    col-height-width: root.col-height-width;
                    col-ar-width: root.col-ar-width;
                    col-duration-width: root.col-duration-width;
                    col-format-width: root.col-format-width;
                    col-flags-width: root.col-flags-width;

                    scroll-offset-x: scroll-area.clamped-x;

                    ensure-focus => { root.ensure-focus(); }
                    clicked(ctrl, shift) => {
                        root.item-clicked(item.id, ctrl, shift);
                    }
                    middle-clicked => {
                        root.item-middle-clicked(item.id);
                    }
                    context-menu-requested(mx, my) => {
                        root.item-context-menu(
                            item.id,
                            mx,
                            28px + self.y + my + scroll-area.clamped-y
                        );
                    }
                    drag-started(id, mx, my) => {
                        root.item-drag-started(id, mx, 28px + self.y + my + scroll-area.clamped-y);
                    }
                    drag-moved(mx, my) => {
                        root.item-drag-moved(mx, 28px + self.y + my + scroll-area.clamped-y);
                        root.item-drag-over-row(root.row-id-at(mx, self.y + my));
                    }
                    drag-ended => {
                        root.item-drag-ended();
                    }
                }

                // Visual Rubberband Selection Rectangle (in Content Space)
                RubberbandOverlay {
                    is-active: root.rubberband-active;
                    rect-x: root.rubberband-x;
                    rect-y: root.rubberband-y;
                    rect-width: root.rubberband-width;
                    rect-height: root.rubberband-height;
                }
            }
        }
    }
}
