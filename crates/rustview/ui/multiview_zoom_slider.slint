import { Theme } from "styles.slint";

/// The zoom slider that hangs below the media bar of an image, and above the minimap (inside the speech bubble of
/// `MultiviewBarMenu`).
///
/// The reset (100%) is in the middle, zooming in is to the right, zooming out to the left; both halves are logarithmic (the
/// same distance is the same factor). A thin line from the middle to the handle shows which way the zoom went, small ticks mark
/// the points the handle snaps to (the snapping itself is done by Rust, which answers with the snapped value at once). The
/// percentage is not drawn here: its owner floats it next to the bubble (`pill-visible`, `handle-center-x`) while the pointer
/// is over the slider, so it takes no room. The mouse wheel over it steps (5%, Shift 10%, Ctrl 25%), a double click on the track
/// or a click on the middle tick resets.
///
/// Every movement is reported as a number that crosses the Slint boundary (`BarClick::from_code` on the Rust side):
/// `4000000 + position * 10000` for the handle (position 0..1), `2000000 + 1/2/4` for up / Shift / Ctrl steps, `3000000` for the
/// reset.
export component MultiviewZoomSlider inherits Rectangle {
    // Tenths of a percent: 1000 = 100%.
    in property <int> value-permille: 1000;
    in property <int> min-permille: 100;
    in property <int> max-permille: 10000;
    in property <[int]> snaps: [];

    callback request(int /* code */);

    out property <length> content-height: 28px;
    // The owner floats the percentage: whether it shows (the pointer is over the slider or the handle is dragged) and the middle of
    // the handle, from the left edge of the slider.
    callback pill-changed(bool /* shown */, length /* handle center x */);

    property <length> pad: 8px;
    property <length> handle-size: 14px;
    property <length> center-y: 9px;
    property <length> track-x: root.pad;
    property <length> track-w: Math.max(root.width - 2 * root.pad - root.handle-size, 20px);
    property <float> wheel-acc: 0;
    property <bool> dragging: false;
    property <float> position: root.pos-of(root.value-permille);
    property <float> reset-position: root.pos-of(1000);
    property <bool> active: track-touch.has-hover || root.dragging;
    property <length> handle-center-x: root.track-x + root.position * root.track-w + root.handle-size / 2;

    changed active => { root.pill-changed(root.active, root.handle-center-x); }
    changed handle-center-x => { root.pill-changed(root.active, root.handle-center-x); }

    // One logarithmic range from the smallest to the largest zoom: the reset sits where its factor puts it (at the left end when the
    // picture cannot be made smaller than its fit).
    pure function pos-of(z: int) -> float {
        return Math.log(Math.max(z, root.min-permille) / root.min-permille, root.max-permille / root.min-permille);
    }

    function position-at(mouse-x: length) -> float {
        return Math.clamp((mouse-x - root.handle-size / 2) / root.track-w, 0, 1);
    }

    function request-position(p: float) {
        root.request(4000000 + Math.round(p * 10000));
    }

    height: root.content-height;

    // The track.
    Rectangle {
        x: root.track-x + root.handle-size / 2;
        y: root.center-y - 2px;
        width: root.track-w;
        height: 4px;
        border-radius: 2px;
        background: Theme.surface-selected;
    }

    // From the middle to the handle: the way the zoom went.
    Rectangle {
        x: root.track-x + root.handle-size / 2 + Math.min(root.position, root.reset-position) * root.track-w;
        y: root.center-y - 2px;
        width: Math.abs(root.position - root.reset-position) * root.track-w;
        height: 4px;
        border-radius: 2px;
        background: Theme.primary;
    }

    // The marks: the reset is the strongest (rank 0), whole 100% steps and the ends are lines (1), 50% steps are shorter lines (2),
    // 25% / 75% steps are dots (3). Rust has already left out the ones that would crowd each other.
    for mark in root.snaps : Rectangle {
        property <int> rank: Math.round(Math.mod(mark, 4));
        property <int> permille: Math.round((mark - self.rank) / 4);

        x: root.track-x + root.handle-size / 2 + root.pos-of(self.permille) * root.track-w - self.width / 2;
        y: root.center-y + 5px;
        width: self.rank == 0 ? 2px : (self.rank == 3 ? 2px : 1px);
        height: self.rank == 0 ? 10px : (self.rank == 1 ? 7px : (self.rank == 2 ? 5px : 2px));
        border-radius: self.rank == 3 ? 1px : 0px;
        background: self.rank == 0 ? Theme.text : Theme.text-muted;
    }

    // A click on the middle tick resets.
    TouchArea {
        x: root.track-x + root.handle-size / 2 + root.reset-position * root.track-w - 7px;
        y: root.center-y + 3px;
        width: 14px;
        height: 12px;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.request(3000000); }
    }

    // The handle.
    Rectangle {
        x: root.track-x + root.position * root.track-w;
        y: root.center-y - self.height / 2;
        width: root.handle-size;
        height: root.handle-size;
        border-radius: root.handle-size / 2;
        background: root.active ? Theme.text : Theme.primary;
        border-width: 2px;
        border-color: Theme.surface;
    }

    // Dragging, the wheel and the double click.
    track-touch := TouchArea {
        x: root.track-x;
        y: 0px;
        width: root.track-w + root.handle-size;
        height: root.content-height;
        mouse-cursor: MouseCursor.pointer;

        pointer-event(event) => {
            if event.button == PointerEventButton.left {
                if event.kind == PointerEventKind.down {
                    root.dragging = true;
                    root.request-position(root.position-at(self.mouse-x));
                } else if event.kind == PointerEventKind.up {
                    root.dragging = false;
                }
            }
        }

        moved => {
            if self.pressed {
                root.request-position(root.position-at(self.mouse-x));
            }
        }

        double-clicked => {
            root.request(3000000);
        }

        scroll-event(event) => {
            // A notch is 120; the small steps of a touchpad add up to one.
            root.wheel-acc += event.delta-y / 1px;
            if Math.abs(root.wheel-acc) >= 120 {
                root.request(2000000 + (root.wheel-acc > 0 ? 1 : 0) + (event.modifiers.shift ? 2 : 0) + (event.modifiers.control ? 4 : 0));
                root.wheel-acc = 0;
            }
            return accept;
        }
    }
}
