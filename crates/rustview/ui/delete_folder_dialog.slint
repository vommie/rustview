import { Button } from "std-widgets.slint";
import { Theme } from "styles.slint";
import { BulletItem } from "bullet_item.slint";
import { IconId } from "icons.slint";
import { DialogHeading } from "dialog_heading.slint";
import { DialogBody } from "dialog_body.slint";

export component DeleteFolderDialog inherits Window {
    title: "RustView - Delete Folder";
    width: 500px;
    preferred-height: dialog-layout.preferred-height;
    min-height: dialog-layout.min-height;
    background: Theme.background;

    in-out property <string> folder-name: "";
    in-out property <int> subfolders-count: 0;
    in-out property <int> files-count: 0;
    in-out property <string> missing-note: "";
    in property <string> error-message: "";

    callback move-to-trash-confirmed();
    callback permanent-delete-confirmed();
    callback cancelled();

    forward-focus: dialog-focus;

    dialog-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            return reject;
        }

        dialog-layout := VerticalLayout {
            width: root.width;
            padding: 0px;
            spacing: 0px;
            alignment: space-between;

            body := DialogBody {
                content-height: content.preferred-height;

                content := VerticalLayout {
                    width: body.width;
                    height: self.preferred-height;
                    padding: 16px;
                    spacing: 12px;

                    DialogHeading {
                        icon: IconId.status-warning;
                        text: "Delete Folder";
                        color: #f38ba8;
                    }

                    Text {
                        text: "Are you sure you want to delete the folder '" + root.folder-name + "'?";
                        font-size: 12px;
                        color: Theme.text;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        background: #f38ba818;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #f38ba844;

                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;

                            Text {
                                text: "Contents to be deleted:";
                                font-size: 11px;
                                font-weight: 700;
                                color: #f38ba8;
                            }

                            BulletItem {
                                text: root.subfolders-count + " subfolder(s)";
                                color: Theme.text;
                            }

                            BulletItem {
                                text: root.files-count + " media file(s)";
                                color: Theme.text;
                            }
                        }
                    }

                    if root.missing-note != "" : Text {
                        text: root.missing-note;
                        font-size: 11px;
                        color: #f9e2af;
                        wrap: word-wrap;
                    }

                    Text {
                        text: "This folder and its media contents will be deleted on disk and flagged in the library database.";
                        font-size: 11px;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }

                    if root.error-message != "" : Text {
                        text: root.error-message;
                        font-size: 11px;
                        color: #ff5555;
                        wrap: word-wrap;
                    }
                }
            }

            // Action Buttons Bar
            Rectangle {
                height: 48px;
                background: Theme.surface;
                vertical-stretch: 0;

                Rectangle {
                    y: 0px;
                    height: 1px;
                    background: Theme.border;
                }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 10px;
                    alignment: end;

                    Button {
                        text: "Cancel";
                        clicked => { root.cancelled(); }
                    }

                    Button {
                        text: "Permanently Delete";
                        clicked => { root.permanent-delete-confirmed(); }
                    }

                    Button {
                        text: "Move to Trash";
                        primary: true;
                        clicked => { root.move-to-trash-confirmed(); }
                    }
                }
            }
        }
    }
}
