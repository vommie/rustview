import { Theme } from "styles.slint";

/// Reusable grouped card container for setting configurations.
export component SettingsCard inherits Rectangle {
    in property <string> title: "";
    in property <string> description: "";

    background: Theme.surface;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        // The title and the description start where the rows' labels start (a row pads 8px for its hover), so every
        // text of a card has one left edge, also on wrapped lines (RustCut's card).
        if root.title != "" : HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;

            Text {
                text: root.title;
                font-size: 13px;
                font-weight: 700;
                color: Theme.primary;
            }
        }

        if root.description != "" : HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;

            Text {
                text: root.description;
                font-size: 11px;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
        }

        @children
    }
}
