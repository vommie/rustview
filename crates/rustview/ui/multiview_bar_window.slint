import { MultiviewBarButtonView } from "multiview_types.slint";
import { MultiviewBar } from "multiview_bar.slint";
import { GlobalTooltipLayer } from "global_tooltip_layer.slint";
import { TooltipSettings, GlobalTooltip } from "tooltips.slint";
import { Theme } from "styles.slint";
import { ContextMenuItemModel } from "types.slint";
import { MultiviewBarMenu } from "multiview_bar_menu.slint";
import { MultiviewZoomSlider } from "multiview_zoom_slider.slint";

/// A bar (the media action bar of the hovered medium, or the primary action bar of the view), in a frameless transparent window of its own that floats above the Multiview.
/// Native video windows are children of the Multiview window, so nothing drawn there can blend with them; a window of its
/// own is blended with everything below it by the compositing manager (glass), and a tooltip drawn in it is never covered
/// by a video. Rust places the window so that the bar (top right corner of this window) sits in the corner of the tile.
/// The window is larger than the bar to leave room for the tooltip bubble below it; Rust limits the pointer input of the
/// window to the bar, so the rest of it is invisible to the pointer. A drop-down menu (the "Open With" applications) hangs
/// below the bar in the same room; while it is open it takes the pointer too.
export component MultiviewBarWindow inherits Window {
    title: "RustView - Multiview bar";
    no-frame: true;
    background: transparent;

    in property <[MultiviewBarButtonView]> actions;
    // The tile the bar belongs to; it is handed back with every click.
    in property <int> tile: -1;
    // False without a compositing manager: the bar is solid then.
    in property <bool> translucent: true;
    // The primary bar sits in the top left corner of its window, the media bar in the top right corner.
    in property <bool> align-left: false;
    in property <bool> enable-tooltips: true;
    in property <int> tooltip-delay-ms: 750;
    // The rows of the drop-down (the same items and rows as in a context menu); the menu is shown while it has any.
    in property <[ContextMenuItemModel]> menu-items;
    in property <bool> menu-open: false;
    // Position in `actions` of the button that opened the menu (-1 = none): it shows as open and the bubble points at it.
    in property <int> menu-owner-index: -1;
    // The zoom slider (images): it hangs below the bar like the drop-down, in the same bubble. Tenths of a percent.
    in property <bool> zoom-open: false;
    in property <int> zoom-permille: 1000;
    in property <int> zoom-min-permille: 100;
    in property <int> zoom-max-permille: 10000;
    in property <[int]> zoom-snaps: [];
    // Where the percentage of the zoom slider floats: its handle, in the slider's own coordinates.
    out property <length> bar-width: bar.width;
    out property <length> bar-height: bar.height;
    out property <length> bar-radius: bar.border-radius;
    out property <length> tooltip-radius: TooltipSettings.default-corner-radius;
    out property <length> menu-radius: bubble.corner-radius;

    callback action-clicked(int /* tile index */, int /* action id */);
    // The tooltip bubble appeared, moved or went away (logical pixels in this window).
    // A row of the drop-down was clicked (the tile and the id of the item).
    callback menu-item-clicked(int /* tile index */, int /* item id */);
    // The drop-down appeared, changed its size or went away (logical pixels in this window).
    callback menu-changed(bool /* visible */, length /* x */, length /* y */, length /* width */, length /* height */, length /* caret center x */, length /* caret height */);
    // The floating percentage appeared, moved or went away (logical pixels in this window).
    callback pill-changed(bool /* visible */, length /* x */, length /* y */, length /* width */, length /* height */);
    callback tooltip-changed(bool /* visible */, length /* x */, length /* y */, length /* width */, length /* height */);

    // Called when the window is hidden: a tooltip that was open must not be there when the window comes back.
    public function reset-tooltip() {
        GlobalTooltip.hide();
    }

    changed enable-tooltips => {
        TooltipSettings.enabled = root.enable-tooltips;
    }
    changed tooltip-delay-ms => {
        TooltipSettings.default-delay = root.tooltip-delay-ms * 1ms;
    }

    bar := MultiviewBar {
        x: root.align-left ? 0px : root.width - self.width;
        y: 0px;
        actions: root.actions;
        translucent: root.translucent;
        menu-owner-index: (root.menu-open || root.zoom-open) ? root.menu-owner-index : -1;

        action-clicked(id) => {
            root.action-clicked(root.tile, id);
        }
    }

    property <length> menu-width: root.zoom-open ? 210px : 230px;
    property <length> menu-gap: 2px;
    // The bubble is centered under the opener where the window leaves room for it.
    property <length> opener-x: bar.x + bar.button-center-x(root.menu-owner-index);
    property <length> menu-x: Math.max(0px, Math.min(root.width - root.menu-width, root.opener-x - root.menu-width / 2));
    property <length> menu-y: bar.y + bar.height + root.menu-gap;
    property <bool> menu-shown: root.zoom-open || (root.menu-open && root.menu-items.length > 0);
    property <length> menu-height: root.menu-shown ? bubble.content-height : 0px;

    changed menu-shown => {
        root.menu-changed(root.menu-shown, root.menu-x, root.menu-y, root.menu-width, root.menu-height, root.menu-x + bubble.caret-center-x, bubble.caret-height);
    }
    changed menu-height => {
        root.menu-changed(root.menu-shown, root.menu-x, root.menu-y, root.menu-width, root.menu-height, root.menu-x + bubble.caret-center-x, bubble.caret-height);
    }

    bubble := MultiviewBarMenu {
        visible: root.menu-shown;
        x: root.menu-x;
        y: root.menu-y;
        width: root.menu-width;
        max-content-height: Math.max(root.height - root.menu-y - 2px, 0px);
        items: root.zoom-open ? [] : root.menu-items;
        custom-height: root.zoom-open ? 28px + 8px : 0px;
        anchor-x: root.opener-x - root.menu-x;
        translucent: root.translucent;

        item-clicked(id) => {
            root.menu-item-clicked(root.tile, id);
        }

        if root.zoom-open : MultiviewZoomSlider {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            value-permille: root.zoom-permille;
            min-permille: root.zoom-min-permille;
            max-permille: root.zoom-max-permille;
            snaps: root.zoom-snaps;
            pill-changed(shown, center) => {
                root.zoom-pill-visible = shown;
                root.zoom-handle-x = center;
            }

            request(code) => {
                root.action-clicked(root.tile, code);
            }
        }
    }

    property <bool> zoom-pill-visible: false;
    property <length> zoom-handle-x: 0px;
    // The percentage of the zoom slider floats below its bubble, so the bubble itself stays as slim as possible.
    property <length> pill-width: 46px;
    property <length> pill-height: 18px;
    property <length> pill-x: Math.clamp(root.menu-x + 4px + root.zoom-handle-x - root.pill-width / 2, 1px, root.width - root.pill-width - 1px);
    property <length> pill-y: root.menu-y + root.menu-height + 3px;
    property <bool> pill-shown: root.zoom-open && root.zoom-pill-visible;

    changed zoom-open => {
        if !root.zoom-open {
            root.zoom-pill-visible = false;
        }
    }
    changed pill-shown => {
        root.pill-changed(root.pill-shown, root.pill-x, root.pill-y, root.pill-width, root.pill-height);
    }
    changed pill-x => {
        root.pill-changed(root.pill-shown, root.pill-x, root.pill-y, root.pill-width, root.pill-height);
    }

    if root.pill-shown : Rectangle {
        x: root.pill-x;
        y: root.pill-y;
        width: root.pill-width;
        height: root.pill-height;
        border-radius: root.pill-height / 2;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;

        Text {
            text: Math.round(root.zoom-permille / 10.0) + "%";
            font-size: 10px;
            font-weight: 700;
            color: Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    GlobalTooltipLayer {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;

        state-changed(visible, x, y, w, h) => {
            root.tooltip-changed(visible, x, y, w, h);
        }
    }
}
