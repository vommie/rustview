import { IconId } from "icons.slint";
import { ButtonFeedback } from "button_feedback_types.slint";

/// One button of the hover bar of a tile. Rust decides which buttons a tile offers and in which order.
export struct MultiviewBarButtonView {
    id: int, // see ActionId::code
    icon: IconId,
    tooltip: string,
    toggle: bool, // the button shows an on/off state
    active: bool,
    // A disabled button is dimmed; its tooltip says why. It still reports clicks (the application may react).
    enabled: bool,
    // The button blinks to draw the user's attention (a refused close of a pinned fullscreen).
    attention: bool,
    feedback: ButtonFeedback,
    // 0 = plain, 1 = emphasized (unsaved changes), 2 = busy (saving), 3 = done (saved)
    emphasis: int,
    // A done button fades away.
    fading: bool,
    // The button has an arrow of its own on its right that opens a drop-down (it reports the id + 1).
    split: bool,
}

/// One tile of the Multiview window. All geometry is computed in Rust (physical pixels converted to logical pixels), so
/// Slint and the X11 video windows always use the same rectangles. Video tiles are drawn by mpv in a native window on
/// top of the Slint scene; Slint only draws images, loading and error states.
export struct MultiviewTileView {
    x: length,
    y: length,
    width: length,
    height: length,
    kind: int, // 0 = image, 1 = video (native window), 2 = unavailable
    image: image,
    is-loading: bool,
    error-text: string,
    // A zoomed image: drawn instead of `image` (which is its fitted picture) in the rectangle zoom-x/y/width/height of the tile.
    // `zoom-hq` says the sharp, resampled `zoom-image` is ready; until then `image` is cut out (zoom-clip-*, pixels of `image`)
    // and scaled by the renderer.
    zoomed: bool,
    zoom-hq: bool,
    zoom-image: image,
    // The room the zoomed picture may use (the tile and the free space around it), relative to the tile; zoom-x/y/width/height are
    // relative to it.
    zoom-area-x: length,
    zoom-area-y: length,
    zoom-area-width: length,
    zoom-area-height: length,
    zoom-x: length,
    zoom-y: length,
    zoom-width: length,
    zoom-height: length,
    zoom-clip-x: int,
    zoom-clip-y: int,
    zoom-clip-width: int,
    zoom-clip-height: int,
    zoom-pixelated: bool,
    // Dragging the picture moves something.
    pannable: bool,
    // The minimap of a zoomed image: its place in the tile, the thumbnail and the visible part (shares of the image).
    mm-available: bool,
    mm-visible: bool,
    mm-image: image,
    mm-x: length,
    mm-y: length,
    mm-width: length,
    mm-height: length,
    mm-vx: float,
    mm-vy: float,
    mm-vw: float,
    mm-vh: float,
    // The zoom slider bubble above the minimap (right click on the minimap), with the numbers of the slider.
    mm-bubble-open: bool,
    mm-zoom-permille: int,
    mm-zoom-min: int,
    mm-zoom-max: int,
    mm-zoom-snaps: [int],
    // The feedback icon of an interaction (`media_feedback`: 0..5 = a rating just given, 6 = saved, -1 = none) and how strong it
    // is (1 = full, fading to 0). Videos get theirs from mpv.
    feedback-icon: int,
    feedback-alpha: float,
    // The crop tool: the room it covers (relative to the tile), the picture and the crop rectangle (relative to that room), the
    // labels and whether the rule-of-thirds lines show.
    crop-open: bool,
    crop-room-x: length,
    crop-room-y: length,
    crop-room-width: length,
    crop-room-height: length,
    crop-pic-x: length,
    crop-pic-y: length,
    crop-pic-width: length,
    crop-pic-height: length,
    crop-x: length,
    crop-y: length,
    crop-width: length,
    crop-height: length,
    crop-size-label: string,
    crop-ratio-label: string,
    crop-grid: bool,
    crop-dragging: bool,
}

/// A draggable separator between two tiles (or the two rows of a 2x2 grid) with a swap button in the middle.
export struct MultiviewGutterView {
    x: length,
    y: length,
    width: length,
    height: length,
    vertical: bool,
    // Only the swap button of one column of a 2x2 grid: no divider line and no drag.
    swap-only: bool,
}

/// Where the virtual display of a Multiview (the container) is shown inside its canvas, in logical pixels relative to the
/// canvas. In the fullscreen window it covers the whole window; in a tab it is the scaled-down, centered miniature.
export struct MultiviewScreenView {
    x: length,
    y: length,
    width: length,
    height: length,
}
