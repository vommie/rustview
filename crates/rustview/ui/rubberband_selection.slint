import { Theme } from "styles.slint";

/// Standalone, reusable visual Rubberband / Marquee selection overlay component.
/// Renders a semi-transparent selection rectangle with theme-adaptive border and background fill.
export component RubberbandOverlay inherits Rectangle {
    in property <bool> is-active: false;
    in property <length> rect-x: 0px;
    in property <length> rect-y: 0px;
    in property <length> rect-width: 0px;
    in property <length> rect-height: 0px;

    // Theming & Customization API
    in property <color> fill-color: Theme.primary.with-alpha(0.149); // 15% opacity Theme.primary
    in property <color> border-line-color: Theme.primary;
    in property <length> border-line-width: 1px;
    in property <length> rect-corner-radius: 2px;

    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: transparent;
    visible: root.is-active;
    z: 50;

    // Visual selection bounding box
    if root.is-active && root.rect-width > 0px && root.rect-height > 0px : Rectangle {
        x: root.rect-x;
        y: root.rect-y;
        width: root.rect-width;
        height: root.rect-height;
        background: root.fill-color;
        border-width: root.border-line-width;
        border-color: root.border-line-color;
        border-radius: root.rect-corner-radius;
    }
}
