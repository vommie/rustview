import { Theme } from "styles.slint";
import { AppIcon, IconId, IconLookup, IconSize } from "icons.slint";
import { MultiviewTileView, MultiviewGutterView, MultiviewScreenView } from "multiview_types.slint";
import { MultiviewGutter } from "multiview_gutter.slint";
import { MultiviewBarMenu } from "multiview_bar_menu.slint";
import { MultiviewZoomSlider } from "multiview_zoom_slider.slint";
import { MultiviewCropOverlay } from "multiview_crop_overlay.slint";
import { MultiviewFocusCorners } from "multiview_focus_marks.slint";
import { MultiviewVideoBar, MultiviewVideoBarView } from "multiview_video_bar.slint";

/// The scene of a Multiview: background, image, video and status tiles and gutters. A video is the newest texture its render
/// thread drew (`video-frames` of the window, the row of the tile). The same component draws the fullscreen window, the tab view
/// and the tab grid item, so a tab is always a true miniature of the fullscreen arrangement. All geometry (tiles, gutters, screen) arrives in logical
/// pixels relative to this canvas. The control bars of the videos are part of the scene (`video-bars`); the action bar of the
/// hovered tile still floats above the canvas in a window of its own.
export component MultiviewCanvas inherits Rectangle {
    in property <[MultiviewTileView]> tiles;
    in property <[MultiviewGutterView]> gutters;
    in property <MultiviewScreenView> screen;
    // The newest picture of every video the window shows (`video_surface::hosts`); a video tile names its row.
    in property <[image]> video-frames;
    // The control bars of the videos that show one (Rust adds and removes them; a bar with an open popup comes last).
    in property <[MultiviewVideoBarView]> video-bars;
    in property <int> background-mode: 0; // 0 = Dark Theme (#11111b), 1 = Deep Black (#000000), 2 = Checkerboard
    // A color that replaces the background of `background-mode` (transparent = use the mode).
    in property <color> fill-color: transparent;
    in property <color> outer-color: #000000; // shown around the screen when the host has another aspect ratio
    // A non-interactive canvas is a picture: it has no touch areas, so clicks reach whatever is below it.
    in property <bool> interactive: true;
    in property <bool> show-frame: false;
    // The mouse wheel is reported (previous/next for a single image); otherwise it passes through untouched.
    in property <bool> wheel-navigation: false;

    callback tile-clicked(int /* tile index */, bool /* is_ctrl */);
    callback background-clicked(bool /* is_ctrl */);
    callback middle-clicked();
    callback wheel(length /* delta-y */);
    // Ctrl + mouse wheel over an image: zoom (the pointer position is in logical pixels inside the tile).
    callback tile-zoom-wheel(int /* tile index */, length /* delta-y */, length /* x */, length /* y */);
    // The mouse wheel over a video (its window lets the pointer through): the volume, with Ctrl mpv's zoom.
    callback tile-video-wheel(int /* tile index */, length /* delta-y */, bool /* ctrl */);
    // A right click on a video: play or pause it.
    callback tile-right-clicked(int /* tile index */);
    // The picture of a zoomed image is dragged (the movement since the last report, logical pixels).
    callback tile-pan(int /* tile index */, length /* dx */, length /* dy */);
    // The minimap of a zoomed image is pressed (0), dragged (1) or released (2) at a point given as shares of the image; 3 = middle
    // click (reset), 4 = right click (the slider bubble opens or closes).
    callback minimap-pointer(int /* tile index */, float /* x */, float /* y */, int /* phase */);
    // The zoom slider on the minimap asks for something (the codes of the slider of the media bar).
    callback minimap-slider(int /* tile index */, int /* code */);
    // The crop tool of a tile: the pointer (phase 0 = press, 1 = move, 2 = release, 3 = double click; logical pixels relative to
    // the tile, Shift held) and its ratio button (left click = landscape, right click = portrait).
    callback crop-pointer(int /* tile index */, int /* phase */, length /* x */, length /* y */, bool /* shift */);
    callback crop-ratio(int /* tile index */, bool /* landscape */);
    callback gutter-drag-started(int);
    callback gutter-dragged(int, length /* distance from drag start */);
    callback gutter-drag-finished(int);
    callback gutter-reset();
    callback gutter-swap(int);

    background: root.outer-color;
    clip: true;

    if root.show-frame : Rectangle {
        x: root.screen.x - 1px;
        y: root.screen.y - 1px;
        width: root.screen.width + 2px;
        height: root.screen.height + 2px;
        border-width: 1px;
        border-color: Theme.border;
    }

    Rectangle {
        x: root.screen.x;
        y: root.screen.y;
        width: root.screen.width;
        height: root.screen.height;
        background: root.fill-color != Colors.transparent ? root.fill-color : (root.background-mode == 1 ? #000000 : (root.background-mode == 2 ? #1e1e2e : #11111b));

        if root.fill-color == Colors.transparent && root.background-mode == 2 : Rectangle {
            width: 100%;
            height: 100%;
            background: #181825;
            opacity: 0.5;
        }
    }

    if root.interactive : TouchArea {
        width: 100%;
        height: 100%;

        scroll-event(event) => {
            if root.wheel-navigation {
                root.wheel(event.delta-y);
                return accept;
            }
            return reject;
        }

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                if event.button == PointerEventButton.left {
                    root.background-clicked(event.modifiers.control || event.modifiers.meta);
                } else if event.button == PointerEventButton.middle {
                    root.middle-clicked();
                }
            }
        }
    }

    for tile[index] in root.tiles : Rectangle {
        x: tile.x;
        y: tile.y;
        width: tile.width;
        height: tile.height;

        // The selected medium of several: its view is brightened (the medium covers its own part of it, so the light shows
        // only where the medium leaves room, also around a video window).
        if root.interactive && tile.focused && tile.focus-brighten > 0 : Rectangle {
            x: tile.focus-view-x;
            y: tile.focus-view-y;
            width: tile.focus-view-width;
            height: tile.focus-view-height;
            background: Colors.white.with-alpha(tile.focus-brighten);
        }

        if tile.kind == 0 && !tile.zoomed && tile.image.width > 0 : Image {
            source: tile.image;
            width: 100%;
            height: 100%;
            image-fit: contain;
        }

        // A video: its texture is the frame mpv draws into (the room of the tile; mpv letterboxes into it), clipped to the part
        // that shows (the medium's place, or the whole room while zoomed).
        if tile.kind == 1 && tile.video-row >= 0 : Rectangle {
            x: tile.video-clip-x;
            y: tile.video-clip-y;
            width: tile.video-clip-width;
            height: tile.video-clip-height;
            clip: true;

            Image {
                x: tile.video-frame-x - tile.video-clip-x;
                y: tile.video-frame-y - tile.video-clip-y;
                width: tile.video-frame-width;
                height: tile.video-frame-height;
                source: root.video-frames[tile.video-row];
                image-fit: fill;
            }
        }

        // A zoomed image: the sharp picture, or - until it is ready - the part of the fitted picture that is visible, scaled by the
        // renderer. It sits where the image is inside the room the tile may use (smaller than the room when zoomed out).
        if tile.kind == 0 && tile.zoomed : Rectangle {
            x: tile.zoom-area-x;
            y: tile.zoom-area-y;
            width: tile.zoom-area-width;
            height: tile.zoom-area-height;
            clip: true;

            if tile.zoom-hq : Image {
                x: tile.zoom-x;
                y: tile.zoom-y;
                width: tile.zoom-width;
                height: tile.zoom-height;
                source: tile.zoom-image;
                source-clip-x: tile.zoom-clip-x;
                source-clip-y: tile.zoom-clip-y;
                source-clip-width: tile.zoom-clip-width;
                source-clip-height: tile.zoom-clip-height;
                image-fit: fill;
                image-rendering: tile.zoom-pixelated ? ImageRendering.pixelated : ImageRendering.smooth;
            }

            if !tile.zoom-hq && tile.image.width > 0 : Image {
                x: tile.zoom-x;
                y: tile.zoom-y;
                width: tile.zoom-width;
                height: tile.zoom-height;
                source: tile.image;
                source-clip-x: tile.zoom-clip-x;
                source-clip-y: tile.zoom-clip-y;
                source-clip-width: tile.zoom-clip-width;
                source-clip-height: tile.zoom-clip-height;
                image-fit: fill;
                image-rendering: tile.zoom-pixelated ? ImageRendering.pixelated : ImageRendering.smooth;
            }
        }

        if tile.is-loading && tile.error-text == "" : AppIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            icon: IconId.loader;
            size: IconSize.xxl;
            color: Theme.primary;
        }

        if tile.error-text != "" : Rectangle {
            background: Theme.corrupt-bg;
            border-width: 1px;
            border-color: #f38ba844;

            VerticalLayout {
                alignment: center;
                spacing: 10px;
                padding: 12px;

                HorizontalLayout {
                    alignment: center;
                    AppIcon {
                        icon: IconId.status-warning;
                        size: IconSize.xxl;
                        color: Theme.status-corrupt;
                    }
                }

                Text {
                    text: tile.error-text;
                    font-size: 13px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        // The corner marks of the selected medium of several frame its view, not the medium, so they stay put at every size and
        // zoom. A video's native window covers this scene where it lies over a corner; mpv draws that part of the mark itself.
        if root.interactive && tile.focused : MultiviewFocusCorners {
            x: tile.focus-view-x;
            y: tile.focus-view-y;
            width: tile.focus-view-width;
            height: tile.focus-view-height;
            mark-length: tile.focus-corner;
            thickness: tile.focus-thickness;
        }

        // The feedback of an interaction (`media_feedback`; a rating given with Ctrl+0..5, a save): its icon in the middle of the tile,
        // full strength first, then fading out. A video tile gets the same icon from mpv itself, because its native window covers this
        // scene. Rating: the colored rating icon; saved: the save icon, white on a green disc (`feedback_overlay` draws both alike).
        if root.interactive && tile.kind != 1 && tile.feedback-icon >= 0 : Rectangle {
            width: 50px;
            height: 50px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            // The one place an icon is dimmed with opacity: it is a fade of a colored icon that cannot be tinted, and at full strength (the
            // whole hold) Slint draws it without a layer.
            opacity: tile.feedback-alpha;

            // A rating: the digit is cut out of the colored disc; a white disc behind it fills the digit white instead of letting the
            // picture shine through. Saved: the green disc itself.
            Rectangle {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                border-radius: self.width / 2;
                background: tile.feedback-icon == 6 ? Theme.status-ok : #ffffff;
            }

            if tile.feedback-icon <= 5 : AppIcon {
                icon: IconLookup.rating(tile.feedback-icon);
                size: 50px;
            }

            if tile.feedback-icon == 6 : AppIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                icon: IconId.save;
                size: 28px;
                color: #ffffff;
            }
        }

        if root.interactive : TouchArea {
            // A zoomed picture takes the whole room of its tile (the pointer is reported inside the room then).
            x: tile.zoomed ? tile.zoom-area-x : 0px;
            y: tile.zoomed ? tile.zoom-area-y : 0px;
            width: tile.zoomed ? tile.zoom-area-width : parent.width;
            height: tile.zoomed ? tile.zoom-area-height : parent.height;

            // The press and the drag that moves a zoomed picture: a click is reported where the button goes up (without a drag
            // in between) on a picture that can be dragged, and where it goes down on every other tile.
            property <length> press-x;
            property <length> press-y;
            property <length> last-x;
            property <length> last-y;
            property <bool> dragged: false;

            mouse-cursor: tile.pannable ? (self.pressed && self.dragged ? MouseCursor.grabbing : MouseCursor.grab) : MouseCursor.default;

            scroll-event(event) => {
                if tile.kind <= 1 && (event.modifiers.control || event.modifiers.meta) {
                    root.tile-zoom-wheel(index, event.delta-y, self.mouse-x, self.mouse-y);
                    return accept;
                }
                if tile.kind == 1 {
                    root.tile-video-wheel(index, event.delta-y, event.modifiers.control || event.modifiers.meta);
                    return accept;
                }
                if root.wheel-navigation {
                    root.wheel(event.delta-y);
                    return accept;
                }
                return reject;
            }

            pointer-event(event) => {
                if event.button == PointerEventButton.left {
                    if event.kind == PointerEventKind.down {
                        self.press-x = self.mouse-x;
                        self.press-y = self.mouse-y;
                        self.last-x = self.mouse-x;
                        self.last-y = self.mouse-y;
                        self.dragged = false;
                        if !tile.pannable {
                            root.tile-clicked(index, event.modifiers.control || event.modifiers.meta);
                        }
                    } else if event.kind == PointerEventKind.up {
                        if tile.pannable && !self.dragged {
                            root.tile-clicked(index, event.modifiers.control || event.modifiers.meta);
                        }
                        self.dragged = false;
                    }
                } else if event.kind == PointerEventKind.down && event.button == PointerEventButton.middle {
                    root.middle-clicked();
                } else if event.kind == PointerEventKind.down && event.button == PointerEventButton.right && tile.kind == 1 {
                    root.tile-right-clicked(index);
                }
            }

            moved => {
                if self.pressed && tile.pannable {
                    if !self.dragged && (Math.abs(self.mouse-x - self.press-x) > 4px || Math.abs(self.mouse-y - self.press-y) > 4px) {
                        self.dragged = true;
                    }
                    if self.dragged {
                        root.tile-pan(index, self.mouse-x - self.last-x, self.mouse-y - self.last-y);
                        self.last-x = self.mouse-x;
                        self.last-y = self.mouse-y;
                    }
                }
            }
        }

        // The crop tool: above the picture and its pointer area, below the minimap (which keeps moving a zoomed picture).
        if tile.kind == 0 && tile.crop-open && root.interactive : MultiviewCropOverlay {
            x: tile.crop-room-x;
            y: tile.crop-room-y;
            width: tile.crop-room-width;
            height: tile.crop-room-height;
            pic-x: tile.crop-pic-x;
            pic-y: tile.crop-pic-y;
            pic-width: tile.crop-pic-width;
            pic-height: tile.crop-pic-height;
            crop-x: tile.crop-x;
            crop-y: tile.crop-y;
            crop-width: tile.crop-width;
            crop-height: tile.crop-height;
            size-label: tile.crop-size-label;
            ratio-label: tile.crop-ratio-label;
            show-grid: tile.crop-grid;
            dragging: tile.crop-dragging;

            pointer(phase, x, y, shift) => {
                root.crop-pointer(index, phase, x + self.x, y + self.y, shift);
            }
            ratio(landscape) => {
                root.crop-ratio(index, landscape);
            }
            pan(dx, dy) => {
                root.tile-pan(index, dx, dy);
            }
            zoom-wheel(delta, x, y) => {
                // The wheel zoom of a zoomed picture is reported in its room, else in the tile.
                if tile.zoomed {
                    root.tile-zoom-wheel(index, delta, x + self.x - tile.zoom-area-x, y + self.y - tile.zoom-area-y);
                } else {
                    root.tile-zoom-wheel(index, delta, x + self.x, y + self.y);
                }
            }
        }

        // The minimap of a zoomed image: the whole image in small, the visible part framed. Dragging the frame moves the picture.
        if tile.mm-available && root.interactive : Rectangle {
            x: tile.mm-x;
            y: tile.mm-y;
            width: tile.mm-width;
            height: tile.mm-height;
            opacity: tile.mm-visible ? 1.0 : 0.0;
            visible: self.opacity > 0.01;
            animate opacity { duration: 150ms; easing: ease-out; }
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000080;
            drop-shadow-offset-y: 2px;
            clip: true;

            Image {
                source: tile.mm-image;
                width: 100%;
                height: 100%;
                image-fit: fill;
            }

            // What is not visible in the tile is dimmed.
            Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height * tile.mm-vy; background: #00000099; }
            Rectangle { x: 0px; y: parent.height * (tile.mm-vy + tile.mm-vh); width: parent.width; height: parent.height - parent.height * (tile.mm-vy + tile.mm-vh); background: #00000099; }
            Rectangle { x: 0px; y: parent.height * tile.mm-vy; width: parent.width * tile.mm-vx; height: parent.height * tile.mm-vh; background: #00000099; }
            Rectangle { x: parent.width * (tile.mm-vx + tile.mm-vw); y: parent.height * tile.mm-vy; width: parent.width - parent.width * (tile.mm-vx + tile.mm-vw); height: parent.height * tile.mm-vh; background: #00000099; }

            Rectangle {
                x: parent.width * tile.mm-vx;
                y: parent.height * tile.mm-vy;
                width: parent.width * tile.mm-vw;
                height: parent.height * tile.mm-vh;
                border-width: 2px;
                border-color: Theme.primary;
                background: Theme.primary.with-alpha(0.12);
            }

            mm-touch := TouchArea {
                mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.pointer;

                pointer-event(event) => {
                    if event.button == PointerEventButton.left {
                        if event.kind == PointerEventKind.down {
                            root.minimap-pointer(index, Math.clamp(self.mouse-x / self.width, 0, 1), Math.clamp(self.mouse-y / self.height, 0, 1), 0);
                        } else if event.kind == PointerEventKind.up {
                            root.minimap-pointer(index, Math.clamp(self.mouse-x / self.width, 0, 1), Math.clamp(self.mouse-y / self.height, 0, 1), 2);
                        }
                    } else if event.kind == PointerEventKind.down && event.button == PointerEventButton.middle {
                        root.minimap-pointer(index, 0, 0, 3);
                    } else if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                        root.minimap-pointer(index, 0, 0, 4);
                    }
                }

                moved => {
                    if self.pressed {
                        root.minimap-pointer(index, Math.clamp(self.mouse-x / self.width, 0, 1), Math.clamp(self.mouse-y / self.height, 0, 1), 1);
                    }
                }
            }
        }

        // The zoom slider on the minimap (right click on it): a speech bubble above it, the same slider as the media bar's, so both show
        // and change the same zoom. The percentage floats above the bubble.
        if tile.mm-available && tile.mm-bubble-open && root.interactive : holder := Rectangle {
            property <length> bubble-width: 210px;
            property <length> bubble-height: 43px;
            property <length> bubble-x: Math.max(tile.zoom-area-x, Math.min(tile.zoom-area-x + tile.zoom-area-width - self.bubble-width, tile.mm-x + tile.mm-width / 2 - self.bubble-width / 2));
            property <bool> pill-shown: false;
            property <length> pill-center: 0px;

            x: 0px;
            y: 0px;
            width: 0px;
            height: 0px;

            MultiviewBarMenu {
                x: holder.bubble-x;
                y: tile.mm-y - holder.bubble-height - 4px;
                width: holder.bubble-width;
                custom-height: 28px + 8px;
                translucent: false;
                caret-down: true;
                anchor-x: tile.mm-x + tile.mm-width / 2 - holder.bubble-x;

                MultiviewZoomSlider {
                    x: 4px;
                    y: 4px;
                    width: parent.width - 8px;
                    value-permille: tile.mm-zoom-permille;
                    min-permille: tile.mm-zoom-min;
                    max-permille: tile.mm-zoom-max;
                    snaps: tile.mm-zoom-snaps;
                    pill-changed(shown, center) => {
                        holder.pill-shown = shown;
                        holder.pill-center = center;
                    }
                    request(code) => {
                        root.minimap-slider(index, code);
                    }
                }
            }

            if holder.pill-shown : Rectangle {
                x: Math.max(tile.zoom-area-x, holder.bubble-x + 4px + holder.pill-center - self.width / 2);
                y: tile.mm-y - holder.bubble-height - 4px - self.height - 3px;
                width: 46px;
                height: 18px;
                border-radius: 9px;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;

                Text {
                    text: Math.round(tile.mm-zoom-permille / 10.0) + "%";
                    font-size: 10px;
                    font-weight: 700;
                    color: Theme.text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    for gutter[index] in root.gutters : MultiviewGutter {
        x: gutter.x;
        y: gutter.y;
        width: gutter.width;
        height: gutter.height;
        vertical: gutter.vertical;
        swap-only: gutter.swap-only;
        interactive: root.interactive;

        drag-started => {
            root.gutter-drag-started(index);
        }
        dragged(distance) => {
            root.gutter-dragged(index, distance);
        }
        drag-finished => {
            root.gutter-drag-finished(index);
        }
        reset => {
            root.gutter-reset();
        }
        swap => {
            root.gutter-swap(index);
        }
    }

    // The control bars, above the tiles and gutters. They take the pointer even on a canvas that is only a picture (the tab grid):
    // there they are the small bars of the video under the pointer.
    for bar in root.video-bars : MultiviewVideoBar {
        x: bar.x;
        y: bar.y;
        width: bar.width;
        height: bar.height;
        bar: bar;
        canvas-width: root.width;
        canvas-height: root.height;
    }
}
