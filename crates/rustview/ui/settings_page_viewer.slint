import { CheckBox, ComboBox, SpinBox } from "std-widgets.slint";
import { Theme } from "styles.slint";
import { SettingsCard } from "settings_card.slint";
import { SettingsCardAbRepeat } from "settings_card_ab_repeat.slint";

export component SettingsPageViewer inherits VerticalLayout {
    spacing: 12px;

    in-out property <bool> open-images-in-tab: true;
    in-out property <bool> allow-multiple-image-tabs: false;
    in-out property <bool> open-videos-in-tab: true;
    in-out property <bool> allow-multiple-video-tabs: true;
    in-out property <int> video-jump-secs: 5;
    // The mpv script ab_repeat.lua (`settings_card_ab_repeat.slint`).
    in-out property <bool> ab-enabled: true;
    in-out property <bool> ab-osd-messages: true;
    in-out property <int> ab-colors-idx: 0;
    in-out property <bool> ab-click-loads: true;
    in-out property <bool> ab-hover-name: true;
    in-out property <bool> ab-hover-times: false;
    in-out property <bool> ab-drag-flags: true;
    in-out property <int> ab-menu-idx: 0;
    in-out property <int> ab-page-size: 10;
    in property <string> ab-status-text;
    in property <int> ab-status-level;
    in property <string> ab-status-tooltip;
    in property <bool> ab-checking;
    callback ab-check-again();
    in-out property <int> video-jump-long-secs: 60;
    in-out property <bool> show-tab-rating-badge: false;
    in-out property <int> background-mode-idx: 0; // 0 = Dark, 1 = Deep Black, 2 = Checkerboard

    SettingsCard {
        title: "Images";
        description: "Configure how images are opened upon double-clicking media tiles in the browser.";

        CheckBox {
            text: "Open images in internal viewer tabs";
            checked <=> root.open-images-in-tab;
        }

        if root.open-images-in-tab : CheckBox {
            text: "Allow multiple tabs for the same image";
            checked <=> root.allow-multiple-image-tabs;
        }

        Text {
            text: root.open-images-in-tab
                ? (root.allow-multiple-image-tabs
                    ? "Double-clicking an image opens a new tab every time with an iteration suffix like (1), (2)."
                    : "Double-clicking an image tile focuses the existing tab if already open.")
                : "Double-clicking an image tile delegates opening to the operating system default application.";
            font-size: 11px;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
    }

    SettingsCard {
        title: "Videos";
        description: "Configure how videos are opened upon double-clicking media tiles in the browser.";

        CheckBox {
            text: "Open videos in internal viewer tabs";
            checked <=> root.open-videos-in-tab;
        }

        if root.open-videos-in-tab : CheckBox {
            text: "Allow multiple tabs for the same video";
            checked <=> root.allow-multiple-video-tabs;
        }

        Text {
            text: root.open-videos-in-tab
                ? (root.allow-multiple-video-tabs
                    ? "Double-clicking a video opens a new tab with an independent MPV player instance and iteration suffix like (1), (2)."
                    : "Double-clicking a video tile focuses the existing tab if already open.")
                : "Double-clicking a video tile delegates opening to the operating system default application.";
            font-size: 11px;
            color: Theme.text-muted;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: "Jump keys move by (seconds):";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }

            SpinBox {
                width: 90px;
                minimum: 1;
                maximum: 600;
                value <=> root.video-jump-secs;
            }
        }

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: "Long jump keys move by (seconds):";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }

            SpinBox {
                width: 90px;
                minimum: 1;
                maximum: 600;
                value <=> root.video-jump-long-secs;
            }
        }

        Text {
            text: "The jump keys are on Settings > Hotkeys > Video Player (Left and Right, with Shift the long jumps, by default).";
            font-size: 11px;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
    }

    SettingsCardAbRepeat {
        enabled <=> root.ab-enabled;
        osd-messages <=> root.ab-osd-messages;
        colors-idx <=> root.ab-colors-idx;
        click-loads <=> root.ab-click-loads;
        hover-name <=> root.ab-hover-name;
        hover-times <=> root.ab-hover-times;
        drag-flags <=> root.ab-drag-flags;
        menu-idx <=> root.ab-menu-idx;
        page-size <=> root.ab-page-size;
        status-text: root.ab-status-text;
        status-level: root.ab-status-level;
        status-tooltip: root.ab-status-tooltip;
        checking: root.ab-checking;
        check-again => { root.ab-check-again(); }
    }

    SettingsCard {
        title: "Tabs";
        description: "Visual indicators and badge overlays for open viewer tabs in the top toolbar.";

        CheckBox {
            text: "Show rating badge in tabs";
            checked <=> root.show-tab-rating-badge;
        }
    }

    SettingsCard {
        title: "Viewer Presentation";
        description: "Background canvas and appearance for internal media tabs.";

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Viewer Canvas Background:";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            ComboBox {
                width: 190px;
                model: ["Dark Theme (#11111b)", "Deep Black (#000000)", "Transparent Checkerboard"];
                current-index <=> root.background-mode-idx;
            }
        }
    }
}
