import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";

/// Centered, non-blocking Fallback Empty State overlay component.
/// Displays context-sensitive guidance when no media items match the active filters or query.
export component EmptyStateView inherits Rectangle {
    in property <bool> is-active: false;
    in property <string> title: "No Media Files";
    in property <string> description: "This folder contains no supported media files.";
    in property <IconId> icon: IconId.folder;

    width: 100%;
    height: 100%;
    visible: root.is-active;
    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: 10px;

        // Centered Icon Badge
        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 54px;
                height: 54px;
                border-radius: 27px;
                background: #89b4fa14;
                border-width: 1px;
                border-color: #89b4fa28;

                AppIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon: root.icon;
                    size: IconSize.xl;
                    color: Theme.primary;
                }
            }
        }

        // Title
        Text {
            text: root.title;
            font-size: 15px;
            font-weight: 700;
            color: Theme.text;
            horizontal-alignment: center;
        }

        // Description / Guidance
        HorizontalLayout {
            alignment: center;

            Text {
                text: root.description;
                font-size: 12px;
                color: Theme.text-muted;
                horizontal-alignment: center;
                wrap: word-wrap;
                max-width: 440px;
            }
        }
    }
}
