import { Theme } from "styles.slint";
import { AppIcon, IconId } from "icons.slint";

/// The short hint of the Multiview when a key has nothing to act on ("Select a medium first"), drawn by the canvas centered over
/// the view, above the media and the bars. It looks like the feedback of a rating: a disc with an icon and one line below it.
/// `shown` going false fades it out over `fade`; a new hint (`shown` true again) is there at once. It takes no pointer input.
export component MultiviewHint inherits Rectangle {
    in property <string> text;
    in property <bool> shown: false;
    in property <duration> fade: 250ms;

    property <length> disc-size: 56px;
    property <length> caption-top: root.disc-size + 6px;
    property <length> caption-height: 26px;
    property <length> caption-width: caption-text.preferred-width + 28px;
    property <color> surface: Theme.surface.with-alpha(0.93);

    width: Math.max(root.disc-size, root.caption-width);
    height: root.caption-top + root.caption-height;
    visible: content.opacity > 0.01;

    content := Rectangle {
        width: root.width;
        height: root.height;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 0px;
            width: root.disc-size;
            height: root.disc-size;
            border-radius: self.width / 2;
            background: root.surface;
            border-width: 2px;
            border-color: Theme.primary;

            AppIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                icon: IconId.multiview-select-first;
                size: 24px;
                color: Theme.primary;
            }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: root.caption-top;
            width: root.caption-width;
            height: root.caption-height;
            border-radius: self.height / 2;
            background: root.surface;

            caption-text := Text {
                text: root.text;
                font-size: 13px;
                color: Theme.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    states [
        gone when !root.shown: {
            content.opacity: 0;
            in {
                animate content.opacity { duration: root.fade; easing: linear; }
            }
        }
    ]
}
