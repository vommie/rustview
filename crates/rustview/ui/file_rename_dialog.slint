import { LineEdit, Button } from "std-widgets.slint";
import { Theme } from "styles.slint";
import { InlineNotice } from "inline_notice.slint";
import { ButtonBar } from "button_bar.slint";
import { DialogBody } from "dialog_body.slint";

export component FileRenameDialog inherits Window {
    title: "RustView - Rename Media File";
    width: 480px;
    preferred-height: dialog-layout.preferred-height;
    min-height: dialog-layout.min-height;
    background: Theme.background;

    in-out property <string> initial-name: "";
    in-out property <string> new-name <=> name-input.text;
    in property <string> error-message: "";

    // Conflict & Smart Resolution Properties
    in-out property <bool> has-conflict: false;
    in-out property <string> suggested-name: "";
    in-out property <string> conflict-message: "";

    callback confirmed(string);
    callback cancelled();
    callback name-edited(string);
    callback use-suggested-name();

    forward-focus: name-input;

    public function select-all() {
        name-input.select-all();
    }

    dialog-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            return reject;
        }

        dialog-layout := VerticalLayout {
            width: root.width;
            padding: 0px;
            spacing: 0px;
            alignment: space-between;

            body := DialogBody {
                content-height: content.preferred-height;

                content := VerticalLayout {
                    width: body.width;
                    height: self.preferred-height;
                    padding: 16px;
                    spacing: 10px;

                    Text {
                        text: "Rename File";
                        font-size: 14px;
                        font-weight: 700;
                        color: Theme.primary;
                    }

                    Text {
                        text: "Enter a new filename for the selected media item:";
                        font-size: 11px;
                        color: Theme.text-muted;
                    }

                    name-input := LineEdit {
                        text: root.initial-name;
                        placeholder-text: "New filename...";
                        height: 32px;
                        vertical-stretch: 0;
                        edited => {
                            root.name-edited(self.text);
                        }
                        accepted => {
                            if self.text != "" {
                                root.confirmed(self.text);
                            }
                        }
                        key-pressed(event) => {
                            if event.text == Key.Escape {
                                root.cancelled();
                                return accept;
                            }
                            return reject;
                        }
                    }

                    // Real-time Conflict Alert & Quick Resolution Action
                    if root.has-conflict : Rectangle {
                        background: Theme.accent.with-alpha(0.094);
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Theme.accent.with-alpha(0.267);

                        VerticalLayout {
                            padding: 8px;
                            spacing: 6px;

                            InlineNotice {
                                text: root.conflict-message;
                                color: Theme.accent;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                Text {
                                    text: "Next available name:";
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }

                                Button {
                                    text: "Use \"" + root.suggested-name + "\"";
                                    clicked => {
                                        root.use-suggested-name();
                                    }
                                }
                            }
                        }
                    }

                    if root.error-message != "" : Text {
                        text: root.error-message;
                        font-size: 11px;
                        color: Theme.status-corrupt;
                        wrap: word-wrap;
                    }
                }
            }

            ButtonBar {
                vertical-stretch: 0;
                bar-height: 48px;
                show-cancel: true;
                show-save: true;
                text-save: root.has-conflict ? "Resolve..." : "Rename";
                text-cancel: "Cancel";
                cancel-clicked => { root.cancelled(); }
                save-clicked => {
                    if name-input.text != "" {
                        root.confirmed(name-input.text);
                    }
                }
            }
        }
    }
}
