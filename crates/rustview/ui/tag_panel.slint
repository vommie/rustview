import { Button } from "std-widgets.slint";
import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize, IconSlot } from "icons.slint";
import { TagNodeView, TagColumnView, TagHistoryRowModel } from "types.slint";
import { RatingBar } from "rating_bar.slint";
import { SmoothScrollArea } from "smooth_scroll_view.slint";
import { NodeButton } from "node_button.slint";
import { CompactTagTreeList } from "tag_tree_compact.slint";
import { TagPanelToolbar } from "tag_panel_toolbar.slint";
import { TagSearchFilter } from "tag_search_filter.slint";
import { TagHistoryPanel } from "tag_history_panel.slint";
import { ResizerBar } from "resizer_bar.slint";

export component TagTreeItem inherits Rectangle {
    in property <TagNodeView> tag;
    in property <bool> is-assign-mode: false;
    in property <bool> has-selection: true;
    callback clicked();
    callback toggle-expanded();
    callback scroll-requested(length /* dx */, length /* dy */);
    callback context-menu-requested(length /* x */, length /* y */);

    height: 22px;
    min-width: 60px;
    max-width: 180px;

    property <bool> is-item-enabled: !root.is-assign-mode || root.has-selection;
    // Indentation of each nesting level; a child label sits only 7px right of its parent label.
    property <length> indent-per-level: 7px;

    background: root.tag.is-selected ? Theme.surface-selected : (
        root.tag.is-assigned ? (root.tag.is-dimmed ? #a6e3a118 : #a6e3a128) : (
            root.tag.is-partial ? (root.tag.is-dimmed ? #f9e2af15 : #f9e2af22) : (
                tag-touch.has-hover ? Theme.surface-hover : (root.tag.is-dimmed ? #1e1e2e66 : Theme.surface-variant)
            )
        )
    );

    border-radius: 3px;
    border-width: 1px;

    border-color: root.tag.is-selected ? Theme.primary : (
        root.tag.is-assigned ? (root.tag.is-dimmed ? #a6e3a188 : #a6e3a1) : (
            root.tag.is-partial ? (root.tag.is-dimmed ? #f9e2af88 : #f9e2af) : Theme.border
        )
    );

    opacity: root.is-item-enabled ? 1.0 : 0.45;

    tag-touch := TouchArea {
        enabled: root.is-item-enabled;
        mouse-cursor: root.is-item-enabled ? pointer : default;

        scroll-event(event) => {
            root.scroll-requested(event.delta-x, event.delta-y);
            return accept;
        }

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                if event.button == PointerEventButton.right {
                    root.context-menu-requested(tag-touch.mouse-x, tag-touch.mouse-y);
                } else if event.button == PointerEventButton.left {
                    root.clicked();
                }
            }
        }
    }

    HorizontalLayout {
        opacity: root.tag.is-dimmed ? 0.8 : 1.0;
        padding-left: (root.tag.depth * root.indent-per-level) + 6px;
        padding-right: 8px;
        spacing: 4px;
        alignment: start;

        NodeButton {
            has-children: root.tag.has-children;
            is-expanded: root.tag.is-expanded;
            button-size: 14px;
            y: (parent.height - self.height) / 2;
            toggled(new-state) => {
                root.toggle-expanded();
            }
        }

        if root.tag.is-assigned || root.tag.is-partial : IconSlot {
            icon: root.tag.is-assigned ? IconId.check : IconId.partial;
            size: IconSize.sm;
            color: root.tag.is-assigned ? #a6e3a1 : #f9e2af;
        }

        Text {
            text: root.tag.name;
            color: root.tag.is-selected ? Theme.primary : (
                root.tag.is-assigned ? #a6e3a1 : (
                    root.tag.is-partial ? #f9e2af : Theme.text
                )
            );

            font-weight: (root.tag.is-selected || root.tag.is-assigned || root.tag.depth == 0) ? 700 : 400;
            font-italic: root.tag.is-partial;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-alignment: left;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

export component TagTreeList inherits Rectangle {
    vertical-stretch: 1;
    background: Theme.background;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    in property <[TagColumnView]> columns: [];
    in property <bool> is-assign-mode: false;
    in property <bool> has-selection: true;

    callback tag-clicked(int);
    callback tag-toggle-expand(int);
    callback tag-context-menu(int, length, length);
    callback root-context-menu(length, length);
    callback tree-geometry-changed(length /* available_height */);

    changed height => {
        if self.height > 10px {
            root.tree-geometry-changed(self.height);
        }
    }

    scroll-area := SmoothScrollArea {
        width: 100%;
        height: 100%;
        enable-horizontal: true;
        enable-vertical: false;
        content-width: columns-layout.preferred-width;
        content-height: self.height;

        bg-touch := TouchArea {
            width: 100%;
            height: 100%;

            scroll-event(event) => {
                scroll-area.handle-scroll(event.delta-x, event.delta-y);
                return accept;
            }

            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                    root.root-context-menu(
                        bg-touch.mouse-x + scroll-area.clamped-x,
                        bg-touch.mouse-y
                    );
                }
            }
        }

        columns-layout := HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 6px;
            alignment: start;

            for column[col-idx] in root.columns: VerticalLayout {
                spacing: 2px;
                alignment: start;
                min-width: 60px;
                max-width: 180px;

                for tag in column.tags: TagTreeItem {
                    tag: tag;
                    is-assign-mode: root.is-assign-mode;
                    has-selection: root.has-selection;

                    clicked => { root.tag-clicked(tag.id); }
                    toggle-expanded => { root.tag-toggle-expand(tag.id); }
                    scroll-requested(dx, dy) => {
                        scroll-area.handle-scroll(dx, dy);
                    }
                    context-menu-requested(mx, my) => {
                        root.tag-context-menu(
                            tag.id,
                            self.x + mx + scroll-area.clamped-x,
                            self.y + my
                        );
                    }
                }
            }
        }
    }
}

export component TagPanel inherits VerticalLayout {
    spacing: 6px;
    vertical-stretch: 1;

    in-out property <bool> is-assign-mode: false;
    in-out property <int> match-mode-idx: 0;
    in-out property <int> scope-mode-idx: 2;
    in-out property <int> selected-rating: 0;
    in property <bool> has-selection: true;
    in property <[bool]> partial-ratings: [false, false, false, false, false, false];
    in property <bool> has-active-query: false;
    in property <bool> is-tab-view: false;
    // Shown below the rating buttons while the panel acts on nothing because a Multiview tab has no selected medium.
    in property <string> selection-hint: "";
    in-out property <string> filter-text: "";
    in-out property <bool> tag-filter-is-regex: false;
    in property <[TagColumnView]> tag-columns: [];
    // Compact Mode of the tree (`tags.compact_tree`): dense rows sharing one line (tag_tree_compact.slint).
    in property <bool> compact-tree: false;

    // Tag History properties
    in property <[TagHistoryRowModel]> tag-history-rows: [];
    in property <int> tag-history-count: 0;
    in-out property <bool> tag-history-is-collapsed: false;
    in-out property <length> tag-history-height: 96px;

    out property <bool> filter-has-focus: filter-input.has-focus;

    callback mode-toggled(bool);
    callback match-mode-changed(int);
    callback scope-mode-changed(int);
    callback reset-clicked();
    callback rating-selected(int);
    callback tag-filter-changed(string);
    callback tag-filter-escape-pressed();
    callback tag-regex-toggled(bool);
    callback tag-clicked(int);
    callback tag-toggle-expand(int);
    callback tag-context-menu(int, length, length);
    callback root-context-menu(length, length);
    callback tree-geometry-changed(length /* available_height */);

    // Tag History callbacks
    callback tag-history-collapsed-toggled(bool);
    callback tag-history-tag-clicked(int /* tag_id */);
    callback tag-history-geometry-changed(length /* available_width */);
    callback tag-history-resized(length /* new_height */);
    callback tag-history-resize-finished(length /* final_height */);

    // a. Controls: Modular Tag Panel Toolbar (Mode, Match, Scope Dropdown, Sensitive Reset)
    TagPanelToolbar {
        is-assign-mode <=> root.is-assign-mode;
        match-mode-idx <=> root.match-mode-idx;
        scope-mode-idx <=> root.scope-mode-idx;
        has-active-query: root.has-active-query;
        is-tab-view: root.is-tab-view;
        mode-toggled(assign) => { root.mode-toggled(assign); }
        match-mode-changed(m) => { root.match-mode-changed(m); }
        scope-mode-changed(s) => { root.scope-mode-changed(s); }
        reset-clicked => { root.reset-clicked(); }
    }

    // b. Rating-Buttons: Rating Selector Bar
    RatingBar {
        selected-rating <=> root.selected-rating;
        is-assign-mode: root.is-tab-view ? true : root.is-assign-mode;
        has-selection: root.has-selection;
        partial-ratings: root.partial-ratings;
        rating-selected(r) => { root.rating-selected(r); }
    }

    if root.selection-hint != "" : Text {
        text: root.selection-hint;
        font-size: 11px;
        color: Theme.text-muted;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    // c. Filter Search: Tag Filter Input with integrated regex toggle & clear button
    filter-input := TagSearchFilter {
        text <=> root.filter-text;
        is-regex <=> root.tag-filter-is-regex;
        placeholder-text: "Filter tags...";
        search-changed(text) => { root.tag-filter-changed(text); }
        regex-toggled(r) => { root.tag-regex-toggled(r); }
        escape-pressed => { root.tag-filter-escape-pressed(); }
    }

    // d. Tags Tree: Hierarchical Tree View (stretches vertically to fill main panel area); Normal Mode or Compact Mode
    tree-area := Rectangle {
        vertical-stretch: 1;

        if !root.compact-tree: TagTreeList {
            width: 100%;
            height: 100%;
            columns: root.tag-columns;
            is-assign-mode: root.is-tab-view ? true : root.is-assign-mode;
            has-selection: root.has-selection;
            tree-geometry-changed(h) => { root.tree-geometry-changed(h); }
            tag-clicked(id) => { root.tag-clicked(id); }
            tag-toggle-expand(id) => { root.tag-toggle-expand(id); }
            tag-context-menu(id, x, y) => { root.tag-context-menu(id, tree-area.x + x, tree-area.y + y); }
            root-context-menu(x, y) => { root.root-context-menu(tree-area.x + x, tree-area.y + y); }
        }

        if root.compact-tree: CompactTagTreeList {
            width: 100%;
            height: 100%;
            columns: root.tag-columns;
            is-assign-mode: root.is-tab-view ? true : root.is-assign-mode;
            has-selection: root.has-selection;
            tree-geometry-changed(h) => { root.tree-geometry-changed(h); }
            tag-clicked(id) => { root.tag-clicked(id); }
            tag-toggle-expand(id) => { root.tag-toggle-expand(id); }
            tag-context-menu(id, x, y) => { root.tag-context-menu(id, tree-area.x + x, tree-area.y + y); }
            root-context-menu(x, y) => { root.root-context-menu(tree-area.x + x, tree-area.y + y); }
        }
    }

    // Horizontal Resizer Bar positioned between Tag Tree and Tag History
    history-resizer := ResizerBar {
        is-horizontal: false;
        height: (!root.tag-history-is-collapsed) ? self.thickness : 0px;
        visible: !root.tag-history-is-collapsed;

        property <length> start-h: 96px;
        drag-started => {
            self.start-h = root.tag-history-height;
        }
        dragged(delta) => {
            // Tag History is bottom-anchored: dragging UP (negative delta) expands, dragging DOWN (positive delta) shrinks
            root.tag-history-height = Math.max(40px, Math.min(500px, self.start-h - delta));
            root.tag-history-resized(root.tag-history-height);
        }
        drag-finished => {
            root.tag-history-resize-finished(root.tag-history-height);
        }
    }

    // e. Tags History: Collapsible panel at the bottom with resizable body height
    history-panel := TagHistoryPanel {
        vertical-stretch: 0;
        body-height: root.tag-history-height;
        is-dragging: history-resizer.is-dragging;
        rows: root.tag-history-rows;
        tag-count: root.tag-history-count;
        is-collapsed <=> root.tag-history-is-collapsed;
        has-selection: root.has-selection;
        collapsed-toggled(c) => { root.tag-history-collapsed-toggled(c); }
        tag-clicked(id) => { root.tag-history-tag-clicked(id); }
        geometry-changed(w) => { root.tag-history-geometry-changed(w); }
    }
}
