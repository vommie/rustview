import { ComboBox } from "settings_controls.slint";
import { SettingsCard } from "settings_card.slint";
import { SettingsOptionRow } from "settings_option_row.slint";

/// Settings > Multiview > Selected Medium: how the selected medium of a Multiview with several media is marked.
export component SettingsCardSelectedMedium inherits VerticalLayout {
    in-out property <int> brighten-idx: 2; // 0 = off, 1 = weak, 2 = medium, 3 = strong
    in-out property <int> corner-idx: 1; // 0 = short, 1 = medium, 2 = long

    SettingsCard {
        title: "Selected Medium";
        description: "With two or more media, a click on a medium or on a button of its media action bar selects it, and the keys act on that medium only.";

        SettingsOptionRow {
            label: "Brighten its area";
            tooltip: "The empty area around the selected medium (above, below or beside it in its column) is lightened. Off: only the corner marks show the selection.";

            ComboBox {
                model: ["Off", "Weak", "Medium", "Strong"];
                current-index <=> root.brighten-idx;
            }
        }

        SettingsOptionRow {
            label: "Corner marks";
            tooltip: "The length of the blue marks inside the corners of the selected medium (on a video too). They are always shown, so the selection never goes unnoticed.";

            ComboBox {
                model: ["Short", "Medium", "Long"];
                current-index <=> root.corner-idx;
            }
        }
    }
}
