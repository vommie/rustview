import { LineEdit } from "std-widgets.slint";
import { Theme } from "styles.slint";
import { ButtonBar } from "button_bar.slint";
import { DialogBody } from "dialog_body.slint";

export component FavoriteRenameDialog inherits Window {
    title: "RustView - Rename Favorite";
    width: 440px;
    preferred-height: dialog-layout.preferred-height;
    min-height: dialog-layout.min-height;
    background: Theme.background;

    in-out property <string> initial-alias: "";
    in-out property <string> new-alias <=> name-input.text;
    in property <string> target-path: "";
    in property <string> error-message: "";

    callback confirmed(string);
    callback cancelled();

    forward-focus: name-input;

    public function select-all() {
        name-input.select-all();
    }

    dialog-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            return reject;
        }

        dialog-layout := VerticalLayout {
            width: root.width;
            padding: 0px;
            spacing: 0px;
            alignment: space-between;

            body := DialogBody {
                content-height: content.preferred-height;

                content := VerticalLayout {
                    width: body.width;
                    height: self.preferred-height;
                    padding: 16px;
                    spacing: 8px;

                    Text {
                        text: "Enter a new custom alias for this favorite (does not rename folder on disk):";
                        font-size: 11px;
                        color: Theme.text-muted;
                    }

                    name-input := LineEdit {
                        text: root.initial-alias;
                        placeholder-text: "Favorite alias...";
                        height: 32px;
                        vertical-stretch: 0;
                        accepted => {
                            if self.text != "" {
                                root.confirmed(self.text);
                            }
                        }
                        key-pressed(event) => {
                            if event.text == Key.Escape {
                                root.cancelled();
                                return accept;
                            }
                            return reject;
                        }
                    }

                    if root.error-message != "" : Text {
                        text: root.error-message;
                        font-size: 11px;
                        color: #ff5555;
                        wrap: word-wrap;
                    }
                }
            }

            ButtonBar {
                vertical-stretch: 0;
                bar-height: 48px;
                show-cancel: true;
                show-save: true;
                text-save: "Rename";
                text-cancel: "Cancel";
                cancel-clicked => { root.cancelled(); }
                save-clicked => {
                    if name-input.text != "" {
                        root.confirmed(name-input.text);
                    }
                }
            }
        }
    }
}
