import { Theme } from "styles.slint";
import { MediaHeaderColumn } from "media_header_column.slint";

export { MediaHeaderColumn } from "media_header_column.slint";

/// Unified modular column header bar shared across TableView (fixed/resizable widths) and GridView (dynamic auto-widths).
export component MediaHeaderBar inherits Rectangle {
    height: 28px;
    background: Theme.surface;

    in property <int> sort-column: 0;
    in property <int> sort-order: 0;
    in property <bool> enable-resize: true;
    in property <bool> auto-width: false;

    // All 13 Table Columns Widths
    in-out property <length> col-filename-width: 260px;
    in-out property <length> col-path-width: 180px;
    in-out property <length> col-modified-date-width: 145px;
    in-out property <length> col-created-date-width: 145px;
    in-out property <length> col-size-width: 95px;
    in-out property <length> col-rating-width: 65px;
    in-out property <length> col-tags-width: 65px;
    in-out property <length> col-width-width: 70px;
    in-out property <length> col-height-width: 70px;
    in-out property <length> col-ar-width: 65px;
    in-out property <length> col-duration-width: 110px;
    in-out property <length> col-format-width: 75px;
    in-out property <length> col-flags-width: 85px;

    // Calculated Cumulative X Offsets for TableView 1:1 Alignments
    property <length> col-pos-0: 0px;
    property <length> col-pos-1: root.col-filename-width;
    property <length> col-pos-2: root.col-pos-1 + root.col-path-width;
    property <length> col-pos-3: root.col-pos-2 + root.col-modified-date-width;
    property <length> col-pos-4: root.col-pos-3 + root.col-created-date-width;
    property <length> col-pos-5: root.col-pos-4 + root.col-size-width;
    property <length> col-pos-6: root.col-pos-5 + root.col-rating-width;
    property <length> col-pos-7: root.col-pos-6 + root.col-tags-width;
    property <length> col-pos-8: root.col-pos-7 + root.col-width-width;
    property <length> col-pos-9: root.col-pos-8 + root.col-height-width;
    property <length> col-pos-10: root.col-pos-9 + root.col-ar-width;
    property <length> col-pos-11: root.col-pos-10 + root.col-duration-width;
    property <length> col-pos-12: root.col-pos-11 + root.col-format-width;

    callback sort-clicked(int /* column_index */);
    callback column-resized(int /* column_index */, length /* new_width */);
    callback column-resize-finished(int /* column_index */, length /* final_width */);

    // Bottom border separator line
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }

    // 1. DYNAMIC AUTO-WIDTH MODE (Grid View: adapts width automatically to text length)
    if root.auto-width : HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 4px;
        alignment: start;

        MediaHeaderColumn {
            title: "Filename";
            column-index: 0;
            active-sort-column: root.sort-column;
            active-sort-order: root.sort-order;
            enable-resize: false;
            auto-width: true;
            sort-clicked(idx) => { root.sort-clicked(idx); }
        }

        MediaHeaderColumn {
            title: "Path";
            column-index: 1;
            active-sort-column: root.sort-column;
            active-sort-order: root.sort-order;
            enable-resize: false;
            auto-width: true;
            sort-clicked(idx) => { root.sort-clicked(idx); }
        }

        MediaHeaderColumn {
            title: "Modified Date";
            column-index: 2;
            active-sort-column: root.sort-column;
            active-sort-order: root.sort-order;
            enable-resize: false;
            auto-width: true;
            sort-clicked(idx) => { root.sort-clicked(idx); }
        }

        MediaHeaderColumn {
            title: "Created Date";
            column-index: 3;
            active-sort-column: root.sort-column;
            active-sort-order: root.sort-order;
            enable-resize: false;
            auto-width: true;
            sort-clicked(idx) => { root.sort-clicked(idx); }
        }

        MediaHeaderColumn {
            title: "Filesize (MB)";
            column-index: 4;
            active-sort-column: root.sort-column;
            active-sort-order: root.sort-order;
            enable-resize: false;
            auto-width: true;
            sort-clicked(idx) => { root.sort-clicked(idx); }
        }

        MediaHeaderColumn {
            title: "Rating";
            column-index: 5;
            active-sort-column: root.sort-column;
            active-sort-order: root.sort-order;
            enable-resize: false;
            auto-width: true;
            sort-clicked(idx) => { root.sort-clicked(idx); }
        }

        MediaHeaderColumn {
            title: "Tags";
            column-index: 6;
            active-sort-column: root.sort-column;
            active-sort-order: root.sort-order;
            enable-resize: false;
            auto-width: true;
            sort-clicked(idx) => { root.sort-clicked(idx); }
        }

        MediaHeaderColumn {
            title: "Width";
            column-index: 7;
            active-sort-column: root.sort-column;
            active-sort-order: root.sort-order;
            enable-resize: false;
            auto-width: true;
            sort-clicked(idx) => { root.sort-clicked(idx); }
        }

        MediaHeaderColumn {
            title: "Height";
            column-index: 8;
            active-sort-column: root.sort-column;
            active-sort-order: root.sort-order;
            enable-resize: false;
            auto-width: true;
            sort-clicked(idx) => { root.sort-clicked(idx); }
        }

        MediaHeaderColumn {
            title: "AR";
            column-index: 9;
            active-sort-column: root.sort-column;
            active-sort-order: root.sort-order;
            enable-resize: false;
            auto-width: true;
            sort-clicked(idx) => { root.sort-clicked(idx); }
        }

        MediaHeaderColumn {
            title: "Duration";
            column-index: 10;
            active-sort-column: root.sort-column;
            active-sort-order: root.sort-order;
            enable-resize: false;
            auto-width: true;
            sort-clicked(idx) => { root.sort-clicked(idx); }
        }

        MediaHeaderColumn {
            title: "Format";
            column-index: 11;
            active-sort-column: root.sort-column;
            active-sort-order: root.sort-order;
            enable-resize: false;
            auto-width: true;
            sort-clicked(idx) => { root.sort-clicked(idx); }
        }

        MediaHeaderColumn {
            title: "Flags";
            column-index: 12;
            active-sort-column: root.sort-column;
            active-sort-order: root.sort-order;
            enable-resize: false;
            auto-width: true;
            sort-clicked(idx) => { root.sort-clicked(idx); }
        }
    }

    // 2. FIXED / RESIZABLE MODE (Table View: pixel-aligned with table columns)
    if !root.auto-width : Rectangle {
        width: 100%;
        height: 100%;

        // Col 0: Filename
        MediaHeaderColumn {
            x: root.col-pos-0;
            title: "Filename";
            column-index: 0;
            active-sort-column: root.sort-column;
            active-sort-order: root.sort-order;
            enable-resize: root.enable-resize;
            auto-width: false;
            column-width <=> root.col-filename-width;
            column-min-width: 80px;
            sort-clicked(idx) => { root.sort-clicked(idx); }
            column-resized(idx, w) => { root.column-resized(idx, w); }
            column-resize-finished(idx, w) => { root.column-resize-finished(idx, w); }
        }

        // Col 1: Path
        MediaHeaderColumn {
            x: root.col-pos-1;
            title: "Path";
            column-index: 1;
            active-sort-column: root.sort-column;
            active-sort-order: root.sort-order;
            enable-resize: root.enable-resize;
            auto-width: false;
            column-width <=> root.col-path-width;
            column-min-width: 80px;
            sort-clicked(idx) => { root.sort-clicked(idx); }
            column-resized(idx, w) => { root.column-resized(idx, w); }
            column-resize-finished(idx, w) => { root.column-resize-finished(idx, w); }
        }

        // Col 2: Modified Date
        MediaHeaderColumn {
            x: root.col-pos-2;
            title: "Modified Date";
            column-index: 2;
            active-sort-column: root.sort-column;
            active-sort-order: root.sort-order;
            enable-resize: root.enable-resize;
            auto-width: false;
            column-width <=> root.col-modified-date-width;
            column-min-width: 90px;
            sort-clicked(idx) => { root.sort-clicked(idx); }
            column-resized(idx, w) => { root.column-resized(idx, w); }
            column-resize-finished(idx, w) => { root.column-resize-finished(idx, w); }
        }

        // Col 3: Created Date
        MediaHeaderColumn {
            x: root.col-pos-3;
            title: "Created Date";
            column-index: 3;
            active-sort-column: root.sort-column;
            active-sort-order: root.sort-order;
            enable-resize: root.enable-resize;
            auto-width: false;
            column-width <=> root.col-created-date-width;
            column-min-width: 90px;
            sort-clicked(idx) => { root.sort-clicked(idx); }
            column-resized(idx, w) => { root.column-resized(idx, w); }
            column-resize-finished(idx, w) => { root.column-resize-finished(idx, w); }
        }

        // Col 4: Filesize (MB)
        MediaHeaderColumn {
            x: root.col-pos-4;
            title: "Filesize (MB)";
            column-index: 4;
            active-sort-column: root.sort-column;
            active-sort-order: root.sort-order;
            enable-resize: root.enable-resize;
            auto-width: false;
            column-width <=> root.col-size-width;
            column-min-width: 70px;
            sort-clicked(idx) => { root.sort-clicked(idx); }
            column-resized(idx, w) => { root.column-resized(idx, w); }
            column-resize-finished(idx, w) => { root.column-resize-finished(idx, w); }
        }

        // Col 5: Rating
        MediaHeaderColumn {
            x: root.col-pos-5;
            title: "Rating";
            column-index: 5;
            active-sort-column: root.sort-column;
            active-sort-order: root.sort-order;
            enable-resize: root.enable-resize;
            auto-width: false;
            column-width <=> root.col-rating-width;
            column-min-width: 50px;
            sort-clicked(idx) => { root.sort-clicked(idx); }
            column-resized(idx, w) => { root.column-resized(idx, w); }
            column-resize-finished(idx, w) => { root.column-resize-finished(idx, w); }
        }

        // Col 6: Tags
        MediaHeaderColumn {
            x: root.col-pos-6;
            title: "Tags";
            column-index: 6;
            active-sort-column: root.sort-column;
            active-sort-order: root.sort-order;
            enable-resize: root.enable-resize;
            auto-width: false;
            column-width <=> root.col-tags-width;
            column-min-width: 50px;
            sort-clicked(idx) => { root.sort-clicked(idx); }
            column-resized(idx, w) => { root.column-resized(idx, w); }
            column-resize-finished(idx, w) => { root.column-resize-finished(idx, w); }
        }

        // Col 7: Width
        MediaHeaderColumn {
            x: root.col-pos-7;
            title: "Width";
            column-index: 7;
            active-sort-column: root.sort-column;
            active-sort-order: root.sort-order;
            enable-resize: root.enable-resize;
            auto-width: false;
            column-width <=> root.col-width-width;
            column-min-width: 50px;
            sort-clicked(idx) => { root.sort-clicked(idx); }
            column-resized(idx, w) => { root.column-resized(idx, w); }
            column-resize-finished(idx, w) => { root.column-resize-finished(idx, w); }
        }

        // Col 8: Height
        MediaHeaderColumn {
            x: root.col-pos-8;
            title: "Height";
            column-index: 8;
            active-sort-column: root.sort-column;
            active-sort-order: root.sort-order;
            enable-resize: root.enable-resize;
            auto-width: false;
            column-width <=> root.col-height-width;
            column-min-width: 50px;
            sort-clicked(idx) => { root.sort-clicked(idx); }
            column-resized(idx, w) => { root.column-resized(idx, w); }
            column-resize-finished(idx, w) => { root.column-resize-finished(idx, w); }
        }

        // Col 9: AR
        MediaHeaderColumn {
            x: root.col-pos-9;
            title: "AR";
            column-index: 9;
            active-sort-column: root.sort-column;
            active-sort-order: root.sort-order;
            enable-resize: root.enable-resize;
            auto-width: false;
            column-width <=> root.col-ar-width;
            column-min-width: 45px;
            sort-clicked(idx) => { root.sort-clicked(idx); }
            column-resized(idx, w) => { root.column-resized(idx, w); }
            column-resize-finished(idx, w) => { root.column-resize-finished(idx, w); }
        }

        // Col 10: Duration
        MediaHeaderColumn {
            x: root.col-pos-10;
            title: "Duration";
            column-index: 10;
            active-sort-column: root.sort-column;
            active-sort-order: root.sort-order;
            enable-resize: root.enable-resize;
            auto-width: false;
            column-width <=> root.col-duration-width;
            column-min-width: 80px;
            sort-clicked(idx) => { root.sort-clicked(idx); }
            column-resized(idx, w) => { root.column-resized(idx, w); }
            column-resize-finished(idx, w) => { root.column-resize-finished(idx, w); }
        }

        // Col 11: Format
        MediaHeaderColumn {
            x: root.col-pos-11;
            title: "Format";
            column-index: 11;
            active-sort-column: root.sort-column;
            active-sort-order: root.sort-order;
            enable-resize: root.enable-resize;
            auto-width: false;
            column-width <=> root.col-format-width;
            column-min-width: 55px;
            sort-clicked(idx) => { root.sort-clicked(idx); }
            column-resized(idx, w) => { root.column-resized(idx, w); }
            column-resize-finished(idx, w) => { root.column-resize-finished(idx, w); }
        }

        // Col 12: Flags
        MediaHeaderColumn {
            x: root.col-pos-12;
            title: "Flags";
            column-index: 12;
            active-sort-column: root.sort-column;
            active-sort-order: root.sort-order;
            enable-resize: root.enable-resize;
            auto-width: false;
            column-width <=> root.col-flags-width;
            column-min-width: 55px;
            sort-clicked(idx) => { root.sort-clicked(idx); }
            column-resized(idx, w) => { root.column-resized(idx, w); }
            column-resize-finished(idx, w) => { root.column-resize-finished(idx, w); }
        }
    }
}
