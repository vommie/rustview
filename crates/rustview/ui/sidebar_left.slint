import { Theme } from "styles.slint";
import { IconId } from "icons.slint";
import { FolderNodeView, FavoriteItemView, SidebarPanelTabModel } from "types.slint";
import { FavoritesPanel } from "favorites_panel.slint";
import { FolderPanel } from "folder_panel.slint";
import { SidebarPanelTabBar } from "sidebar_panel_tab_bar.slint";
import { MetadataInspector } from "metadata_inspector.slint";

export { FavoritesPanel } from "favorites_panel.slint";
export { FolderPanel } from "folder_panel.slint";
export { MetadataInspector } from "metadata_inspector.slint";

export component SidebarLeft inherits Rectangle {
    in-out property <length> sidebar-width: 260px;
    width: root.sidebar-width;
    background: Theme.surface;

    // Sidebar Panel Tabs properties (Dock panel tabs at top)
    in property <[SidebarPanelTabModel]> panel-tabs: [];
    in property <string> active-panel-tab: "folders";
    in property <bool> is-dragging-panel-tab: false;
    in property <length> panel-tab-drag-ghost-x: 0px;
    in property <length> panel-tab-drag-ghost-width: 100px;
    in property <string> panel-tab-drag-ghost-title: "";
    in property <IconId> panel-tab-drag-ghost-icon: IconId.none;

    callback panel-tab-selected(string /* tab_id */);
    callback panel-tab-drag-started(string /* tab_id */, int /* source_index */, length /* mouse_x */, length /* tab_width */);
    callback panel-tab-drag-moved(length /* mouse_x */, length /* view_width */);
    callback panel-tab-drag-ended(string /* tab_id */, int /* target_index */);
    callback panel-tab-drag-cancelled(string /* tab_id */);

    in property <[FolderNodeView]> folders: [];
    in property <[FavoriteItemView]> favorites: [];
    in property <bool> is-refreshing-folders: false;
    in property <bool> is-busy: false;
    in-out property <bool> show-hidden-folders: false;
    in property <int> drop-target-folder-id: -1;
    out property <length> folder-tree-scroll-y: folder-panel.scroll-offset-y;
    out property <length> folder-tree-container-height: stacked-container.height;

    callback folder-clicked(int /* id */, string /* path */);
    callback folder-toggle-expand(int /* id */);
    callback folder-context-menu(int /* id */, length /* x */, length /* y */);
    callback folder-refresh-all-clicked();
    callback folder-refresh-relative-clicked();
    callback folder-collapse-all-clicked();
    callback favorite-clicked(string /* path */);
    callback favorite-context-menu(string /* path */, string /* alias */, length /* x */, length /* y */);
    callback toggle-hidden-folders(bool /* show_hidden */);
    callback folder-row-hovered(int /* folder_id */);
    callback folder-row-unhovered(int /* folder_id */);

    // Metadata Inspector properties
    in property <string> info-filename: "-";
    in property <string> info-filename-tooltip: "";
    in property <string> info-path-label: "Path:";
    in property <string> info-path: "-";
    in property <string> info-path-tooltip: "";
    in property <string> info-size: "-";
    in property <string> info-size-tooltip: "";
    in property <string> info-dimensions: "-";
    in property <string> info-format: "-";
    in property <string> info-hash: "-";
    in property <string> info-hash-tooltip: "";
    in property <int> info-selection-count: 0;
    in property <string> info-size-label: "Size:";
    in property <string> info-dimensions-label: "Dimensions:";
    in property <string> info-format-label: "Format:";
    in property <string> info-hash-label: "";
    in property <string> info-badge-text: "";
    in-out property <bool> info-is-collapsed: false;
    callback info-collapsed-toggled(bool);

    /// Programmatically scrolls the folder tree by a delta in pixels
    public function scroll-folder-tree-by(dy: length) {
        folder-panel.scroll-by(dy);
    }

    /// Public endpoint to scroll to specific folder row index
    public function scroll-folder-to-row(row-idx: int) {
        folder-panel.scroll-folder-to-row(row-idx);
    }

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        // 1. Modular Sidebar Panel Tab Bar (Dock tabs positioned at the top of the sidebar)
        SidebarPanelTabBar {
            tabs: root.panel-tabs;
            is-dragging-tab: root.is-dragging-panel-tab;
            drag-ghost-x: root.panel-tab-drag-ghost-x;
            drag-ghost-width: root.panel-tab-drag-ghost-width;
            drag-ghost-title: root.panel-tab-drag-ghost-title;
            drag-ghost-icon: root.panel-tab-drag-ghost-icon;

            tab-selected(id) => { root.panel-tab-selected(id); }
            tab-drag-started(id, idx, mx, tw) => { root.panel-tab-drag-started(id, idx, mx, tw); }
            tab-drag-moved(mx, vw) => { root.panel-tab-drag-moved(mx, vw); }
            tab-drag-ended(id, idx) => { root.panel-tab-drag-ended(id, idx); }
            tab-drag-cancelled(id) => { root.panel-tab-drag-cancelled(id); }
        }

        // 2. Stacked Active Panel Area: Fills available vertical space above inspector
        stacked-container := Rectangle {
            vertical-stretch: 1;

            // Folders Browser Panel (100% height when active)
            folder-panel := FolderPanel {
                width: 100%;
                height: 100%;
                visible: root.active-panel-tab == "folders";
                folders: root.folders;
                drop-target-folder-id: root.drop-target-folder-id;
                is-refreshing: root.is-refreshing-folders;
                is-busy: root.is-busy;
                show-hidden-folders <=> root.show-hidden-folders;
                toggle-hidden-folders(h) => { root.toggle-hidden-folders(h); }
                collapse-all-clicked => { root.folder-collapse-all-clicked(); }
                folder-clicked(id, path) => { root.folder-clicked(id, path); }
                folder-toggle-expand(id) => { root.folder-toggle-expand(id); }
                row-hovered(id) => { root.folder-row-hovered(id); }
                row-unhovered(id) => { root.folder-row-unhovered(id); }
                folder-context-menu(id, x, y) => { root.folder-context-menu(id, stacked-container.x + x, stacked-container.y + y); }
                folder-refresh-all-clicked => { root.folder-refresh-all-clicked(); }
                folder-refresh-relative-clicked => { root.folder-refresh-relative-clicked(); }
            }

            // Favorites Navigation Panel (100% height when active)
            favorites-panel := FavoritesPanel {
                width: 100%;
                height: 100%;
                visible: root.active-panel-tab == "favorites";
                favorites: root.favorites;
                favorite-clicked(path) => { root.favorite-clicked(path); }
                favorite-context-menu(path, alias, x, y) => {
                    root.favorite-context-menu(path, alias, stacked-container.x + x, stacked-container.y + y);
                }
            }
        }

        // 3. Collapsible Metadata Inspector (Docked permanently at the bottom of the left sidebar)
        metadata-inspector := MetadataInspector {
            vertical-stretch: 0;
            filename: root.info-filename;
            filename-tooltip: root.info-filename-tooltip;
            path-label: root.info-path-label;
            path-value: root.info-path;
            path-tooltip: root.info-path-tooltip;
            filesize: root.info-size;
            filesize-tooltip: root.info-size-tooltip;
            dimensions: root.info-dimensions;
            format-name: root.info-format;
            hash-or-rating: root.info-hash;
            hash-tooltip: root.info-hash-tooltip;
            selection-count: root.info-selection-count;
            size-label: root.info-size-label;
            dimensions-label: root.info-dimensions-label;
            format-label: root.info-format-label;
            hash-label: root.info-hash-label;
            badge-text: root.info-badge-text;
            is-collapsed <=> root.info-is-collapsed;
            collapsed-toggled(c) => { root.info-collapsed-toggled(c); }
        }
    }
}
