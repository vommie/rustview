import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize, IconSlot } from "icons.slint";
import { TooltipHost } from "tooltips.slint";

export struct ToolbarSelectItem {
    id: int,
    text: string,
    icon: IconId,
}

/// Compact, modular select/dropdown button tailored for panel toolbars.
/// Supports Icon-only, Text-only, or Icon+Text rendering with theme-adaptive SVG colorization and integrated tooltips.
export component ToolbarSelectButton inherits Rectangle {
    in property <[ToolbarSelectItem]> model: [];
    in-out property <int> current-index: 0;
    in property <bool> is-enabled: true;
    in property <string> tooltip: "";
    in property <duration> tooltip-delay: 0ms;
    in property <bool> popup-align-right: false;

    // Display modes: 0 = Icon Only, 1 = Text Only, 2 = Icon + Text
    in property <int> button-display-mode: 0;
    in property <int> popup-display-mode: 2;
    in property <length> icon-size: IconSize.md;
    in property <length> font-size: 11px;
    in property <length> button-width: 0px;

    callback selected(int /* index */);

    property <int> safe-index: Math.max(0, Math.min(root.model.length - 1, root.current-index));
    property <ToolbarSelectItem> active-item: root.model.length > 0 ? root.model[root.safe-index] : { id: 0, text: "", icon: IconId.none };

    property <bool> btn-has-icon: (root.button-display-mode == 0 || root.button-display-mode == 2) && root.active-item.icon != IconId.none;
    property <bool> btn-has-text: (root.button-display-mode == 1 || root.button-display-mode == 2) && root.active-item.text != "";

    width: root.button-width > 0px
        ? root.button-width
        : ((!root.btn-has-text && root.btn-has-icon)
            ? 26px
            : content-layout.preferred-width);
    height: 24px;
    horizontal-stretch: 0;
    border-radius: 4px;

    // RustCut's `IconButton` look: a framed button on the panel.
    background: !root.is-enabled ? transparent : (
        touch-area.pressed ? Theme.surface-selected : (
            touch-area.has-hover ? Theme.surface-hover : Theme.surface
        )
    );

    border-width: 1px;
    border-color: Theme.border;

    tooltip-host := TooltipHost {
        text: root.tooltip;
        delay: root.tooltip-delay;
    }

    // Always enabled: a disabled TouchArea reports no hover, so the tooltip (with the reason) could not show. Clicks are filtered below.
    touch-area := TouchArea {
        mouse-cursor: root.is-enabled ? pointer : default;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                tooltip-host.on-hover-leave();
            }
        }
        clicked => {
            if root.is-enabled {
                tooltip-host.on-hover-leave();
                popup.show();
            }
        }
        moved => {
            tooltip-host.on-mouse-move(self.mouse-x, self.mouse-y);
        }
    }

    property <bool> is-hovered: touch-area.has-hover && root.tooltip != "";
    changed is-hovered => {
        if self.is-hovered {
            tooltip-host.on-hover-enter(touch-area.mouse-x, touch-area.mouse-y);
        } else {
            tooltip-host.on-hover-leave();
        }
    }

    // Disabled state dims through the color alpha, never through `opacity` (an opacity layer would resample the icon).
    property <color> content-color: !root.is-enabled ? Theme.text-muted.transparentize(0.6) : (
        Theme.text
    );

    content-layout := HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: root.btn-has-text ? 6px : 2px;
        padding-right: root.btn-has-text ? 6px : 2px;
        spacing: 3px;
        alignment: center;

        if root.btn-has-icon : IconSlot {
            icon: root.active-item.icon;
            size: root.icon-size;
            color: root.content-color;
        }

        if root.btn-has-text : Text {
            text: root.active-item.text;
            font-size: root.font-size;
            font-weight: 400;
            color: root.content-color;
            vertical-alignment: center;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    popup := PopupWindow {
        x: root.popup-align-right ? (root.width - popup-content.preferred-width) : 0px;
        y: root.height + 3px;
        width: popup-content.preferred-width;
        height: popup-content.preferred-height;
        close-policy: close-on-click;

        Rectangle {
            background: Theme.surface;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 10px;
            drop-shadow-color: #000000aa;

            popup-content := VerticalLayout {
                padding: 3px;
                spacing: 2px;
                alignment: start;

                for item[idx] in root.model: Rectangle {
                    height: 22px;
                    border-radius: 3px;
                    background: (idx == root.current-index)
                        ? Theme.surface-selected
                        : (opt-touch.has-hover ? Theme.surface-hover : transparent);

                    opt-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current-index = idx;
                            root.selected(idx);
                        }
                    }

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 8px;
                        spacing: 6px;
                        alignment: start;

                        if (root.popup-display-mode == 0 || root.popup-display-mode == 2) && item.icon != IconId.none : IconSlot {
                            icon: item.icon;
                            size: root.icon-size;
                            color: (idx == root.current-index) ? Theme.primary : Theme.text;
                        }

                        if root.popup-display-mode == 1 || root.popup-display-mode == 2 : Text {
                            text: item.text;
                            font-size: root.font-size;
                            font-weight: (idx == root.current-index) ? 700 : 400;
                            color: (idx == root.current-index) ? Theme.primary : Theme.text;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                        }
                    }
                }
            }
        }
    }
}
