import { Theme } from "styles.slint";
import { SidebarPanelTabModel } from "types.slint";
import { TooltipHost } from "tooltips.slint";
import { AppIcon, IconId, IconSize, IconSlot } from "icons.slint";

export component SidebarPanelTabItem inherits Rectangle {
    in property <SidebarPanelTabModel> tab;
    in-out property <length> shift-x: 0px;
    in property <bool> is-placeholder: false;

    callback clicked();
    callback drag-started(length /* press_x */, length /* press_y */, length /* item_width */);
    callback drag-moved(length /* mouse_x */, length /* mouse_y */);
    callback drag-ended();
    callback drag-cancelled();

    width: Math.min(110px, Math.max(60px, content-layout.preferred-width));
    height: 26px;
    background: transparent;

    inner-card := Rectangle {
        x: root.shift-x;
        width: 100%;
        height: 100%;
        border-radius: 4px;

        animate x { duration: 180ms; easing: ease-out; }
        opacity: root.is-placeholder ? 0.22 : 1.0;
        animate opacity { duration: 120ms; }

        background: root.tab.is_active
            ? (tab-touch.has-hover ? Theme.surface-selected-hover : Theme.surface-selected)
            : (tab-touch.has-hover ? Theme.surface-hover : Theme.surface-variant);

        border-width: 1px;
        border-color: root.tab.is_active
            ? (tab-touch.has-hover ? Theme.accent : Theme.primary)
            : (tab-touch.has-hover ? Theme.primary : Theme.border);

        tooltip-host := TooltipHost {
            text: root.tab.title;
            shortcut: "Hold & drag to reorder panel tabs";
            is-enabled: !root.is-placeholder;
        }

        tab-touch := TouchArea {
            property <length> press-x: 0px;
            property <length> press-y: 0px;
            property <bool> is-drag-active: false;

            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    tooltip-host.on-hover-leave();
                    self.press-x = self.mouse-x;
                    self.press-y = self.mouse-y;
                    self.is-drag-active = false;
                }
                if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                    if self.is-drag-active {
                        self.is-drag-active = false;
                        root.drag-ended();
                    } else {
                        root.clicked();
                    }
                }
            }

            moved => {
                if self.pressed {
                    if !self.is-drag-active {
                        let dx = self.mouse-x - self.press-x;
                        let dy = self.mouse-y - self.press-y;
                        if (dx * dx + dy * dy) > 20px * 1px {
                            self.is-drag-active = true;
                            root.drag-started(self.press-x, self.press-y, root.width);
                        }
                    }
                    if self.is-drag-active {
                        root.drag-moved(self.mouse-x, self.mouse-y);
                    }
                }
            }
        }

        property <bool> is-hovered: tab-touch.has-hover && !root.is-placeholder;
        changed is-hovered => {
            if self.is-hovered {
                tooltip-host.on-hover-enter(tab-touch.mouse-x, tab-touch.mouse-y);
            } else {
                tooltip-host.on-hover-leave();
            }
        }

        content-layout := HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;
            alignment: center;

            IconSlot {
                icon: root.tab.icon;
                size: IconSize.md;
                color: root.tab.is_active ? Theme.primary : Theme.text-muted;
            }

            Text {
                text: root.tab.title;
                font-size: 11px;
                font-weight: root.tab.is_active ? 700 : 400;
                color: root.tab.is_active ? Theme.primary : Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }
    }
}

/// Floating visual ghost tab preview following the cursor during drag operations.
export component SidebarPanelTabGhost inherits Rectangle {
    in property <string> title: "";
    in property <IconId> icon: IconId.none;

    height: 26px;
    border-radius: 4px;
    background: Theme.surface-selected-hover;
    border-width: 1.5px;
    border-color: Theme.accent;
    drop-shadow-blur: 12px;
    drop-shadow-color: #000000aa;
    drop-shadow-offset-y: 2px;
    clip: true;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        alignment: center;

        IconSlot {
            icon: root.icon;
            size: IconSize.md;
            color: Theme.primary;
        }

        Text {
            text: root.title;
            font-size: 11px;
            font-weight: 700;
            color: Theme.accent;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

/// Reusable tab bar header organizing dock panels as tabs in a sidebar.
export component SidebarPanelTabBar inherits Rectangle {
    height: 28px;
    background: transparent;

    in property <[SidebarPanelTabModel]> tabs: [];
    in property <bool> is-dragging-tab: false;
    in property <length> drag-ghost-x: 0px;
    in property <length> drag-ghost-width: 100px;
    in property <string> drag-ghost-title: "";
    in property <IconId> drag-ghost-icon: IconId.none;

    callback tab-selected(string /* tab_id */);
    callback tab-drag-started(string /* tab_id */, int /* source_index */, length /* mouse_x */, length /* tab_width */);
    callback tab-drag-moved(length /* mouse_x */, length /* view_width */);
    callback tab-drag-ended(string /* tab_id */, int /* target_index */);
    callback tab-drag-cancelled(string /* tab_id */);

    HorizontalLayout {
        padding: 0px;
        spacing: 4px;
        alignment: start;

        for tab[idx] in root.tabs: SidebarPanelTabItem {
            tab: tab;
            shift-x: tab.shift_x;
            is-placeholder: tab.is_placeholder;

            clicked => { root.tab-selected(tab.id); }

            drag-started(press-x, press-y, item-w) => {
                let global-x = self.x + press-x;
                root.tab-drag-started(tab.id, idx, global-x, item-w);
            }

            drag-moved(mx, my) => {
                let global-x = self.x + mx;
                root.tab-drag-moved(global-x, root.width);
            }

            drag-ended => {
                root.tab-drag-ended(tab.id, -1);
            }

            drag-cancelled => {
                root.tab-drag-cancelled(tab.id);
            }
        }
    }

    if root.is-dragging-tab : SidebarPanelTabGhost {
        x: Math.max(0px, Math.min(parent.width - self.width, root.drag-ghost-x));
        y: 1px;
        width: root.drag-ghost-width;
        title: root.drag-ghost-title;
        icon: root.drag-ghost-icon;
        z: 60;
    }
}
