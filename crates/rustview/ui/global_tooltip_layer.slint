import { TooltipSettings, GlobalTooltip } from "tooltips.slint";
import { IconSlot, IconSize, IconId } from "icons.slint";
import { HoldConfirm } from "hold.slint";

/// The hold badge: the element acts only when held this long (hold.slint).
component HoldBadge inherits Rectangle {
    height: 18px;
    border-radius: 3px;
    background: HoldConfirm.color.with-alpha(0.18);

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 5px;
        spacing: 3px;
        alignment: center;

        IconSlot {
            icon: IconId.tip-hold;
            size: IconSize.sm;
            color: HoldConfirm.color;
        }

        Text {
            text: "Hold " + Math.round(HoldConfirm.duration / 100ms) / 10 + " s";
            font-size: 10.5px;
            font-weight: 700;
            color: HoldConfirm.color;
            vertical-alignment: center;
        }
    }
}

/// The tooltip bubble of `GlobalTooltip`, drawn on the highest z level of a window. Every window that hosts tooltip
/// sources puts one of these over its content (the main window and the Multiview window). Native video windows are
/// cut open where a bubble is, so `state-changed` reports the bubble rectangle (logical pixels in this layer) whenever it
/// appears, moves or disappears.
export component GlobalTooltipLayer inherits Rectangle {
    callback state-changed(bool /* is_visible */, length /* x */, length /* y */, length /* width */, length /* height */);

    property <bool> active: GlobalTooltip.is-visible && TooltipSettings.enabled;
    property <bool> show-hold: GlobalTooltip.hold && HoldConfirm.duration > 0ms;
    // Long tooltips wrap at the maximum width; `measure` is the text on one line, `wrapped` the same text at the final width.
    // The bubble stays inside the window it is drawn in (the bar windows are narrow): 8px margin on both sides, the padding
    // of the bubble, and room for an icon or a shortcut badge.
    property <length> room: root.width - 16px - 2 * TooltipSettings.default-padding-h - (GlobalTooltip.shortcut != "" ? 60px : 0px) - (GlobalTooltip.icon != IconId.none ? 22px : 0px) - (root.show-hold ? 76px : 0px);
    property <length> text-w: Math.max(40px, Math.min(Math.min(TooltipSettings.max-width, root.room), measure.preferred-width));
    property <length> bubble-w: tooltip-bubble.preferred-width;
    property <length> bubble-h: Math.max(tooltip-bubble.preferred-height, wrapped.preferred-height + 2 * TooltipSettings.default-padding-v);
    property <length> bubble-x: Math.max(8px, Math.min(root.width - root.bubble-w - 8px, GlobalTooltip.pos-x));
    property <length> bubble-y: Math.max(8px, Math.min(root.height - root.bubble-h - 8px, GlobalTooltip.pos-y));

    changed active => {
        if self.active {
            root.state-changed(true, self.bubble-x, self.bubble-y, self.bubble-w, self.bubble-h);
        } else {
            root.state-changed(false, 0px, 0px, 0px, 0px);
        }
    }

    changed bubble-x => {
        if self.active {
            root.state-changed(true, self.bubble-x, self.bubble-y, self.bubble-w, self.bubble-h);
        }
    }

    changed bubble-y => {
        if self.active {
            root.state-changed(true, self.bubble-x, self.bubble-y, self.bubble-w, self.bubble-h);
        }
    }

    z: 200;
    background: transparent;
    visible: root.active;

    measure := Text {
        visible: false;
        text: GlobalTooltip.text;
        font-size: TooltipSettings.default-font-size;
    }

    wrapped := Text {
        visible: false;
        width: root.text-w;
        wrap: word-wrap;
        text: GlobalTooltip.text;
        font-size: TooltipSettings.default-font-size;
    }

    tooltip-bubble := Rectangle {
        x: root.bubble-x;
        y: root.bubble-y;
        width: bubble-layout.preferred-width;
        height: root.bubble-h;
        visible: root.active;

        background: TooltipSettings.default-background;
        border-radius: TooltipSettings.default-corner-radius;
        border-width: 1px;
        border-color: TooltipSettings.default-border;
        drop-shadow-blur: 8px;
        drop-shadow-color: #000000aa;
        drop-shadow-offset-y: 2px;

        bubble-layout := HorizontalLayout {
            padding-left: TooltipSettings.default-padding-h;
            padding-right: TooltipSettings.default-padding-h;
            padding-top: TooltipSettings.default-padding-v;
            padding-bottom: TooltipSettings.default-padding-v;
            spacing: 6px;
            alignment: center;

            if GlobalTooltip.icon != IconId.none : IconSlot {
                icon: GlobalTooltip.icon;
                size: IconSize.sm;
                color: TooltipSettings.default-text;
            }

            if GlobalTooltip.text != "" : Text {
                width: root.text-w;
                wrap: word-wrap;
                text: GlobalTooltip.text;
                font-size: TooltipSettings.default-font-size;
                color: TooltipSettings.default-text;
                vertical-alignment: center;
                horizontal-alignment: left;
            }

            if GlobalTooltip.shortcut != "" : Rectangle {
                background: #ffffff14;
                border-radius: 3px;
                border-width: 1px;
                border-color: #ffffff22;
                height: 18px;
                y: (parent.height - self.height) / 2;

                HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 5px;
                    alignment: center;

                    Text {
                        text: GlobalTooltip.shortcut;
                        font-size: 10.5px;
                        font-weight: 700;
                        color: TooltipSettings.default-shortcut-color;
                        vertical-alignment: center;
                    }
                }
            }

            if root.show-hold : HoldBadge {
                y: (parent.height - self.height) / 2;
            }
        }
    }
}
