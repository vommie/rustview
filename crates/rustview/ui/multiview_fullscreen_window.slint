import { Theme } from "styles.slint";
import { AppIdentity } from "app_identity.slint";
import { MultiviewTileView, MultiviewGutterView } from "multiview_types.slint";
import { MultiviewCanvas } from "multiview_canvas.slint";
import { MultiviewVideoBarView } from "multiview_video_bar.slint";
import { GlobalTooltipLayer } from "global_tooltip_layer.slint";

/// Frameless fullscreen window showing one to four media (Multiview), drawn by the shared `MultiviewCanvas` (videos are the
/// textures of their render threads, `video-frames`). The
/// action bar floats above this window in a window of its own (`MultiviewBarWindow`). A single image of a Multiview opened from
/// Browse can be browsed with the keys of the keymap and the mouse wheel (`navigation`); a video keeps them for mpv.
export component MultiviewFullscreenWindow inherits Window {
    title: "RustView - Fullscreen (Multiview)";
    icon: AppIdentity.window-icon;
    no-frame: true;

    in property <[MultiviewTileView]> tiles;
    in property <[MultiviewGutterView]> gutters;
    // The newest picture of every video drawn in this window (`video_surface::hosts`).
    in property <[image]> video-frames;
    // The control bars of the videos (their events go to `VideoBarBus`).
    in property <[MultiviewVideoBarView]> video-bars;
    in property <int> navigation: 0; // 0 = off, 1 = previous/next allowed, 2 = refused (sticky single image)
    in property <int> background-mode: 0; // 0 = Dark Theme (#11111b), 1 = Deep Black (#000000), 2 = Checkerboard
    // Where the background comes from: 0 = the theme, 1 = `background-mode` (the viewer setting), 2 = `custom-fill`.
    in property <int> fill-source: 0;
    in property <color> custom-fill: #11111b;
    // The color behind the media (transparent when the background is drawn by `background-mode`); Rust also gives it to
    // the video player, whose window covers the whole display when a single video is shown.
    out property <color> resolved-fill: root.fill-source == 0 ? Theme.fullscreen-background : (root.fill-source == 2 ? root.custom-fill : transparent);
    in-out property <bool> is-ready: false;
    // A dialog is open (opened from here, or from the main window while the fullscreen is open): nothing here reacts.
    in property <bool> is-modal-locked: false;

    callback request-close();
    // A click (or Esc) while a dialog is open.
    callback modal-dismiss-requested();
    callback request-rename();
    callback request-delete();
    callback tile-clicked(int /* tile index */, bool /* is_ctrl */);
    callback background-clicked(bool /* is_ctrl */);
    callback middle-clicked();
    callback navigate(bool /* forward */);
    callback wheel(length /* delta-y */);
    callback tile-zoom-wheel(int /* tile index */, length /* delta-y */, length /* x */, length /* y */);
    callback tile-video-wheel(int /* tile index */, length /* delta-y */, bool /* ctrl */);
    callback tile-right-clicked(int /* tile index */);
    callback tile-pan(int /* tile index */, length /* dx */, length /* dy */);
    callback minimap-pointer(int /* tile index */, float /* x */, float /* y */, int /* phase */);
    callback minimap-slider(int /* tile index */, int /* code of the slider */);
    callback crop-pointer(int /* tile index */, int /* phase */, length /* x */, length /* y */, bool /* shift */);
    callback crop-ratio(int /* tile index */, bool /* landscape */);
    // A key of the image editor: 0 = Esc, 1 = Enter, 2 = Ctrl+S, 3 = Ctrl+Shift+S, 4 = Ctrl+Z, 5 = Ctrl+Shift+Z / Ctrl+Y.
    // True = the editor used it (Esc cancelled a crop tool; the others act on the selected picture or show why not); otherwise
    // the key keeps its usual meaning.
    callback edit-key(int /* code */) -> bool;
    callback zoom-key(int /* 0 = reset, 1 = in, 2 = out */);
    // Every key press besides Esc (text, Ctrl, Alt, Shift, Meta, key repeat): Rust looks it up in the keymap
    // (`ui::multiview::session_keys`); true = it was an action's key and is consumed.
    callback hotkey(string, bool, bool, bool, bool, bool) -> bool;
    callback gutter-drag-started(int);
    callback gutter-dragged(int, length /* distance from drag start */);
    callback gutter-drag-finished(int);
    callback gutter-reset();
    callback gutter-swap(int);
    callback size-changed();

    // Root window is transparent so mapping on the wrong display before X11 repositioning is invisible
    background: transparent;

    changed width => {
        root.size-changed();
    }
    changed height => {
        root.size-changed();
    }

    /// The keys go to the window's own handling again (a text field of a video's control bar that had them went away).
    public function focus-keys() {
        fs-focus.focus();
    }

    forward-focus: fs-focus;
    fs-focus := FocusScope {
        key-pressed(event) => {
            if root.is-modal-locked {
                if event.text == Key.Escape {
                    root.modal-dismiss-requested();
                }
                return accept;
            }
            // The crop tools come first: Esc cancels the one of the selected picture, else the one opened last; the normal Esc only
            // when none is open.
            if event.text == Key.Escape {
                if root.edit-key(0) {
                    return accept;
                }
                root.request-close();
                return accept;
            }
            // Every other key: the keymap (Settings > Hotkeys).
            if root.hotkey(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta,
                event.repeat) {
                return accept;
            }
            return reject;
        }
    }

    main-canvas := MultiviewCanvas {
        width: 100%;
        height: 100%;
        opacity: root.is-ready ? 1.0 : 0.0;
        animate opacity { duration: 60ms; }

        tiles: root.tiles;
        gutters: root.gutters;
        video-frames: root.video-frames;
        video-bars: root.video-bars;
        wheel-navigation: root.navigation != 0;
        screen: { x: 0px, y: 0px, width: root.width, height: root.height };
        background-mode: root.background-mode;
        fill-color: root.resolved-fill;

        tile-clicked(index, is-ctrl) => {
            root.tile-clicked(index, is-ctrl);
        }
        background-clicked(is-ctrl) => {
            root.background-clicked(is-ctrl);
        }
        middle-clicked => {
            root.middle-clicked();
        }
        wheel(delta) => {
            root.wheel(delta);
        }
        tile-zoom-wheel(index, delta, x, y) => {
            root.tile-zoom-wheel(index, delta, x, y);
        }
        tile-video-wheel(index, delta, ctrl) => {
            root.tile-video-wheel(index, delta, ctrl);
        }
        tile-right-clicked(index) => {
            root.tile-right-clicked(index);
        }
        tile-pan(index, dx, dy) => {
            root.tile-pan(index, dx, dy);
        }
        minimap-pointer(index, x, y, phase) => {
            root.minimap-pointer(index, x, y, phase);
        }
        minimap-slider(index, code) => {
            root.minimap-slider(index, code);
        }
        crop-pointer(index, phase, x, y, shift) => {
            root.crop-pointer(index, phase, x, y, shift);
        }
        crop-ratio(index, landscape) => {
            root.crop-ratio(index, landscape);
        }
        gutter-drag-started(index) => {
            root.gutter-drag-started(index);
        }
        gutter-dragged(index, distance) => {
            root.gutter-dragged(index, distance);
        }
        gutter-drag-finished(index) => {
            root.gutter-drag-finished(index);
        }
        gutter-reset => {
            root.gutter-reset();
        }
        gutter-swap(index) => {
            root.gutter-swap(index);
        }
    }

    // Above everything: while a dialog is open no click, wheel or drag reaches the Multiview, and a click brings the dialog to the
    // front. Dimmed like the locked main window.
    if root.is-modal-locked : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000066;

        TouchArea {
            clicked => {
                root.modal-dismiss-requested();
            }
            scroll-event(event) => {
                accept
            }
        }
    }

    // The tooltips of the control bars (A-B buttons, the rows of the load menu).
    GlobalTooltipLayer {}
}
