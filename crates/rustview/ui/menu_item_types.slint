// The row of a menu (context menus, the drop-downs of the Multiview's bars, the "..." menu of a video's control bar). A file of
// its own so that the structs of the bars can use it without importing `types.slint` (which imports them).

import { IconId } from "icons.slint";

export struct ContextMenuItemModel {
    id: int,
    text: string,
    shortcut: string,
    /// Library icon shown in the leading icon slot (`IconId.none` = empty slot).
    icon: IconId,
    /// Image of an external application (system icon theme, e.g. "Open With" entries). Takes precedence over `icon`.
    app_icon: image,
    kind: int, // 0 = Action, 1 = Checkable, 2 = Radio, 3 = Separator, 4 = Header, 5 = Submenu, 6 = Slider (video bar menus)
    is_checked: bool,
    is_enabled: bool,
    has_submenu: bool,
    submenu_depth: int,
    menu_index: int,
    tooltip: string,
    /// The entry acts only when held for `HoldConfirm.duration` (hold.slint).
    hold: bool,
    /// Kind 6 (a slider of a video bar's menu): its value as a share of its width, and as text.
    value: float,
    value_text: string,
}
