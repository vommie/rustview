import { Theme, MediaTheme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { TooltipArea } from "tooltips.slint";
import { ButtonFeedbackOverlay } from "button_feedback.slint";
import { MultiviewBarButtonView } from "multiview_types.slint";

component MultiviewBarButton inherits Rectangle {
    in property <MultiviewBarButtonView> action;
    // The button has its menu open: it stays highlighted and shows no tooltip.
    in property <bool> open: false;
    in property <length> size: 28px;
    in property <length> arrow-width: 16px;

    callback activated();
    // The arrow of a split button (it opens the button's drop-down).
    callback arrow-activated();

    property <bool> emphasized: root.action.emphasis == 1;

    width: root.size + (root.action.split ? root.arrow-width : 0px);
    height: root.size;
    border-radius: 6px;
    background: root.action.attention ? MediaTheme.accent.with-alpha(0.7)
        : root.emphasized ? (area.has-hover || arrow.has-hover || root.open ? MediaTheme.primary.brighter(15%) : MediaTheme.primary)
        : (root.open ? MediaTheme.primary.with-alpha(0.28) : (area.has-hover ? MediaTheme.surface-hover : transparent));
    animate background { duration: 90ms; }
    // The one place a bar button fades with opacity: the Save button going away after a save (an icon cannot be faded by its
    // color without Slint drawing the raw black SVG at the end).
    opacity: root.action.fading ? 0.0 : 1.0;
    animate opacity { duration: 600ms; easing: ease-out; }

    area := TooltipArea {
        x: 0px;
        width: root.size;
        height: 100%;
        text: root.action.tooltip;
        tooltip-enabled: !root.open;

        clicked => {
            root.activated();
        }

        AppIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            icon: root.action.icon;
            size: IconSize.lg;
            color: root.action.attention || root.emphasized ? MediaTheme.background
                : root.action.emphasis == 3 ? MediaTheme.text-muted.with-alpha(0.6)
                : root.action.emphasis == 2 ? MediaTheme.text-muted
                : (!root.action.enabled ? MediaTheme.text-muted.with-alpha(0.5) : ((root.action.toggle && root.action.active) || root.open || area.has-hover ? MediaTheme.primary : MediaTheme.text));
        }

        ButtonFeedbackOverlay {
            feedback: root.action.feedback;
            border-radius: root.border-radius;
        }
    }

    if root.action.split : Rectangle {
        x: root.size - 1px;
        y: 6px;
        width: 1px;
        height: root.height - 12px;
        background: MediaTheme.background.with-alpha(0.35);
    }

    arrow := TooltipArea {
        x: root.size;
        width: root.action.split ? root.arrow-width : 0px;
        height: 100%;
        visible: root.action.split;
        text: "More: Save, Save As..., Discard Changes";
        tooltip-enabled: !root.open;

        clicked => {
            root.arrow-activated();
        }

        AppIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            icon: IconId.chevron-down;
            size: IconSize.md;
            color: root.emphasized ? MediaTheme.background : MediaTheme.text;
        }
    }
}

/// The sizes of the action bars. Rust places the bars and needs their size before Slint lays them out, so it owns the numbers
/// (`MULTIVIEW_BAR_*` in the settings schema) and sets them here for every window that draws bars; the defaults are the same.
export global MultiviewBarMetrics {
    in property <length> button-size: 28px;
    in property <length> spacing: 2px;
    in property <length> inset: 3px;
    in property <length> arrow-width: 16px;
}

/// Row of action buttons: the media bar of a medium, or the primary bar of the view (`MultiviewActionBar` in the canvas).
export component MultiviewBar inherits Rectangle {
    in property <[MultiviewBarButtonView]> actions;
    // Position of the button whose menu is open (-1 = none).
    in property <int> menu-owner-index: -1;
    // Position of the button with an arrow of its own (-1 = none): it is wider by the arrow, and its drop-down hangs from the arrow.
    in property <int> split-index: -1;

    callback action-clicked(int /* action id */);

    // The size follows from the number of buttons alone (`bar_placement::bar_size_logical` computes the same).
    property <length> button-size: MultiviewBarMetrics.button-size;
    property <length> button-spacing: MultiviewBarMetrics.spacing;
    property <length> inset: MultiviewBarMetrics.inset;
    property <length> arrow-width: MultiviewBarMetrics.arrow-width;

    /// Center of the button at `index`, from the left edge of the bar (the layout is plain arithmetic, see `width`); for the
    /// split button the center of its arrow (its drop-down hangs from there).
    public pure function button-center-x(index: int) -> length {
        return root.inset + index * (root.button-size + root.button-spacing)
            + (root.split-index >= 0 && root.split-index < index ? root.arrow-width : 0px)
            + (index == root.split-index ? root.button-size + root.arrow-width / 2 : root.button-size / 2);
    }

    width: root.actions.length * root.button-size + (root.split-index >= 0 ? root.arrow-width : 0px) + Math.max(root.actions.length - 1, 0) * root.button-spacing + 2 * root.inset;
    height: root.button-size + 2 * root.inset;
    background: MediaTheme.surface.with-alpha(0.7);
    border-radius: 8px;
    border-width: 1px;
    border-color: MediaTheme.border;

    // The bar is solid for the pointer: a click between its buttons or a wheel over it does not reach the medium below.
    TouchArea {
        scroll-event(event) => {
            accept
        }
    }

    layout := HorizontalLayout {
        padding: root.inset;
        spacing: root.button-spacing;

        for action[index] in root.actions : MultiviewBarButton {
            action: action;
            open: index == root.menu-owner-index;
            size: root.button-size;
            arrow-width: root.arrow-width;

            activated => {
                root.action-clicked(action.id);
            }
            // The arrow reports the code that follows the button's (Save -> SaveMenu).
            arrow-activated => {
                root.action-clicked(action.id + 1);
            }
        }
    }
}
