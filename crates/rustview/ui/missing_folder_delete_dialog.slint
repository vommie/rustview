import { Theme } from "styles.slint";
import { BulletItem } from "bullet_item.slint";
import { IconId } from "icons.slint";
import { DialogHeading } from "dialog_heading.slint";
import { ButtonBar } from "button_bar.slint";
import { DialogBody } from "dialog_body.slint";

export component MissingFolderDeleteDialog inherits Window {
    title: "RustView - Folder Not Found on Disk";
    width: 520px;
    preferred-height: dialog-layout.preferred-height;
    min-height: dialog-layout.min-height;
    background: Theme.background;

    in-out property <string> folder-name: "";
    in-out property <string> folder-path: "";
    in-out property <int> subfolders-count: 0;
    in-out property <int> files-count: 0;
    in property <string> error-message: "";

    callback clean-confirmed();
    callback cancelled();

    forward-focus: dialog-focus;

    dialog-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            return reject;
        }

        dialog-layout := VerticalLayout {
            width: root.width;
            padding: 0px;
            spacing: 0px;
            alignment: space-between;

            body := DialogBody {
                content-height: content.preferred-height;

                content := VerticalLayout {
                    width: body.width;
                    height: self.preferred-height;
                    padding: 16px;
                    spacing: 12px;

                    DialogHeading {
                        icon: IconId.status-warning;
                        text: "Folder Not Found on Disk";
                        color: Theme.status-warn;
                    }

                    Text {
                        text: "The folder '" + root.folder-name + "' could not be found on physical storage:";
                        font-size: 12px;
                        color: Theme.text;
                        wrap: word-wrap;
                    }

                    Text {
                        text: root.folder-path;
                        font-size: 11px;
                        font-italic: true;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        background: Theme.status-warn.with-alpha(0.094);
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Theme.status-warn.with-alpha(0.267);

                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;

                            Text {
                                text: "Database records available for cleanup:";
                                font-size: 11px;
                                font-weight: 700;
                                color: Theme.status-warn;
                            }

                            BulletItem {
                                text: root.subfolders-count + " subfolder record(s)";
                                color: Theme.text;
                            }

                            BulletItem {
                                text: root.files-count + " media file & thumbnail record(s)";
                                color: Theme.text;
                            }
                        }
                    }

                    Text {
                        text: "Since the folder is missing from disk, it cannot be moved to trash. Would you like to clean its records from the database instead?";
                        font-size: 11px;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }

                    if root.error-message != "" : Text {
                        text: root.error-message;
                        font-size: 11px;
                        color: Theme.status-corrupt;
                        wrap: word-wrap;
                    }
                }
            }

            ButtonBar {
                vertical-stretch: 0;
                bar-height: 48px;
                show-cancel: true;
                show-save: true;
                text-save: "Clean from Database";
                text-cancel: "Cancel";
                cancel-clicked => { root.cancelled(); }
                save-clicked => { root.clean-confirmed(); }
            }
        }
    }
}
