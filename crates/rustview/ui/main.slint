import { Theme } from "styles.slint";
import { AppIdentity } from "app_identity.slint";
import { IconId, IconSize, IconSlot } from "icons.slint";
import { TooltipSettings, GlobalTooltip } from "tooltips.slint";
import { GlobalTooltipLayer } from "global_tooltip_layer.slint";
import { MediaItemView, FolderNodeView, FavoriteItemView, TagNodeView, TagColumnView, TagHistoryRowModel, ContextMenuItemModel, ContextMenuLevelModel, ConflictFileView, TabItemModel, TabGridItemModel, SidebarPanelTabModel } from "types.slint";
import { TopToolbar } from "toolbar.slint";
import { SidebarLeft } from "sidebar_left.slint";
import { SidebarRight } from "sidebar_right.slint";
import { VirtualizedMediaGrid } from "media_grid.slint";
import { ThumbnailBadgeConfig, ThumbnailBadgeOverflowMode } from "thumbnail_badge_types.slint";
import { MediaTableView } from "media_table.slint";
import { StatusBar } from "status_bar.slint";
import { ContextMenuPopup } from "context_menu.slint";
import { ResizerBar } from "resizer_bar.slint";
import { FloatingChoicePopup } from "floating_choice_popup.slint";
import { MediaPanelToolbar } from "media_panel_toolbar.slint";
import { ImageTabPanelToolbar } from "image_tab_panel_toolbar.slint";
import { AwayPanel } from "fullscreen_away.slint";
import { MultiviewCanvas } from "multiview_canvas.slint";
import { MultiviewTabBus } from "multiview_tab_bus.slint";
import { MultiviewScreenView } from "multiview_types.slint";
import { EmptyStateView } from "empty_state_view.slint";
import { TabGridView } from "tab_grid_view.slint";

export { SettingsWindow } from "settings_window.slint";
export { FormatRowView, UnsupportedFormatView } from "settings_format_row.slint";
export { FileRenameDialog } from "file_rename_dialog.slint";
export { FileOpsConflictDialog } from "file_ops_conflict_dialog.slint";
export { DeleteFileDialog } from "delete_file_dialog.slint";
export { RemoveOrphanedFileDialog } from "remove_orphaned_file_dialog.slint";
export { AddTagDialog } from "add_tag_dialog.slint";
export { RenameTagDialog } from "rename_tag_dialog.slint";
export { DeleteTagDialog } from "delete_tag_dialog.slint";
export { RenameFolderDialog } from "rename_folder_dialog.slint";
export { DeleteFolderDialog } from "delete_folder_dialog.slint";
export { DeleteSelectionDialog } from "delete_selection_dialog.slint";
export { NewFolderDialog } from "new_folder_dialog.slint";
export { MoveFolderToDialog } from "move_folder_to_dialog.slint";
export { RemoveOrphanedFolderDialog } from "remove_orphaned_folder_dialog.slint";
export { RebornFolderDeleteWarnDialog } from "reborn_folder_delete_warn_dialog.slint";
export { MissingFolderDeleteDialog } from "missing_folder_delete_dialog.slint";
export { MissingFileDialog } from "missing_file_dialog.slint";
export { OpenManyFilesDialog } from "open_many_files_dialog.slint";
export { TabMergeLimitDialog } from "tab_merge_limit_dialog.slint";
export { ImageSaveConflictDialog, ImageChoiceView } from "image_save_conflict_dialog.slint";
export { ImageUnsavedDialog, UnsavedPictureView } from "image_unsaved_dialog.slint";
export { ImageExportDialog } from "image_export_dialog.slint";
export { DialogFit } from "dialog_body.slint";
export { MultiviewFullscreenWindow } from "multiview_fullscreen_window.slint";
export { MultiviewBarWindow } from "multiview_bar_window.slint";
export { MultiviewHintWindow } from "multiview_hint_window.slint";
export { MultiviewTileView, MultiviewGutterView, MultiviewScreenView, MultiviewBarButtonView } from "multiview_types.slint";
export { MultiviewTabBus } from "multiview_tab_bus.slint";
export { FeedbackKind, ButtonFeedback } from "button_feedback_types.slint";
export { FavoriteRenameDialog } from "favorite_rename_dialog.slint";
export { TooltipSettings, GlobalTooltip } from "tooltips.slint";
export { HoldConfirm } from "hold.slint";
export { ColorCodec, ColorPickerWindow } from "color_picker.slint";
export { IconId } from "icons.slint";
export { ThumbnailBadgeEngine, ThumbnailBadgeConfig, ThumbnailBadgeView, ThumbnailBadgeZones, ThumbnailBadgeOrientation, ThumbnailBadgeKind, ThumbnailBadgeTone, ThumbnailBadgeOverflowMode } from "thumbnail_badge_types.slint";

export component MainWindow inherits Window {
    title: "RustView";
    icon: AppIdentity.window-icon;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 600px;
    background: Theme.background;

    // Global Operation State Properties (Single Refreshment Guarantee)
    in-out property <bool> is-system-busy: false;

    // View state & Mode properties (0 = Browse Library, 1 = Tab Viewer, 2 = Tab Grid)
    in-out property <int> active-view-mode: 0;
    in-out property <bool> is-browse-active: true;
    in-out property <bool> is-tab-grid-active: false;
    in property <[TabItemModel]> tabs: [];

    // Sidebar Panel Tabs Properties (Left Sidebar dock panels: Folders & Favorites)
    in property <[SidebarPanelTabModel]> sidebar-panel-tabs: [];
    in-out property <string> active-sidebar-panel-tab: "folders";
    in-out property <bool> is-dragging-panel-tab: false;
    in-out property <length> panel-tab-drag-ghost-x: 0px;
    in-out property <length> panel-tab-drag-ghost-width: 100px;
    in-out property <string> panel-tab-drag-ghost-title: "";
    in-out property <IconId> panel-tab-drag-ghost-icon: IconId.none;

    callback sidebar-panel-tab-selected(string /* tab_id */);
    callback sidebar-panel-tab-drag-started(string /* tab_id */, int /* source_index */, length /* mouse_x */, length /* tab_width */);
    callback sidebar-panel-tab-drag-moved(length /* mouse_x */, length /* view_width */);
    callback sidebar-panel-tab-drag-ended(string /* tab_id */, int /* target_index */);
    callback sidebar-panel-tab-drag-cancelled(string /* tab_id */);

    // Tab Grid Masonry View State Properties
    in property <[TabGridItemModel]> tab-grid-items: [];
    in property <length> tab-grid-content-height: 0px;
    in-out property <int> tab-grid-columns: 3;
    in-out property <bool> tab-grid-auto-columns: true;
    out property <length> tab-grid-scroll-y: tab-grid-view.scroll-offset-y;

    // Tab Drag & Drop State Properties
    in-out property <bool> is-dragging-tab: false;
    in-out property <length> drag-ghost-x: 0px;
    in-out property <string> drag-ghost-title: "";
    in-out property <string> drag-ghost-format: "";
    in-out property <IconId> drag-ghost-icon: IconId.media-image;
    in-out property <int> drag-ghost-rating: 0;
    in-out property <bool> drag-ghost-is-active: false;

    in-out property <bool> is-table-view: false;
    in-out property <bool> is-modal-locked: false;
    // A fullscreen that belongs to a tab is open above the main window. Kept apart from `is-modal-locked` (a dialog or the
    // settings window is open) so that closing a dialog does not release this lock, and the action bars know about dialogs.
    in-out property <bool> is-fullscreen-locked: false;
    in-out property <int> thumb-size: 190;
    in-out property <int> thumb-aspect-idx: 1;
    in-out property <ThumbnailBadgeConfig> thumbnail-badge-config: {
        show-rating: true,
        show-tag: true,
        show-media-type: true,
        show-duration: true,
        overflow-mode: ThumbnailBadgeOverflowMode.hide,
    };
    in-out property <string> status-text: "Ready.";
    in-out property <int> status-level: 0;
    in-out property <string> items-metric-text: "Items: 0";
    in-out property <int> status-total-items: 0;
    in-out property <int> status-visible-items: 0;
    in-out property <string> status-total-size: "";
    in-out property <int> status-selection-count: 0;
    in-out property <int> status-selection-folders: 0;
    in-out property <string> status-selection-size: "";
    in-out property <string> search-query: "";
    in-out property <bool> regex-mode: false;
    in-out property <bool> is-virtual-folder: false;
    in property <bool> is-virtual-folder-btn-enabled: false;
    in property <bool> is-new-folder-btn-enabled: false;
    in property <string> new-folder-tooltip: "";
    in-out property <bool> show-folders: false;
    in property <string> virtual-folder-tooltip: "";
    in property <bool> is-regenerate-thumbs-enabled: false;
    in property <string> regenerate-thumbs-tooltip: "";
    in-out property <int> virtual-folder-count: 0;
    in-out property <int> media-type-filter-idx: 2;

    // Fallback Empty State Properties
    in-out property <bool> empty-state-active: false;
    in-out property <string> empty-state-title: "";
    in-out property <string> empty-state-description: "";
    in-out property <IconId> empty-state-icon: IconId.none;

    // Image / Video Viewer properties
    in-out property <string> viewer-filename: "";
    in-out property <string> viewer-resolution: "";
    in-out property <int> viewer-background-mode: 0;
    in-out property <bool> viewer-show-tab-rating-badge: false;
    in-out property <bool> viewer-has-previous: false;
    in-out property <bool> viewer-has-next: false;

    // Grid Items Layout properties
    in-out property <int> grid-item-padding-h: 8;
    in-out property <int> grid-item-padding-v: 6;
    in-out property <int> grid-spacing: 12;
    in-out property <int> grid-padding: 12;
    in-out property <int> grid-item-border-width: 1;
    in-out property <int> grid-item-corner-radius: 4;

    // Viewport windowing properties
    in-out property <int> total-items-count: 0;
    out property <int> grid-columns: grid-view.columns;

    // Media Drag and Drop State Properties
    in-out property <bool> is-dragging-media: false;
    in-out property <int> drag-count: 0;
    in-out property <string> drag-title: "";
    in-out property <image> drag-thumbnail;
    in-out property <length> drag-x: 0px;
    in-out property <length> drag-y: 0px;
    in-out property <int> drop-target-folder-id: -1;
    /// The folder row (negative view id) of the Browse view that a dragged medium hovers, 0 = none.
    in-out property <int> drop-target-row-id: 0;
    /// Width of the Browse view (grid or table), for the edge zones of the drag auto-scroll.
    out property <length> media-view-width: root.is-table-view ? table-view.width : grid-view.width;
    out property <length> folder-tree-scroll-y: sidebar_left.folder-tree-scroll-y;
    out property <length> folder-tree-container-height: sidebar_left.folder-tree-container-height;

    // Rubberband Area Selection State Properties
    in-out property <bool> rubberband-active: false;
    in-out property <length> rubberband-x: 0px;
    in-out property <length> rubberband-y: 0px;
    in-out property <length> rubberband-width: 0px;
    in-out property <length> rubberband-height: 0px;

    // Floating Choice Popup State Properties
    in-out property <bool> is-choice-popup-open: false;
    in-out property <int> choice-target-folder-id: -1;
    in-out property <string> choice-target-folder-name: "";
    in-out property <int> choice-item-count: 1;
    in-out property <length> choice-popup-x: 0px;
    in-out property <length> choice-popup-y: 0px;

    // Tooltip global settings properties
    in-out property <bool> enable-tooltips: true;
    in-out property <int> tooltip-delay-ms: 750;

    changed enable-tooltips => {
        TooltipSettings.enabled = root.enable-tooltips;
    }

    changed tooltip-delay-ms => {
        TooltipSettings.default-delay = root.tooltip-delay-ms * 1ms;
    }

    in-out property <length> sidebar-left-width: 260px;
    in-out property <length> sidebar-right-width: 280px;

    in-out property <int> sort-column-idx: 0;
    in-out property <int> sort-order-idx: 0;

    // All 13 Table Column Widths
    in-out property <length> col-filename-width: 260px;
    in-out property <length> col-path-width: 180px;
    in-out property <length> col-modified-date-width: 145px;
    in-out property <length> col-created-date-width: 145px;
    in-out property <length> col-size-width: 95px;
    in-out property <length> col-rating-width: 65px;
    in-out property <length> col-tags-width: 65px;
    in-out property <length> col-width-width: 70px;
    in-out property <length> col-height-width: 70px;
    in-out property <length> col-ar-width: 65px;
    in-out property <length> col-duration-width: 110px;
    in-out property <length> col-format-width: 75px;
    in-out property <length> col-flags-width: 85px;

    in-out property <bool> is-refreshing-folders: false;
    in-out property <int> folder-scan-count: 0;
    in-out property <bool> show-hidden-folders: false;

    in-out property <bool> is-indexing-media: false;
    in-out property <int> media-index-current: 0;
    in-out property <int> media-index-total: 0;
    /// The tab whose content is shown in the fullscreen window right now (-1 = none); its tab-grid item shows a placeholder.
    in-out property <int> fullscreen-tab-id: -1;
    /// The tab the tab view shows (-1 = none), to tell whether it is the one in the fullscreen.
    in-out property <int> viewer-tab-id: -1;
    // The shown Multiview tab holds several media and none is selected: the panels act on nothing and say so.
    in property <bool> tab-needs-selection: false;

    in-out property <bool> is-preloading: false;
    in-out property <int> preload-current: 0;
    in-out property <int> preload-total: 100;

    in-out property <bool> is-generating: false;
    in-out property <int> generate-current: 0;
    in-out property <int> generate-total: 100;
    in-out property <int> active-workers: 0;

    in-out property <bool> tag-is-assign-mode: false;
    in-out property <int> tag-match-mode-idx: 0;
    in-out property <int> tag-scope-mode-idx: 2;
    in-out property <int> selected-rating: 0;
    in property <bool> has-file-selection: false;
    in property <[bool]> partial-ratings: [false, false, false, false, false, false];
    in-out property <bool> has-active-query: false;
    in-out property <string> tag-filter-text: "";
    in-out property <bool> tag-filter-is-regex: false;

    // Assigned Tags History Properties
    in property <[TagHistoryRowModel]> tag-history-rows: [];
    in property <int> tag-history-count: 0;
    in-out property <bool> tag-history-is-collapsed: false;
    in-out property <length> tag-history-height: 96px;

    callback tag-history-collapsed-toggled(bool);
    callback tag-history-tag-clicked(int /* tag_id */);
    callback tag-history-geometry-changed(length /* available_width */);
    callback tag-history-resized(length /* new_height */);
    callback tag-history-resize-finished(length /* final_height */);

    property <bool> is-text-input-focused: media-toolbar.search-has-focus || sidebar_right.tag-filter-has-focus;

    in-out property <bool> is-context-menu-open: false;
    in property <[ContextMenuLevelModel]> context-menu-levels: [];

    in property <[MediaItemView]> media-items: [];
    in property <[FolderNodeView]> folders: [];
    in property <[FavoriteItemView]> favorites: [];
    in property <[TagColumnView]> tag-columns: [];

    // Metadata Inspector properties
    in property <string> info-filename: "-";
    in property <string> info-filename-tooltip: "";
    in property <string> info-path-label: "Path:";
    in property <string> info-path: "-";
    in property <string> info-path-tooltip: "";
    in property <string> info-size: "-";
    in property <string> info-size-tooltip: "";
    in property <string> info-dimensions: "-";
    in property <string> info-format: "-";
    in property <string> info-hash: "-";
    in property <string> info-hash-tooltip: "";
    in property <int> info-selection-count: 0;
    in property <string> info-size-label: "Size:";
    in property <string> info-dimensions-label: "Dimensions:";
    in property <string> info-format-label: "Format:";
    in property <string> info-hash-label: "";
    in property <string> info-badge-text: "";
    in-out property <bool> info-is-collapsed: false;
    callback info-collapsed-toggled(bool);

    callback global-tooltip-state-changed(bool /* is_visible */, length /* x */, length /* y */, length /* width */, length /* height */);

    callback refresh-folder();
    callback regenerate-thumbs-clicked();
    callback new-folder-clicked();
    /// A row of a folder (or "Up") in the Browse view was clicked; `id` is negative.
    callback folder-row-clicked(int /* id */, bool /* ctrl */, bool /* shift */);
    /// Enter in the Browse view: opens the selected folder row or the selected medium.
    callback browse-enter-pressed();
    /// Backspace / Alt+Up in the Browse view: shows the parent folder.
    callback browse-go-up-requested();
    /// Alt+Left (-1) / Alt+Right (+1) in the Browse view: back / forward through the visited folders.
    callback browse-history-requested(int /* direction */);
    /// A right click on the free space of the Browse view.
    callback browse-background-context-menu(length /* x */, length /* y */);
    callback show-folders-toggled(bool);
    callback open-settings();
    // Opens the settings on the page Hotkeys.
    callback open-hotkey-settings();
    callback browse-clicked();
    callback tab-grid-clicked();
    callback tab-selected(int /* tab_id */);
    callback tab-multi-selected(int /* tab_id */, bool /* ctrl */, bool /* shift */);
    /// The multi-selection of tabs ends (click on free space, Esc).
    callback tab-selection-cleared();
    /// Some tabs are selected (Esc ends the selection only then).
    in property <bool> has-tab-selection: false;
    callback tab-closed(int /* tab_id */);
    callback tab-context-menu(int /* tab_id */, length /* x */, length /* y */);
    callback tab-wheel-scrolled(bool /* is_next */);

    // Tab Grid View Callbacks
    callback tab-grid-item-left-clicked(int /* tab_id */);
    callback tab-grid-item-selection-clicked(int /* tab_id */, bool /* ctrl */, bool /* shift */);
    callback tab-grid-item-middle-clicked(int /* tab_id */);
    callback tab-grid-item-close-clicked(int /* tab_id */);
    callback tab-grid-columns-changed(int /* new_columns */);
    callback tab-grid-auto-columns-toggled(bool /* is_auto */);
    callback tab-grid-close-all-clicked();
    callback tab-grid-viewport-geometry-changed(length /* width */, length /* height */);
    callback tab-grid-scrolled(length /* dx */, length /* dy */);

    // Tab Drag & Drop Callbacks
    callback tab-drag-started(int /* tab_id */, int /* source_index */, length /* mouse_x */, length /* tab_width */);
    callback tab-drag-moved(length /* mouse_x */, length /* view_width */);
    callback tab-drag-ended(int /* tab_id */, int /* target_index */);
    callback tab-drag-cancelled(int /* tab_id */);

    callback viewer-close-tab();
    callback viewer-refresh();
    // Keys of the tab view that act on the selected medium of its Multiview: DEL and the zoom keys (0 = reset, 1 = in, 2 = out).
    callback viewer-delete-key();
    callback viewer-zoom-key(int);
    // The refresh key of a Multiview (tab view or fullscreen): the medium is read again from the drive.
    callback refresh-medium(int /* media id */);
    callback viewer-previous();
    callback viewer-next();
    // The area of the viewer tab that a Multiview fills changed (size or position); Rust places the native video windows.
    callback multiview-viewport-changed();

    /// The area of the Multiview canvas in the window (logical pixels), read by Rust to place the native video windows.
    public pure function multiview-viewport() -> MultiviewScreenView {
        return {
            x: multiview-viewer.absolute-position.x,
            y: multiview-viewer.absolute-position.y,
            width: multiview-viewer.width,
            height: multiview-viewer.height,
        };
    }

    callback modal-dismiss-requested();
    callback request-rename();
    callback request-delete();

    // Global Media Selection Callbacks (Ctrl+A & Ctrl+Shift+A)
    callback select-all-media();
    callback clear-media-selection();

    callback folder-selected(int, string);
    callback folder-toggle-expand(int);
    callback folder-context-menu(int /* id */, length /* x */, length /* y */);
    callback folder-refresh-all-clicked();
    callback folder-refresh-relative-clicked();
    callback folder-collapse-all-clicked();
    callback favorite-selected(string);
    callback favorite-context-menu(string /* path */, string /* alias */, length /* x */, length /* y */);
    callback toggle-hidden-folders(bool /* show_hidden */);
    callback media-clicked(int /* id */, bool /* is_ctrl */, bool /* is_shift */);
    callback media-middle-clicked(int /* id */);
    callback media-context-menu(int /* id */, length /* x */, length /* y */);
    callback media-hover-changed(int /* id */, bool /* is_hover */);
    callback background-clicked();
    callback viewport-changed(int /* first_row */, int /* visible_rows */, int /* columns */, int /* total */);

    // Keyboard Navigation Callback
    callback media-navigate(int /* direction */, bool /* is_shift */, int /* page_rows */);

    // Type-ahead find: every key press of the Browse view is offered to Rust first; true = the search took the key.
    callback type-ahead-key(string /* event.text */, bool /* Ctrl, Alt or Meta is held */) -> bool;

    // Every key press the fixed handling below leaves (text, Ctrl, Alt, Shift, Meta, key repeat, a text input has the focus): Rust
    // looks it up in the keymap (`ui::hotkeys`); true = it was an action's key and is consumed.
    callback hotkey(string, bool, bool, bool, bool, bool, bool) -> bool;
    // A rating key (0 = no rating): the Browse selection, the selected medium of the tab, or the open fullscreen.
    callback rate-key(int);
    // A key of the image editor in the tab view: 0 = Esc, 1 = Enter, 2 = Ctrl+S, 3 = Ctrl+Shift+S, 4 = Ctrl+Z,
    // 5 = Ctrl+Shift+Z / Ctrl+Y. True = the editor used it; otherwise the key keeps its usual meaning.
    callback edit-key(int /* code */) -> bool;

    callback media-drag-started(int /* id */, length /* x */, length /* y */);
    callback media-drag-moved(length /* x */, length /* y */);
    callback media-drag-ended();
    callback media-drag-over-row(int /* folder row id under the pointer, 0 = none */);
    callback folder-row-context-menu(int /* folder row id */, length /* x */, length /* y */);
    callback folder-row-hovered(int /* folder_id */);
    callback folder-row-unhovered(int /* folder_id */);
    callback media-dropped-on-folder(int /* target_folder_id */);

    // Rubberband selection callbacks
    callback rubberband-started(length /* start_content_x */, length /* start_content_y */, length /* view_x */, length /* view_y */, bool /* ctrl */, bool /* shift */);
    callback rubberband-moved(length /* content_x */, length /* content_y */, length /* view_x */, length /* view_y */);
    callback rubberband-ended();

    callback choice-popup-copy(int /* target_folder_id */);
    callback choice-popup-move(int /* target_folder_id */);
    callback choice-popup-cancel();
    callback choice-popup-dismissed();

    callback context-menu-item-clicked(int /* action_id */);
    callback context-menu-request-submenu(int /* depth */, length /* visible_row_y */, int /* menu_index */);
    callback context-menu-close-submenus-above(int /* depth */);
    callback context-menu-dismissed();

    callback search-query-changed(string);
    callback regex-mode-toggled(bool);
    callback virtual-folder-toggled(bool);
    callback media-type-filter-changed(int /* index */);
    callback rating-applied(int);
    callback tag-toggled(int);
    callback tag-toggle-expand(int);
    callback tag-context-menu(int /* tag_id */, length /* x */, length /* y */);
    callback tag-root-context-menu(length /* x */, length /* y */);
    callback tag-filter-changed(string);
    callback tag-regex-toggled(bool);
    callback tag-mode-toggled(bool);
    callback match-mode-changed(int);
    callback scope-mode-changed(int);
    callback tag-reset-clicked();
    callback tag-tree-geometry-changed(length /* available_height */);

    callback sort-column-clicked(int /* column_index */);
    callback column-resized(int /* column_index */, length /* new_width */);
    callback column-resize-finished(int /* column_index */, length /* final_width */);
    callback view-mode-toggled-with-index(bool /* is_table */, int /* anchor_top_index */);

    callback sidebar-left-resized(length /* new_width */);
    callback sidebar-left-resize-finished(length /* final_width */);
    callback sidebar-right-resized(length /* new_width */);
    callback sidebar-right-resize-finished(length /* final_width */);

    public function scroll-tab-bar-by(dx: length) {
        top-toolbar.scroll-tab-bar-by(dx);
    }

    public function scroll-tab-into-view(tab-x: length, tab-width: length) {
        top-toolbar.scroll-tab-into-view(tab-x, tab-width);
    }

    public function scroll-folder-tree-by(dy: length) {
        sidebar_left.scroll-folder-tree-by(dy);
    }

    public function scroll-folder-to-row(row-idx: int) {
        sidebar_left.scroll-folder-to-row(row-idx);
    }

    public function scroll-media-by(dy: length) {
        if root.active-view-mode == 2 {
            tab-grid-view.scroll-by(dy);
        } else if !root.is-table-view {
            grid-view.scroll-by(dy);
        } else {
            table-view.scroll-by(dy);
        }
    }

    pure public function get-media-viewport-y() -> length {
        if !root.is-table-view {
            return grid-view.get-viewport-y();
        } else {
            return table-view.get-viewport-y();
        }
    }

    public function scroll-media-to-top() {
        if !root.is-table-view {
            grid-view.scroll-to-top();
        } else {
            table-view.scroll-to-top();
        }
    }

    public function scroll-media-to-index(item-idx: int, is-table: bool) {
        if is-table {
            table-view.scroll-to-index(item-idx);
        } else {
            grid-view.scroll-to-index(item-idx);
        }
    }

    public function scroll-media-item-into-view(item-idx: int) {
        if root.is-table-view {
            table-view.scroll-item-into-view(item-idx);
        } else {
            grid-view.scroll-item-into-view(item-idx);
        }
    }

    /// The folder row of the Browse view under the window point (x, y), 0 when there is none: lets the drop target follow a scroll
    /// that happens while the pointer rests.
    pure public function drag-row-id-at(window-x: length, window-y: length) -> int {
        let view-x = window-x - root.sidebar-left-width - resizer_left.width;
        let view-y = window-y - 64px - 28px;
        if root.is-table-view {
            return table-view.row-id-at-viewport(view-x, view-y);
        } else {
            return grid-view.row-id-at-viewport(view-x, view-y);
        }
    }

    public function scroll-media-item-centered(item-idx: int) {
        if root.is-table-view {
            table-view.scroll-item-centered(item-idx);
        } else {
            grid-view.scroll-item-centered(item-idx);
        }
    }

    pure public function get-top-visible-index() -> int {
        if root.is-table-view {
            return table-view.get-top-visible-index();
        } else {
            return grid-view.get-top-visible-index();
        }
    }

    public function focus-search() {
        media-toolbar.focus-search();
    }

    /// The rows one page of the Browse view moves (the page keys).
    pure public function media-page-rows() -> int {
        return root.is-table-view ? table-view.get-page-rows() : grid-view.get-page-rows();
    }

    /// Switches the Browse view between thumbnails and the table, like the toolbar's button.
    public function toggle-table-view() {
        let new-is-table = !root.is-table-view;
        let anchor-top-idx = new-is-table ? grid-view.get-top-visible-index() : table-view.get-top-visible-index();
        root.is-table-view = new-is-table;
        root.view-mode-toggled-with-index(new-is-table, anchor-top-idx);
    }

    forward-focus: main-window-focus;
    main-window-focus := FocusScope {
        key-pressed(event) => {
            if root.is-modal-locked || root.is-fullscreen-locked {
                if event.text == Key.Escape {
                    root.modal-dismiss-requested();
                    return accept;
                }
                return accept;
            }

            if root.is-choice-popup-open {
                if event.text == Key.Escape {
                    root.choice-popup-dismissed();
                    return accept;
                }
                return reject;
            }

            if root.is-context-menu-open {
                if event.text == Key.Escape {
                    root.context-menu-dismissed();
                    return accept;
                }
                return reject;
            }

            if root.is-dragging-media || root.is-dragging-tab || root.is-dragging-panel-tab || root.rubberband-active {
                return reject;
            }

            // Esc is fixed: the crop tool of the tab view first (the selected picture's, else the one opened last), then a selection
            // of tabs; in Browse a running type-ahead search, then the media selection.
            if event.text == Key.Escape && !root.is-text-input-focused {
                if root.active-view-mode == 1 && root.edit-key(0) {
                    return accept;
                }
                if root.has-tab-selection {
                    root.tab-selection-cleared();
                    return accept;
                }
            }

            // Type-ahead find: printable keys of the Browse view jump to the item whose name starts with what was typed;
            // Backspace and Escape belong to a running search first. Every other key ends it (Rust decides, the key goes on).
            if root.active-view-mode == 0 && !root.is-text-input-focused {
                if root.type-ahead-key(event.text, event.modifiers.control || event.modifiers.alt || event.modifiers.meta) {
                    return accept;
                }
                if event.text == Key.Escape {
                    root.clear-media-selection();
                    return accept;
                }
            }

            // Every other key: the keymap (Settings > Hotkeys).
            if root.hotkey(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta,
                event.repeat, root.is-text-input-focused) {
                return accept;
            }
            return reject;
        }
    }

    VerticalLayout {
        spacing: 0px;

        top-toolbar := TopToolbar {
            is-browse-active: root.is-browse-active;
            is-tab-grid-active: root.is-tab-grid-active;
            tabs: root.tabs;
            show-tab-rating-badge: root.viewer-show-tab-rating-badge;

            is-dragging-tab: root.is-dragging-tab;
            drag-ghost-x: root.drag-ghost-x;
            drag-ghost-title: root.drag-ghost-title;
            drag-ghost-format: root.drag-ghost-format;
            drag-ghost-icon: root.drag-ghost-icon;
            drag-ghost-rating: root.drag-ghost-rating;
            drag-ghost-is-active: root.drag-ghost-is-active;

            browse-clicked => { root.browse-clicked(); }
            tab-grid-clicked => { root.tab-grid-clicked(); }
            tab-selected(id) => { root.tab-selected(id); }
            tab-multi-selected(id, ctrl, shift) => { root.tab-multi-selected(id, ctrl, shift); }
            tab-selection-cleared => { root.tab-selection-cleared(); }
            tab-closed(id) => { root.tab-closed(id); }
            tab-context-menu(id, x, y) => { root.tab-context-menu(id, x, y); }
            tab-wheel-scrolled(is-next) => { root.tab-wheel-scrolled(is-next); }
            settings-clicked => { root.open-settings(); }

            tab-drag-started(id, s-idx, mx, tw) => {
                root.tab-drag-started(id, s-idx, mx, tw);
            }
            tab-drag-moved(mx, vw) => {
                root.tab-drag-moved(mx, vw);
            }
            tab-drag-ended(id, t-idx) => {
                root.tab-drag-ended(id, t-idx);
            }
            tab-drag-cancelled(id) => {
                root.tab-drag-cancelled(id);
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;

            sidebar_left := SidebarLeft {
                sidebar-width: (root.active-view-mode == 0) ? root.sidebar-left-width : 0px;
                visible: root.active-view-mode == 0;
                panel-tabs: root.sidebar-panel-tabs;
                active-panel-tab: root.active-sidebar-panel-tab;
                is-dragging-panel-tab: root.is-dragging-panel-tab;
                panel-tab-drag-ghost-x: root.panel-tab-drag-ghost-x;
                panel-tab-drag-ghost-width: root.panel-tab-drag-ghost-width;
                panel-tab-drag-ghost-title: root.panel-tab-drag-ghost-title;
                panel-tab-drag-ghost-icon: root.panel-tab-drag-ghost-icon;
                panel-tab-selected(id) => { root.sidebar-panel-tab-selected(id); }
                panel-tab-drag-started(id, idx, mx, tw) => { root.sidebar-panel-tab-drag-started(id, idx, mx, tw); }
                panel-tab-drag-moved(mx, vw) => { root.sidebar-panel-tab-drag-moved(mx, vw); }
                panel-tab-drag-ended(id, idx) => { root.sidebar-panel-tab-drag-ended(id, idx); }
                panel-tab-drag-cancelled(id) => { root.sidebar-panel-tab-drag-cancelled(id); }

                folders: root.folders;
                favorites: root.favorites;
                drop-target-folder-id: root.drop-target-folder-id;
                is-refreshing-folders: root.is-refreshing-folders;
                is-busy: root.is-system-busy;
                show-hidden-folders <=> root.show-hidden-folders;
                toggle-hidden-folders(h) => { root.toggle-hidden-folders(h); }
                folder-collapse-all-clicked => { root.folder-collapse-all-clicked(); }
                folder-clicked(id, path) => { root.folder-selected(id, path); }
                folder-toggle-expand(id) => { root.folder-toggle-expand(id); }
                folder-row-hovered(id) => { root.folder-row-hovered(id); }
                folder-row-unhovered(id) => { root.folder-row-unhovered(id); }
                folder-context-menu(id, x, y) => { root.folder-context-menu(id, sidebar_left.x + x, 38px + sidebar_left.y + y); }
                folder-refresh-all-clicked => { root.folder-refresh-all-clicked(); }
                folder-refresh-relative-clicked => { root.folder-refresh-relative-clicked(); }
                favorite-clicked(path) => { root.favorite-selected(path); }
                favorite-context-menu(path, alias, x, y) => {
                    root.favorite-context-menu(path, alias, sidebar_left.x + x, 38px + sidebar_left.y + y);
                }

                // Info Inspector in SidebarLeft
                info-filename: root.info-filename;
                info-filename-tooltip: root.info-filename-tooltip;
                info-path-label: root.info-path-label;
                info-path: root.info-path;
                info-path-tooltip: root.info-path-tooltip;
                info-size: root.info-size;
                info-size-tooltip: root.info-size-tooltip;
                info-dimensions: root.info-dimensions;
                info-format: root.info-format;
                info-hash: root.info-hash;
                info-hash-tooltip: root.info-hash-tooltip;
                info-selection-count: root.info-selection-count;
                info-size-label: root.info-size-label;
                info-dimensions-label: root.info-dimensions-label;
                info-format-label: root.info-format-label;
                info-hash-label: root.info-hash-label;
                info-badge-text: root.info-badge-text;
                info-is-collapsed <=> root.info-is-collapsed;
                info-collapsed-toggled(c) => { root.info-collapsed-toggled(c); }
            }

            resizer_left := ResizerBar {
                is-horizontal: true;
                width: (root.active-view-mode == 0) ? self.thickness : 0px;
                visible: root.active-view-mode == 0;
                property <length> start-w: 260px;
                drag-started => {
                    self.start-w = root.sidebar-left-width;
                }
                dragged(delta) => {
                    root.sidebar-left-width = Math.max(150px, Math.min(700px, self.start-w + delta));
                    root.sidebar-left-resized(root.sidebar-left-width);
                }
                drag-finished => {
                    root.sidebar-left-resize-finished(root.sidebar-left-width);
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0px;

                Rectangle {
                    height: (root.active-view-mode == 0 || root.active-view-mode == 1) ? 26px : 0px;
                    visible: root.active-view-mode == 0 || root.active-view-mode == 1;
                    vertical-stretch: 0;

                    media-toolbar := MediaPanelToolbar {
                        visible: root.active-view-mode == 0;
                        thumb-width <=> root.thumb-size;
                        search-text <=> root.search-query;
                        regex-mode <=> root.regex-mode;
                        is-table-view: root.is-table-view;
                        is-busy: root.is-system-busy;
                        is-virtual-folder <=> root.is-virtual-folder;
                        is-virtual-folder-enabled: root.is-virtual-folder-btn-enabled;
                        virtual-folder-tooltip: root.virtual-folder-tooltip;
                        is-regenerate-thumbs-enabled: root.is-regenerate-thumbs-enabled;
                        regenerate-thumbs-tooltip: root.regenerate-thumbs-tooltip;
                        is-new-folder-enabled: root.is-new-folder-btn-enabled;
                        new-folder-tooltip: root.new-folder-tooltip;
                        show-folders <=> root.show-folders;
                        media-type-filter-idx <=> root.media-type-filter-idx;
                        thumb-width-changed(w) => { }
                        search-changed(t) => { root.search-query-changed(t); }
                        search-escape-pressed => { main-window-focus.focus(); }
                        regex-toggled(r) => { root.regex-mode-toggled(r); }
                        virtual-folder-toggled(v) => { root.virtual-folder-toggled(v); }
                        media-type-filter-changed(m) => { root.media-type-filter-changed(m); }
                        refresh-clicked => { root.refresh-folder(); }
                        regenerate-thumbs-clicked => { root.regenerate-thumbs-clicked(); }
                        new-folder-clicked => { root.new-folder-clicked(); }
                        show-folders-toggled(on) => { root.show-folders-toggled(on); }
                        view-mode-toggled(new-is-table) => {
                            if new-is-table != root.is-table-view {
                                root.toggle-table-view();
                            }
                        }
                    }

                    ImageTabPanelToolbar {
                        visible: root.active-view-mode == 1;
                        filename: root.viewer-filename;
                        resolution: root.viewer-resolution;
                        has-previous: root.viewer-has-previous;
                        has-next: root.viewer-has-next;
                        previous-clicked => { root.viewer-previous(); }
                        next-clicked => { root.viewer-next(); }
                        refresh-clicked => { root.viewer-refresh(); }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.background;

                    grid-view := VirtualizedMediaGrid {
                        visible: root.active-view-mode == 0 && !root.is-table-view;
                        media-items: root.media-items;
                        total-items-count: root.total-items-count;
                        drop-target-row-id: root.drop-target-row-id;
                        active: root.active-view-mode == 0 && !root.is-table-view;
                        thumb-size: root.thumb-size;
                        thumb-aspect-idx: root.thumb-aspect-idx;
                        badge-config: root.thumbnail-badge-config;
                        grid-item-padding-h: root.grid-item-padding-h;
                        grid-item-padding-v: root.grid-item-padding-v;
                        grid-spacing-val: root.grid-spacing;
                        grid-padding-val: root.grid-padding;
                        grid-item-border-width: root.grid-item-border-width;
                        grid-item-corner-radius: root.grid-item-corner-radius;
                        sort-column: root.sort-column-idx;
                        sort-order: root.sort-order-idx;

                        rubberband-active: root.rubberband-active && !root.is-table-view && root.active-view-mode == 0;
                        rubberband-x: root.rubberband-x;
                        rubberband-y: root.rubberband-y;
                        rubberband-width: root.rubberband-width;
                        rubberband-height: root.rubberband-height;

                        ensure-focus => {
                            main-window-focus.focus();
                        }
                        viewport-changed(first-row, visible-rows, columns, total) => {
                            root.viewport-changed(first-row, visible-rows, columns, total);
                        }
                        item-clicked(id, ctrl, shift) => {
                            if id < 0 {
                                root.folder-row-clicked(id, ctrl, shift);
                            } else {
                                root.media-clicked(id, ctrl, shift);
                            }
                        }
                        item-middle-clicked(id) => {
                            if id >= 0 {
                                root.media-middle-clicked(id);
                            }
                        }
                        item-context-menu(id, x, y) => {
                            if id >= 0 {
                                root.media-context-menu(id, x + root.sidebar-left-width + resizer_left.width, y + 64px);
                            } else {
                                root.folder-row-context-menu(id, x + root.sidebar-left-width + resizer_left.width, y + 64px);
                            }
                        }
                        item-hover-changed(id, hover) => { root.media-hover-changed(id, hover); }
                        sort-clicked(idx) => { root.sort-column-clicked(idx); }
                        background-clicked => { root.background-clicked(); }
                        background-context-menu(x, y) => {
                            root.browse-background-context-menu(x + root.sidebar-left-width + resizer_left.width, y + 64px);
                        }
                        item-drag-started(id, x, y) => {
                            if id >= 0 {
                                root.media-drag-started(id, x + root.sidebar-left-width + resizer_left.width, y + 64px);
                            }
                        }
                        item-drag-moved(x, y) => { root.media-drag-moved(x + root.sidebar-left-width + resizer_left.width, y + 64px); }
                        item-drag-ended => { root.media-drag-ended(); }
                        item-drag-over-row(id) => { root.media-drag-over-row(id); }

                        rubberband-started(cx, cy, vx, vy, ctrl, shift) => {
                            root.rubberband-started(cx, cy, vx, vy, ctrl, shift);
                        }
                        rubberband-moved(cx, cy, vx, vy) => {
                            root.rubberband-moved(cx, cy, vx, vy);
                        }
                        rubberband-ended => {
                            root.rubberband-ended();
                        }
                    }

                    table-view := MediaTableView {
                        visible: root.active-view-mode == 0 && root.is-table-view;
                        items: root.media-items;
                        total-items-count: root.total-items-count;
                        active: root.active-view-mode == 0 && root.is-table-view;
                        sort-column: root.sort-column-idx;
                        sort-order: root.sort-order-idx;

                        drop-target-row-id: root.drop-target-row-id;
                        rubberband-active: root.rubberband-active && root.is-table-view && root.active-view-mode == 0;
                        rubberband-x: root.rubberband-x;
                        rubberband-y: root.rubberband-y;
                        rubberband-width: root.rubberband-width;
                        rubberband-height: root.rubberband-height;

                        col-filename-width <=> root.col-filename-width;
                        col-path-width <=> root.col-path-width;
                        col-modified-date-width <=> root.col-modified-date-width;
                        col-created-date-width <=> root.col-created-date-width;
                        col-size-width <=> root.col-size-width;
                        col-rating-width <=> root.col-rating-width;
                        col-tags-width <=> root.col-tags-width;
                        col-width-width <=> root.col-width-width;
                        col-height-width <=> root.col-height-width;
                        col-ar-width <=> root.col-ar-width;
                        col-duration-width <=> root.col-duration-width;
                        col-format-width <=> root.col-format-width;
                        col-flags-width <=> root.col-flags-width;

                        ensure-focus => {
                            main-window-focus.focus();
                        }
                        viewport-changed(first-row, visible-rows, columns, total) => {
                            root.viewport-changed(first-row, visible-rows, columns, total);
                        }
                        item-clicked(id, ctrl, shift) => {
                            if id < 0 {
                                root.folder-row-clicked(id, ctrl, shift);
                            } else {
                                root.media-clicked(id, ctrl, shift);
                            }
                        }
                        item-middle-clicked(id) => {
                            if id >= 0 {
                                root.media-middle-clicked(id);
                            }
                        }
                        item-context-menu(id, x, y) => {
                            if id >= 0 {
                                root.media-context-menu(id, x + root.sidebar-left-width + resizer_left.width, y + 64px);
                            } else {
                                root.folder-row-context-menu(id, x + root.sidebar-left-width + resizer_left.width, y + 64px);
                            }
                        }
                        sort-clicked(idx) => { root.sort-column-clicked(idx); }
                        column-resized(idx, w) => { root.column-resized(idx, w); }
                        column-resize-finished(idx, w) => { root.column-resize-finished(idx, w); }
                        background-clicked => { root.background-clicked(); }
                        background-context-menu(x, y) => {
                            root.browse-background-context-menu(x + root.sidebar-left-width + resizer_left.width, y + 64px);
                        }
                        item-drag-started(id, x, y) => {
                            if id >= 0 {
                                root.media-drag-started(id, x + root.sidebar-left-width + resizer_left.width, y + 64px);
                            }
                        }
                        item-drag-moved(x, y) => { root.media-drag-moved(x + root.sidebar-left-width + resizer_left.width, y + 64px); }
                        item-drag-ended => { root.media-drag-ended(); }
                        item-drag-over-row(id) => { root.media-drag-over-row(id); }

                        rubberband-started(cx, cy, vx, vy, ctrl, shift) => {
                            root.rubberband-started(cx, cy, vx, vy, ctrl, shift);
                        }
                        rubberband-moved(cx, cy, vx, vy) => {
                            root.rubberband-moved(cx, cy, vx, vy);
                        }
                        rubberband-ended => {
                            root.rubberband-ended();
                        }
                    }

                    empty-state := EmptyStateView {
                        is-active: root.active-view-mode == 0 && root.empty-state-active;
                        title: root.empty-state-title;
                        description: root.empty-state-description;
                        icon: root.empty-state-icon;
                    }

                    multiview-viewer := MultiviewCanvas {
                        visible: root.active-view-mode == 1;
                        tiles: MultiviewTabBus.tiles;
                        gutters: MultiviewTabBus.gutters;
                        screen: MultiviewTabBus.screen;
                        background-mode: root.viewer-background-mode;
                        outer-color: #000000;
                        show-frame: true;

                        changed width => { root.multiview-viewport-changed(); }
                        changed height => { root.multiview-viewport-changed(); }
                        changed absolute-position => { root.multiview-viewport-changed(); }

                        tile-clicked(index, is-ctrl) => { MultiviewTabBus.tile-clicked(index, is-ctrl); }
                        tile-zoom-wheel(index, delta, x, y) => { MultiviewTabBus.tile-zoom-wheel(index, delta, x, y); }
                        tile-pan(index, dx, dy) => { MultiviewTabBus.tile-pan(index, dx, dy); }
                        minimap-pointer(index, x, y, phase) => { MultiviewTabBus.minimap-pointer(index, x, y, phase); }
                        minimap-slider(index, code) => { MultiviewTabBus.minimap-slider(index, code); }
                        crop-pointer(index, phase, x, y, shift) => { MultiviewTabBus.crop-pointer(index, phase, x, y, shift); }
                        crop-ratio(index, landscape) => { MultiviewTabBus.crop-ratio(index, landscape); }
                        background-clicked(is-ctrl) => { MultiviewTabBus.background-clicked(is-ctrl); }
                        middle-clicked => { MultiviewTabBus.middle-clicked(); }
                        gutter-drag-started(index) => { MultiviewTabBus.gutter-drag-started(index); }
                        gutter-dragged(index, distance) => { MultiviewTabBus.gutter-dragged(index, distance); }
                        gutter-drag-finished(index) => { MultiviewTabBus.gutter-drag-finished(index); }
                        gutter-reset => { MultiviewTabBus.gutter-reset(); }
                        gutter-swap(index) => { MultiviewTabBus.gutter-swap(index); }
                    }

                    // The tab of the tab view is shown in the fullscreen window: the whole inner area is a placeholder.
                    AwayPanel {
                        visible: root.active-view-mode == 1 && root.fullscreen-tab-id >= 0 && root.fullscreen-tab-id == root.viewer-tab-id;
                        width: 100%;
                        height: 100%;
                    }

                    tab-grid-view := TabGridView {
                        visible: root.active-view-mode == 2;
                        items: root.tab-grid-items;
                        away-tab-id: root.fullscreen-tab-id;
                        total-content-height: root.tab-grid-content-height;
                        columns <=> root.tab-grid-columns;
                        auto-columns <=> root.tab-grid-auto-columns;
                        grid-item-padding-h: root.grid-item-padding-h;
                        grid-item-padding-v: root.grid-item-padding-v;
                        grid-spacing-val: root.grid-spacing;
                        grid-padding-val: root.grid-padding;
                        grid-item-border-width: root.grid-item-border-width;
                        grid-item-corner-radius: root.grid-item-corner-radius;
                        background-mode: root.viewer-background-mode;

                        item-left-clicked(id) => { root.tab-grid-item-left-clicked(id); }
                        item-selection-clicked(id, ctrl, shift) => { root.tab-grid-item-selection-clicked(id, ctrl, shift); }
                        selection-cleared => { root.tab-selection-cleared(); }
                        item-middle-clicked(id) => { root.tab-grid-item-middle-clicked(id); }
                        item-close-clicked(id) => { root.tab-grid-item-close-clicked(id); }
                        item-context-menu(id, x, y) => { root.tab-context-menu(id, x, y + 38px); }
                        columns-changed(c) => { root.tab-grid-columns-changed(c); }
                        auto-columns-toggled(a) => { root.tab-grid-auto-columns-toggled(a); }
                        close-all-clicked => { root.tab-grid-close-all-clicked(); }
                        viewport-geometry-changed(vw, vh) => { root.tab-grid-viewport-geometry-changed(vw, vh); }
                        scrolled(dx, dy) => { root.tab-grid-scrolled(dx, dy); }
                    }
                }
            }

            resizer_right := ResizerBar {
                is-horizontal: true;
                width: (root.active-view-mode != 2) ? self.thickness : 0px;
                visible: root.active-view-mode != 2;
                property <length> start-w: 280px;
                drag-started => {
                    self.start-w = root.sidebar-right-width;
                }
                dragged(delta) => {
                    root.sidebar-right-width = Math.max(150px, Math.min(700px, self.start-w - delta));
                    root.sidebar-right-resized(root.sidebar-right-width);
                }
                drag-finished => {
                    root.sidebar-right-resize-finished(root.sidebar-right-width);
                }
            }

            sidebar_right := SidebarRight {
                sidebar-width: (root.active-view-mode != 2) ? root.sidebar-right-width : 0px;
                visible: root.active-view-mode != 2;
                tag-columns: root.tag-columns;
                is-assign-mode <=> root.tag-is-assign-mode;
                match-mode-idx <=> root.tag-match-mode-idx;
                scope-mode-idx <=> root.tag-scope-mode-idx;
                selected-rating <=> root.selected-rating;
                has-selection: root.has-file-selection;
                partial-ratings: root.partial-ratings;
                has-active-query: root.has-active-query;
                is-tab-view: root.active-view-mode == 1;
                selection-hint: root.active-view-mode == 1 && root.tab-needs-selection ? "Select a medium in the view" : "";
                tag-filter-text <=> root.tag-filter-text;
                tag-filter-is-regex <=> root.tag-filter-is-regex;

                // Bind Tag History properties
                tag-history-rows: root.tag-history-rows;
                tag-history-count: root.tag-history-count;
                tag-history-is-collapsed <=> root.tag-history-is-collapsed;
                tag-history-height <=> root.tag-history-height;
                tag-history-collapsed-toggled(c) => { root.tag-history-collapsed-toggled(c); }
                tag-history-tag-clicked(id) => { root.tag-history-tag-clicked(id); }
                tag-history-geometry-changed(w) => { root.tag-history-geometry-changed(w); }
                tag-history-resized(h) => { root.tag-history-resized(h); }
                tag-history-resize-finished(h) => { root.tag-history-resize-finished(h); }

                mode-toggled(assign) => { root.tag-mode-toggled(assign); }
                rating-selected(r) => { root.rating-applied(r); }
                tag-clicked(id) => { root.tag-toggled(id); }
                tag-toggle-expand(id) => { root.tag-toggle-expand(id); }
                tag-context-menu(id, x, y) => { root.tag-context-menu(id, sidebar_right.x + x, 38px + sidebar_right.y + y); }
                root-context-menu(x, y) => { root.tag-root-context-menu(sidebar_right.x + x, 38px + sidebar_right.y + y); }
                tag-filter-changed(txt) => { root.tag-filter-changed(txt); }
                tag-filter-escape-pressed => { main-window-focus.focus(); }
                tag-regex-toggled(r) => { root.tag-regex-toggled(r); }
                match-mode-changed(m) => { root.match-mode-changed(m); }
                scope-mode-changed(s) => { root.scope-mode-changed(s); }
                reset-clicked => { root.tag-reset-clicked(); }
                tag-tree-geometry-changed(h) => { root.tag-tree-geometry-changed(h); }
            }
        }

        StatusBar {
            is-tab-view: root.active-view-mode == 1 || root.active-view-mode == 2;
            status-message: root.status-text;
            status-level: root.status-level;
            item-count-str: root.items-metric-text;
            total-items: root.status-total-items;
            visible-items: root.status-visible-items;
            total-size-str: root.status-total-size;
            selection-count: root.status-selection-count;
            selection-folders: root.status-selection-folders;
            selection-size-str: root.status-selection-size;
            is-virtual-folder: root.is-virtual-folder;
            virtual-folder-count: root.virtual-folder-count;
            is-refreshing-folders: root.is-refreshing-folders;
            folder-scan-count: root.folder-scan-count;
            is-indexing-media: root.is-indexing-media;
            media-index-current: root.media-index-current;
            media-index-total: root.media-index-total;
            is-preloading: root.is-preloading;
            preload-val: root.preload-current;
            preload-max: root.preload-total;
            is-generating: root.is-generating;
            generate-val: root.generate-current;
            generate-max: root.generate-total;
            active-workers: root.active-workers;
        }
    }

    if root.is-context-menu-open : ContextMenuPopup {
        levels: root.context-menu-levels;
        item-clicked(id) => { root.context-menu-item-clicked(id); }
        request-submenu(depth, row-y, m-idx) => { root.context-menu-request-submenu(depth, row-y, m-idx); }
        close-submenus-above(depth) => { root.context-menu-close-submenus-above(depth); }
        dismissed => { root.context-menu-dismissed(); }
    }

    if root.is-choice-popup-open : FloatingChoicePopup {
        target-folder-name: root.choice-target-folder-name;
        item-count: root.choice-item-count;
        pos-x: root.choice-popup-x;
        pos-y: root.choice-popup-y;
        copy-clicked => { root.choice-popup-copy(root.choice-target-folder-id); }
        move-clicked => { root.choice-popup-move(root.choice-target-folder-id); }
        cancel-clicked => { root.choice-popup-cancel(); }
        dismissed => { root.choice-popup-dismissed(); }
    }

    // High-Priority Global Tooltip Layer (Strictly rendered over all context menus and media at z: 200)
    GlobalTooltipLayer {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;

        state-changed(is-visible, x, y, w, h) => {
            root.global-tooltip-state-changed(is-visible, x, y, w, h);
        }
    }

    if root.is-modal-locked || root.is-fullscreen-locked : Rectangle {
        background: #00000066;

        modal-touch := TouchArea {
            clicked => {
                root.modal-dismiss-requested();
            }
        }
    }
}
