import { SmoothScrollArea } from "smooth_scroll_view.slint";

/// Tells the application that the content of an open dialog grew by `by` while the dialog showed all of it
/// (`ui::dialog_fit::install` makes the window that much taller).
export global DialogFit {
    callback grow(length /* by */);
}

/// The body of every dialog window, above its button bar. The content sits at the top at its own height (a single-line field
/// never stretches); a taller window leaves the space below it empty, a lower one shows a vertical scroll bar instead of
/// squeezing it. When the content grows while the dialog shows all of it (a note appears), the window grows with it.
///
/// Usage: `body := DialogBody { content-height: content.preferred-height; content := VerticalLayout { width: body.width;
/// height: self.preferred-height; ... } }` (the explicit width lets Slint measure wrapped text at its real width).
export component DialogBody {
    in property <length> content-height;
    // The height of the content when it last changed (0 until then: the window opens at the content's height).
    property <length> last-content: 0px;

    vertical-stretch: 1;
    preferred-height: root.content-height;
    min-height: Math.min(root.content-height, 96px);

    changed content-height => {
        if root.content-height > root.height && (root.last-content == 0px || root.height >= root.last-content - 1px) {
            DialogFit.grow(root.content-height - root.height);
        }
        root.last-content = root.content-height;
    }

    SmoothScrollArea {
        width: 100%;
        height: 100%;
        content-height: root.content-height;
        // Logical sizes are rounded to physical pixels: a content a pixel or two taller than the body fits (into its padding).
        enable-vertical: root.content-height > root.height + 2px;

        // A child of fixed height is centered by Slint; the layout keeps the content at the top.
        VerticalLayout {
            alignment: start;

            @children
        }
    }
}
