import { Button } from "std-widgets.slint";
import { Theme } from "styles.slint";
import { BulletItem } from "bullet_item.slint";
import { IconId } from "icons.slint";
import { DialogHeading } from "dialog_heading.slint";
import { DialogBody } from "dialog_body.slint";

export component DeleteFileDialog inherits Window {
    title: "RustView - Delete File";
    width: 500px;
    preferred-height: dialog-layout.preferred-height;
    min-height: dialog-layout.min-height;
    background: Theme.background;

    in-out property <string> file-name: "";
    in-out property <int> files-count: 1;
    in-out property <string> missing-note: "";
    in property <string> error-message: "";

    callback move-to-trash-confirmed();
    callback permanent-delete-confirmed();
    callback cancelled();

    forward-focus: dialog-focus;

    dialog-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            return reject;
        }

        dialog-layout := VerticalLayout {
            width: root.width;
            padding: 0px;
            spacing: 0px;
            alignment: space-between;

            body := DialogBody {
                content-height: content.preferred-height;

                content := VerticalLayout {
                    width: body.width;
                    height: self.preferred-height;
                    padding: 16px;
                    spacing: 12px;

                    DialogHeading {
                        icon: IconId.status-warning;
                        text: "Delete File" + (root.files-count > 1 ? "s" : "");
                        color: Theme.status-corrupt;
                    }

                    Text {
                        text: root.files-count > 1
                            ? ("Are you sure you want to delete the " + root.files-count + " selected files?")
                            : ("Are you sure you want to delete '" + root.file-name + "'?");
                        font-size: 12px;
                        color: Theme.text;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        background: Theme.status-corrupt.with-alpha(0.094);
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Theme.status-corrupt.with-alpha(0.267);

                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;

                            Text {
                                text: "Database and storage cleanup:";
                                font-size: 11px;
                                font-weight: 700;
                                color: Theme.status-corrupt;
                            }

                            BulletItem {
                                text: root.files-count > 1
                                    ? (root.files-count + " media records, thumbnails and preview caches will be deleted")
                                    : "Media record, thumbnail and preview cache will be removed from database";
                                color: Theme.text;
                            }
                        }
                    }

                    if root.missing-note != "" : Text {
                        text: root.missing-note;
                        font-size: 11px;
                        color: Theme.accent;
                        wrap: word-wrap;
                    }

                    if root.error-message != "" : Text {
                        text: root.error-message;
                        font-size: 11px;
                        color: Theme.status-corrupt;
                        wrap: word-wrap;
                    }
                }
            }

            // Action Buttons Bar
            Rectangle {
                height: 48px;
                background: Theme.surface;
                vertical-stretch: 0;

                Rectangle {
                    y: 0px;
                    height: 1px;
                    background: Theme.border;
                }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 10px;
                    alignment: end;

                    Button {
                        text: "Cancel";
                        clicked => { root.cancelled(); }
                    }

                    Button {
                        text: "Permanently Delete";
                        clicked => { root.permanent-delete-confirmed(); }
                    }

                    Button {
                        text: "Move to Trash";
                        primary: true;
                        clicked => { root.move-to-trash-confirmed(); }
                    }
                }
            }
        }
    }
}
