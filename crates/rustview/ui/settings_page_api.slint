import { CheckBox } from "settings_controls.slint";
import { Theme } from "styles.slint";
import { BulletItem } from "bullet_item.slint";
import { SettingsCard } from "settings_card.slint";

export component SettingsPageApi inherits VerticalLayout {
    spacing: 12px;

    in-out property <bool> auto-complete-external-stubs: true;

    SettingsCard {
        title: "CLI API & External Applications";
        description: "Configure how RustView handles media entries introduced by external tools (e.g. PyCutRv or custom CLI scripts).";

        CheckBox {
            text: "Auto-complete external media stubs on folder access";
            checked <=> root.auto-complete-external-stubs;
        }

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;

            Text {
                text: "When enabled, entering a directory containing media records created by external tools that are still missing metadata or thumbnails will automatically probe the disk, extract full video/image container metrics, and generate thumbnails as soon as the render file becomes available.";
                font-size: 11px;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
        }
    }

    SettingsCard {
        title: "Queue & Render Job Safety";
        description: "Files currently rendering or pending in an external export queue are handled safely without marking them corrupted.";

        BulletItem {
            text: "If an external file has not yet been rendered to disk (0 bytes or missing), it remains safely in 'Pending' status and will be seamlessly completed upon subsequent folder visits.";
            color: Theme.text-muted;
        }

        BulletItem {
            text: "The media panel refresh action is temporarily disabled during completion to guarantee atomic transaction integrity.";
            color: Theme.text-muted;
        }
    }
}
