import { Theme } from "styles.slint";
import { BulletItem } from "bullet_item.slint";
import { IconId } from "icons.slint";
import { DialogHeading } from "dialog_heading.slint";
import { ButtonBar } from "button_bar.slint";
import { DialogBody } from "dialog_body.slint";

export component MoveFolderToDialog inherits Window {
    title: "RustView - Move Folder";
    width: 480px;
    preferred-height: dialog-layout.preferred-height;
    min-height: dialog-layout.min-height;
    background: Theme.background;

    in-out property <string> source-folder-name: "";
    in-out property <string> target-folder-name: "";
    in-out property <int> subfolders-count: 0;
    in-out property <int> files-count: 0;
    in property <string> error-message: "";

    callback confirmed();
    callback cancelled();

    forward-focus: dialog-focus;

    dialog-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            return reject;
        }

        dialog-layout := VerticalLayout {
            width: root.width;
            padding: 0px;
            spacing: 0px;
            alignment: space-between;

            body := DialogBody {
                content-height: content.preferred-height;

                content := VerticalLayout {
                    width: body.width;
                    height: self.preferred-height;
                    padding: 16px;
                    spacing: 12px;

                    DialogHeading {
                        icon: IconId.move-to;
                        text: "Move Directory";
                        color: Theme.primary;
                    }

                    Text {
                        text: "Move folder '" + root.source-folder-name + "' under destination '" + root.target-folder-name + "'?";
                        font-size: 12px;
                        color: Theme.text;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        background: Theme.surface-variant;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Theme.border;

                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;

                            Text {
                                text: "Contents to be relocated on disk and in database:";
                                font-size: 11px;
                                font-weight: 700;
                                color: Theme.primary;
                            }

                            BulletItem {
                                text: root.subfolders-count + " subfolder(s)";
                                color: Theme.text;
                            }

                            BulletItem {
                                text: root.files-count + " media file(s)";
                                color: Theme.text;
                            }
                        }
                    }

                    if root.error-message != "" : Text {
                        text: root.error-message;
                        font-size: 11px;
                        color: #ff5555;
                        wrap: word-wrap;
                    }
                }
            }

            ButtonBar {
                vertical-stretch: 0;
                bar-height: 48px;
                show-cancel: true;
                show-save: true;
                text-save: "Move Folder";
                text-cancel: "Cancel";
                cancel-clicked => { root.cancelled(); }
                save-clicked => { root.confirmed(); }
            }
        }
    }
}
