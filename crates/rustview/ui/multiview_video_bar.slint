import { Theme, MediaTheme } from "styles.slint";
import { AppIcon, IconId } from "icons.slint";
import { AbColors, AbGroup, AbLoadMenu, AbSaveBubble } from "multiview_video_bar_ab.slint";
import { AbMenuRowView, AbStripSegmentView, MultiviewVideoBarView, VideoBarSpanView } from "multiview_video_bar_view.slint";
import { BarBubble, BarIconButton, BarPopupMetrics, BarTime, BarVolumePopup } from "multiview_video_bar_parts.slint";
import { MultiviewBarMenu } from "multiview_bar_menu.slint";
import { AbMarks } from "multiview_video_bar_ab_marks.slint";

export { AbMenuRowView, AbStripSegmentView, MultiviewVideoBarView, VideoBarSpanView }

/// What the user did on a bar (`VideoBarInput::from_event` decodes it): `kind` says what, the other fields carry its values.
///  0 play/pause, 1 milliseconds, 2 speaker, 3 seek (share, phase), 4 hover (index 1 = inside, share), 5 volume (share, phase),
///  6 wheel (delta), 10 A-B button (index: 0 = A, 1 = B, 2 = AB clicked, 3 = AB held, 4 = Save, 5 = Load), 11 save text,
///  12 save commit (text), 13 close the popup, 14 menu query (text), 15 menu page (index = -1 or 1), 16 pick, 17 delete, 18 delete
///  all, 19 rename (index), 20 rename text, 21 rename commit (text), 22 rename cancel, 23 strip hover (index 1 = inside, share),
///  24 strip click (share), 25 flag (index 0 = A, 1 = B; share, phase), 26 measured (widths: what each step needs besides the
///  progress bar), 27 the speaker of a bar without slider (its volume popup), 28 the A-B button (its bubble), 29 "...", 30 a
///  press outside the open popup, 31 an entry of the "..." menu (index = its id), 32 refresh the load menu.
///  Phases: 0 = press, 1 = drag, 2 = release.
export struct VideoBarEvent {
    kind: int,
    share: float,
    phase: int,
    index: int,
    text: string,
    delta: length,
    widths: [length],
}

/// The events of every control bar of a window go here (the canvas is drawn in the main and the fullscreen window, each has its
/// own instance of this global; Rust finds the tile by its key).
export global VideoBarBus {
    callback event(int /* tile key */, VideoBarEvent);
}

/// The control bar of a video, drawn by the canvas over the bottom of its video (`MultiviewCanvas.video-bars`). The rectangle holds
/// the room above the bar (the time bubble, the A-B group); only the bar and the parts of the A-B group take the pointer. The
/// Save bubble and the Load menu open above their button, inside the window: a click anywhere else on the canvas closes them.
/// Everything grows with `bar-height` (Settings > Multiview > Player).
export component MultiviewVideoBar inherits Rectangle {
    in property <MultiviewVideoBarView> bar;
    // The size of the canvas: an open popup may use all of it and the backdrop that closes it covers it.
    in property <length> canvas-width;
    in property <length> canvas-height;

    function send(kind: int, share: float, phase: int, index: int, text: string) {
        VideoBarBus.event(root.bar.key, { kind: kind, share: share, phase: phase, index: index, text: text });
    }
    function play-pause() { root.send(0, 0, 0, 0, ""); }
    function toggle-ms() { root.send(1, 0, 0, 0, ""); }
    function speaker() { root.send(2, 0, 0, 0, ""); }
    function seek(share: float, phase: int) { root.send(3, share, phase, 0, ""); }
    function hover(inside: bool, share: float) { root.send(4, share, 0, inside ? 1 : 0, ""); }
    function volume(share: float, phase: int) { root.send(5, share, phase, 0, ""); }
    function wheel(delta: length) {
        VideoBarBus.event(root.bar.key, { kind: 6, delta: delta });
    }
    function ab-button(code: int) { root.send(10, 0, 0, code, ""); }
    function ab-save-edited(text: string) { root.send(11, 0, 0, 0, text); }
    function ab-save-commit(text: string) { root.send(12, 0, 0, 0, text); }
    function ab-close-popup() { root.send(13, 0, 0, 0, ""); }
    function ab-menu-query-edited(text: string) { root.send(14, 0, 0, 0, text); }
    function ab-menu-page-step(delta: int) { root.send(15, 0, 0, delta, ""); }
    function ab-menu-pick(index: int) { root.send(16, 0, 0, index, ""); }
    function ab-menu-delete(index: int) { root.send(17, 0, 0, index, ""); }
    function ab-menu-delete-all() { root.send(18, 0, 0, 0, ""); }
    function ab-menu-rename(index: int) { root.send(19, 0, 0, index, ""); }
    function ab-menu-rename-edited(text: string) { root.send(20, 0, 0, 0, text); }
    function ab-menu-rename-commit(text: string) { root.send(21, 0, 0, 0, text); }
    function ab-menu-rename-cancel() { root.send(22, 0, 0, 0, ""); }
    function ab-strip-hover(inside: bool, share: float) { root.send(23, share, 0, inside ? 1 : 0, ""); }
    function ab-strip-click(share: float) { root.send(24, share, 0, 0, ""); }
    function ab-flag(point: int, share: float, phase: int) { root.send(25, share, phase, point, ""); }
    function ab-menu-refresh() { root.send(32, 0, 0, 0, ""); }
    function audio-button() { root.send(27, 0, 0, 0, ""); }
    function ab-bubble-toggle() { root.send(28, 0, 0, 0, ""); }
    function more-button() { root.send(29, 0, 0, 0, ""); }
    function close-popups() { root.send(30, 0, 0, 0, ""); }
    function menu-entry(id: int) { root.send(31, 0, 0, id, ""); }
    function menu-slider(id: int, share: float, phase: int) { root.send(33, share, phase, id, ""); }
    function filter-button() { root.send(34, 0, 0, 0, ""); }
    function menu-reset(id: int) { root.send(35, 0, 0, id, ""); }

    // One "point" of the default bar (30 px high): every size below is a multiple of it.
    property <length> pt: root.bar.bar-height / 30;
    property <length> icon-size: Math.round(root.bar.bar-height * 0.6 / 1px) * 1px;
    property <length> font-size: Math.round(root.bar.bar-height * 0.4 / 1px) * 1px;
    property <length> pad: Math.round((root.bar.pill ? 14 : 8) * root.pt / 1px) * 1px;
    property <length> gap: Math.round(8 * root.pt / 1px) * 1px;
    property <color> panel: Theme.fullscreen-background;
    property <color> bar-fill: root.panel.with-alpha(root.bar.bar-opacity);

    // The A-B group: its buttons and where its parts are (relative to this element).
    property <length> ab-button-size: Math.round(root.bar.bar-height * 0.86 / 1px) * 1px;
    property <length> ab-icon-size: Math.round(root.bar.bar-height * 0.56 / 1px) * 1px;

    // ---- What fits (`video_bar::collapse`). Every part has a fixed width (the times are as wide as their templates), so the
    // bar knows what each step needs besides the progress bar and reports it; Rust picks the step (`bar.fit`) with some
    // hysteresis. The parts are placed from the left edge (play, current time) and from the right edge (volume slider,
    // speaker or "...", the A-B group or its button, the remaining time); the progress bar takes what lies between.
    property <length> btn: root.bar.bar-height;
    property <length> ab-inset: Math.round(3 * root.pt / 1px) * 1px;
    property <bool> ab-on: root.bar.ab-shown && !root.bar.mini;
    property <length> ab-full-width: 5 * root.ab-button-size + 2 * root.ab-inset;
    property <length> ab-group-height: root.ab-button-size + 2 * Math.round(2 * root.pt / 1px) * 1px;
    property <length> cur-width: cur-measure.preferred-width;
    property <length> rem-width: rem-measure.preferred-width;
    property <length> slider-width: 3 * root.bar.bar-height;
    property <int> fit: root.bar.mini ? 0 : root.bar.fit;
    property <bool> has-cur: !root.bar.mini && root.fit < 6;
    property <bool> has-rem: !root.bar.mini && root.fit < 2;
    property <bool> has-ab-group: root.ab-on && root.fit < 3;
    property <bool> has-ab-button: root.ab-on && (root.fit == 3 || root.fit == 4);
    property <bool> has-speaker: !root.bar.mini && root.fit < 5;
    property <bool> has-slider: !root.bar.mini && root.fit == 0;
    property <bool> has-filter: !root.bar.mini && root.fit < 4;
    property <bool> has-more: !root.bar.mini && root.fit >= 4;
    property <length> play-x: root.pad;
    property <length> cur-x: root.play-x + root.btn + root.gap;
    property <length> left-end: root.has-cur ? root.cur-x + root.cur-width : root.play-x + root.btn;
    property <length> slider-x: root.width - root.pad - root.slider-width;
    property <length> right-1: root.has-slider ? root.slider-x - root.gap : root.width - root.pad;
    // "..." takes the place of the filter button (step 4), then the speaker's (from step 5 on).
    property <length> speaker-x: root.right-1 - root.btn;
    property <length> speaker-center: root.speaker-x + root.btn / 2;
    property <bool> speaker-slot: root.has-speaker || (root.has-more && root.fit >= 5);
    property <length> right-2: root.speaker-slot ? root.speaker-x - root.gap : root.right-1;
    property <length> filter-x: root.right-2 - root.btn;
    property <length> filter-center: root.filter-x + root.btn / 2;
    property <bool> filter-slot: root.has-filter || (root.has-more && root.fit == 4);
    property <length> right-2b: root.filter-slot ? root.filter-x - root.gap : root.right-2;
    property <length> more-x-bar: root.fit == 4 ? root.filter-x : root.speaker-x;
    property <length> more-center: root.more-x-bar + root.btn / 2;
    property <length> ab-x: root.right-2b - (root.has-ab-button ? root.btn : root.ab-full-width);
    property <length> right-3: root.has-ab-button || root.has-ab-group ? root.ab-x - root.gap : root.right-2b;
    property <length> rem-x: root.right-3 - root.rem-width;
    property <length> right-4: root.has-rem ? root.rem-x - root.gap : root.right-3;
    property <length> progress-x: root.left-end + root.gap;
    property <length> progress-w: Math.max(0px, root.right-4 - root.progress-x);

    // What step `step` needs besides the progress bar: the same parts as above, each with its gap.
    pure function need(step: int) -> length {
        return 2 * root.pad + root.btn + root.gap
            + (step < 6 ? root.cur-width + root.gap : 0px)
            + (step < 2 ? root.rem-width + root.gap : 0px)
            + (root.ab-on && step < 3 ? root.ab-full-width + root.gap : 0px)
            + (root.ab-on && (step == 3 || step == 4) ? root.btn + root.gap : 0px)
            // The speaker (until step 4), and the filter button or "..." (always one of them).
            + (step < 5 ? root.btn + root.gap : 0px)
            + root.btn + root.gap
            + (step == 0 ? root.slider-width + root.gap : 0px);
    }

    // Reported when the bar is made and whenever a width changes (the bar's height, the times' templates, the A-B group);
    // the small bar of the tab grid has no steps.
    property <string> needs-text: root.bar.mini ? "" : root.bar.key + ":" + root.need(0) / 1px + ":" + root.need(1) / 1px + ":"
        + root.need(2) / 1px + ":" + root.need(3) / 1px + ":" + root.need(4) / 1px + ":" + root.need(5) / 1px + ":"
        + root.need(6) / 1px;
    function report-needs() {
        if !root.bar.mini {
            VideoBarBus.event(root.bar.key, {
                kind: 26,
                widths: [root.need(0), root.need(1), root.need(2), root.need(3), root.need(4), root.need(5), root.need(6)],
            });
        }
    }
    init => { root.report-needs(); }
    changed needs-text => { root.report-needs(); }

    cur-measure := Text {
        visible: false;
        text: root.bar.current-template;
        font-size: root.font-size;
    }

    rem-measure := Text {
        visible: false;
        text: root.bar.remaining-template;
        font-size: root.font-size;
    }

    // Keeps a popup of `w` inside the canvas (whole pixels).
    pure function canvas-x(x: length, w: length) -> length {
        return Math.round(Math.clamp(x, 4px - root.x, Math.max(4px - root.x, root.canvas-width - root.x - w - 4px)) / 1px) * 1px;
    }

    // The bubble of the A-B button: the group, centered over the button, its caret touching the top of the bar.
    property <bool> ab-bubble-shown: root.has-ab-button && root.bar.ab-bubble;
    property <length> ab-button-center: root.ab-x + root.btn / 2;
    property <length> ab-bubble-pad: Math.round(4 * root.pt / 1px) * 1px;
    property <length> ab-bubble-width: root.ab-full-width + 2 * root.ab-bubble-pad;
    property <length> ab-bubble-height: root.ab-group-height + 2 * root.ab-bubble-pad + Math.round(7 * root.pt / 1px) * 1px;
    property <length> ab-bubble-x: root.canvas-x(root.ab-button-center - root.ab-bubble-width / 2, root.ab-bubble-width);
    property <length> ab-bubble-y: root.bar-top - root.ab-bubble-height;
    // The centers of Save and Load inside the A-B group (`AbGroup`: five buttons after its inset).
    property <length> ab-opener-offset: root.ab-inset + (root.bar.ab-popup == 1 ? 3.5 : 4.5) * root.ab-button-size;

    // The volume popup and the "..." menu, above the speaker (or "...").
    property <length> volume-width: BarPopupMetrics.volume-width(root.pt);
    property <length> volume-center: root.has-speaker ? root.speaker-center : root.more-center;
    property <length> volume-x: root.canvas-x(root.volume-center - root.volume-width / 2, root.volume-width);
    property <length> volume-y: Math.max(4px - root.y, root.bar-top - BarPopupMetrics.volume-height(root.pt));
    property <bool> menu-shown: (root.bar.menu-open == 1 && root.has-more) || (root.bar.menu-open == 2 && root.has-filter);
    property <length> menu-center: root.bar.menu-open == 2 ? root.filter-center : root.more-center;
    property <bool> popup-open: root.bar.ab-popup > 0 || root.bar.volume-open || root.bar.menu-open > 0;
    property <length> bar-top: root.height - root.bar.bar-height;
    property <length> ab-strip-top: root.bar-top - root.bar.ab-strip-height;
    // The strip only shows while it has something to show: saved repeats, the current A-B or one of its points.
    property <bool> ab-strip-shown: root.bar.ab-shown && (root.bar.ab-strip.length > 0 || root.bar.ab-span-shown || root.bar.ab-a-flag-shown || root.bar.ab-b-flag-shown);
    property <length> track-x: root.progress-x;
    property <length> track-w: root.progress-w;
    property <length> ab-font: Math.max(9px, Math.round(root.bar.bar-height * 0.34 / 1px) * 1px);
    // The open A-B popup: as wide as it wants within the canvas, centered over its opener (the caret points at the opener's
    // center) and moved sideways only where the canvas ends; its caret touches the top of the bar, or of the A-B bubble when
    // it opened from there. The opener is Save or Load of the group (in the bar or in its bubble), else the A-B button or
    // "..." of a collapsed bar.
    property <length> ab-popup-width: Math.min(Math.round((root.bar.ab-popup == 1 ? 290 : 520) * root.pt / 1px) * 1px, root.canvas-width - 8px);
    property <length> ab-opener-x: root.has-ab-group ? root.ab-x + root.ab-opener-offset
        : root.ab-bubble-shown ? root.ab-bubble-x + root.ab-bubble-pad + root.ab-opener-offset
        : root.has-ab-button ? root.ab-button-center
        : root.more-center;
    property <length> ab-popup-x: root.canvas-x(root.ab-opener-x - root.ab-popup-width / 2, root.ab-popup-width);
    property <length> ab-popup-y: Math.max(4px - root.y, (root.ab-bubble-shown ? root.ab-bubble-y : root.bar-top) - root.bar.ab-popup-height);

    // While a popup is open a press anywhere else on the canvas closes it (and does nothing else), like a menu. The bar itself and
    // the popup lie above it; the canvas draws the bar with the open popup last, so no other bar covers it.
    if root.popup-open : TouchArea {
        x: -root.x;
        y: -root.y;
        width: root.canvas-width;
        height: root.canvas-height;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.close-popups();
            }
        }
    }

    content := Rectangle {
        opacity: root.bar.revealed ? 1 : 0;
        animate opacity { duration: root.bar.fade ? 150ms : 0ms; }

        bar-panel := Rectangle {
            x: 0px;
            y: root.height - root.bar.bar-height;
            width: root.width;
            height: root.bar.bar-height;
            border-radius: root.bar.pill ? root.bar.bar-height / 2 : 0px;
            background: root.bar-fill;

            TouchArea {
                scroll-event(event) => {
                    root.wheel(event.delta-y);
                    return accept;
                }
            }

            BarIconButton {
                x: root.play-x;
                height: root.btn;
                size: root.btn;
                pt: root.pt;
                icon: root.bar.playing ? IconId.video-bar-pause : IconId.video-bar-play;
                icon-size: root.icon-size;
                clicked => { root.play-pause(); }
            }

            if root.has-cur : BarTime {
                x: root.cur-x;
                width: root.cur-width;
                height: root.btn;
                text: root.bar.current-text;
                font-size: root.font-size;
                text-color: MediaTheme.text;
                alignment: right;
                clicked => { root.toggle-ms(); }
            }

            progress := Rectangle {
                x: root.progress-x;
                width: root.progress-w;
                property <length> block: root.bar.bar-height - 2 * Math.round(6 * root.pt / 1px) * 1px;

                track := Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: progress.block;
                    border-radius: Math.round(2 * root.pt / 1px) * 1px;
                    clip: true;
                    background: Colors.white.with-alpha(0.18);

                    for span in root.bar.spans : Rectangle {
                        x: span.from * parent.width;
                        width: (span.to - span.from) * parent.width;
                        height: 100%;
                        background: span.kind == 0 ? MediaTheme.primary : MediaTheme.text-muted;
                    }

                    // The current A-B over the progress, translucent yellow (stronger while it loops), so the progress
                    // shows through and a saved repeat in the strip stays visible when it is loaded.
                    if root.bar.ab-shown && root.bar.ab-span-shown : Rectangle {
                        x: root.bar.ab-span-from * parent.width;
                        width: Math.max(2px, (root.bar.ab-span-to - root.bar.ab-span-from) * parent.width);
                        height: 100%;
                        background: MediaTheme.accent.with-alpha(root.bar.ab-span-looping ? 0.8 : 0.5);
                    }

                    if root.bar.ab-shown && root.bar.ab-dim : Rectangle {
                        x: 0;
                        width: root.bar.ab-span-from * parent.width;
                        height: 100%;
                        background: #000000.with-alpha(0.45);
                    }

                    if root.bar.ab-shown && root.bar.ab-dim : Rectangle {
                        x: root.bar.ab-span-to * parent.width;
                        width: (1 - root.bar.ab-span-to) * parent.width;
                        height: 100%;
                        background: #000000.with-alpha(0.45);
                    }

                    if root.bar.hover-shown : Rectangle {
                        x: Math.round(root.bar.hover-share * parent.width / 1px) * 1px - self.width / 2;
                        width: Math.max(1px, Math.round(2 * root.pt / 1px) * 1px);
                        height: 100%;
                        background: Colors.white.with-alpha(0.7);
                    }
                }

                seek-touch := TouchArea {
                    mouse-cursor: pointer;
                    property <float> share: Math.clamp(self.mouse-x / Math.max(1px, self.width), 0, 1);

                    pointer-event(event) => {
                        if event.button == PointerEventButton.left {
                            if event.kind == PointerEventKind.down {
                                root.seek(self.share, 0);
                            } else if event.kind == PointerEventKind.up {
                                root.seek(self.share, 2);
                            }
                        }
                    }
                    changed mouse-x => {
                        if self.pressed {
                            root.seek(self.share, 1);
                        }
                        if self.has-hover || self.pressed {
                            root.hover(true, self.share);
                        }
                    }
                    changed has-hover => {
                        root.hover(self.has-hover || self.pressed, self.share);
                    }
                    changed pressed => {
                        root.hover(self.has-hover || self.pressed, self.share);
                    }
                }
            }

            if root.has-rem : BarTime {
                x: root.rem-x;
                width: root.rem-width;
                height: root.btn;
                text: root.bar.remaining-text;
                font-size: root.font-size;
                text-color: MediaTheme.text-muted;
                alignment: left;
                clicked => { root.toggle-ms(); }
            }

            if root.has-ab-group : AbGroup {
                x: root.ab-x;
                y: Math.round((root.btn - root.ab-group-height) / 2 / 1px) * 1px;
                width: root.ab-full-width;
                height: root.ab-group-height;
                pt: root.pt;
                button-size: root.ab-button-size;
                icon-size: root.ab-icon-size;
                a-look: root.bar.ab-a-look;
                b-look: root.bar.ab-b-look;
                loop-look: root.bar.ab-loop-look;
                save-enabled: root.bar.ab-save-enabled;
                save-open: root.bar.ab-popup == 1;
                load-count: root.bar.ab-load-count;
                load-open: root.bar.ab-popup == 2;
                a-tip: root.bar.ab-a-tip;
                b-tip: root.bar.ab-b-tip;
                loop-tip: root.bar.ab-loop-tip;
                a-key: root.bar.ab-a-key;
                b-key: root.bar.ab-b-key;
                loop-key: root.bar.ab-loop-key;
                clearable: root.bar.ab-clearable;
                save-tip: root.bar.ab-save-tip;
                load-tip: root.bar.ab-load-tip;
                button(code) => { root.ab-button(code); }
            }

            // The A-B group collapsed into one button: its icon tells the state of the repeat, a click shows the group in its
            // bubble (or hides it).
            if root.has-ab-button : BarIconButton {
                x: root.ab-x;
                height: root.btn;
                size: root.btn;
                pt: root.pt;
                icon: root.bar.ab-loop-look == 0 ? IconId.ab-loop-off : IconId.ab-loop;
                icon-size: root.icon-size;
                tint: root.bar.ab-loop-look == 2 ? MediaTheme.accent : root.bar.ab-loop-look == 1 ? MediaTheme.primary : MediaTheme.text;
                open: root.bar.ab-bubble;
                tip: root.bar.ab-bubble ? "Hide the A-B repeat buttons" : "Show the A-B repeat buttons";
                clicked => { root.ab-bubble-toggle(); }
                scrolled(delta) => { root.wheel(delta); }
            }

            // The speaker: with the slider beside it a click mutes; without, a click opens the volume popup and a right click
            // mutes.
            if root.has-speaker : BarIconButton {
                x: root.speaker-x;
                height: root.btn;
                size: root.btn;
                pt: root.pt;
                icon: root.bar.volume-icon == 0 ? IconId.volume-off : (root.bar.volume-icon == 1 ? IconId.volume-low : IconId.volume-on);
                icon-size: root.icon-size;
                open: root.bar.volume-open;
                tip: root.has-slider ? (root.bar.muted ? "Sound on" : "Mute")
                    : "Volume " + root.bar.volume-text + ". Right click: " + (root.bar.muted ? "sound on" : "mute");
                clicked => {
                    if root.has-slider {
                        root.speaker();
                    } else {
                        root.audio-button();
                    }
                }
                right-clicked => {
                    if !root.has-slider {
                        root.speaker();
                    }
                }
                scrolled(delta) => { root.wheel(delta); }
            }

            // The video filters: orange with the number of filters that are on.
            if root.has-filter : BarIconButton {
                x: root.filter-x;
                height: root.btn;
                size: root.btn;
                pt: root.pt;
                icon: IconId.video-filter;
                icon-size: root.icon-size;
                tint: root.bar.filter-count > 0 ? MediaTheme.filter-active : MediaTheme.text;
                badge: root.bar.filter-count;
                open: root.bar.menu-open == 2;
                tip: root.bar.filter-count > 0 ? "Video filters (" + root.bar.filter-count + " on)" : "Video filters";
                clicked => { root.filter-button(); }
                scrolled(delta) => { root.wheel(delta); }
            }

            // "...": the controls the bar has no room for; the number tells how many video filters are on in it.
            if root.has-more : BarIconButton {
                x: root.more-x-bar;
                height: root.btn;
                size: root.btn;
                pt: root.pt;
                icon: IconId.video-bar-more;
                icon-size: root.icon-size;
                badge: root.bar.filter-count;
                open: root.bar.menu-open == 1;
                tip: root.bar.filter-count > 0 ? "More controls (" + root.bar.filter-count + " video filters on)" : "More controls";
                clicked => { root.more-button(); }
                scrolled(delta) => { root.wheel(delta); }
            }

            if root.has-slider : slider := Rectangle {
                x: root.slider-x;
                width: root.slider-width;
                height: root.btn;
                property <length> knob: Math.round(12 * root.pt / 1px) * 1px;
                property <length> inner-width: self.width - self.knob;
                property <bool> active: volume-touch.has-hover || volume-touch.pressed;
                property <color> fill: root.bar.muted ? MediaTheme.text-muted.with-alpha(0.5) : MediaTheme.primary;

                Rectangle {
                    x: slider.knob / 2;
                    y: (parent.height - self.height) / 2;
                    width: slider.inner-width;
                    height: Math.max(2px, Math.round(4 * root.pt / 1px) * 1px);
                    border-radius: self.height / 2;
                    background: Colors.white.with-alpha(0.22);

                    Rectangle {
                        x: 0px;
                        width: root.bar.volume-share * parent.width;
                        height: 100%;
                        border-radius: parent.border-radius;
                        background: slider.fill;
                    }
                }

                if slider.active : Rectangle {
                    x: root.bar.volume-share * slider.inner-width;
                    y: (parent.height - self.height) / 2;
                    width: slider.knob;
                    height: slider.knob;
                    border-radius: self.width / 2;
                    background: root.bar.muted ? MediaTheme.text-muted : #ffffff;
                }

                volume-touch := TouchArea {
                    mouse-cursor: pointer;
                    property <float> share: Math.clamp((self.mouse-x - slider.knob / 2) / Math.max(1px, slider.inner-width), 0, 1);

                    pointer-event(event) => {
                        if event.button == PointerEventButton.left {
                            if event.kind == PointerEventKind.down {
                                root.volume(self.share, 0);
                            } else if event.kind == PointerEventKind.up {
                                root.volume(self.share, 2);
                            }
                        }
                    }
                    changed mouse-x => {
                        if self.pressed {
                            root.volume(self.share, 1);
                        }
                    }
                    scroll-event(event) => {
                        root.wheel(event.delta-y);
                        return accept;
                    }
                }
            }
        }

        // ---- The A-B repeat group above the progress bar (only while `ab-shown`): the strip, the flags and the labels.
        AbMarks {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            bar: root.bar;
            pt: root.pt;
            track-x: root.track-x;
            track-w: root.track-w;
            bar-top: root.bar-top;
            ab-strip-top: root.ab-strip-top;
            ab-strip-shown: root.ab-strip-shown;
            ab-font: root.ab-font;
            bar-fill: root.bar-fill;
            ab-strip-hover(inside, share) => { root.ab-strip-hover(inside, share); }
            ab-strip-click(share) => { root.ab-strip-click(share); }
            ab-flag(point, share, phase) => { root.ab-flag(point, share, phase); }
        }

        // The bubble of the A-B button: the whole group, until the button is clicked again. It belongs to the bar and fades
        // with it, above the A-B marks (a flag's label must not cover a button).
        if root.ab-bubble-shown : BarBubble {
            x: root.ab-bubble-x;
            y: root.ab-bubble-y;
            width: root.ab-bubble-width;
            height: root.ab-bubble-height;
            pt: root.pt;
            caret-center: root.ab-button-center - root.ab-bubble-x;

            AbGroup {
                x: root.ab-bubble-pad;
                y: root.ab-bubble-pad;
                width: root.ab-full-width;
                height: root.ab-group-height;
                pt: root.pt;
                button-size: root.ab-button-size;
                icon-size: root.ab-icon-size;
                a-look: root.bar.ab-a-look;
                b-look: root.bar.ab-b-look;
                loop-look: root.bar.ab-loop-look;
                save-enabled: root.bar.ab-save-enabled;
                save-open: root.bar.ab-popup == 1;
                load-count: root.bar.ab-load-count;
                load-open: root.bar.ab-popup == 2;
                a-tip: root.bar.ab-a-tip;
                b-tip: root.bar.ab-b-tip;
                loop-tip: root.bar.ab-loop-tip;
                a-key: root.bar.ab-a-key;
                b-key: root.bar.ab-b-key;
                loop-key: root.bar.ab-loop-key;
                clearable: root.bar.ab-clearable;
                save-tip: root.bar.ab-save-tip;
                load-tip: root.bar.ab-load-tip;
                button(code) => { root.ab-button(code); }
            }
        }

        // The time under the pointer, above the progress bar (and above a drag on it).
        bubble := Rectangle {
            property <length> pointer-x: progress.x + root.bar.hover-share * progress.width;
            visible: root.bar.hover-shown;
            width: bubble-text.preferred-width + 2 * Math.round(6 * root.pt / 1px) * 1px;
            height: root.bar.bubble-height - Math.round(4 * root.pt / 1px) * 1px;
            x: Math.round(Math.clamp(self.pointer-x - self.width / 2, 0px, Math.max(0px, root.width - self.width)) / 1px) * 1px;
            y: (root.ab-strip-shown ? root.ab-strip-top : root.bar-top) - root.bar.bubble-height;
            border-radius: Math.round(4 * root.pt / 1px) * 1px;
            background: root.panel.with-alpha(Math.max(root.bar.bar-opacity, 0.85));

            bubble-text := Text {
                text: root.bar.hover-text;
                font-size: root.font-size;
                color: #ffffff;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }

    // ---- The popups of Save and Load: above the bar and above everything else of the canvas, their caret touching the top of the
    // bar over the center of their button. They are no part of the fading content: an open popup keeps its bar shown anyway.

    if root.bar.ab-popup == 1 : AbSaveBubble {
        x: root.ab-popup-x;
        y: root.ab-popup-y;
        width: root.ab-popup-width;
        height: root.bar.ab-popup-height;
        pt: root.pt;
        font-size: root.ab-font + 1px;
        placeholder: root.bar.ab-save-placeholder;
        hint: root.bar.ab-save-hint;
        caret-center: root.ab-opener-x - root.ab-popup-x;
        text: root.bar.ab-save-text;
        edited(text) => { root.ab-save-edited(text); }
        commit(text) => { root.ab-save-commit(text); }
        cancel => { root.ab-close-popup(); }
        init => { self.focus-input(); }
    }

    if root.bar.ab-popup == 2 : AbLoadMenu {
        x: root.ab-popup-x;
        y: root.ab-popup-y;
        width: root.ab-popup-width;
        height: root.bar.ab-popup-height;
        pt: root.pt;
        font-size: root.ab-font + 1px;
        icon-size: Math.round(14 * root.pt / 1px) * 1px;
        rows: root.bar.ab-menu-rows;
        query: root.bar.ab-menu-query;
        page: root.bar.ab-menu-page;
        pages: root.bar.ab-menu-pages;
        scroll: root.bar.ab-menu-scroll;
        visible-rows: root.bar.ab-menu-visible-rows;
        status: root.bar.ab-menu-status;
        renaming: root.bar.ab-menu-renaming;
        rename-text: root.bar.ab-menu-rename-text;
        caret-center: root.ab-opener-x - root.ab-popup-x;
        query-edited(text) => { root.ab-menu-query-edited(text); }
        page-step(delta) => { root.ab-menu-page-step(delta); }
        pick(index) => { root.ab-menu-pick(index); }
        rename(index) => { root.ab-menu-rename(index); }
        rename-edited(text) => { root.ab-menu-rename-edited(text); }
        rename-commit(text) => { root.ab-menu-rename-commit(text); }
        rename-cancel => { root.ab-menu-rename-cancel(); }
        delete(index) => { root.ab-menu-delete(index); }
        delete-all => { root.ab-menu-delete-all(); }
        refresh => { root.ab-menu-refresh(); }
        cancel => { root.ab-close-popup(); }
        init => { self.focus-input(); }
    }

    // ---- The popups of a collapsed bar, above the speaker or "...": the volume, and the "..." menu with its submenu beside
    // it (on the left where the canvas has room, else on the right; its bottom on the menu's bottom).

    if root.bar.volume-open && !root.has-slider : BarVolumePopup {
        x: root.volume-x;
        y: root.volume-y;
        pt: root.pt;
        caret-center: root.volume-center - root.volume-x;
        share: root.bar.volume-share;
        muted: root.bar.muted;
        level-text: root.bar.volume-text;
        volume-icon: root.bar.volume-icon;
        icon-size: root.icon-size;
        volume(share, phase) => { root.volume(share, phase); }
        wheel(delta) => { root.wheel(delta); }
        mute => { root.speaker(); }
    }

    // The open menu ("..." or the filter button's) and its two submenu levels beside it.
    if root.menu-shown : Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;

        menu := MultiviewBarMenu {
            x: root.canvas-x(root.menu-center - self.width / 2, self.width);
            y: Math.max(4px - root.y, root.bar-top - self.content-height);
            width: self.natural-width;
            items: root.bar.menu-items;
            // As tall as the room above the bar allows (no scroll bar where the canvas has room).
            max-content-height: Math.max(160px, root.bar-top + root.y - 8px);
            caret-down: true;
            anchor-x: root.menu-center - self.x;
            active-id: root.bar.menu-active-id;
            item-clicked(id) => { root.menu-entry(id); }
            item-slider(id, share, phase) => { root.menu-slider(id, share, phase); }
            item-reset(id) => { root.menu-reset(id); }
        }

        sub := MultiviewBarMenu {
            property <length> left: menu.x - self.width - 2px;
            visible: root.bar.menu-sub-items.length > 0;
            x: self.left >= 4px - root.x ? self.left : menu.x + menu.width + 2px;
            y: Math.max(4px - root.y, menu.y + menu.content-height - menu.caret-height - self.content-height);
            width: self.natural-width;
            items: root.bar.menu-sub-items;
            max-content-height: Math.max(160px, root.bar-top + root.y - 8px);
            show-caret: false;
            active-id: root.bar.menu-sub-active-id;
            item-clicked(id) => { root.menu-entry(id); }
            item-slider(id, share, phase) => { root.menu-slider(id, share, phase); }
            item-reset(id) => { root.menu-reset(id); }
        }

        MultiviewBarMenu {
            property <length> left: Math.min(sub.x, menu.x) - self.width - 2px;
            visible: root.bar.menu-sub2-items.length > 0;
            x: self.left >= 4px - root.x ? self.left : Math.max(sub.x + sub.width, menu.x + menu.width) + 2px;
            y: Math.max(4px - root.y, sub.y + sub.content-height - self.content-height);
            items: root.bar.menu-sub2-items;
            max-content-height: Math.max(160px, root.bar-top + root.y - 8px);
            width: self.natural-width;
            show-caret: false;
            item-clicked(id) => { root.menu-entry(id); }
            item-slider(id, share, phase) => { root.menu-slider(id, share, phase); }
            item-reset(id) => { root.menu-reset(id); }
        }
    }
}
