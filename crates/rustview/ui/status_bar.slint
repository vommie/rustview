import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSize } from "icons.slint";
import { ThumbnailPipelineProgress } from "thumbnail_progress.slint";
import { FolderRefreshProgress } from "progressbar_folders.slint";
import { MediaIndexProgress } from "progressbar_media.slint";

/// Clean vertical divider separator for status bar sections
export component StatusBarSeparator inherits VerticalLayout {
    alignment: center;
    horizontal-stretch: 0;

    Rectangle {
        width: 1px;
        height: 14px;
        background: Theme.border;
    }
}

/// Comprehensive, multi-zoned Status Bar component.
/// Zone 1 (Left): Status messages & severity indicators (strictly left-aligned).
/// Spacer: Expands to push all progress bars and status metrics flush to the right.
/// Zone 2 (Right): Dynamic progress bars + structured info badges (all right-aligned).
export component StatusBar inherits Rectangle {
    // RustCut's status line height (`Theme.status-bar-height` there).
    height: 26px;
    background: Theme.surface;

    // View Mode Context Property (Browse View vs. Tab Viewer View)
    in property <bool> is-tab-view: false;

    // Message & Severity Properties (Zone 1: Left)
    in property <string> status-message: "Ready.";
    in property <int> status-level: 0; // 0 = Info, 1 = Success, 2 = Warning, 3 = Error

    // Metrics Properties (Zone 2: Right)
    in property <string> item-count-str: "Items: 0";
    in property <int> total-items: 0;
    in property <int> visible-items: 0;
    in property <string> total-size-str: "";
    in property <int> selection-count: 0;
    in property <int> selection-folders: 0;
    in property <string> selection-size-str: "";

    // Virtual Folder / Recursive Subfolders View Indicator Properties
    in property <bool> is-virtual-folder: false;
    in property <int> virtual-folder-count: 0;

    // Folder Structure Scan Progress Properties
    in property <bool> is-refreshing-folders: false;
    in property <int> folder-scan-count: 0;

    // Media Files Indexing Progress Properties
    in property <bool> is-indexing-media: false;
    in property <int> media-index-current: 0;
    in property <int> media-index-total: 0;

    // Thumbnail Pipeline Progress Properties
    in property <bool> is-preloading: false;
    in property <int> preload-val: 0;
    in property <int> preload-max: 100;

    in property <bool> is-generating: false;
    in property <int> generate-val: 0;
    in property <int> generate-max: 100;
    in property <int> active-workers: 0;

    // Top border separator line running full width
    Rectangle {
        y: 0px;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 8px;

        // =========================================================================
        // ZONE 1: LEFT - Messages & Notifications (Strictly left-aligned)
        // =========================================================================
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 6px;
            alignment: start;

            // Status Level Indicator Icon / Dot
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;

                Rectangle {
                    width: IconSize.md;
                    height: IconSize.md;

                    if root.status-level == 1 : AppIcon {
                        icon: IconId.status-ok;
                        size: IconSize.md;
                        color: Theme.status-ok;
                    }

                    if root.status-level == 2 : AppIcon {
                        icon: IconId.status-warning;
                        size: IconSize.md;
                        color: Theme.accent;
                    }

                    if root.status-level == 3 : AppIcon {
                        icon: IconId.status-error;
                        size: IconSize.md;
                        color: Theme.status-corrupt;
                    }

                    if root.status-level == 0 : Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.primary;
                        opacity: 0.6;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            // Status Message Text
            Text {
                text: root.status-message;
                color: root.status-level == 3 ? Theme.status-corrupt : (
                    root.status-level == 2 ? Theme.accent : (
                        root.status-level == 1 ? Theme.status-ok : Theme.text
                    )
                );
                font-size: 11px;
                vertical-alignment: center;
                horizontal-alignment: left;
                overflow: elide;
            }
        }

        // =========================================================================
        // EXPANDER / SPACER (Pushes progress bars & metrics flush to the right)
        // =========================================================================
        Rectangle {
            horizontal-stretch: 1;
            background: transparent;
        }

        // =========================================================================
        // ZONE 2: RIGHT CLUSTER - Dynamic Progress Bars & Contextual Status Metrics
        // =========================================================================
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 8px;
            alignment: end;

            // 1. Dynamic Progress Bars (Always visible when active, across all modes)
            if root.is-refreshing-folders : VerticalLayout {
                alignment: center;
                FolderRefreshProgress {
                    is-refreshing: root.is-refreshing-folders;
                    scanned-count: root.folder-scan-count;
                }
            }

            if root.is-indexing-media : VerticalLayout {
                alignment: center;
                MediaIndexProgress {
                    is-indexing: root.is-indexing-media;
                    current-val: root.media-index-current;
                    total-val: root.media-index-total;
                }
            }

            if root.is-preloading || root.is-generating : VerticalLayout {
                alignment: center;
                ThumbnailPipelineProgress {
                    is-preloading: root.is-preloading;
                    preload-current: root.preload-val;
                    preload-total: root.preload-max;
                    is-generating: root.is-generating;
                    generate-current: root.generate-val;
                    generate-total: root.generate-max;
                    active-workers: root.active-workers;
                }
            }

            // Separator between Progress Bars and Browse Metrics (only in Browse Mode)
            if !root.is-tab-view && (root.is-refreshing-folders || root.is-indexing-media || root.is-preloading || root.is-generating) : StatusBarSeparator {}

            // 2. Virtual Recursive Folder Indicator Badge (Browse Mode Only)
            if !root.is-tab-view && root.is-virtual-folder : VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 18px;
                    background: #89b4fa1a;
                    border-radius: 0px;
                    border-width: 1px;
                    border-color: #89b4fa55;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 4px;
                        alignment: center;

                        Text {
                            text: "Recursive: " + root.virtual-folder-count + " dir" + (root.virtual-folder-count == 1 ? "" : "s");
                            font-size: 10px;
                            font-weight: 700;
                            color: Theme.primary;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if !root.is-tab-view && root.is-virtual-folder : StatusBarSeparator {}

            // 3. Selection Metric Badge (Browse Mode Only, visible when >= 1 files are selected)
            if !root.is-tab-view && (root.selection-count + root.selection-folders) > 0 : VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 18px;
                    background: #cba6f71a;
                    border-radius: 0px;
                    border-width: 1px;
                    border-color: #cba6f766;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 4px;
                        alignment: center;

                        Text {
                            text: "Selected: " + (root.selection-folders > 0 ? (root.selection-folders + (root.selection-folders == 1 ? " folder" : " folders") + (root.selection-count > 0 ? ", " : "")) : "") + (root.selection-count > 0 ? (root.selection-count + (root.total-items > 0 ? (" of " + root.total-items) : "")) : "") + (root.selection-size-str != "" ? (" (" + root.selection-size-str + ")") : "");
                            font-size: 10.5px;
                            font-weight: 700;
                            color: #cba6f7;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if !root.is-tab-view && (root.selection-count + root.selection-folders) > 0 : StatusBarSeparator {}

            // 4. Total / Filtered View Items Metric Badge (Browse Mode Only)
            if !root.is-tab-view : VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 18px;
                    background: transparent;

                    HorizontalLayout {
                        padding-left: 2px;
                        padding-right: 2px;
                        spacing: 4px;
                        alignment: center;

                        Text {
                            text: root.item-count-str + (root.total-size-str != "" && root.selection-count == 0 ? (" (" + root.total-size-str + ")") : "");
                            color: Theme.primary;
                            font-size: 11px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
