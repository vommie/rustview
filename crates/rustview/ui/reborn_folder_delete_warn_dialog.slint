import { Theme } from "styles.slint";
import { IconId } from "icons.slint";
import { DialogHeading } from "dialog_heading.slint";
import { ButtonBar } from "button_bar.slint";

export component RebornFolderDeleteWarnDialog inherits Window {
    title: "RustView - Folder Re-detected on Disk";
    width: 480px;
    preferred-height: dialog-layout.preferred-height;
    min-height: dialog-layout.preferred-height;
    background: Theme.background;

    in-out property <string> folder-name: "";
    in-out property <string> folder-path: "";

    callback acknowledged();

    forward-focus: dialog-focus;

    dialog-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.acknowledged();
                return accept;
            }
            return reject;
        }

        dialog-layout := VerticalLayout {
            width: root.width;
            padding: 0px;
            spacing: 0px;
            alignment: space-between;

            VerticalLayout {
                width: root.width;
                padding: 16px;
                spacing: 12px;
                vertical-stretch: 1;

                DialogHeading {
                    icon: IconId.status-warning;
                    text: "Folder Re-detected on Disk";
                    color: #f9e2af;
                }

                Text {
                    text: "The folder '" + root.folder-name + "' was previously marked as missing, but was detected on physical storage:";
                    font-size: 12px;
                    color: Theme.text;
                    wrap: word-wrap;
                }

                Rectangle {
                    background: Theme.surface-variant;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;

                        Text {
                            text: root.folder-path;
                            font-size: 11px;
                            color: Theme.primary;
                            wrap: word-wrap;
                        }
                    }
                }

                Text {
                    text: "Database purge was aborted. The folder has been automatically restored to active status in your library.";
                    font-size: 11px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
            }

            ButtonBar {
                vertical-stretch: 0;
                bar-height: 48px;
                show-ok: true;
                text-ok: "OK";
                ok-clicked => { root.acknowledged(); }
            }
        }
    }
}
