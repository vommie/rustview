import { IconId } from "icons.slint";
import { MultiviewTileView, MultiviewGutterView, MultiviewScreenView } from "multiview_types.slint";

export struct MediaItemView {
    id: int,
    /// Position of the item in the sorted list; the tile places itself by it.
    index: int,
    filename: string,
    path_str: string,
    modified_date_str: string,
    created_date_str: string,
    filesize_str: string,
    rating: int,
    rating_str: string,
    tags_count: int,
    tags_str: string,
    width_str: string,
    height_str: string,
    ar_str: string,
    duration_str: string,
    duration_badge_str: string,
    format_str: string,
    flags_str: string,
    has_tags: bool,
    thumbnail: image,
    is_selected: bool,
    is_video: bool,
    /// Hover preview frames of an animated picture are stored.
    is_animated: bool,
    is_corrupted: bool,
    is_deleted: bool,
    is_pending: bool,
    /// A subfolder of the open folder listed in the Browse view (`id` is negative), or the navigation entry "Up".
    is_folder: bool,
    is_folder_up: bool,
    /// States of a folder row that the thumbnail badges show (see `src/ui/thumbnail_badges/providers.rs`).
    folder_hidden: bool,
    folder_empty: bool,
    /// Direct subfolders that are missing on disk (flagged in the database).
    folder_missing_children: int,
}

export struct FolderNodeView {
    id: int,
    name: string,
    path: string,
    depth: int,
    has_children: bool,
    is_expanded: bool,
    is_selected: bool,
    is_deleted: bool,
    subfolder_count: int,
    file_count: int,
}

export struct FavoriteItemView {
    alias: string,
    original_folder: string,
    path: string,
    is_valid: bool,
    is_selected: bool,
}

export struct TagNodeView {
    id: int,
    name: string,
    depth: int,
    has_children: bool,
    is_expanded: bool,
    is_selected: bool,
    is_assigned: bool,
    is_partial: bool,
    is_dimmed: bool,
}

export struct TagColumnView {
    tags: [TagNodeView],
}

export struct TagHistoryItemModel {
    id: int,
    name: string,
    display_text: string,
    is_assigned: bool,
    is_partial: bool,
    is_bold: bool,
    is_italic: bool,
    width: length,
    tooltip: string,
}

export struct TagHistoryRowModel {
    items: [TagHistoryItemModel],
}

export struct ContextMenuItemModel {
    id: int,
    text: string,
    shortcut: string,
    /// Library icon shown in the leading icon slot (`IconId.none` = empty slot).
    icon: IconId,
    /// Image of an external application (system icon theme, e.g. "Open With" entries). Takes precedence over `icon`.
    app_icon: image,
    kind: int, // 0 = Action, 1 = Checkable, 2 = Radio, 3 = Separator, 4 = Header, 5 = Submenu
    is_checked: bool,
    is_enabled: bool,
    has_submenu: bool,
    submenu_depth: int,
    menu_index: int,
    tooltip: string,
    /// The entry acts only when held for `HoldConfirm.duration` (hold.slint).
    hold: bool,
}

export struct ContextMenuLevelModel {
    depth: int,
    active_menu_index: int,
    x: length,
    y: length,
    width: length,
    max_height: length,
    /// The height the level really has (its content, at most `max_height`): the video windows are cut out exactly there.
    height: length,
    items: [ContextMenuItemModel],
}

export struct ConflictFileView {
    filename: string,
    folder_path: string,
    filesize_str: string,
    dimensions_str: string,
    date_str: string,
    hash_str: string,
    thumbnail: image,
}

export struct TabItemModel {
    id: int,
    media_id: int,
    title: string,
    format_str: string,
    is_active: bool,
    /// Part of the multi-selection of tabs (Ctrl/Shift+click); the menu entries "Merge/Close Selected Tabs" act on these.
    is_selected: bool,
    icon: IconId,
    rating: int,
    has_tags: bool,
    shift_x: length,
    is_placeholder: bool,
    /// A picture of the tab has unsaved edits (a dot next to the title).
    has_unsaved: bool,
}

/// Dynamic Model for a single tile item positioned within the TabGridView Masonry layout.
export struct TabGridItemModel {
    id: int, // TabId
    media_id: int,
    title: string,
    format_str: string,
    is_video: bool,
    is_multiview: bool,
    /// Part of the multi-selection of tabs (Ctrl/Shift+click).
    is_selected: bool,
    /// A picture of the tab has unsaved edits (a dot next to the title).
    has_unsaved: bool,
    /// The keyboard mark of the grid is on this item (Settings > Hotkeys > Tab-Grid); it looks like the hover frame.
    is_marked: bool,
    icon: IconId,
    rating: int,
    has_tags: bool,
    image: image,
    // Multiview items: the miniature drawn by MultiviewCanvas (coordinates relative to the media canvas of the item)
    mv_tiles: [MultiviewTileView],
    mv_gutters: [MultiviewGutterView],
    mv_screen: MultiviewScreenView,
    is_loading: bool,
    error_message: string,
    orig_width: int,
    orig_height: int,
    x: length,
    y: length,
    width: length,
    height: length,
}

/// Dynamic Model representing an individual dock panel tab in a sidebar (e.g. Folders vs Favorites).
export struct SidebarPanelTabModel {
    id: string,
    title: string,
    icon: IconId,
    is_active: bool,
    shift_x: length,
    is_placeholder: bool,
}
