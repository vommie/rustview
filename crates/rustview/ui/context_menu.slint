import { Theme } from "styles.slint";
import { AppIcon, IconId, IconSlot, IconSize } from "icons.slint";
import { ContextMenuItemModel, ContextMenuLevelModel } from "types.slint";
import { TooltipArea, TooltipHost } from "tooltips.slint";
import { SmoothScrollArea } from "smooth_scroll_view.slint";
import { HoldConfirm, HoldLogic, HoldRing } from "hold.slint";

export component ContextMenuItemRow inherits Rectangle {
    in property <ContextMenuItemModel> item;
    in property <bool> is-parent-active: false;
    callback clicked();
    callback scrolled(length /* delta_x */, length /* delta_y */);
    callback row-hovered(bool /* is_hover */, length /* y_pos */, int /* menu_index */, bool /* has_sub */);

    property <bool> usable: root.item.is-enabled && root.item.kind != 3 && root.item.kind != 4;

    height: (root.item.kind == 3) ? 7px : ((root.item.kind == 4) ? 22px : 28px);
    background: (!root.item.is-enabled || root.item.kind == 3 || root.item.kind == 4)
        ? transparent
        : ((item-touch.has-hover || root.is-parent-active) ? Theme.surface-hover : transparent);
    border-radius: 4px;
    clip: root.item.hold;

    tooltip-host := TooltipHost {
        text: root.item.tooltip;
        hold: root.item.hold && root.usable;
        is-enabled: (root.item.tooltip != "" || (root.item.hold && root.usable)) && root.item.kind != 3;
        in-menu: true;
        delay: 350ms;
    }

    // A held entry acts only after `HoldConfirm.duration`; a short click wiggles it and shows the tooltip with the hold badge.
    hold-logic := HoldLogic {
        pressed: item-touch.pressed;
        enabled: root.usable && !root.item.has-submenu;
        hold: root.item.hold;
        confirmed => {
            tooltip-host.on-hover-leave();
            root.clicked();
        }
        short-click => {
            tooltip-host.reveal(item-touch.mouse-x, item-touch.mouse-y);
        }
    }

    if root.item.hold : HoldRing {
        progress: hold-logic.progress;
        flash: hold-logic.flash;
        ring: false;
        border-radius: root.border-radius;
    }

    item-touch := TouchArea {
        enabled: true;
        mouse-cursor: (root.item.kind == 3 || root.item.kind == 4) ? default : (
            !root.item.is-enabled ? not-allowed : pointer
        );

        scroll-event(event) => {
            root.scrolled(event.delta-x, event.delta-y);
            return accept;
        }

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                tooltip-host.on-hover-leave();
                hold-logic.pressed-down();
            }
        }
        clicked => {
            if root.item.hold && !root.item.has-submenu {
                hold-logic.released-click();
                return;
            }
            if root.usable {
                tooltip-host.on-hover-leave();
                root.clicked();
            }
        }
        moved => {
            tooltip-host.on-mouse-move(self.mouse-x, self.mouse-y);
        }
    }

    property <bool> is-hovered: item-touch.has-hover;
    changed is-hovered => {
        if self.is-hovered {
            if (root.item.tooltip != "" || root.item.hold) && root.item.kind != 3 {
                tooltip-host.on-hover-enter(item-touch.mouse-x, item-touch.mouse-y);
            }
            root.row-hovered(true, root.y, root.item.menu-index, root.item.has-submenu);
        } else {
            tooltip-host.on-hover-leave();
        }
    }

    // Separator Line
    if root.item.kind == 3 : Rectangle {
        y: 3px;
        height: 1px;
        background: Theme.border;
    }

    // Header Label with Sticky-Prefix Truncation and Hover Tooltip
    if root.item.kind == 4 : TooltipArea {
        width: 100%;
        height: 100%;
        text: root.item.tooltip != "" ? root.item.tooltip : root.item.text;
        tooltip-enabled: root.item.tooltip != "";
        in-menu: true;
        delay: 350ms;

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            alignment: start;

            Text {
                text: root.item.text;
                font-size: 10px;
                font-weight: 700;
                color: Theme.primary;
                vertical-alignment: center;
                horizontal-alignment: left;
                overflow: elide;
            }
        }
    }

    // Mark shown in the leading slot of checked checkable/radio rows
    property <bool> shows-mark: root.item.is-checked && (root.item.kind == 1 || root.item.kind == 2);
    property <IconId> slot-icon: root.shows-mark
        ? (root.item.kind == 1 ? IconId.check : IconId.point)
        : root.item.icon;
    property <color> slot-color: !root.item.is-enabled
        ? Theme.text-muted.transparentize(0.55)
        : hold-logic.progress > 0 ? HoldConfirm.color.mix(Theme.text, hold-logic.progress)
        : (root.shows-mark ? Theme.primary : ((item-touch.has-hover || root.is-parent-active) ? Theme.text : Theme.text-muted));

    // Standard Action / Checkable / Submenu Row: [icon slot] [label] [shortcut] [submenu chevron]
    if root.item.kind != 3 && root.item.kind != 4 : HorizontalLayout {
        x: hold-logic.nudge;
        width: parent.width;
        height: parent.height;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: start;

        // Leading icon slot: reserved on EVERY row, so all labels start at the same x position.
        // External application icons (system icon theme) take precedence over library icons.
        if root.item.app_icon.width > 0 && !root.shows-mark : Rectangle {
            width: IconSize.md;
            horizontal-stretch: 0;

            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: IconSize.md;
                height: IconSize.md;
                source: root.item.app_icon;
                image-fit: contain;
            }
        }

        if root.item.app_icon.width == 0 || root.shows-mark : IconSlot {
            icon: root.slot-icon;
            color: root.slot-color;
            size: IconSize.md;
            slot-width: IconSize.md;
        }

        Text {
            text: root.item.text;
            color: !root.item.is-enabled ? Theme.text-muted
                : hold-logic.progress > 0 ? HoldConfirm.color.mix(Theme.text, hold-logic.progress)
                : Theme.text;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: left;
            horizontal-stretch: 1;
            overflow: elide;
        }

        if root.item.shortcut != "" : Text {
            text: root.item.shortcut;
            color: Theme.text-muted;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }

        if root.item.has-submenu : IconSlot {
            icon: IconId.chevron-right;
            color: Theme.text-muted;
            size: IconSize.sm;
            slot-width: IconSize.sm;
        }
    }
}

export component ContextMenuPopup inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    z: 160;

    in property <[ContextMenuLevelModel]> levels: [];

    callback item-clicked(int);
    callback request-submenu(int /* depth */, length /* visible_row_y */, int /* menu_index */);
    callback close-submenus-above(int /* depth */);
    callback dismissed();
    /// A click outside the menu (at its press position): the menu closes and the click goes on to what is under the pointer.
    callback outside-clicked(length /* x */, length /* y */, PointerEventButton);

    property <int> pending-depth: -1;
    property <length> pending-row-y: 0px;
    property <int> pending-menu-idx: 0;

    submenu-timer := Timer {
        interval: 160ms;
        running: false;
        triggered => {
            self.running = false;
            if root.pending-depth >= 0 {
                root.request-submenu(root.pending-depth, root.pending-row-y, root.pending-menu-idx);
                root.pending-depth = -1;
            }
        }
    }

    forward-focus: popup-focus;
    popup-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismissed();
                return accept;
            }
            return reject;
        }
    }

    // Reports the click on release, so the replayed click (press and release) never meets the real release of this one.
    // The press position is kept here: `pressed-x`/`pressed-y` of a TouchArea follow the left button only.
    backdrop-touch := TouchArea {
        property <length> press-x: 0px;
        property <length> press-y: 0px;
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                self.press-x = self.mouse-x;
                self.press-y = self.mouse-y;
            } else if event.kind == PointerEventKind.up {
                root.outside-clicked(self.press-x, self.press-y, event.button);
            } else if event.kind == PointerEventKind.cancel {
                root.dismissed();
            }
        }
    }

    for level[depth] in root.levels : Rectangle {
        // Snap to whole physical pixels so borders, text and icons are never resampled
        x: Math.round(level.x / 1phx) * 1phx;
        y: Math.round(level.y / 1phx) * 1phx;
        width: level.width;
        height: Math.min(level.max_height, level-layout.preferred-height);
        background: Theme.surface;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000bb;
        clip: true;

        scroll-area := SmoothScrollArea {
            width: 100%;
            height: 100%;
            enable-horizontal: false;
            enable-vertical: true;
            scrollbar-size: 5px;
            scrollbar-padding: 2px;
            content-width: self.width;
            content-height: level-layout.preferred-height;

            level-layout := VerticalLayout {
                padding: 4px;
                spacing: 1px;

                for item in level.items : ContextMenuItemRow {
                    item: item;
                    is-parent-active: item.is-checked && item.has-submenu;

                    scrolled(dx, dy) => {
                        submenu-timer.running = false;
                        root.pending-depth = -1;
                        if root.levels.length > depth + 1 {
                            root.request-submenu(depth, 0px, 0);
                        }
                        scroll-area.handle-scroll(dx, dy);
                    }

                    row-hovered(is-hover, row-y, m-idx, has-sub) => {
                        if is-hover {
                            if !has-sub {
                                submenu-timer.running = false;
                                root.pending-depth = -1;
                                if root.levels.length > depth + 1 {
                                    root.request-submenu(depth, 0px, 0);
                                }
                            } else {
                                if !item.is-checked {
                                    root.pending-depth = depth;
                                    root.pending-row-y = row-y + scroll-area.clamped-y;
                                    root.pending-menu-idx = m-idx;
                                    submenu-timer.running = true;
                                }
                            }
                        }
                    }

                    clicked => {
                        if !item.has-submenu {
                            root.item-clicked(item.id);
                        }
                    }
                }
            }
        }
    }
}
