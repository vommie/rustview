import { ComboBox, Slider } from "std-widgets.slint";
import { Theme } from "styles.slint";
import { BulletItem } from "bullet_item.slint";
import { SettingsCard } from "settings_card.slint";
import { SettingsOptionRow, SettingsSwitchRow } from "settings_option_row.slint";
import { ColorSwatchButton } from "color_picker.slint";
import { SettingsCardAbRepeat } from "settings_card_ab_repeat.slint";
import { SettingsCardDisplays } from "settings_card_displays.slint";
import { SettingsCardImageZoom } from "settings_card_image_zoom.slint";
import { SettingsCardJumpKeys } from "settings_card_jump_keys.slint";
import { SettingsCardSelectedMedium } from "settings_card_selected_medium.slint";
import { SettingsCardPlayer, PlayerBarLimits } from "settings_card_player.slint";

/// Settings > Multiview: everything about the view that shows media (fullscreen and tabs), the video player included,
/// because videos play only there. The values live in the `fullscreen` and `viewer.videos` sections of settings.json.
export component SettingsPageMultiview inherits VerticalLayout {
    spacing: 12px;

    in property <[string]> display-options: [];
    in-out property <int> selected-display-idx: 0;
    in-out property <bool> enable-specific-monitor: false;
    in-out property <bool> enable-fallback-rule: false;
    in-out property <int> fallback-target-idx: 0; // 0 = Same display as Main UI, 1 = Different display from Main UI

    // Action bar
    in-out property <bool> media-bar-enabled: true;
    in-out property <bool> media-bar-show-mute: true;
    in-out property <bool> media-bar-show-sticky: true;
    in-out property <bool> media-bar-show-duplicate: true;
    in-out property <bool> media-bar-show-open-as-tab: true;
    in-out property <bool> media-bar-show-open-with: true;
    in-out property <bool> media-bar-show-zoom: true;
    in-out property <bool> media-bar-show-crop: true;
    in-out property <bool> media-bar-show-delete: true;
    in-out property <bool> media-bar-show-remove: true;
    in-out property <int> media-bar-reveal-distance-px: 15;

    // Primary action bar
    in-out property <bool> primary-bar-enabled: true;
    in-out property <bool> primary-bar-show-send-to-tab: true;
    in-out property <bool> primary-bar-show-close: true;
    in-out property <bool> primary-bar-show-mute-all: true;
    in-out property <bool> primary-bar-show-play-pause-all: true;
    in-out property <bool> primary-bar-show-reset-layout: true;
    in-out property <bool> primary-bar-show-hide-cursor: true;
    in-out property <bool> primary-bar-show-pin: true;
    in-out property <int> primary-bar-reveal-distance-px: 15;
    in-out property <bool> hide-idle-cursor: false;
    in-out property <int> idle-cursor-secs: 3;
    in-out property <bool> hide-selection-with-cursor: true;

    // Selected medium
    in-out property <int> selection-brighten-idx: 2; // 0 = off, 1 = weak, 2 = medium, 3 = strong
    in-out property <int> selection-corner-idx: 1; // 0 = short, 1 = medium, 2 = long

    // Image zoom
    in-out property <int> zoom-step-percent: 15;
    in-out property <int> zoom-max-percent: 1000;
    in-out property <int> zoom-out-percent: 200;
    in-out property <int> zoom-minimap-secs: 3;
    in-out property <bool> zoom-smooth: true;
    in-out property <int> zoom-minimap-idx: 0; // 0 = bottom left, 1 = bottom right
    in-out property <bool> zoom-minimap-always: false;
    in-out property <int> zoom-resample-idx: 0; // 0 = Lanczos, 1 = Catmull-Rom, 2 = Bilinear, 3 = Nearest neighbor

    // Sound
    in-out property <bool> sound-auto-control: true;
    in-out property <int> sound-follows-idx: 0; // 0 = first video, 1 = newest video, 2 = selected video, 3 = nobody
    in-out property <bool> sound-hand-over: true;

    // Rating
    in-out property <bool> rating-show-feedback: true;
    // Player (the control bar of a video)
    in-out property <int> player-style-idx: 0; // 0 = translucent bar, 1 = floating pill
    in-out property <int> player-opacity-percent: 70;
    in-out property <int> player-height-px: 30;
    in-out property <int> player-reveal-idx: 0; // 0 = near the bottom, 1 = any movement over the video
    in-out property <bool> player-fade: true;
    in-out property <bool> player-show-ms: false;
    in-out property <int> player-seek-idx: 0;
    in property <PlayerBarLimits> player-limits;
    // Jump keys of the video player
    in-out property <int> video-jump-secs: 5;
    in-out property <int> video-jump-long-secs: 60;
    // The mpv script ab_repeat.lua (`settings_card_ab_repeat.slint`).
    in-out property <bool> ab-enabled: true;
    in-out property <bool> ab-osd-messages: true;
    in-out property <int> ab-colors-idx: 0;
    in-out property <bool> ab-click-loads: true;
    in-out property <bool> ab-hover-name: true;
    in-out property <bool> ab-hover-times: false;
    in-out property <bool> ab-drag-flags: true;
    in-out property <int> ab-menu-idx: 0;
    in-out property <int> ab-page-size: 10;
    in property <string> ab-status-text;
    in property <int> ab-status-level;
    in property <string> ab-status-tooltip;
    in property <bool> ab-checking;
    callback ab-check-again();
    // The rating keys as the description names them (Settings > Hotkeys).
    in property <string> rating-keys: "the rating keys";

    // Background
    in-out property <int> background-source-idx: 0; // 0 = theme, 1 = same as viewer, 2 = custom color
    in-out property <color> background-color: Theme.fullscreen-background;

    callback refresh-displays();
    // The user wants to choose the custom background color (Rust opens the color picker window).
    callback pick-background-color();

    Text {
        text: "The Multiview is where RustView shows media: one to four images and videos side by side, in the fullscreen or in a tab. Videos play only there, so the video player is set up on this page too.";
        color: Theme.text-muted;
        font-size: 12px;
        wrap: word-wrap;
    }

    SettingsCardDisplays {
        display-options: root.display-options;
        selected-display-idx <=> root.selected-display-idx;
        enable-specific-monitor <=> root.enable-specific-monitor;
        enable-fallback-rule <=> root.enable-fallback-rule;
        fallback-target-idx <=> root.fallback-target-idx;
        refresh-displays => { root.refresh-displays(); }
    }

    SettingsCard {
        title: "Media Action Bar";
        description: "The buttons in the top-right corner of a medium in fullscreen.";

        SettingsSwitchRow {
            label: "Show the media action bar";
            tooltip: "Show a small bar of buttons in the corner of a medium when the pointer comes close to it.";
            checked <=> root.media-bar-enabled;
        }

        SettingsOptionRow {
            label: "Reveal distance";
            description: "How close the pointer must come before the bar appears. 0 = only directly on the bar.";
            tooltip: "The bar stays hidden while you watch. It appears when the pointer is within this many pixels of the place where the bar would be.";
            enabled: root.media-bar-enabled;

            HorizontalLayout {
                spacing: 8px;

                Slider {
                    width: 140px;
                    minimum: 0;
                    maximum: 100;
                    enabled: root.media-bar-enabled;
                    value: root.media-bar-reveal-distance-px;
                    changed(v) => { root.media-bar-reveal-distance-px = Math.round(v); }
                }

                Text {
                    text: root.media-bar-reveal-distance-px + " px";
                    color: root.media-bar-enabled ? Theme.primary : Theme.text-muted;
                    width: 46px;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }
        }

        Text {
            text: "Buttons";
            color: Theme.text-muted;
            font-size: 11px;
            font-weight: 700;
        }

        SettingsSwitchRow {
            indent: 12px;
            label: "Mute";
            tooltip: "Mute or unmute a video. Shown on videos only.";
            enabled: root.media-bar-enabled;
            checked <=> root.media-bar-show-mute;
        }

        SettingsSwitchRow {
            indent: 12px;
            label: "Sticky";
            tooltip: "Keep a medium in view when the selection changes. Shown when the fullscreen follows the selection of the media view.";
            enabled: root.media-bar-enabled;
            checked <=> root.media-bar-show-sticky;
        }

        SettingsSwitchRow {
            indent: 12px;
            label: "Duplicate";
            tooltip: "Show the medium a second time, as a tile of its own next to the original. Disabled while the view already shows the maximum number of media.";
            enabled: root.media-bar-enabled;
            checked <=> root.media-bar-show-duplicate;
        }

        SettingsSwitchRow {
            indent: 12px;
            label: "Open in a background tab";
            tooltip: "Open the medium in a viewer tab of its own, without leaving the fullscreen.";
            enabled: root.media-bar-enabled;
            checked <=> root.media-bar-show-open-as-tab;
        }

        SettingsSwitchRow {
            indent: 12px;
            label: "Open with...";
            tooltip: "A drop-down with the applications that can open the medium, like Open With in the context menu of a medium.";
            enabled: root.media-bar-enabled;
            checked <=> root.media-bar-show-open-with;
        }

        SettingsSwitchRow {
            indent: 12px;
            label: "Zoom";
            tooltip: "A button with a zoom slider, for pictures and videos. Ctrl + mouse wheel over a medium zooms without the button.";
            enabled: root.media-bar-enabled;
            checked <=> root.media-bar-show-zoom;
        }

        SettingsSwitchRow {
            indent: 12px;
            label: "Crop";
            tooltip: "A button that opens the crop tool on images. Save, Undo and Redo appear by themselves while a picture has unsaved changes.";
            enabled: root.media-bar-enabled;
            checked <=> root.media-bar-show-crop;
        }

        SettingsSwitchRow {
            indent: 12px;
            label: "Delete";
            tooltip: "Delete the medium (to the trash or permanently), after the usual confirmation. The delete key (Settings > Hotkeys) does the same for the selected medium.";
            enabled: root.media-bar-enabled;
            checked <=> root.media-bar-show-delete;
        }

        SettingsSwitchRow {
            indent: 12px;
            label: "Remove / Close";
            description: "Removes a medium from the view; on the last medium it closes the fullscreen (or the tab).";
            tooltip: "Remove the medium from the view. Closes the fullscreen or tab instead when it is the last medium. Esc always closes the fullscreen.";
            enabled: root.media-bar-enabled;
            checked <=> root.media-bar-show-remove;
        }
    }

    SettingsCard {
        title: "Primary Action Bar";
        description: "The buttons for the whole view in the top-left corner of the fullscreen and of a Multiview tab.";

        SettingsSwitchRow {
            label: "Show the primary action bar";
            tooltip: "Show a small bar of view-wide buttons in the top-left corner when the pointer comes close to it.";
            checked <=> root.primary-bar-enabled;
        }

        SettingsOptionRow {
            label: "Reveal distance";
            description: "How close the pointer must come before the bar appears. 0 = only directly on the bar.";
            tooltip: "The bar stays hidden while you watch. It appears when the pointer is within this many pixels of the place where the bar would be.";
            enabled: root.primary-bar-enabled;

            HorizontalLayout {
                spacing: 8px;

                Slider {
                    width: 140px;
                    minimum: 0;
                    maximum: 100;
                    enabled: root.primary-bar-enabled;
                    value: root.primary-bar-reveal-distance-px;
                    changed(v) => { root.primary-bar-reveal-distance-px = Math.round(v); }
                }

                Text {
                    text: root.primary-bar-reveal-distance-px + " px";
                    color: root.primary-bar-enabled ? Theme.primary : Theme.text-muted;
                    width: 46px;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }
        }

        Text {
            text: "Buttons";
            color: Theme.text-muted;
            font-size: 11px;
            font-weight: 700;
        }

        SettingsSwitchRow {
            indent: 12px;
            label: "Send this view to a background tab";
            tooltip: "Turn the whole fullscreen into a tab and close the fullscreen. Only shown in a fullscreen that follows the media view.";
            enabled: root.primary-bar-enabled;
            checked <=> root.primary-bar-show-send-to-tab;
        }

        SettingsSwitchRow {
            indent: 12px;
            label: "Close fullscreen / tab";
            tooltip: "Close the fullscreen, or the tab when the Multiview is shown in a tab. Esc always closes an unpinned fullscreen.";
            enabled: root.primary-bar-enabled;
            checked <=> root.primary-bar-show-close;
        }

        SettingsSwitchRow {
            indent: 12px;
            label: "Mute / unmute all videos";
            tooltip: "Mutes all videos, or unmutes them all when every video is muted. Shown when the Multiview has at least two videos.";
            enabled: root.primary-bar-enabled;
            checked <=> root.primary-bar-show-mute-all;
        }

        SettingsSwitchRow {
            indent: 12px;
            label: "Play / pause all videos";
            tooltip: "Pauses all videos, or starts them all when every video is paused. Shown while the Multiview has a video.";
            enabled: root.primary-bar-enabled;
            checked <=> root.primary-bar-show-play-pause-all;
        }

        SettingsSwitchRow {
            indent: 12px;
            label: "Reset the arrangement";
            tooltip: "Sets all resizers back to the automatic arrangement. Shown with two or more media; disabled while nothing was resized.";
            enabled: root.primary-bar-enabled;
            checked <=> root.primary-bar-show-reset-layout;
        }

        SettingsSwitchRow {
            indent: 12px;
            label: "Button: hide the idle mouse cursor";
            tooltip: "A switch for the setting below, so you can change it without opening the settings.";
            enabled: root.primary-bar-enabled;
            checked <=> root.primary-bar-show-hide-cursor;
        }

        SettingsSwitchRow {
            indent: 12px;
            label: "Pin the fullscreen";
            description: "While pinned, the fullscreen cannot be closed by Esc, double click or its buttons.";
            tooltip: "Locks the fullscreen against closing by accident. Every attempt to close it makes the bar appear and the pin blink.";
            enabled: root.primary-bar-enabled;
            checked <=> root.primary-bar-show-pin;
        }

        Text {
            text: "Mouse cursor";
            color: Theme.text-muted;
            font-size: 11px;
            font-weight: 700;
        }

        SettingsSwitchRow {
            indent: 12px;
            label: "Hide the mouse cursor when it rests";
            tooltip: "Hides the cursor over the Multiview (fullscreen and tab) after it has not moved for the time below. It shows again when it moves and is never hidden over other windows. The marks of the selected medium can go with it (below). The button of the primary bar changes this setting too.";
            checked <=> root.hide-idle-cursor;
        }

        SettingsOptionRow {
            indent: 12px;
            label: "Hide after";
            tooltip: "How long the mouse cursor has to rest before it is hidden.";
            enabled: root.hide-idle-cursor;

            HorizontalLayout {
                spacing: 8px;

                Slider {
                    width: 140px;
                    minimum: 1;
                    maximum: 30;
                    enabled: root.hide-idle-cursor;
                    value: root.idle-cursor-secs;
                    changed(v) => { root.idle-cursor-secs = Math.round(v); }
                }

                Text {
                    text: root.idle-cursor-secs + " s";
                    color: root.hide-idle-cursor ? Theme.primary : Theme.text-muted;
                    width: 46px;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }
        }

        SettingsSwitchRow {
            indent: 12px;
            label: "Hide the selection marks too";
            tooltip: "While the resting mouse cursor is hidden, the marks of the selected medium are hidden as well. They show again with the cursor; the keys still act on the selected medium, and a key that does shows them for a moment.";
            enabled: root.hide-idle-cursor;
            checked <=> root.hide-selection-with-cursor;
        }
    }

    SettingsCardImageZoom {
        step-percent <=> root.zoom-step-percent;
        max-percent <=> root.zoom-max-percent;
        out-percent <=> root.zoom-out-percent;
        minimap-secs <=> root.zoom-minimap-secs;
        smooth <=> root.zoom-smooth;
        minimap-idx <=> root.zoom-minimap-idx;
        minimap-always <=> root.zoom-minimap-always;
        resample-idx <=> root.zoom-resample-idx;
    }

    SettingsCardSelectedMedium {
        brighten-idx <=> root.selection-brighten-idx;
        corner-idx <=> root.selection-corner-idx;
    }

    SettingsCardPlayer {
        style-idx <=> root.player-style-idx;
        opacity-percent <=> root.player-opacity-percent;
        height-px <=> root.player-height-px;
        reveal-idx <=> root.player-reveal-idx;
        fade <=> root.player-fade;
        show-ms <=> root.player-show-ms;
        seek-idx <=> root.player-seek-idx;
        limits: root.player-limits;
    }

    SettingsCardJumpKeys {
        jump-secs <=> root.video-jump-secs;
        jump-long-secs <=> root.video-jump-long-secs;
    }

    SettingsCardAbRepeat {
        enabled <=> root.ab-enabled;
        osd-messages <=> root.ab-osd-messages;
        colors-idx <=> root.ab-colors-idx;
        click-loads <=> root.ab-click-loads;
        hover-name <=> root.ab-hover-name;
        hover-times <=> root.ab-hover-times;
        drag-flags <=> root.ab-drag-flags;
        menu-idx <=> root.ab-menu-idx;
        page-size <=> root.ab-page-size;
        status-text: root.ab-status-text;
        status-level: root.ab-status-level;
        status-tooltip: root.ab-status-tooltip;
        checking: root.ab-checking;
        check-again => { root.ab-check-again(); }
    }

    SettingsCard {
        title: "Sound";
        description: "Which videos are muted automatically while several videos are shown. A mute you set yourself is never changed.";

        SettingsSwitchRow {
            label: "Automatic sound control";
            tooltip: "Mute surplus videos automatically so that only one video plays sound at a time. When off, every video keeps its own sound state.";
            checked <=> root.sound-auto-control;
        }

        SettingsOptionRow {
            label: "The sound belongs to";
            tooltip: "First video: the leftmost video plays, videos that join start muted. Newest video: a video that joins takes the sound. Selected video: the video you select takes the sound (the leftmost until you select one). Nobody: every video starts muted.";
            enabled: root.sound-auto-control;

            ComboBox {
                width: 220px;
                enabled: root.sound-auto-control;
                model: ["The first video (leftmost)", "The newest video", "The selected video", "Nobody (all muted)"];
                current-index <=> root.sound-follows-idx;
            }
        }

        SettingsSwitchRow {
            indent: 12px;
            label: "Pass the sound on when its video leaves";
            tooltip: "When the video that plays sound is removed or deleted, the next video takes over instead of the view falling silent.";
            enabled: root.sound-auto-control && root.sound-follows-idx != 3;
            checked <=> root.sound-hand-over;
        }

        Rectangle {
            background: #89b4fa12;
            border-radius: 4px;
            border-width: 1px;
            border-color: #89b4fa33;

            VerticalLayout {
                padding: 8px;
                spacing: 3px;

                Text {
                    text: "Active Behavior:";
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.primary;
                }

                BulletItem {
                    text: !root.sound-auto-control
                        ? "Nothing is muted automatically: every video starts with its own sound state."
                        : (root.sound-follows-idx == 0
                            ? ("The leftmost video plays sound, the others start muted. A video that joins starts muted" + (root.sound-hand-over ? ", unless nothing plays; when the video with sound leaves, the next one takes over." : ", unless nothing plays."))
                            : (root.sound-follows-idx == 1
                                ? ("The leftmost video plays sound when the fullscreen opens. A video that joins takes the sound; the others are muted" + (root.sound-hand-over ? ", and the sound passes on when its video leaves." : "."))
                                : (root.sound-follows-idx == 2
                                    ? ("The leftmost video plays sound until you select a video; the selected video then takes the sound and the others are muted (a mute you set yourself stays)" + (root.sound-hand-over ? ". When the video with sound leaves, the next one takes over." : "."))
                                    : "Every video starts muted. Unmute one with its button in the media action bar or with the M key.")));
                    color: Theme.text-muted;
                }
            }
        }
    }

    SettingsCard {
        title: "Rating";
        description: "Rate the selected medium with " + root.rating-keys + ", in the fullscreen and in tabs (a single medium needs no selection).";

        SettingsSwitchRow {
            label: "Show the rating animation";
            tooltip: "The icon of the new rating appears in the middle of the rated medium and fades out after about a second. The rating itself is always saved, whatever this is set to.";
            checked <=> root.rating-show-feedback;
        }
    }

    SettingsCard {
        title: "Background";
        description: "The color behind the media in fullscreen.";

        SettingsOptionRow {
            label: "Fullscreen background";
            tooltip: "Theme: the background color of the app theme. Same as viewer: the background chosen under Viewer. Custom color: pick any color.";

            ComboBox {
                width: 220px;
                model: ["Theme (automatic)", "Same as viewer background", "Custom color"];
                current-index <=> root.background-source-idx;
            }
        }

        SettingsOptionRow {
            indent: 12px;
            label: "Custom color";
            tooltip: "Click to open the color picker. The color applies to the next fullscreen and to one that is open once you save.";
            enabled: root.background-source-idx == 2;

            ColorSwatchButton {
                value: root.background-color;
                enabled: root.background-source-idx == 2;
                tooltip: "Choose the fullscreen background color";
                clicked => {
                    root.pick-background-color();
                }
            }
        }
    }
}
