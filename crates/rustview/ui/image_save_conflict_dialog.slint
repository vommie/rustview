import { Button } from "std-widgets.slint";
import { Theme } from "styles.slint";
import { IconId } from "icons.slint";
import { DialogHeading } from "dialog_heading.slint";
import { DialogBody } from "dialog_body.slint";

/// One answer of the question (Rust defines them).
export struct ImageChoiceView {
    code: int,
    label: string,
    // The safe answer: drawn as the main button, Enter chooses it.
    primary: bool,
    // The answer that overwrites something: drawn in the warning color.
    destructive: bool,
}

/// Asks what to do when an edited picture cannot simply be written: the file changed on disk, it is gone, it is read-only or
/// writing failed. The answers come from Rust (`image_edit::conflict::conflict_prompt` and the save flow).
export component ImageSaveConflictDialog inherits Window {
    title: "RustView - Save Picture";
    width: 520px;
    preferred-height: dialog-layout.preferred-height;
    min-height: dialog-layout.min-height;
    background: Theme.background;

    in property <string> heading: "";
    in property <string> message: "";
    // The file the question is about (folder and name, shown small).
    in property <string> detail: "";
    in property <[ImageChoiceView]> choices;
    // The answer Esc gives (the cancel answer) and the one Enter gives (the primary answer).
    in property <int> cancel-code: 3;
    in property <int> primary-code: 1;

    callback chosen(int /* code */);

    forward-focus: dialog-focus;

    dialog-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.chosen(root.cancel-code);
                return accept;
            }
            if event.text == Key.Return {
                root.chosen(root.primary-code);
                return accept;
            }
            return reject;
        }

        dialog-layout := VerticalLayout {
            width: root.width;
            padding: 0px;
            spacing: 0px;

            body := DialogBody {
                content-height: content.preferred-height;

                content := VerticalLayout {
                    width: body.width;
                    height: self.preferred-height;
                    padding: 18px;
                    spacing: 10px;

                    DialogHeading {
                        icon: IconId.status-warning;
                        text: root.heading;
                        color: #fab387;
                    }

                    Text {
                        text: root.message;
                        font-size: 12px;
                        color: Theme.text;
                        wrap: word-wrap;
                    }

                    if root.detail != "" : Text {
                        text: root.detail;
                        font-size: 11px;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            Rectangle {
                background: Theme.surface;

                HorizontalLayout {
                    padding: 12px;
                    spacing: 8px;
                    alignment: end;

                    for choice in root.choices : Button {
                        text: choice.label;
                        primary: choice.primary;
                        clicked => {
                            root.chosen(choice.code);
                        }
                    }
                }
            }
        }
    }
}
