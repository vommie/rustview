import { Theme } from "styles.slint";
import { AppIcon, IconId, IconLookup, IconSize, IconSlot } from "icons.slint";
import { TabGridItemModel } from "types.slint";
import { MultiviewCanvas } from "multiview_canvas.slint";
import { AwayBadge } from "fullscreen_away.slint";

/// Standalone Masonry Tile item for the TabGridView.
/// Displays live loaded image buffers or solid video subwindow placeholders with full aspect ratio preservation.
export component TabGridItemView inherits Rectangle {
    in property <TabGridItemModel> item;
    in property <length> padding-h: 8px;
    in property <length> padding-v: 6px;
    in property <length> border-width-val: 1px;
    in property <length> corner-radius-val: 4px;
    in property <int> background-mode: 0;
    /// The content of this tab is shown in the fullscreen window: its videos are not here, and say so.
    in property <bool> away: false;

    callback left-clicked(int /* tab_id */);
    /// A click with Ctrl or Shift: selects the tab together with others instead of showing it.
    callback selection-clicked(int /* tab_id */, bool /* ctrl */, bool /* shift */);
    callback middle-clicked(int /* tab_id */);
    callback close-clicked(int /* tab_id */);
    callback context-menu-requested(int /* tab_id */, length /* x */, length /* y */);

    x: root.item.x;
    y: root.item.y;
    width: root.item.width;
    height: root.item.height;

    background: (tile-touch.has-hover || root.item.is-selected) ? Theme.surface-hover : Theme.surface;
    border-width: root.item.is-selected ? Math.max(2px, root.border-width-val) : (tile-touch.has-hover ? Math.max(1.5px, root.border-width-val) : root.border-width-val);
    border-color: root.item.is-selected ? Theme.accent : (tile-touch.has-hover ? Theme.primary : Theme.border);
    border-radius: root.corner-radius-val;
    clip: true;

    tile-touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                if event.button == PointerEventButton.left {
                    if event.modifiers.control || event.modifiers.shift {
                        root.selection-clicked(root.item.id, event.modifiers.control, event.modifiers.shift);
                    } else {
                        root.left-clicked(root.item.id);
                    }
                } else if event.button == PointerEventButton.middle {
                    root.middle-clicked(root.item.id);
                } else if event.button == PointerEventButton.right {
                    root.context-menu-requested(root.item.id, self.mouse-x, self.mouse-y);
                }
            }
        }
    }

    VerticalLayout {
        padding-left: root.padding-h;
        padding-right: root.padding-h;
        padding-top: root.padding-v;
        padding-bottom: root.padding-v;
        spacing: 4px;

        // 1. Top Media Header Bar
        Rectangle {
            height: 22px;
            vertical-stretch: 0;
            background: transparent;

            HorizontalLayout {
                spacing: 4px;
                alignment: space-between;

                // Left: Format Icon + Title
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    horizontal-stretch: 1;

                    IconSlot {
                        icon: root.item.icon;
                        size: IconSize.md;
                        color: Theme.primary;
                    }

                    Text {
                        text: root.item.title;
                        font-size: 11px;
                        font-weight: 700;
                        color: Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                // Right: Rating & Close Button
                HorizontalLayout {
                    spacing: 4px;
                    alignment: end;
                    horizontal-stretch: 0;

                    if root.item.rating > 0 : IconSlot {
                        icon: IconLookup.rating(root.item.rating);
                        size: IconSize.md;
                    }

                    Rectangle {
                        width: 16px;
                        height: 16px;
                        border-radius: 8px;
                        y: (parent.height - self.height) / 2;
                        background: close-touch.has-hover ? #f38ba833 : transparent;

                        close-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.close-clicked(root.item.id);
                            }
                        }

                        AppIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            icon: IconId.close;
                            size: IconSize.xs;
                            color: close-touch.has-hover ? #f38ba8 : Theme.text-muted;
                        }
                    }
                }
            }
        }

        // 2. Center Media Canvas / Placeholder Area
        Rectangle {
            vertical-stretch: 1;
            background: #000000;
            border-radius: Math.max(0px, root.corner-radius-val - 2px);
            clip: true;

            if root.item.error-message != "" : VerticalLayout {
                alignment: center;
                spacing: 6px;

                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: 22px;
                        background: Theme.corrupt-bg;
                        border-width: 1px;
                        border-color: #f38ba844;

                        AppIcon {
                            icon: IconId.status-warning;
                            size: IconSize.xl;
                            color: Theme.status-corrupt;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                Text {
                    text: "File Not Found";
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.status-corrupt;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.item.error-message;
                    font-size: 9px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    overflow: elide;
                    max-width: root.item.width - 24px;
                }
            }

            if !root.item.is-video && !root.item.is-multiview && root.item.image.width > 0 && root.item.error-message == "" : Image {
                source: root.item.image;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }

            if !root.item.is-video && !root.item.is-multiview && root.item.image.width == 0 && root.item.error-message == "" : AppIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                icon: IconId.media-image;
                size: IconSize.xl;
                color: Theme.text-muted;
            }

            // Multiview: the miniature of the fullscreen arrangement. Its video tiles are native mpv windows that Rust places
            // on top; the canvas is a picture (no touch areas), so clicks reach the tile touch area below.
            if root.item.is-multiview : MultiviewCanvas {
                width: 100%;
                height: 100%;
                interactive: false;
                tiles: root.item.mv-tiles;
                gutters: root.item.mv-gutters;
                screen: root.item.mv-screen;
                background-mode: root.background-mode;
                outer-color: #000000;
            }

            // The video tiles of a Multiview that is in the fullscreen: their players are over there.
            if root.item.is-multiview && root.away : Rectangle {
                width: 100%;
                height: 100%;

                for mv-tile in root.item.mv-tiles : AwayBadge {
                    visible: mv-tile.kind == 1;
                    x: mv-tile.x;
                    y: mv-tile.y;
                    width: mv-tile.width;
                    height: mv-tile.height;
                }
            }

            // Video Viewport Area: Solid black background ensures Slint's canvas is 100% opaque.
            // When XShape cutouts punch through the MPV window, Slint's opaque background and menus are revealed,
            // guaranteeing the desktop never shines through.
            if root.item.is-video && root.item.error-message == "" && root.away : AwayBadge {
                width: 100%;
                height: 100%;
            }

            if root.item.is-video && root.item.error-message == "" && !root.away : Rectangle {
                width: 100%;
                height: 100%;
                background: #000000;

                Rectangle {
                    x: parent.width - 24px;
                    y: parent.height - 20px;
                    width: 20px;
                    height: 16px;
                    background: #000000bb;
                    border-radius: 2px;

                    AppIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        icon: IconId.pause;
                        size: IconSize.xs;
                        color: #ffffff;
                    }
                }
            }
        }
    }
}
