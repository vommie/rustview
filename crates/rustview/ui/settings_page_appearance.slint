import { Slider, CheckBox, ComboBox } from "std-widgets.slint";
import { Theme } from "styles.slint";
import { SettingsCard } from "settings_card.slint";

export component SettingsPageAppearance inherits VerticalLayout {
    spacing: 12px;

    in-out property <int> default-thumb-size: 190;
    in-out property <int> thumb-aspect-idx: 1; // 0=1:1, 1=4:3, 2=5:4, 3=16:9, 4=3:4, 5=4:5, 6=9:16
    in-out property <bool> show-filenames: true;
    in-out property <bool> show-rating-badge: true;
    in-out property <bool> show-tag-badge: true;
    in-out property <bool> show-media-type-badges: true;
    in-out property <bool> show-animated-badge: true;
    in-out property <bool> show-duration-badge: true;
    in-out property <int> thumbnail-badge-overflow-idx: 0; // 0=hide, 1=wrap
    in-out property <bool> enable-hover-previews: true;
    in-out property <bool> enable-tooltips: true;
    in-out property <int> tooltip-delay-ms: 750;
    in-out property <bool> type-ahead-enabled: true;
    in-out property <int> type-ahead-timeout-ms: 1000;
    in-out property <int> type-ahead-new-search-gap-ms: 500;
    in-out property <bool> type-ahead-include-folders: true;
    in-out property <bool> type-ahead-cycle-repeated-keys: true;
    in-out property <bool> type-ahead-center-target: true;
    in-out property <bool> type-ahead-show-no-match: true;
    in-out property <int> type-ahead-multiview-delay-ms: 400;

    // Grid Items Layout Configuration
    in-out property <int> grid-item-padding-h: 8;
    in-out property <int> grid-item-padding-v: 6;
    in-out property <int> grid-spacing: 12;
    in-out property <int> grid-padding: 12;
    in-out property <int> grid-item-border-width: 1;
    in-out property <int> grid-item-corner-radius: 4;

    SettingsCard {
        title: "Grid & Thumbnail Presentation";

        HorizontalLayout {
            Text {
                text: "Default Thumbnail Width:";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Slider {
                width: 140px;
                minimum: 80;
                maximum: 400;
                value: root.default-thumb-size;
                changed(v) => { root.default-thumb-size = Math.round(v); }
            }
            Text {
                text: root.default-thumb-size + "px";
                color: Theme.primary;
                width: 50px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Thumbnail Aspect Ratio:";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            ComboBox {
                width: 180px;
                model: ["1:1 (Square)", "4:3 (Standard)", "5:4 (Landscape)", "16:9 (Widescreen)", "3:4 (Portrait)", "4:5 (Portrait)", "9:16 (Tall Portrait)"];
                current-index <=> root.thumb-aspect-idx;
            }
        }

        CheckBox {
            text: "Display filenames below tiles";
            checked <=> root.show-filenames;
        }

        CheckBox {
            text: "Enable hover video preview animation (YouTube-style)";
            checked <=> root.enable-hover-previews;
        }
    }

    SettingsCard {
        title: "Thumbnail Badges";
        description: "Choose which badges are drawn on top of thumbnails and how they behave when a thumbnail is too small for all of them.";

        CheckBox {
            text: "Show colored rating badge overlay";
            checked <=> root.show-rating-badge;
        }

        CheckBox {
            text: "Show tag indicator overlay";
            checked <=> root.show-tag-badge;
        }

        CheckBox {
            text: "Show media type / status badge on thumbnails (Video / Image / Folder, Missing, Hidden)";
            checked <=> root.show-media-type-badges;
        }

        CheckBox {
            text: "Show ANIM badge on animated pictures (GIF, APNG, WebP, AVIF sequences)";
            checked <=> root.show-animated-badge;
        }

        CheckBox {
            text: "Show duration badge on thumbnails (video)";
            checked <=> root.show-duration-badge;
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "When thumbnail space is insufficient:";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            ComboBox {
                width: 180px;
                model: ["Hide badges", "Wrap badges"];
                current-index <=> root.thumbnail-badge-overflow-idx;
            }
        }
    }

    SettingsCard {
        title: "Grid Items Layout";
        description: "Customize spacing, padding, borders, and corner rounding for media items in the Grid View.";

        HorizontalLayout {
            Text {
                text: "Horizontal Item Padding (Left / Right):";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Slider {
                width: 140px;
                minimum: 0;
                maximum: 32;
                value: root.grid-item-padding-h;
                changed(v) => { root.grid-item-padding-h = Math.round(v); }
            }
            Text {
                text: root.grid-item-padding-h + "px";
                color: Theme.primary;
                width: 50px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        HorizontalLayout {
            Text {
                text: "Vertical Item Padding (Top / Bottom):";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Slider {
                width: 140px;
                minimum: 0;
                maximum: 32;
                value: root.grid-item-padding-v;
                changed(v) => { root.grid-item-padding-v = Math.round(v); }
            }
            Text {
                text: root.grid-item-padding-v + "px";
                color: Theme.primary;
                width: 50px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        HorizontalLayout {
            Text {
                text: "Spacing Between Items:";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Slider {
                width: 140px;
                minimum: 0;
                maximum: 48;
                value: root.grid-spacing;
                changed(v) => { root.grid-spacing = Math.round(v); }
            }
            Text {
                text: root.grid-spacing + "px";
                color: Theme.primary;
                width: 50px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        HorizontalLayout {
            Text {
                text: "Outer Grid Padding:";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Slider {
                width: 140px;
                minimum: 0;
                maximum: 48;
                value: root.grid-padding;
                changed(v) => { root.grid-padding = Math.round(v); }
            }
            Text {
                text: root.grid-padding + "px";
                color: Theme.primary;
                width: 50px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        HorizontalLayout {
            Text {
                text: "Tile Border Width:";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Slider {
                width: 140px;
                minimum: 0;
                maximum: 6;
                value: root.grid-item-border-width;
                changed(v) => { root.grid-item-border-width = Math.round(v); }
            }
            Text {
                text: root.grid-item-border-width == 0 ? "0px (None)" : (root.grid-item-border-width + "px");
                color: Theme.primary;
                width: 75px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        HorizontalLayout {
            Text {
                text: "Tile Corner Radius:";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Slider {
                width: 140px;
                minimum: 0;
                maximum: 24;
                value: root.grid-item-corner-radius;
                changed(v) => { root.grid-item-corner-radius = Math.round(v); }
            }
            Text {
                text: root.grid-item-corner-radius == 0 ? "0px (Square)" : (root.grid-item-corner-radius + "px");
                color: Theme.primary;
                width: 75px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }
    }

    SettingsCard {
        title: "Tooltips";
        description: "Configure application-wide hover tooltip behavior and display delay.";

        CheckBox {
            text: "Enable hover tooltips across application";
            checked <=> root.enable-tooltips;
        }

        if root.enable-tooltips : HorizontalLayout {
            Text {
                text: "Tooltip Display Delay:";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Slider {
                width: 140px;
                minimum: 50;
                maximum: 1500;
                value: root.tooltip-delay-ms;
                changed(v) => { root.tooltip-delay-ms = Math.round(v / 25) * 25; }
            }
            Text {
                text: root.tooltip-delay-ms + " ms";
                color: Theme.primary;
                width: 60px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }
    }

    SettingsCard {
        title: "Type-Ahead Find";
        description: "Type the beginning of a file or folder name in the Browse view (grid or table) to jump to it, without any visible input. Not active while a text field has the focus or a dialog is open.";

        CheckBox {
            text: "Enable type-ahead find";
            checked <=> root.type-ahead-enabled;
        }

        if root.type-ahead-enabled : HorizontalLayout {
            Text {
                text: "Keep typing within (search timeout):";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Slider {
                width: 140px;
                minimum: 300;
                maximum: 3000;
                value: root.type-ahead-timeout-ms;
                changed(v) => { root.type-ahead-timeout-ms = Math.round(v / 50) * 50; }
            }
            Text {
                text: root.type-ahead-timeout-ms + " ms";
                color: Theme.primary;
                width: 60px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        if root.type-ahead-enabled : HorizontalLayout {
            Text {
                text: "Start a new search after a pause of:";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Slider {
                width: 140px;
                minimum: 0;
                maximum: 1500;
                value: root.type-ahead-new-search-gap-ms;
                changed(v) => { root.type-ahead-new-search-gap-ms = Math.round(v / 50) * 50; }
            }
            Text {
                text: root.type-ahead-new-search-gap-ms == 0 ? "Off" : (root.type-ahead-new-search-gap-ms + " ms");
                color: Theme.primary;
                width: 60px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        if root.type-ahead-enabled : Text {
            text: "A typed letter that continues no name starts a new search after that pause, and is ignored as a typo when typed faster. Off = always a typo.";
            color: Theme.text-muted;
            wrap: word-wrap;
        }

        if root.type-ahead-enabled : CheckBox {
            text: "Also find folders";
            checked <=> root.type-ahead-include-folders;
        }

        if root.type-ahead-enabled : CheckBox {
            text: "Repeating a letter cycles through the names that start with it";
            checked <=> root.type-ahead-cycle-repeated-keys;
        }

        if root.type-ahead-enabled : CheckBox {
            text: "Center the found item in the view (otherwise scroll only as far as needed)";
            checked <=> root.type-ahead-center-target;
        }

        if root.type-ahead-enabled : CheckBox {
            text: "Show \"No match\" in the status bar when nothing starts with the typed text";
            checked <=> root.type-ahead-show-no-match;
        }

        if root.type-ahead-enabled : HorizontalLayout {
            Text {
                text: "Open Multiview follows the selection after:";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Slider {
                width: 140px;
                minimum: 0;
                maximum: 2000;
                value: root.type-ahead-multiview-delay-ms;
                changed(v) => { root.type-ahead-multiview-delay-ms = Math.round(v / 50) * 50; }
            }
            Text {
                text: root.type-ahead-multiview-delay-ms == 0 ? "At once" : (root.type-ahead-multiview-delay-ms + " ms");
                color: Theme.primary;
                width: 60px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        if root.type-ahead-enabled : Text {
            text: "Only for items selected by typing: the item is selected at once, a Multiview that follows the selection waits, so no video is opened for every letter.";
            color: Theme.text-muted;
            wrap: word-wrap;
        }
    }
}
