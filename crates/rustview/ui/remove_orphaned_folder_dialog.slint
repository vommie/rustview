import { Theme } from "styles.slint";
import { BulletItem } from "bullet_item.slint";
import { IconId } from "icons.slint";
import { DialogHeading } from "dialog_heading.slint";
import { ButtonBar } from "button_bar.slint";
import { DialogBody } from "dialog_body.slint";

export component RemoveOrphanedFolderDialog inherits Window {
    title: "RustView - Remove Missing Folder from Database";
    width: 500px;
    preferred-height: dialog-layout.preferred-height;
    min-height: dialog-layout.min-height;
    background: Theme.background;

    in-out property <string> folder-name: "";
    in-out property <string> folder-path: "";
    in-out property <int> subfolders-count: 0;
    in-out property <int> files-count: 0;
    in property <string> error-message: "";

    callback confirmed();
    callback cancelled();

    forward-focus: dialog-focus;

    dialog-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            return reject;
        }

        dialog-layout := VerticalLayout {
            width: root.width;
            padding: 0px;
            spacing: 0px;
            alignment: space-between;

            body := DialogBody {
                content-height: content.preferred-height;

                content := VerticalLayout {
                    width: body.width;
                    height: self.preferred-height;
                    padding: 16px;
                    spacing: 12px;

                    DialogHeading {
                        icon: IconId.database-clean;
                        text: "Clean Missing Folder from Database";
                        color: #fab387;
                    }

                    Text {
                        text: "The folder '" + root.folder-name + "' no longer physically exists on disk:";
                        font-size: 12px;
                        color: Theme.text;
                        wrap: word-wrap;
                    }

                    Text {
                        text: root.folder-path;
                        font-size: 11px;
                        font-italic: true;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        background: #fab38718;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #fab38744;

                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;

                            Text {
                                text: "Database records to be permanently purged:";
                                font-size: 11px;
                                font-weight: 700;
                                color: #fab387;
                            }

                            BulletItem {
                                text: root.subfolders-count + " missing subfolder record(s)";
                                color: Theme.text;
                            }

                            BulletItem {
                                text: root.files-count + " media metadata & thumbnail record(s)";
                                color: Theme.text;
                            }
                        }
                    }

                    Text {
                        text: "This operation will clean all database references, tags, and cached thumbnails for this folder tree.";
                        font-size: 11px;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }

                    if root.error-message != "" : Text {
                        text: root.error-message;
                        font-size: 11px;
                        color: #ff5555;
                        wrap: word-wrap;
                    }
                }
            }

            ButtonBar {
                vertical-stretch: 0;
                bar-height: 48px;
                show-cancel: true;
                show-save: true;
                text-save: "Remove from Database";
                text-cancel: "Cancel";
                cancel-clicked => { root.cancelled(); }
                save-clicked => { root.confirmed(); }
            }
        }
    }
}
