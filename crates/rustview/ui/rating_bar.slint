import { Theme } from "styles.slint";

export component RatingButton inherits Rectangle {
    in property <int> rating: 0;
    in property <bool> is-selected: false;
    in property <bool> is-partial: false;
    in property <bool> is-enabled: true;
    callback clicked();

    // Dark with the rating's color as its border; hovered or chosen it is filled with the color and the digit turns dark
    // (the look of RustCut 0.0.75, user decision 2026-10-27). The chosen one is all its color, a little lighter under the
    // pointer; a press darkens the fill (click feedback). A partial rating is filled faintly.
    property <bool> hovered: touch.has-hover && root.is-enabled;
    property <bool> pressed: touch.pressed && root.is-enabled;
    property <bool> filled: root.is-selected || root.hovered;
    property <color> tint: Theme.rating-color(root.rating);
    property <color> fill: root.pressed ? root.tint.darker(0.2)
        : root.is-selected && root.hovered ? root.tint.brighter(0.15) : root.tint;

    border-width: 1px;
    border-color: root.filled ? root.fill : root.tint;
    background: root.filled ? root.fill : root.is-partial ? root.tint.with-alpha(0.35) : Theme.background;
    border-radius: 3px;
    opacity: root.is-enabled ? 1.0 : 0.38;

    touch := TouchArea {
        enabled: root.is-enabled;
        mouse-cursor: root.is-enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.rating;
        color: root.filled ? #000000 : Theme.text;
        font-weight: 700;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component RatingBar inherits HorizontalLayout {
    spacing: 4px;
    height: 20px;

    in-out property <int> selected-rating: 0;
    in property <bool> is-assign-mode: false;
    in property <bool> has-selection: true;
    in property <[bool]> partial-ratings: [false, false, false, false, false, false];
    callback rating-selected(int);

    for rate[idx] in [0, 1, 2, 3, 4, 5]: RatingButton {
        rating: rate;
        is-enabled: !root.is-assign-mode || root.has-selection;
        is-selected: root.selected-rating == rate;
        is-partial: root.is-assign-mode && root.partial-ratings[idx];
        clicked => {
            root.selected-rating = rate;
            root.rating-selected(rate);
        }
    }
}
