import { Theme, MediaTheme } from "styles.slint";

/// The corner marks of the selected medium of a Multiview: four L-shaped marks inside the corners of the view of its tile (its
/// canvas, never the medium itself), drawn over pictures and videos alike.
export component MultiviewFocusCorners inherits Rectangle {
    in property <length> mark-length: 24px;
    in property <length> thickness: 2px;

    property <length> arm: Math.min(root.mark-length, Math.min(root.width, root.height) / 2);

    // top left
    Rectangle { x: 0px; y: 0px; width: root.arm; height: root.thickness; background: MediaTheme.primary; }
    Rectangle { x: 0px; y: 0px; width: root.thickness; height: root.arm; background: MediaTheme.primary; }
    // top right
    Rectangle { x: root.width - root.arm; y: 0px; width: root.arm; height: root.thickness; background: MediaTheme.primary; }
    Rectangle { x: root.width - root.thickness; y: 0px; width: root.thickness; height: root.arm; background: MediaTheme.primary; }
    // bottom left
    Rectangle { x: 0px; y: root.height - root.thickness; width: root.arm; height: root.thickness; background: MediaTheme.primary; }
    Rectangle { x: 0px; y: root.height - root.arm; width: root.thickness; height: root.arm; background: MediaTheme.primary; }
    // bottom right
    Rectangle { x: root.width - root.arm; y: root.height - root.thickness; width: root.arm; height: root.thickness; background: MediaTheme.primary; }
    Rectangle { x: root.width - root.thickness; y: root.height - root.arm; width: root.thickness; height: root.arm; background: MediaTheme.primary; }
}
