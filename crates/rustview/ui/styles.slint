// The colors of both apps (RustCut's `ui/styles.slint` has the same tokens and values): Catppuccin Mocha when `dark`,
// Catppuccin Latte when light (questionnaire 2026-11-06-rustview-light-theme). Rust sets `dark` in every window
// (`src/ui/theme.rs`: Settings > Appearance > Theme: follow the system, dark or light). Colors drawn over pictures and
// videos (badges, the fullscreen background, the Multiview bars) stay dark in both.
export global Theme {
    in-out property <bool> dark: true;
    // The text size of the windows (RustCut's `Theme.font-size`; KDE Plasma's default font is 10 pt).
    out property <length> font-size: 13px;
    // Dark: Catppuccin Mocha; light: Catppuccin Latte.
    out property <color> background: root.dark ? #181825 : #eff1f5;
    // Background of the fullscreen and the tab viewer ("Dark Theme" choice): media stay on dark in both themes.
    out property <color> fullscreen-background: #11111b;
    // The top bar of the main window: darker than the window, so the active tab merges into the window below it.
    out property <color> chrome: root.dark ? #11111b : #dce0e8;
    out property <color> surface: root.dark ? #1e1e2e : #ffffff;
    out property <color> surface-variant: root.dark ? #252538 : #e6e9ef;
    out property <color> surface-hover: root.dark ? #313244 : #dce0e8;
    out property <color> surface-selected: root.dark ? #45475a : #ccd0da;
    out property <color> surface-selected-hover: root.dark ? #52556d : #bcc0cc;
    out property <color> border: root.dark ? #313244 : #ccd0da;
    out property <color> text: root.dark ? #cdd6f4 : #4c4f69;
    out property <color> text-muted: root.dark ? #a6adc8 : #6c6f85;
    out property <color> primary: root.dark ? #89b4fa : #1e66f5;
    out property <color> accent: root.dark ? #f9e2af : #df8e1d;
    // Peach: a video filter is on (the filter button and the number on it).
    out property <color> filter-active: root.dark ? #fab387 : #fe640b;

    // Status / Flags Colors (Catppuccin Palette)
    // A warning (missing files, unsaved edits), pending stubs and running work (progress), the stronger line of a key cap
    // or a scroll thumb, and the rows of the compact tag tree.
    out property <color> status-warn: root.dark ? #fab387 : #fe640b;
    out property <color> status-pending: root.dark ? #89dceb : #04a5e5;
    out property <color> status-info: root.dark ? #cba6f7 : #8839ef;
    out property <color> border-strong: root.dark ? #585b70 : #acb0be;
    out property <color> tree-row: root.dark ? #1b1b2a : #e6e9ef;
    out property <color> tree-row-hover: root.dark ? #383a4f : #dce0e8;
    out property <color> status-ok: root.dark ? #a6e3a1 : #40a02b;         // Green
    out property <color> status-corrupt: root.dark ? #f38ba8 : #d20f39;    // Red
    out property <color> status-deleted: root.dark ? #6c7086 : #9ca0b0;    // Overlay Gray
    out property <color> corrupt-border: root.dark ? #f38ba8 : #d20f39;
    out property <color> corrupt-bg: root.dark ? #f38ba818 : #d20f3918;
    out property <color> deleted-border: root.dark ? #6c7086 : #9ca0b0;
    out property <color> deleted-bg: root.dark ? #31324460 : #ccd0da60;

    // Thumbnail Badge Palette (shared base design of all thumbnail badges)
    out property <color> badge-bg: #000000aa;
    out property <color> badge-text: #ffffff;
    out property <color> badge-text-on-light: #11111b;
    out property <color> badge-text-on-rating: #000000;
    out property <color> badge-info-bg: #89dcebcc;      // Pending stubs
    out property <color> badge-muted-bg: #6c7086cc;     // Deleted files
    out property <color> badge-danger-bg: #f38ba8cc;    // Corrupted files

    // Rating Color Scales (Matching PyView)
    out property <color> rating-0: root.dark ? #dddddd : #8c8fa1;
    out property <color> rating-1: root.dark ? #eeaaaa : #e64553;
    out property <color> rating-2: root.dark ? #ffcc88 : #fe640b;
    out property <color> rating-3: root.dark ? #88ee88 : #40a02b;
    out property <color> rating-4: root.dark ? #6688ee : #1e66f5;
    out property <color> rating-5: root.dark ? #cc88ee : #8839ef;

    /// Returns the semantic theme color for a rating value (0..5).
    pure public function rating-color(rating: int) -> color {
        if rating == 1 { return rating-1; }
        if rating == 2 { return rating-2; }
        if rating == 3 { return rating-3; }
        if rating == 4 { return rating-4; }
        if rating == 5 { return rating-5; }
        return rating-0;
    }

    /// Calculates thumbnail image height based on width and aspect ratio index.
    /// (0: 1:1, 1: 4:3, 2: 5:4, 3: 16:9, 4: 3:4, 5: 4:5, 6: 9:16)
    pure public function calculate-thumb-height(width-px: int, aspect-idx: int) -> length {
        if aspect-idx == 0 { return (width-px * 1px); }
        if aspect-idx == 1 { return Math.round(width-px * 3 / 4) * 1px; }
        if aspect-idx == 2 { return Math.round(width-px * 4 / 5) * 1px; }
        if aspect-idx == 3 { return Math.round(width-px * 9 / 16) * 1px; }
        if aspect-idx == 4 { return Math.round(width-px * 4 / 3) * 1px; }
        if aspect-idx == 5 { return Math.round(width-px * 5 / 4) * 1px; }
        if aspect-idx == 6 { return Math.round(width-px * 16 / 9) * 1px; }
        return Math.round(width-px * 3 / 4) * 1px;
    }
}

// What is drawn over pictures and videos (the Multiview's bars, menus, sliders and hints): always the dark values, also in
// the light theme (questionnaire 2026-11-06-rustview-light-theme, "the bars over videos stay dark").
export global MediaTheme {
    out property <color> background: #181825;
    out property <color> surface: #1e1e2e;
    out property <color> surface-variant: #252538;
    out property <color> surface-hover: #313244;
    out property <color> surface-selected: #45475a;
    out property <color> surface-selected-hover: #52556d;
    out property <color> border: #313244;
    out property <color> text: #cdd6f4;
    out property <color> text-muted: #a6adc8;
    out property <color> primary: #89b4fa;
    out property <color> accent: #f9e2af;
    out property <color> filter-active: #fab387;
    out property <color> status-ok: #a6e3a1;
    out property <color> status-corrupt: #f38ba8;
    out property <color> status-deleted: #6c7086;
}
