# Maintainer: vommie
# Packs the release binary that build-package.sh has just built (target/release/rustview); the version is synchronized from Cargo.toml.
pkgname=rustview
pkgver=0.5.10
pkgrel=1
pkgdesc='Fast image and video browser with folders, tags and ratings (Rust, Slint, FFmpeg, mpv)'
arch=('x86_64')
url='https://github.com/vommie/rustview'
license=('MIT')
depends=(
  'ffmpeg'
  'mpv'
  'hicolor-icon-theme'
)

package() {
    local root="$startdir/.."
    install -Dm755 "$root/target/release/rustview" "$pkgdir/usr/bin/rustview"

    install -Dm644 "$startdir/io.github.vommie.rustview.desktop" \
        "$pkgdir/usr/share/applications/io.github.vommie.rustview.desktop"

    sed -e "s/@VERSION@/$pkgver/" \
        -e "s/@DATE@/$(date -u +%F -d "@${SOURCE_DATE_EPOCH:-$(date +%s)}")/" \
        "$startdir/io.github.vommie.rustview.metainfo.xml" > "$srcdir/io.github.vommie.rustview.metainfo.xml"
    install -Dm644 "$srcdir/io.github.vommie.rustview.metainfo.xml" \
        "$pkgdir/usr/share/metainfo/io.github.vommie.rustview.metainfo.xml"

    # Color icon (scalable and PNG sizes) and the monochrome icon that the desktop recolors to the active color scheme.
    install -Dm644 "$startdir/rustview.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/rustview.svg"
    install -Dm644 "$startdir/rustview-symbolic.svg" "$pkgdir/usr/share/icons/hicolor/symbolic/apps/rustview-symbolic.svg"
    for size in 16 22 24 32 48 64 128 256 512; do
        install -Dm644 "$startdir/icons/rustview-$size.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/rustview.png"
    done

    install -Dm644 "$root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$root/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$root/CHANGELOG.md" "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
}
